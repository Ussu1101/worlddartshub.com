  "system_rules": [
    {
      "rule": "2-Year Rolling Calculation",
      "detail": "Rankings are determined by official prize money won in ranking tournaments over an ongoing 24-month cycle (£1 earned = 1 ranking pound)."
    },
    {
      "rule": "Ranking Events Only",
      "detail": "Prize money counts exclusively from PDC ranking tournaments (World Championship, World Matchplay, World Grand Prix, UK Open, Grand Slam, European Championship, Players Championship Finals, European Tour, and Players Championship events)."
    },
    {
      "rule": "Non-Ranking Events Excluded",
      "detail": "Invitational events such as Premier League Darts, the World Series of Darts, and The Masters do NOT count toward Order of Merit totals."
    },
    {
      "rule": "Defending Prize Money",
      "detail": "Players defend prize money won at the equivalent event two years prior. Failure to reach the same stage results in a net drop in ranking points."
    }
