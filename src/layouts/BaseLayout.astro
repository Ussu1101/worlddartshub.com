---
// src/layouts/BaseLayout.astro
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BackToTop from '../components/BackToTop.astro';
import CookieBanner from '../components/CookieBanner.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  schema?: Record<string, any> | Record<string, any>[];
  noindex?: boolean;
  lang?: string;
  alternates?: { hreflang: string; href: string }[];
}

const {
  title,
  description,
  canonicalUrl,
  ogType = 'website',
  ogImage = '/images/og-default-darts.jpg',
  schema,
  noindex = false,
  lang = 'en',
  alternates = [],
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://worlddartshub.com';
const resolvedCanonical = canonicalUrl || new URL(Astro.url.pathname, siteUrl).toString();
const resolvedOgImage = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;

// Base Schema: WebSite & Organization
const baseWebsiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "World Darts Hub",
  "url": siteUrl,
  "description": "Comprehensive independent fan guide to the PDC World Darts Championship 2026/27 at Alexandra Palace.",
  "inLanguage": "en-GB",
  "publisher": {
    "@type": "Organization",
    "name": "World Darts Hub Editorial Team",
    "url": siteUrl
  }
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <!-- Google tag (gtag.js) — external library deferred to window load so its 177 KiB
         never competes with first paint. The stub below queues every gtag() call in
         dataLayer, so no analytics event is lost while the library is still loading. -->
    <script is:inline>
      (function () {
        function loadGtag() {
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=G-80LM7CCQNR';
          document.head.appendChild(s);
        }
        if (document.readyState === 'complete') loadGtag();
        else window.addEventListener('load', loadGtag);
      })();
    </script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      // Google Consent Mode v2: deny non-essential storage by default (UK GDPR/PECR).
      // The cookie banner updates these to 'granted' when the visitor accepts.
      gtag('consent', 'default', {
        'ad_storage': 'denied',
        'ad_user_data': 'denied',
        'ad_personalization': 'denied',
        'analytics_storage': 'denied'
      });

      gtag('config', 'G-80LM7CCQNR');
    </script>
    <!-- Google AdSense verification -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3021073598613808"
     crossorigin="anonymous"></script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0f172a" />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    )}
    {!noindex && <link rel="canonical" href={resolvedCanonical} />}
    {alternates.map((a) => (
      <link rel="alternate" hreflang={a.hreflang} href={a.href} />
    ))}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={resolvedCanonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:site_name" content="World Darts Hub" />
    <meta property="og:locale" content={lang === 'de' ? 'de_DE' : 'en_GB'} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={resolvedCanonical} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={resolvedOgImage} />

    <!-- No font preconnect: the site uses a system font stack only (see global.css),
         so the previous fonts.googleapis.com preconnect opened a useless connection. -->

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" type="image/x-icon" href="/favicon.ico" />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(baseWebsiteSchema)} />
    {schema && (
      Array.isArray(schema) ? (
        schema.map((s) => (
          <script type="application/ld+json" set:html={JSON.stringify(s)} />
        ))
      ) : (
        <script type="application/ld+json" set:html={JSON.stringify(schema)} />
      )
    )}

    <!-- Suppress Netlify HUD & Floating Badge Overlays.
         The localStorage flags tell Netlify not to inject the HUD, and global.css
         already hides any overlay with display:none !important. The previous
         MutationObserver scanned the whole document on every DOM mutation during
         load (a forced-reflow / main-thread cost), so it was removed. -->
    <script is:inline>
      try {
        localStorage.setItem('nl-hud:public:v1', 'hidden');
        localStorage.setItem('nl-hud:owner-private:v1', 'hidden');
      } catch (e) {}
    </script>
    <!-- Microsoft Clarity — always loads, not gated behind cookie consent (owner decision 2026-10-26) -->
    <script type="text/javascript">
        (function(c,l,a,r,i,t,y){
            c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
            t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
            y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
        })(window, document, "clarity", "script", "z3o9wa2ngh");
    </script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <BackToTop />
    <CookieBanner />
    <script is:inline>
      // GA4: ticket_click — delegated tracking for outbound ticket-vendor links.
      // Add new vendors inside classifyTicketVendor() as links are added.
      (function () {
        function classifyTicketVendor(hostname, pathname) {
          var host = hostname.replace(/^www\./, '');
          if (host === 'seetickets.com') return 'see_tickets';
          if (host === 'pdc.tv' && pathname.indexOf('ticket') !== -1) return 'pdc';
          return null;
        }
        document.addEventListener('click', function (e) {
          var el = e.target && e.target.closest ? e.target.closest('a[href]') : null;
          if (!el) return;
          var href = el.getAttribute('href') || '';
          if (href.charAt(0) !== 'h') return;
          var url;
          try { url = new URL(href, window.location.origin); } catch (err) { return; }
          if (url.origin === window.location.origin) return;
          var vendor = classifyTicketVendor(url.hostname, url.pathname);
          if (!vendor) return;
          if (typeof window.gtag === 'function') {
            window.gtag('event', 'ticket_click', {
              vendor: vendor,
              link_url: url.href,
              page_path: window.location.pathname
            });
          }
        });
      })();
    </script>
    <!-- Netlify HUD guard: these pre-existing marker elements make hud.js return early
         (its dedup check) instead of injecting the badge iframe. Inert: display:none, aria-hidden. -->
    <div id="nl-badge-frame" style="display:none!important" aria-hidden="true"></div><div id="nl-hud-frame" style="display:none!important" aria-hidden="true"></div>
  </body>
</html>
