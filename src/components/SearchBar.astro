---
// src/components/SearchBar.astro
// Additive site-wide search: type to filter /search-index.json, live dropdown results.
// Used twice (desktop header + mobile drawer); each instance inits itself via data-search-root.
const { id = 'site-search', extraClass = '' } = Astro.props;
const inputId = `${id}-input`;
const resultsId = `${id}-results`;
---
<div class={`site-search ${extraClass}`} data-search-root={id}>
  <label class="sr-only" for={inputId}>Search World Darts Hub</label>
  <div class="search-box">
    <span class="search-icon" aria-hidden="true">🔍</span>
    <input
      id={inputId}
      class="search-input"
      type="search"
      placeholder="Search guides, players, tickets…"
      autocomplete="off"
      autocapitalize="off"
      spellcheck="false"
      role="combobox"
      aria-expanded="false"
      aria-autocomplete="list"
      aria-controls={resultsId}
    />
  </div>
  <ul id={resultsId} class="search-results" role="listbox" aria-label="Search results" hidden></ul>
</div>

<script>
  (function initAllSiteSearch() {
    // Shared index cache across instances
    function loadIndex() {
      if (window.__wdhSearchIndex) return Promise.resolve(window.__wdhSearchIndex);
      if (!window.__wdhSearchIndexPromise) {
        window.__wdhSearchIndexPromise = fetch('/search-index.json')
          .then(function (r) { return r.ok ? r.json() : []; })
          .then(function (data) { window.__wdhSearchIndex = data; return data; })
          .catch(function () { return []; });
      }
      return window.__wdhSearchIndexPromise;
    }

    function scoreItem(item, tokens) {
      var title = (item.title || '').toLowerCase();
      var desc = (item.description || '').toLowerCase();
      var url = (item.url || '').toLowerCase().replace(/-/g, ' ');
      var score = 0;
      for (var i = 0; i < tokens.length; i++) {
        var tok = tokens[i];
        if (title.indexOf(tok) !== -1) score += 3;
        else if (url.indexOf(tok) !== -1) score += 2;
        else if (desc.indexOf(tok) !== -1) score += 1;
        else return -1;
      }
      return score;
    }

    function initRoot(root) {
      if (root.dataset.searchInit === '1') return;
      root.dataset.searchInit = '1';
      var input = root.querySelector('.search-input');
      var results = root.querySelector('.search-results');
      var activeIndex = -1;
      var currentItems = [];

      function closeResults() {
        results.hidden = true;
        results.innerHTML = '';
        input.setAttribute('aria-expanded', 'false');
        activeIndex = -1;
        currentItems = [];
      }

      function trackSearch(term, url) {
        var gtagFn = window.gtag;
        if (typeof gtagFn === 'function' && term) {
          gtagFn('event', 'site_search', {
            search_term: term.slice(0, 100),
            result_url: url || ''
          });
        }
      }

      function render(matches) {
        results.innerHTML = '';
        activeIndex = -1;
        currentItems = matches;
        if (!matches.length) {
          var li = document.createElement('li');
          li.className = 'search-no-results';
          li.textContent = 'No matches — try "tickets", "prize money" or "checkout".';
          results.appendChild(li);
        } else {
          matches.forEach(function (item, idx) {
            var li = document.createElement('li');
            li.className = 'search-result-item';
            li.setAttribute('role', 'option');
            li.id = results.id + '-opt-' + idx;
            var a = document.createElement('a');
            a.href = item.url;
            a.tabIndex = -1;
            var t = document.createElement('span');
            t.className = 'search-result-title';
            t.textContent = item.title;
            var u = document.createElement('span');
            u.className = 'search-result-url';
            u.textContent = item.url;
            a.appendChild(t);
            a.appendChild(u);
            li.appendChild(a);
            results.appendChild(li);
          });
        }
        results.hidden = false;
        input.setAttribute('aria-expanded', 'true');
      }

      function setActive(idx) {
        var items = results.querySelectorAll('.search-result-item');
        items.forEach(function (el) { el.classList.remove('is-active'); });
        activeIndex = idx;
        if (idx >= 0 && items[idx]) {
          items[idx].classList.add('is-active');
          input.setAttribute('aria-activedescendant', items[idx].id);
        } else {
          input.removeAttribute('aria-activedescendant');
        }
      }

      input.addEventListener('input', function () {
        var q = input.value.trim().toLowerCase();
        if (q.length < 2) { closeResults(); return; }
        var tokens = q.split(/\s+/);
        loadIndex().then(function (index) {
          // Guard against stale responses
          if (input.value.trim().toLowerCase() !== q) return;
          var scored = [];
          for (var i = 0; i < index.length; i++) {
            var s = scoreItem(index[i], tokens);
            if (s >= 0) scored.push({ item: index[i], score: s });
          }
          scored.sort(function (a, b) { return b.score - a.score; });
          render(scored.slice(0, 8).map(function (x) { return x.item; }));
        });
      });

      input.addEventListener('keydown', function (e) {
        if (results.hidden) return;
        var items = results.querySelectorAll('.search-result-item');
        if (e.key === 'Escape') { closeResults(); input.blur(); }
        else if (e.key === 'ArrowDown') { e.preventDefault(); setActive(Math.min(activeIndex + 1, items.length - 1)); }
        else if (e.key === 'ArrowUp') { e.preventDefault(); setActive(Math.max(activeIndex - 1, -1)); }
        else if (e.key === 'Enter' && activeIndex >= 0 && currentItems[activeIndex]) {
          trackSearch(input.value.trim(), currentItems[activeIndex].url);
          window.location.href = currentItems[activeIndex].url;
        }
      });

      input.addEventListener('focus', function () { loadIndex(); });

      results.addEventListener('click', function (e) {
        var a = e.target && e.target.closest ? e.target.closest('a') : null;
        if (!a || !root.contains(a)) return;
        trackSearch(input.value.trim(), a.getAttribute('href'));
      });
      document.addEventListener('click', function (e) {
        if (!root.contains(e.target)) closeResults();
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && !results.hidden) closeResults();
      });
    }

    document.querySelectorAll('[data-search-root]').forEach(initRoot);
  })();
</script>

<style>
  .site-search {
    position: relative;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .search-box {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 0.45rem 0.75rem;
    transition: border-color 0.15s ease;
  }
  .search-box:focus-within {
    border-color: var(--color-accent, #f59e0b);
  }
  .search-icon {
    font-size: 0.95rem;
    line-height: 1;
    opacity: 0.8;
  }
  .search-input {
    flex: 1;
    min-width: 0;
    background: transparent;
    border: 0;
    outline: 0;
    color: #f8fafc;
    font-size: 0.9rem;
  }
  .search-input::placeholder {
    color: #94a3b8;
  }
  .search-input::-webkit-search-cancel-button {
    cursor: pointer;
  }
  .search-results {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    right: 0;
    margin: 0;
    padding: 0.35rem;
    list-style: none;
    background: #0f172a;
    border: 1px solid #334155;
    border-radius: 10px;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.45);
    max-height: 22rem;
    overflow-y: auto;
    z-index: 60;
  }
  .search-results[hidden] {
    display: none;
  }
  .search-result-item a {
    display: block;
    padding: 0.55rem 0.65rem;
    border-radius: 6px;
    text-decoration: none;
  }
  .search-result-item a:hover,
  .search-result-item.is-active a {
    background: #1e293b;
  }
  .search-result-title {
    display: block;
    color: #f8fafc;
    font-size: 0.88rem;
    font-weight: 600;
    line-height: 1.3;
  }
  .search-result-url {
    display: block;
    color: #94a3b8;
    font-size: 0.75rem;
    margin-top: 0.15rem;
  }
  .search-no-results {
    padding: 0.75rem;
    color: #94a3b8;
    font-size: 0.85rem;
  }
  /* Desktop header instance: visible ≥1024px */
  .search-in-header {
    width: 250px;
    flex-shrink: 0;
  }
  .search-in-drawer {
    display: none;
  }
  @media (max-width: 1023px) {
    .search-in-header {
      display: none;
    }
    .search-in-drawer {
      display: block;
      padding: 0.75rem 1rem 0;
    }
    .search-in-drawer .search-results {
      position: static;
      margin-top: 0.5rem;
      max-height: 18rem;
    }
  }
</style>
