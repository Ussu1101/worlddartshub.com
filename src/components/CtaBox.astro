---
// src/components/CtaBox.astro
interface Props {
  title: string;
  body: string;
  terms: string;
  link: string;
  linkLabel: string;
  disclosure: string;
  image: string;
  imageAlt: string;
}

const {
  title,
  body,
  terms,
  link,
  linkLabel,
  disclosure,
  image,
  imageAlt
} = Astro.props;
---

<aside class="cpa-card" aria-label="Sponsored Offer">
  <div class="cpa-image-container">
    <img 
      src={image} 
      alt={imageAlt} 
      width="600" 
      height="400" 
      loading="lazy" 
      decoding="async" 
      class="cpa-img"
    />
    <span class="cpa-pill-badge">Sponsored</span>
  </div>
  <div class="cpa-body-container">
    <h3 class="cpa-headline">{title}</h3>
    <p class="cpa-text">{body}</p>
    <p class="cpa-terms">{terms}</p>
    <div class="cpa-btn-wrap">
      <a 
        href={link} 
        target="_blank" 
        rel="sponsored nofollow" 
        class="cpa-cta-button"
      >
        <span>{linkLabel}</span>
        <svg class="cpa-arrow-icon" viewBox="0 0 20 20" fill="currentColor" width="18" height="18" aria-hidden="true">
          <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
        </svg>
      </a>
    </div>
    <div class="cpa-disclosure-line">
      <small>{disclosure}</small>
    </div>
  </div>
</aside>

<style>
  .cpa-card {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    overflow: hidden;
    margin: 2.25rem 0;
    box-shadow: 0 4px 12px rgba(15, 23, 42, 0.06);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    max-width: 640px;
    margin-left: auto;
    margin-right: auto;
  }

  .cpa-card:hover {
    box-shadow: 0 8px 20px rgba(15, 23, 42, 0.1);
  }

  .cpa-image-container {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 2;
    background-color: #f1f5f9;
    overflow: hidden;
  }

  .cpa-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .cpa-card:hover .cpa-img {
    transform: scale(1.02);
  }

  .cpa-pill-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    background-color: rgba(15, 23, 42, 0.85);
    backdrop-filter: blur(4px);
    color: #ffffff;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 4px 10px;
    border-radius: 20px;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .cpa-body-container {
    padding: 1.5rem 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .cpa-headline {
    font-size: 1.25rem;
    font-weight: 700;
    color: #0f172a;
    line-height: 1.35;
    margin: 0;
  }

  .cpa-text {
    font-size: 0.95rem;
    color: #334155;
    line-height: 1.55;
    margin: 0;
  }

  .cpa-terms {
    font-size: 0.8rem;
    color: #64748b;
    line-height: 1.45;
    margin: 0;
    padding-top: 0.15rem;
  }

  .cpa-btn-wrap {
    margin-top: 0.6rem;
  }

  .cpa-cta-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background-color: #d97706;
    background-image: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
    color: #ffffff;
    font-size: 1rem;
    font-weight: 700;
    text-decoration: none;
    padding: 0.8rem 1.6rem;
    border-radius: 50px;
    box-shadow: 0 3px 8px rgba(217, 119, 6, 0.35);
    transition: all 0.2s ease;
    width: 100%;
    text-align: center;
  }

  .cpa-cta-button:hover {
    background-image: linear-gradient(135deg, #fbbf24 0%, #d97706 100%);
    transform: translateY(-1px);
    box-shadow: 0 5px 12px rgba(217, 119, 6, 0.45);
    color: #ffffff;
    text-decoration: none;
  }

  .cpa-arrow-icon {
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  .cpa-cta-button:hover .cpa-arrow-icon {
    transform: translateX(3px);
  }

  .cpa-disclosure-line {
    font-size: 0.72rem;
    color: #94a3b8;
    text-align: center;
    margin-top: 0.25rem;
    line-height: 1.4;
  }

  @media (min-width: 640px) {
    .cpa-cta-button {
      width: auto;
      min-width: 260px;
    }
    .cpa-btn-wrap {
      display: flex;
      justify-content: flex-start;
    }
    .cpa-disclosure-line {
      text-align: left;
    }
  }
</style>
