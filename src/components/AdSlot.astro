---
// src/components/AdSlot.astro
interface Props {
  slotType: 'leaderboard' | 'rectangle' | 'in-feed' | 'billboard';
  id?: string;
}

const { slotType, id = 'ad-slot-' + Math.random().toString(36).substring(2, 7) } = Astro.props;

let heightClass = 'ad-rectangle';
let label = 'Advertisement';

if (slotType === 'leaderboard') {
  heightClass = 'ad-leaderboard';
  label = 'Sponsored / Advertisement';
} else if (slotType === 'billboard') {
  heightClass = 'ad-billboard';
  label = 'Sponsored / Advertisement';
} else if (slotType === 'in-feed') {
  heightClass = 'ad-rectangle';
  label = 'Sponsored Resource';
}
---

<aside class="ad-slot-wrapper" aria-label={label}>
  <span class="ad-label">{label}</span>
  <div class:list={['ad-slot-box', heightClass]} id={id}>
    <!-- Ad Network Integration Slot (e.g. Google AdSense / Header Bidding) -->
    <span class="ad-placeholder-text">Ad Slot ({slotType})</span>
  </div>
</aside>

<style>
  .ad-slot-wrapper {
    margin: 2rem auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    clear: both;
  }

  .ad-label {
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #94a3b8;
    margin-bottom: 0.35rem;
    font-weight: 600;
  }

  .ad-slot-box {
    background-color: #f8fafc;
    border: 1px dashed #cbd5e1;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    transition: background-color 0.2s ease;
  }

  .ad-placeholder-text {
    color: #94a3b8;
    font-size: 0.75rem;
    font-family: ui-monospace, monospace;
    opacity: 0.6;
  }

  .ad-leaderboard {
    min-height: 90px;
    max-width: 728px;
  }

  .ad-rectangle {
    min-height: 250px;
    max-width: 300px;
  }

  .ad-billboard {
    min-height: 250px;
    max-width: 970px;
  }

  @media (max-width: 768px) {
    .ad-leaderboard {
      min-height: 50px;
      max-width: 320px;
    }
  }
</style>
