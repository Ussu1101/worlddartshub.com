---
// src/pages/players/player-comparisons.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AdSlot from '../../components/AdSlot.astro';
import VerificationBadge from '../../components/VerificationBadge.astro';
import compData from '../../data/player-comparisons.json';

const pageTitle = "PDC Darts Rivalries & Head-to-Head Comparisons (2026/27)";
const pageDescription = "Premier head-to-head rivalries in professional darts: Humphries vs Littler, Van Gerwen vs Price, and Anderson vs MVG. Match stats and records.";
const siteUrl = "https://worlddartshub.com";

const breadcrumbItems = [
  { name: 'Players', url: '/players/' },
  { name: 'Head-to-Head Comparisons', url: '/players/player-comparisons/' }
];

const rivalriesSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": pageTitle,
  "description": pageDescription,
  "url": `${siteUrl}/players/player-comparisons/`,
  "mainEntity": {
    "@type": "ItemList",
    "name": "PDC Darts Blockbuster Head-to-Head Rivalries",
    "numberOfItems": compData.rivalries.length,
    "itemListElement": compData.rivalries.map((riv, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "name": `${riv.title}: ${riv.tagline}`
    }))
  }
};
---

<BaseLayout 
  title={pageTitle} 
  description={pageDescription}
  schema={rivalriesSchema}
>
  <Breadcrumbs items={breadcrumbItems} />

  <header class="page-header">
    <div class="container">
      <div class="badge-row">
        <span class="badge badge-accent">HEAD-TO-HEAD</span>
        <span class="badge">OFFICIAL PDC MATCHPLAY RECORDS</span>
      </div>
      <h1>PDC Darts Blockbuster Player Rivalries</h1>
      <p class="lead-text">
        The defining rivalries of world darts: Humphries vs Littler, Van Gerwen vs Price, and Smith vs MVG. Detailed head-to-head records, clash-of-styles tactical breakdowns, and legendary finals in the Great Hall.
      </p>
    </div>
  </header>

  <div class="container content-layout">
    <main class="main-column">
      <VerificationBadge verifiedDate={compData.last_verified} topic="PDC Head-to-Head Records & Stage Finals" />

      <!-- High Level Summary -->
      <section class="content-card intro-summary">
        <h2>The Clashes That Define Modern Darts</h2>
        <p>
          Darts is a psychological duel played across seven feet and nine and a quarter inches. When the world's greatest players collide on the Alexandra Palace stage, differing paces of play, equipment philosophies, and high-intensity rivalries produce sporting drama of the highest caliber.
        </p>
      </section>

      <AdSlot id="rivalry-top-ad" label="Sports Streaming & Live Tickets" />

      <!-- Detailed Rivalries Section -->
      {compData.rivalries.map((riv) => (
        <section class="content-card rivalry-card" id={riv.rivalry_id}>
          <div class="rivalry-header">
            <span class="rivalry-tagline">{riv.tagline}</span>
            <h2>{riv.title}</h2>
          </div>

          <!-- Head to Head Box -->
          <div class="h2h-score-banner">
            <div class="h2h-player player-one">
              <span class="p-name">
                <a href={`/players/${riv.player_1.slug}/`}>{riv.player_1.name}</a>
              </span>
              <span class="p-nick">"{riv.player_1.nickname}"</span>
              <span class="p-titles">{riv.player_1.world_titles} World Titles</span>
            </div>
            
            <div class="h2h-vs-box">
              <div class="vs-label">HEAD-TO-HEAD</div>
              <div class="vs-tally">
                {riv.head_to_head_record.humphries_wins ?? riv.head_to_head_record.van_gerwen_wins ?? riv.head_to_head_record.player_1_wins ?? 0}
                -
                {riv.head_to_head_record.littler_wins ?? riv.head_to_head_record.price_wins ?? riv.head_to_head_record.player_2_wins ?? 0}
              </div>
              <div class="vs-total">{riv.head_to_head_record.total_meetings} Career Meetings</div>
              <div class="vs-meta">Cutoff: {riv.as_of_date}</div>
            </div>

            <div class="h2h-player player-two">
              <span class="p-name">
                <a href={`/players/${riv.player_2.slug}/`}>{riv.player_2.name}</a>
              </span>
              <span class="p-nick">"{riv.player_2.nickname}"</span>
              <span class="p-titles">{riv.player_2.world_titles} World Titles</span>
            </div>
          </div>

          <div class="scope-banner">
            <strong>Scope:</strong> {riv.record_scope} | <strong>Source:</strong> {riv.source}
          </div>

          <p class="match-overview-text">{riv.match_overview}</p>

          <!-- Defining Matches -->
          <div class="defining-matches-block">
            <h4>Historic Defining Clashes</h4>
            <div class="matches-grid">
              {riv.defining_matches.map((match) => (
                <div class="match-entry">
                  <div class="match-head">
                    <span class="match-event">{match.event}</span>
                    <span class="match-score">{match.score}</span>
                  </div>
                  <div class="match-venue">{match.venue}</div>
                  <p class="match-summary">{match.summary}</p>
                </div>
              ))}
            </div>
          </div>

          <!-- Tactical Analysis -->
          <div class="tactical-box">
            <h4>Tactical Breakdown & Clash of Styles</h4>
            <p>{riv.tactical_analysis}</p>
          </div>
        </section>
      ))}

      <AdSlot id="rivalry-mid-ad" label="Darts Sets & Custom Flights" />

      <!-- FAQ Section -->
      <section class="content-card faq-section">
        <h2>Darts Rivalries FAQ</h2>
        <div class="faq-accordion">
          <details class="faq-item">
            <summary class="faq-question">What was the final score of the 2024 World Darts Championship Final?</summary>
            <div class="faq-answer">
              <p>Luke Humphries defeated 16-year-old Luke Littler <strong>7–4 in sets</strong> to win the 2024 PDC World Darts Championship and the £500,000 top prize, recovering from 4-2 down in sets with five consecutive set victories.</p>
            </div>
          </details>

          <details class="faq-item">
            <summary class="faq-question">How many times did Phil Taylor and Raymond van Barneveld play each other?</summary>
            <div class="faq-answer">
              <p>Phil Taylor and Raymond van Barneveld met 83 times across all televised and non-televised PDC competitions, with Taylor winning 60 matches, Van Barneveld winning 19, and 4 matches ending in draws.</p>
            </div>
          </details>

          <details class="faq-item">
            <summary class="faq-question">Why was the 2023 final between Smith and Van Gerwen so historic?</summary>
            <div class="faq-answer">
              <p>The 2023 final featured what is universally regarded as the greatest leg in darts history, when Michael van Gerwen missed double 12 for a nine-darter and Michael Smith immediately followed on the same turn to hit a nine-darter before winning his maiden world crown 7–4.</p>
            </div>
          </details>
        </div>
      </section>
    </main>

    <!-- Sidebar -->
    <aside class="sidebar-column">
      <div class="sidebar-card">
        <h3>Player Authority Hubs</h3>
        <ul class="sidebar-links">
          <li><a href="/players/">← Back to All Players</a></li>
          <li><a href="/players/stats/">📈 Performance Statistics</a></li>
          <li><a href="/players/rankings/">📊 Official Order of Merit</a></li>
          <li><a href="/players/earnings/">💰 Player Career Earnings</a></li>
          <li><a href="/players/darts-equipment-specs/">🎯 Darts Equipment Specs</a></li>
          <li><a href="/players/walk-on-songs/">🎵 Walk-On Songs & Anthems</a></li>
          <li><a href="/players/records/">🏆 All-Time Records</a></li>
          <li><a href="/players/world-championship-records/">🏛️ World Championship Records</a></li>
          <li><a href="/players/9-darters/">🎯 Televised Nine-Darters</a></li>
          <li><a href="/players/180-records/">⚡ 180 Maximum Records</a></li>
        </ul>
      </div>

      <div class="sidebar-card highlight-sidebar">
        <h3>Tournament Key Pages</h3>
        <ul class="sidebar-links">
          <li><a href="/draw/">Tournament Draw & Bracket</a></li>
          <li><a href="/schedule/">Full Schedule of Play</a></li>
          <li><a href="/results/">Live Match Results</a></li>
          <li><a href="/tournament/prize-money/">£5,000,000 Prize Fund</a></li>
        </ul>
      </div>

      <AdSlot id="rivalry-sidebar-ad" label="Official PDC Darts Tickets" />
    </aside>
  </div>
</BaseLayout>

<style>
  .page-header {
    background: linear-gradient(135deg, #111827 0%, #1f2937 100%);
    border-bottom: 1px solid #374151;
    padding: 3rem 0 2rem;
    margin-bottom: 2rem;
  }
  .badge-row {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }
  .lead-text {
    font-size: 1.125rem;
    color: #9ca3af;
    max-width: 800px;
    line-height: 1.6;
    margin-top: 0.75rem;
  }
  .content-layout {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 2rem;
    margin-bottom: 3rem;
  }
  @media (max-width: 900px) {
    .content-layout {
      grid-template-columns: 1fr;
    }
  }
  .content-card {
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 2rem;
    margin-bottom: 2rem;
  }
  .rivalry-card {
    border-color: #475569;
  }
  .rivalry-header {
    margin-bottom: 1.5rem;
  }
  .rivalry-tagline {
    font-size: 0.85rem;
    text-transform: uppercase;
    font-weight: 700;
    color: #f59e0b;
    display: block;
    margin-bottom: 0.25rem;
  }
  .rivalry-header h2 {
    margin: 0;
    font-size: 1.75rem;
    color: #f8fafc;
  }
  .h2h-score-banner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    background: #0f172a;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 1.25rem;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  @media (max-width: 640px) {
    .h2h-score-banner {
      grid-template-columns: 1fr;
      text-align: center;
    }
  }
  .h2h-player {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .player-one {
    text-align: left;
  }
  .player-two {
    text-align: right;
  }
  @media (max-width: 640px) {
    .player-one, .player-two {
      text-align: center;
    }
  }
  .p-name a {
    font-size: 1.25rem;
    font-weight: 800;
    color: #38bdf8;
    text-decoration: none;
  }
  .p-name a:hover {
    text-decoration: underline;
  }
  .p-nick {
    font-size: 0.85rem;
    color: #94a3b8;
  }
  .p-titles {
    font-size: 0.8rem;
    color: #f59e0b;
    font-weight: 600;
  }
  .h2h-vs-box {
    text-align: center;
    padding: 0 1rem;
  }
  .vs-label {
    font-size: 0.75rem;
    font-weight: 700;
    color: #94a3b8;
  }
  .vs-tally {
    font-size: 1.75rem;
    font-weight: 900;
    color: #10b981;
    line-height: 1.2;
  }
  .vs-total {
    font-size: 0.75rem;
    color: #64748b;
  }
  .vs-meta {
    font-size: 0.7rem;
    color: #f59e0b;
    margin-top: 0.15rem;
  }
  .scope-banner {
    background: #0f172a;
    border: 1px solid #334155;
    padding: 0.5rem 0.75rem;
    border-radius: 4px;
    font-size: 0.8rem;
    color: #94a3b8;
    margin-bottom: 1.25rem;
  }
  .match-overview-text {
    font-size: 1rem;
    line-height: 1.6;
    color: #cbd5e1;
    margin-bottom: 1.5rem;
  }
  .defining-matches-block {
    margin-bottom: 1.5rem;
  }
  .defining-matches-block h4 {
    margin: 0 0 0.75rem;
    color: #f8fafc;
    font-size: 1.05rem;
  }
  .matches-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }
  .match-entry {
    background: #0f172a;
    border: 1px solid #334155;
    padding: 1rem;
    border-radius: 6px;
  }
  .match-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.25rem;
  }
  .match-event {
    font-weight: 700;
    color: #f8fafc;
    font-size: 0.95rem;
  }
  .match-score {
    font-weight: 800;
    color: #f59e0b;
    font-size: 0.95rem;
  }
  .match-venue {
    font-size: 0.8rem;
    color: #94a3b8;
    margin-bottom: 0.5rem;
  }
  .match-summary {
    margin: 0;
    font-size: 0.85rem;
    color: #cbd5e1;
    line-height: 1.4;
  }
  .tactical-box {
    background: #0f172a;
    border-left: 4px solid #38bdf8;
    padding: 1.25rem;
    border-radius: 0 6px 6px 0;
  }
  .tactical-box h4 {
    margin: 0 0 0.5rem;
    color: #38bdf8;
    font-size: 1rem;
  }
  .tactical-box p {
    margin: 0;
    font-size: 0.9rem;
    color: #94a3b8;
    line-height: 1.5;
  }
  .faq-accordion details {
    background: #0f172a;
    border: 1px solid #334155;
    border-radius: 6px;
    margin-bottom: 0.75rem;
    padding: 0.75rem 1rem;
  }
  .faq-question {
    cursor: pointer;
    font-weight: 600;
    color: #f8fafc;
  }
  .faq-answer {
    margin-top: 0.75rem;
    color: #94a3b8;
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .sidebar-card {
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
  }
  .sidebar-card h3 {
    margin-top: 0;
    font-size: 1.1rem;
    color: #f8fafc;
    border-bottom: 1px solid #334155;
    padding-bottom: 0.5rem;
    margin-bottom: 1rem;
  }
  .sidebar-links {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .sidebar-links li {
    margin-bottom: 0.6rem;
  }
  .sidebar-links a {
    color: #94a3b8;
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.2s;
  }
  .sidebar-links a:hover {
    color: #38bdf8;
  }
  .highlight-sidebar {
    border-color: #f59e0b;
  }
</style>
