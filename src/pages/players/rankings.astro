---
// src/pages/players/rankings.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AdSlot from '../../components/AdSlot.astro';
import VerificationBadge from '../../components/VerificationBadge.astro';
import oomData from '../../data/order-of-merit.json';

const pageTitle = "PDC World Darts Rankings 2026/27 — Official Order of Merit & Seeds";
const pageDescription = "Official PDC Order of Merit world rankings for 2026/27. Track provisional seeds, the 2-year rolling prize money system, cut-off rules, and race for Ally Pally.";
const siteUrl = "https://worlddartshub.com";

const breadcrumbItems = [
  { name: 'Players', url: '/players/' },
  { name: 'Rankings & Order of Merit', url: '/players/rankings/' }
];

const rankingsSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": pageTitle,
  "description": pageDescription,
  "url": `${siteUrl}/players/rankings/`,
  "mainEntity": {
    "@type": "ItemList",
    "name": "PDC Order of Merit Top 32 Seeds",
    "numberOfItems": oomData.provisional_rankings.length,
    "itemListElement": oomData.provisional_rankings.map((item, index) => ({
      "@type": "ListItem",
      "position": item.rank,
      "name": `World No. ${item.rank}: ${item.player} (${item.prize_money})`
    }))
  }
};
---

<BaseLayout 
  title={pageTitle} 
  description={pageDescription}
  schema={rankingsSchema}
>
  <Breadcrumbs items={breadcrumbItems} />

  <header class="page-header">
    <div class="container">
      <div class="badge-row">
        <span class="badge badge-accent">PDC WORLD RANKINGS</span>
        <span class="badge">{oomData.status_badge}</span>
      </div>
      <h1>PDC Order of Merit & World Rankings</h1>
      <p class="lead-text">
        The official global hierarchy of professional darts. The Top 32 players on the PDC Order of Merit earn automatic seeded entry into the second round of the World Darts Championship at Alexandra Palace.
      </p>
    </div>
  </header>

  <div class="container content-layout">
    <main class="main-column">
      <VerificationBadge verifiedDate="October 2026" topic="PDC Order of Merit & Cut-Off Specifications" />

      <!-- Ranking Mechanism Summary -->
      <section class="content-card intro-summary">
        <h2>How the PDC Order of Merit Works</h2>
        <p>
          Unlike tennis (points system) or golf (weighted average), professional darts operates on a pure <strong>two-year rolling prize money calculation</strong>. Every £1 earned in an official PDC ranking tournament equals one ranking point. A player's world ranking is the exact sum of all ranking prize money won across the trailing 24 calendar months.
        </p>

        <div class="rules-grid">
          {oomData.system_rules.map((rule) => (
            <div class="rule-box">
              <h4>{rule.rule}</h4>
              <p>{rule.detail}</p>
            </div>
          ))}
        </div>
      </section>

      <AdSlot id="rankings-top-ad" label="Darts Betting & Travel Sponsors" />

      <!-- Provisional Top 32 Seedings Table -->
      <section class="content-card table-section">
        <h2>Provisional Top 32 Order of Merit: 2026/27 World Championship Seeds</h2>
        <p class="table-note">
          Final seeded positions are locked following the completion of the Players Championship Finals in late November 2026. Players ranked 1 to 32 receive a direct bye into Round Two.
        </p>

        <div class="table-responsive">
          <table class="data-table">
            <thead>
              <tr>
                <th>Rank</th>
                <th>Player</th>
                <th>Nationality</th>
                <th>2-Year Prize Money</th>
                <th>Status / Recent Achievements</th>
              </tr>
            </thead>
            <tbody>
              {oomData.provisional_rankings.map((item) => (
                <tr class={item.rank <= 4 ? "top-four-row" : ""}>
                  <td>
                    <span class={`rank-badge ${item.rank <= 4 ? "elite-rank" : item.rank <= 16 ? "seed-rank" : "top32-rank"}`}>
                      #{item.rank}
                    </span>
                  </td>
                  <td>
                    <strong>{item.player}</strong>
                  </td>
                  <td><span class="nation-text">{item.nationality}</span></td>
                  <td><strong class="money-text">{item.prize_money}</strong></td>
                  <td><span class="notes-text">{item.notes}</span></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <!-- Qualification Criteria Breakdown -->
      <section class="content-card qual-section">
        <h2>World Darts Championship 128-Player Field Composition</h2>
        <p>
          The World Championship features an international field of 128 competitors qualified through three distinct avenues:
        </p>

        <div class="qual-route-card">
          <h3>1. Top 32 PDC Order of Merit (The Seeds)</h3>
          <p>
            The world's highest earners over the two-year cycle receive guaranteed seeded positions and bypass Round One entirely, entering directly at the Round Two stage.
          </p>
        </div>

        <div class="qual-route-card">
          <h3>2. Top 32 ProTour Order of Merit Qualifiers</h3>
          <p>
            The next 32 highest earners from the single-season ProTour (European Tour + Players Championship events) who are not already in the top 32 main Order of Merit enter in Round One.
          </p>
        </div>

        <div class="qual-route-card">
          <h3>3. International & Tour Card Qualifiers (64 Players)</h3>
          <p>
            Global qualifying circuits including the PDC Asian Tour, DPA Australian Tour, CDC North American Tour, PDC Nordic & Baltic, Women's Series qualifiers, World Youth Champion, and final Tour Card Holder Qualifiers.
          </p>
        </div>
      </section>

      <AdSlot id="rankings-mid-ad" label="Sports Equipment & Apparel" />

      <!-- Rankings FAQ -->
      <section class="content-card faq-section">
        <h2>PDC World Rankings FAQ</h2>
        <div class="faq-accordion">
          <details class="faq-item">
            <summary class="faq-question">Does Premier League prize money count towards the Order of Merit?</summary>
            <div class="faq-answer">
              <p>No. Premier League Darts is an invitational tournament. Although the champion receives £275,000, non-ranking events do not contribute to the official PDC Order of Merit.</p>
            </div>
          </details>

          <details class="faq-item">
            <summary class="faq-question">What does "defending prize money" mean in darts?</summary>
            <div class="faq-answer">
              <p>Because the Order of Merit covers a rolling two-year window, any prize money won exactly two years ago drops off a player's balance. If a player won £500,000 as World Champion two years prior, they must repeat that performance to avoid losing £500,000 from their ranking calculation.</p>
            </div>
          </details>

          <details class="faq-item">
            <summary class="faq-question">Who holds the record for longest consecutive streak as World No. 1?</summary>
            <div class="faq-answer">
              <p>Phil Taylor held the World No. 1 ranking for a cumulative total of over 13 years across multiple reigns. In the modern era, Michael van Gerwen held the No. 1 spot uninterrupted for seven continuous years from January 2014 to January 2021.</p>
            </div>
          </details>
        </div>
      </section>
    </main>

    <!-- Sidebar -->
    <aside class="sidebar-column">
      <div class="sidebar-card">
        <h3>Player Authority Hubs</h3>
        <ul class="sidebar-links">
          <li><a href="/players/">← Back to All Players</a></li>
          <li><a href="/players/earnings/">💰 Player Career Earnings</a></li>
          <li><a href="/players/darts-equipment-specs/">🎯 Darts Equipment Specs</a></li>
          <li><a href="/players/walk-on-songs/">🎵 Walk-On Songs & Anthems</a></li>
          <li><a href="/players/stats/">📈 Performance Statistics</a></li>
          <li><a href="/players/records/">🏆 All-Time Records</a></li>
          <li><a href="/players/9-darters/">🎯 Televised Nine-Darters</a></li>
          <li><a href="/players/180-records/">⚡ 180 Maximum Records</a></li>
          <li><a href="/players/player-comparisons/">⚔️ Head-to-Head Rivalries</a></li>
        </ul>
      </div>

      <div class="sidebar-card highlight-sidebar">
        <h3>Tournament Key Pages</h3>
        <ul class="sidebar-links">
          <li><a href="/tournament/prize-money/">£5,000,000 Prize Fund Breakdown</a></li>
          <li><a href="/draw/">Tournament Draw & Bracket</a></li>
          <li><a href="/schedule/">Full Schedule of Play</a></li>
          <li><a href="/tournament/order-of-merit/">Order of Merit Explainer</a></li>
        </ul>
      </div>

      <AdSlot id="rankings-sidebar-ad" label="Official Ticket & Hospitality Packages" />
    </aside>
  </div>
</BaseLayout>

<style>
  .page-header {
    background: linear-gradient(135deg, #111827 0%, #1f2937 100%);
    border-bottom: 1px solid #374151;
    padding: 3rem 0 2rem;
    margin-bottom: 2rem;
  }
  .badge-row {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }
  .lead-text {
    font-size: 1.125rem;
    color: #9ca3af;
    max-width: 800px;
    line-height: 1.6;
    margin-top: 0.75rem;
  }
  .content-layout {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 2rem;
    margin-bottom: 3rem;
  }
  @media (max-width: 900px) {
    .content-layout {
      grid-template-columns: 1fr;
    }
  }
  .content-card {
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 2rem;
    margin-bottom: 2rem;
  }
  .rules-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
    margin-top: 1.5rem;
  }
  .rule-box {
    background: #0f172a;
    border: 1px solid #334155;
    padding: 1.25rem;
    border-radius: 6px;
  }
  .rule-box h4 {
    margin: 0 0 0.5rem;
    color: #38bdf8;
    font-size: 1rem;
  }
  .rule-box p {
    margin: 0;
    font-size: 0.85rem;
    color: #94a3b8;
    line-height: 1.4;
  }
  .table-responsive {
    overflow-x: auto;
    margin-top: 1rem;
  }
  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
    text-align: left;
  }
  .data-table th {
    background: #0f172a;
    color: #e2e8f0;
    padding: 0.75rem 1rem;
    border-bottom: 2px solid #475569;
    white-space: nowrap;
  }
  .data-table td {
    padding: 0.85rem 1rem;
    border-bottom: 1px solid #334155;
    vertical-align: middle;
  }
  .top-four-row {
    background: rgba(245, 158, 11, 0.05);
  }
  .rank-badge {
    display: inline-block;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    font-weight: 700;
    font-size: 0.85rem;
  }
  .elite-rank {
    background: #f59e0b;
    color: #0f172a;
  }
  .seed-rank {
    background: #38bdf8;
    color: #0f172a;
  }
  .top32-rank {
    background: #334155;
    color: #f1f5f9;
  }
  .nation-text {
    color: #94a3b8;
    font-size: 0.85rem;
  }
  .money-text {
    color: #10b981;
    font-size: 1rem;
  }
  .notes-text {
    color: #cbd5e1;
    font-size: 0.85rem;
  }
  .qual-route-card {
    background: #0f172a;
    border-left: 4px solid #10b981;
    padding: 1.25rem;
    border-radius: 0 6px 6px 0;
    margin-bottom: 1.25rem;
  }
  .qual-route-card h3 {
    margin-top: 0;
    color: #f8fafc;
    font-size: 1.05rem;
  }
  .qual-route-card p {
    margin: 0;
    color: #94a3b8;
    font-size: 0.9rem;
    line-height: 1.5;
  }
  .faq-accordion details {
    background: #0f172a;
    border: 1px solid #334155;
    border-radius: 6px;
    margin-bottom: 0.75rem;
    padding: 0.75rem 1rem;
  }
  .faq-question {
    cursor: pointer;
    font-weight: 600;
    color: #f8fafc;
  }
  .faq-answer {
    margin-top: 0.75rem;
    color: #94a3b8;
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .sidebar-card {
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
  }
  .sidebar-card h3 {
    margin-top: 0;
    font-size: 1.1rem;
    color: #f8fafc;
    border-bottom: 1px solid #334155;
    padding-bottom: 0.5rem;
    margin-bottom: 1rem;
  }
  .sidebar-links {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .sidebar-links li {
    margin-bottom: 0.6rem;
  }
  .sidebar-links a {
    color: #94a3b8;
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.2s;
  }
  .sidebar-links a:hover {
    color: #38bdf8;
  }
  .highlight-sidebar {
    border-color: #f59e0b;
  }
</style>
