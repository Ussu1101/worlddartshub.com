---
// src/pages/players/littler-vs-van-veen.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import VerificationBadge from '../../components/VerificationBadge.astro';

const pageTitle = "Luke Littler vs Gian van Veen Head to Head: Record, Meetings & Rivalry";
const pageDescription = "Luke Littler leads Gian van Veen 6–5 in 11 verified PDC meetings as of 26 November 2026. Full televised meetings table, 3 major finals, last 5 meetings and the rivalry story.";
const siteUrl = "https://worlddartshub.com";
const canonicalUrl = `${siteUrl}/players/littler-vs-van-veen/`;

const breadcrumbItems = [
  { name: 'Home', url: '/' },
  { name: 'Players', url: '/players/' },
  { name: 'Head-to-Head Comparisons', url: '/players/player-comparisons/' },
  { name: 'Littler vs van Veen' }
];

const faqItems = [
  {
    q: "Who leads the head-to-head between Luke Littler and Gian van Veen?",
    a: "Luke Littler leads 6–5 across 11 verified PDC meetings as of 26 November 2026. In televised meetings the lead is 6–4 from 10 meetings."
  },
    {
    q: "When did Littler and van Veen last play each other?",
    a: "2 April 2026, Premier League Night 9, when van Veen won 6–5. They have not met since — no meeting at the 2026 UK Open, World Matchplay, World Grand Prix, European Championship, World Series Finals or Grand Slam."
  },
    {
    q: "How many major finals have Littler and van Veen contested?",
    a: "Three finals, all won by Littler: the 2023 World Youth Championship (6–4), the 2026 World Championship (7–1 in sets) and the 2026 Poland Darts Open (8–4)."
  }
];

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${canonicalUrl}#webpage`,
      "name": pageTitle,
      "description": pageDescription,
      "url": canonicalUrl,
      "inLanguage": "en-GB"
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonicalUrl}#breadcrumb`,
      "itemListElement": breadcrumbItems.map((item, index) => ({
        "@type": "ListItem",
        "position": index + 1,
        "name": item.name,
        "item": item.url ? `${siteUrl}${item.url}` : canonicalUrl
      }))
    },
    {
      "@type": "FAQPage",
      "@id": `${canonicalUrl}#faq`,
      "mainEntity": faqItems.map(item => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.a
        }
      }))
    }
  ]
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  schema={pageSchema}
  canonicalUrl={canonicalUrl}
>
  <Breadcrumbs items={breadcrumbItems} />

  <header class="page-header">
    <div class="container">
      <div class="badge-row">
        <span class="badge badge-accent">HEAD-TO-HEAD</span>
        <span class="badge">11 PDC MEETINGS</span>
      </div>
      <h1>Luke Littler vs Gian van Veen Head to Head</h1>
      <p class="lead-text">
        The closest rivalry of Littler’s career so far: he leads van Veen 6–5 in 11 verified PDC meetings, with 3 major finals between them — including the 2026 World Championship final.
      </p>
    </div>
  </header>

  <div class="container content-layout">
    <main class="main-column">
      <VerificationBadge verifiedDate="26 November 2026" topic="PDC Head-to-Head Records & Stage Finals" />

      <!-- Head to Head Ledger -->
      <section class="content-card">
        <h2>Head-to-Head Record</h2>
        <div class="h2h-score-banner">
          <div class="h2h-player player-one">
            <span class="p-name">
              <a href="/players/luke-littler/">Luke Littler</a>
            </span>
            <span class="p-nick">"The Nuke"</span>
            <span class="p-titles">2 World Titles</span>
          </div>

          <div class="h2h-vs-box">
            <div class="vs-label">HEAD-TO-HEAD</div>
            <div class="vs-tally">6 - 5</div>
            <div class="vs-total">11 PDC Meetings</div>
            <div class="vs-meta">As of 26 November 2026</div>
          </div>

          <div class="h2h-player player-two">
            <span class="p-name">
              <a href="/players/gian-van-veen/">Gian van Veen</a>
            </span>
            <span class="p-nick">"The Giant"</span>
            <span class="p-titles">European Champion</span>
          </div>
        </div>

        <div class="scope-banner">
          <strong>Scope:</strong> All PDC meetings — televised majors, World Series, European Tour and Players Championship floor events. <strong>Source:</strong> mastercaller.com tournament results, Sky Sports and Sporting Life previews, CSWStats results pages.
        </div>

        <p class="ledger-note">
          11 verified PDC meetings: 10 televised plus the Players Championship 5 floor event in 2025 (van Veen 7–6). Two reported totals are NOT in this ledger: Darts News (2 April 2026) said 12 meetings with van Veen on 5 — one more Littler win than can be identified; a 1 November 2026 social graphic gave 7–6 to Littler (13 meetings) — one more van Veen win after April 2026 that could not be identified. Televised majors on their own: 5 meetings, Littler 3–2. No CSWStats head-to-head page exists for this pair.
        </p>
      </section>

      <!-- TV Meetings Table -->
      <section class="content-card table-section">
        <h2>Televised Meetings</h2>
        <p>
          Every televised meeting between Littler and van Veen, most recent first — 10 meetings in total, plus one floor meeting in the all-PDC count above. Scores are shown Littler first; averages are Littler / van Veen.
        </p>
        <div class="table-responsive">
          <table class="data-table">
            <thead>
              <tr>
                <th>Date</th>
                <th>Event</th>
                <th>Round</th>
                <th>Winner</th>
                <th>Score</th>
                <th>Averages</th>
              </tr>
            </thead>
            <tbody>
              <tr><td>2 Apr 2026</td><td>Premier League Night 9</td><td>Quarter-final</td><td>van Veen</td><td>5–6</td><td>98.56 / 96.26</td></tr>
              <tr><td>22 Feb 2026</td><td>Poland Darts Open</td><td>Final</td><td>Littler</td><td>8–4</td><td>108.06 / 96.11</td></tr>
              <tr><td>5 Feb 2026</td><td>Premier League Night 1</td><td>Quarter-final</td><td>van Veen</td><td>4–6</td><td>96.98 / 95.55</td></tr>
              <tr><td>20 Jan 2026</td><td>Saudi Arabia Masters</td><td>Quarter-final</td><td>Littler</td><td>6–4</td><td>111.58 / 97.91</td></tr>
              <tr><td>3 Jan 2026</td><td>World Championship</td><td>Final</td><td>Littler</td><td>7–1 (sets)</td><td>106.02 / 99.94</td></tr>
              <tr><td>7 Oct 2025</td><td>World Grand Prix</td><td>Round 1</td><td>Littler</td><td>2–0 (sets)</td><td>105.58 / 106.47</td></tr>
              <tr><td>7 Sep 2025</td><td>Czech Darts Open</td><td>Round 3</td><td>van Veen</td><td>4–6</td><td>98.60 / 100.86</td></tr>
              <tr><td>21 Apr 2025</td><td>German Darts Grand Prix</td><td>Semi-final</td><td>van Veen</td><td>4–7</td><td>95.78 / 110.81</td></tr>
              <tr><td>2 Mar 2025</td><td>UK Open</td><td>Quarter-final</td><td>Littler</td><td>10–4</td><td>—</td></tr>
              <tr><td>26 Nov 2023</td><td>World Youth Championship</td><td>Final</td><td>Littler</td><td>6–4</td><td>—</td></tr>
            </tbody>
          </table>
        </div>
        <p class="table-note">Averages are not verified for the 2023 World Youth Championship final or the 2025 UK Open quarter-final. The Players Championship 5 floor meeting in 2025 (van Veen 7–6) is in the all-PDC ledger above, not in this televised table.</p>
      </section>

      <!-- Major Finals -->
      <section class="content-card table-section">
        <h2>Major Finals Contested</h2>
        <p>Littler and van Veen have met in 3 finals — Littler has won all 3. Scores below are shown winner first.</p>
        <div class="table-responsive">
          <table class="data-table">
            <thead>
              <tr>
                <th>Final</th>
                <th>Winner</th>
                <th>Score</th>
              </tr>
            </thead>
            <tbody>
              <tr><td>World Youth Championship 2023 (26 Nov 2023)</td><td>Littler</td><td>6–4</td></tr>
              <tr><td>World Championship 2026 (3 Jan 2026)</td><td>Littler</td><td>7–1 (sets)</td></tr>
              <tr><td>Poland Darts Open 2026 (22 Feb 2026)</td><td>Littler</td><td>8–4</td></tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- Last 5 Meetings -->
      <section class="content-card table-section">
        <h2>Last 5 Meetings</h2>
        <p>Most recent first. Scores are shown winner first; averages are Littler / van Veen.</p>
        <div class="table-responsive">
          <table class="data-table">
            <thead>
              <tr>
                <th>Date</th>
                <th>Event</th>
                <th>Round</th>
                <th>Result</th>
                <th>Averages</th>
              </tr>
            </thead>
            <tbody>
              <tr><td>2 Apr 2026</td><td>Premier League Night 9</td><td>Quarter-final</td><td>van Veen 6–5</td><td>98.56 / 96.26</td></tr>
              <tr><td>22 Feb 2026</td><td>Poland Darts Open</td><td>Final</td><td>Littler 8–4</td><td>108.06 / 96.11</td></tr>
              <tr><td>5 Feb 2026</td><td>Premier League Night 1</td><td>Quarter-final</td><td>van Veen 6–4</td><td>96.98 / 95.55</td></tr>
              <tr><td>20 Jan 2026</td><td>Saudi Arabia Masters</td><td>Quarter-final</td><td>Littler 6–4</td><td>111.58 / 97.91</td></tr>
              <tr><td>3 Jan 2026</td><td>World Championship</td><td>Final</td><td>Littler 7–1 (sets)</td><td>106.02 / 99.94</td></tr>
            </tbody>
          </table>
        </div>
        <p class="table-note">No meeting since 2 April 2026 — verified no meeting at the UK Open 2026, World Matchplay 2026, World Grand Prix 2026, European Championship 2026, World Series Finals 2026 or Grand Slam 2026 (different groups; Littler out in the Last 16, van Veen finalist).</p>
      </section>

      <!-- Rivalry Narrative -->
      <section class="content-card">
        <h2>The Rivalry</h2>
        <p>
          They first met in the 2023 World Youth Championship final on 26 November 2023 in Minehead: 16-year-old Littler led 5–1, van Veen fought back to 5–4 and missed a dart at double 5 for a decider before Littler won 6–4.
        </p>
        <p>
          Van Veen is the player who has troubled Littler most: the pair were level 3–3 before the 2026 World Championship final, and van Veen was the only top-10 player without a losing record against Littler at that point. The closest call came at the 2025 World Grand Prix, where van Veen averaged 106.47 — then the highest average in World Grand Prix history — and still lost 2–0 in sets to Littler (105.58), who finished with a 144 checkout.
        </p>
        <p>
          The rivalry boiled over at Premier League Night 9 on 2 April 2026: van Veen called Littler “out of order” for celebrating his missed double 15, Littler mimicked crying at him, and van Veen won 6–5 with double 6. Van Veen had also beaten Littler 6–4 on his Premier League debut night (5 February 2026) to avenge the 7–1 World Championship final defeat.
        </p>
        <p>
          Van Veen overtook van Gerwen as Dutch No. 1 during his 2026 World Championship run, beating Humphries 5–1 in the quarter-final (105.41 average, 11 maximums, 170 checkout) and Gary Anderson 6–3 in the semi-final before the 7–1 final defeat — Littler won seven straight sets after dropping the first.
        </p>
      </section>

      <!-- FAQ Section -->
      <section class="content-card faq-section">
        <h2>Littler vs van Veen FAQ</h2>
        <div class="faq-accordion">
          {faqItems.map((item) => (
            <details class="faq-item">
              <summary class="faq-question">{item.q}</summary>
              <div class="faq-answer">
                <p>{item.a}</p>
              </div>
            </details>
          ))}
        </div>
      </section>

      <p class="last-updated">Last updated: 26 November 2026. Head-to-head record as of 26 November 2026. <a href="/players/player-comparisons/">← Back to Head-to-Head Comparisons</a></p>
    </main>

    <!-- Sidebar -->
    <aside class="sidebar-column">
      <div class="sidebar-card">
        <h3>Player Authority Hubs</h3>
        <ul class="sidebar-links">
          <li><a href="/players/">← Back to All Players</a></li>
          <li><a href="/players/stats/">📈 Performance Statistics</a></li>
          <li><a href="/players/rankings/">📊 Official Order of Merit</a></li>
          <li><a href="/players/earnings/">💰 Player Career Earnings</a></li>
          <li><a href="/players/darts-equipment-specs/">🎯 Darts Equipment Specs</a></li>
          <li><a href="/players/walk-on-songs/">🎵 Walk-On Songs &amp; Anthems</a></li>
          <li><a href="/players/records/">🏆 All-Time Records</a></li>
          <li><a href="/players/world-championship-records/">🏛️ World Championship Records</a></li>
          <li><a href="/players/9-darters/">🎯 Televised Nine-Darters</a></li>
          <li><a href="/players/180-records/">⚡ 180 Maximum Records</a></li>
        </ul>
      </div>

      <div class="sidebar-card highlight-sidebar">
        <h3>Tournament Key Pages</h3>
        <ul class="sidebar-links">
          <li><a href="/draw/">Tournament Draw &amp; Bracket</a></li>
          <li><a href="/schedule/">Full Schedule of Play</a></li>
          <li><a href="/results/">Live Match Results</a></li>
          <li><a href="/tournament/prize-money/">£5,000,000 Prize Fund</a></li>
        </ul>
      </div>
    </aside>
  </div>
</BaseLayout>

<style>
  .page-header {
    background: linear-gradient(135deg, #111827 0%, #1f2937 100%);
    border-bottom: 1px solid #374151;
    padding: 3rem 0 2rem;
    margin-bottom: 2rem;
  }
  .page-header h1 {
    color: #ffffff;
    font-size: 2.3rem;
    font-weight: 800;
    line-height: 1.2;
    margin: 0 0 1rem;
  }
  .badge-row {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }
  .lead-text {
    font-size: 1.125rem;
    color: #9ca3af;
    max-width: 800px;
    line-height: 1.6;
    margin-top: 0.75rem;
  }
  .content-layout {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 2rem;
    margin-bottom: 3rem;
  }
  @media (max-width: 900px) {
    .content-layout {
      grid-template-columns: 1fr;
    }
  }
  .content-card {
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 2rem;
    margin-bottom: 2rem;
  }
  .content-card h2 {
    color: #f8fafc;
    margin-top: 0;
  }
  .h2h-score-banner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    background: #0f172a;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 1.25rem;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  @media (max-width: 640px) {
    .h2h-score-banner {
      grid-template-columns: 1fr;
      text-align: center;
    }
  }
  .h2h-player {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .player-one {
    text-align: left;
  }
  .player-two {
    text-align: right;
  }
  @media (max-width: 640px) {
    .player-one, .player-two {
      text-align: center;
    }
  }
  .p-name a {
    font-size: 1.25rem;
    font-weight: 800;
    color: #38bdf8;
    text-decoration: none;
  }
  .p-name a:hover {
    text-decoration: underline;
  }
  .p-nick {
    font-size: 0.85rem;
    color: #94a3b8;
  }
  .p-titles {
    font-size: 0.8rem;
    color: #f59e0b;
    font-weight: 600;
  }
  .h2h-vs-box {
    text-align: center;
    padding: 0 1rem;
  }
  .vs-label {
    font-size: 0.75rem;
    font-weight: 700;
    color: #94a3b8;
  }
  .vs-tally {
    font-size: 1.75rem;
    font-weight: 900;
    color: #10b981;
    line-height: 1.2;
  }
  .vs-total {
    font-size: 0.75rem;
    color: #64748b;
  }
  .vs-meta {
    font-size: 0.7rem;
    color: #f59e0b;
    margin-top: 0.15rem;
  }
  .scope-banner {
    background: #0f172a;
    border: 1px solid #334155;
    padding: 0.5rem 0.75rem;
    border-radius: 4px;
    font-size: 0.8rem;
    color: #94a3b8;
    margin-bottom: 1.25rem;
  }
  .ledger-note {
    font-size: 0.9rem;
    color: #94a3b8;
    line-height: 1.5;
    margin: 0;
  }
  .table-note {
    font-size: 0.85rem;
    color: #94a3b8;
    line-height: 1.5;
    margin-top: 1rem;
  }
  .last-updated {
    font-size: 0.85rem;
    color: #94a3b8;
  }
  .last-updated a {
    color: #38bdf8;
    text-decoration: none;
  }
  .faq-accordion details {
    background: #0f172a;
    border: 1px solid #334155;
    border-radius: 6px;
    margin-bottom: 0.75rem;
    padding: 0.75rem 1rem;
  }
  .faq-question {
    cursor: pointer;
    font-weight: 600;
    color: #f8fafc;
  }
  .faq-answer {
    margin-top: 0.75rem;
    color: #94a3b8;
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .sidebar-card {
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
  }
  .sidebar-card h3 {
    margin-top: 0;
    font-size: 1.1rem;
    color: #f8fafc;
    border-bottom: 1px solid #334155;
    padding-bottom: 0.5rem;
    margin-bottom: 1rem;
  }
  .sidebar-links {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .sidebar-links li {
    margin-bottom: 0.6rem;
  }
  .sidebar-links a {
    color: #94a3b8;
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.2s;
  }
  .sidebar-links a:hover {
    color: #38bdf8;
  }
  .highlight-sidebar {
    border-color: #f59e0b;
  }
</style>
