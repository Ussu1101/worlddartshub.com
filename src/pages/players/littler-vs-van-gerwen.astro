---
// src/pages/players/littler-vs-van-gerwen.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import VerificationBadge from '../../components/VerificationBadge.astro';

const pageTitle = "Luke Littler vs Michael van Gerwen Head to Head: Record, Meetings & Rivalry";
const pageDescription = "Luke Littler leads Michael van Gerwen 18–10 in 28 PDC meetings as of 26 November 2026. Full televised meetings table, 5 major finals, last 5 meetings and the rivalry story.";
const siteUrl = "https://worlddartshub.com";
const canonicalUrl = `${siteUrl}/players/littler-vs-van-gerwen/`;

const breadcrumbItems = [
  { name: 'Home', url: '/' },
  { name: 'Players', url: '/players/' },
  { name: 'Head-to-Head Comparisons', url: '/players/player-comparisons/' },
  { name: 'Littler vs van Gerwen' }
];

const faqItems = [
  {
    q: "Who leads the head-to-head between Luke Littler and Michael van Gerwen?",
    a: "Luke Littler leads 18–10 across 28 PDC meetings as of 26 November 2026. In televised majors the lead is 13–9 from 22 meetings."
  },
    {
    q: "When did Littler and van Gerwen last play each other?",
    a: "6 September 2026, the Czech Open semi-final, which Littler won 7–3 (averages 106.64 for Littler and 83.53 for van Gerwen). They did not meet at the 2026 Grand Slam of Darts."
  },
    {
    q: "How many major finals have Littler and van Gerwen contested?",
    a: "Five finals. Littler has won three and van Gerwen two, including the 2025 World Championship final (Littler 7–3 in sets) and the 2026 Saudi Arabia Masters final (Littler 8–5)."
  }
];

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${canonicalUrl}#webpage`,
      "name": pageTitle,
      "description": pageDescription,
      "url": canonicalUrl,
      "inLanguage": "en-GB"
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonicalUrl}#breadcrumb`,
      "itemListElement": breadcrumbItems.map((item, index) => ({
        "@type": "ListItem",
        "position": index + 1,
        "name": item.name,
        "item": item.url ? `${siteUrl}${item.url}` : canonicalUrl
      }))
    },
    {
      "@type": "FAQPage",
      "@id": `${canonicalUrl}#faq`,
      "mainEntity": faqItems.map(item => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.a
        }
      }))
    }
  ]
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  schema={pageSchema}
  canonicalUrl={canonicalUrl}
>
  <Breadcrumbs items={breadcrumbItems} />

  <header class="page-header">
    <div class="container">
      <div class="badge-row">
        <span class="badge badge-accent">HEAD-TO-HEAD</span>
        <span class="badge">28 PDC MEETINGS</span>
      </div>
      <h1>Luke Littler vs Michael van Gerwen Head to Head</h1>
      <p class="lead-text">
        The apprentice who became the master: Littler leads van Gerwen 18–10 across 28 PDC meetings, with 5 major finals between them — including the 2025 World Championship final and the first meeting, the 2024 Bahrain Masters final.
      </p>
    </div>
  </header>

  <div class="container content-layout">
    <main class="main-column">
      <VerificationBadge verifiedDate="26 November 2026" topic="PDC Head-to-Head Records & Stage Finals" />

      <!-- Head to Head Ledger -->
      <section class="content-card">
        <h2>Head-to-Head Record</h2>
        <div class="h2h-score-banner">
          <div class="h2h-player player-one">
            <span class="p-name">
              <a href="/players/luke-littler/">Luke Littler</a>
            </span>
            <span class="p-nick">"The Nuke"</span>
            <span class="p-titles">2 World Titles</span>
          </div>

          <div class="h2h-vs-box">
            <div class="vs-label">HEAD-TO-HEAD</div>
            <div class="vs-tally">18 - 10</div>
            <div class="vs-total">28 PDC Meetings</div>
            <div class="vs-meta">As of 26 November 2026</div>
          </div>

          <div class="h2h-player player-two">
            <span class="p-name">
              <a href="/players/michael-van-gerwen/">Michael van Gerwen</a>
            </span>
            <span class="p-nick">"Mighty Mike"</span>
            <span class="p-titles">3 World Titles</span>
          </div>
        </div>

        <div class="scope-banner">
          <strong>Scope:</strong> All PDC meetings — televised majors, World Series, European Tour and Players Championship floor events. <strong>Source:</strong> CSWStats televised-majors records, mastercaller.com tournament results and PDC archives.
        </div>

        <p class="ledger-note">
          All 28 meetings are verified individually. No floor meeting was found and Littler played no Players Championship events in 2026, but a pre-2026 floor meeting cannot be exhaustively ruled out — if one exists, the 28 total rises. Note: 19 February 2026 was NOT a meeting — van Gerwen withdrew ill from Premier League Night 3 and Littler got a bye (a second bye occurred on 19 March 2026 when van Veen withdrew with kidney stones and van Gerwen advanced). Darts Report’s claim of a “6–5 win on 19 February” is wrong. Televised majors on their own: 22 meetings, Littler 13–9.
        </p>
      </section>

      <!-- TV Meetings Table -->
      <section class="content-card table-section">
        <h2>Televised Meetings</h2>
        <p>
          Every televised meeting between Littler and van Gerwen, most recent first — 28 meetings in total. Scores are shown Littler first; averages are Littler / van Gerwen.
        </p>
        <div class="table-responsive">
          <table class="data-table">
            <thead>
              <tr>
                <th>Date</th>
                <th>Event</th>
                <th>Round</th>
                <th>Winner</th>
                <th>Score</th>
                <th>Averages</th>
              </tr>
            </thead>
            <tbody>
              <tr><td>6 Sep 2026</td><td>Czech Open</td><td>Semi-final</td><td>Littler</td><td>7–3</td><td>106.64 / 83.53</td></tr>
              <tr><td>7 May 2026</td><td>Premier League</td><td>Night 14, quarter-final</td><td>Littler</td><td>6–5</td><td>100.28 / 101.15</td></tr>
              <tr><td>23 Apr 2026</td><td>Premier League</td><td>Night 12, semi-final</td><td>Littler</td><td>6–5</td><td>102.06 / 107.54</td></tr>
              <tr><td>26 Mar 2026</td><td>Premier League</td><td>Night 8, final</td><td>Littler</td><td>6–4</td><td>106.36 / 103.87</td></tr>
              <tr><td>19 Mar 2026</td><td>Premier League</td><td>Night 7, semi-final</td><td>Littler</td><td>6–5</td><td>102.45 / 98.90</td></tr>
              <tr><td>12 Feb 2026</td><td>Premier League</td><td>Night 2, semi-final</td><td>van Gerwen</td><td>4–6</td><td>95.18 / 100.70</td></tr>
              <tr><td>20 Jan 2026</td><td>Saudi Arabia Masters</td><td>Final</td><td>Littler</td><td>8–5</td><td>104.84 / 101.89</td></tr>
              <tr><td>25 Jan 2025</td><td>Dutch Masters</td><td>Quarter-final</td><td>Littler</td><td>6–3</td><td>94.85 / 90.26</td></tr>
              <tr><td>2025</td><td>World Series Finals</td><td>Final</td><td>van Gerwen</td><td>7–11</td><td>101.99 / 98.37</td></tr>
              <tr><td>2025</td><td>Premier League</td><td>Weekly night</td><td>Littler</td><td>6–4</td><td>102.5 / 94.3</td></tr>
              <tr><td>2025</td><td>Premier League</td><td>Weekly night</td><td>van Gerwen</td><td>5–6</td><td>98.8 / 95.5</td></tr>
              <tr><td>2025</td><td>Premier League</td><td>Weekly night</td><td>Littler</td><td>6–4</td><td>112.5 / 101.4</td></tr>
              <tr><td>2025</td><td>Premier League</td><td>Weekly night</td><td>Littler</td><td>6–2</td><td>106.1 / 90.4</td></tr>
              <tr><td>2025</td><td>Premier League</td><td>Weekly night</td><td>Littler</td><td>6–2</td><td>104.0 / 98.5</td></tr>
              <tr><td>2025</td><td>Premier League</td><td>Weekly night</td><td>van Gerwen</td><td>5–6</td><td>113.9 / 105.9</td></tr>
              <tr><td>3 Jan 2025</td><td>World Championship</td><td>Final</td><td>Littler</td><td>7–3 (sets)</td><td>102.7 / 100.7</td></tr>
              <tr><td>20 Oct 2024</td><td>Swiss Trophy</td><td>—</td><td>Littler</td><td>6–1</td><td>110.57 / 112.19</td></tr>
              <tr><td>2024</td><td>World Series Finals</td><td>—</td><td>Littler</td><td>11–4</td><td>108.0 / 99.2</td></tr>
              <tr><td>2024</td><td>World Matchplay</td><td>Round 1</td><td>van Gerwen</td><td>6–10</td><td>100.8 / 101.9</td></tr>
              <tr><td>2024</td><td>Premier League</td><td>Weekly night</td><td>van Gerwen</td><td>1–6</td><td>86.7 / 92.9</td></tr>
              <tr><td>2024</td><td>Premier League</td><td>Weekly night</td><td>van Gerwen</td><td>3–6</td><td>88.1 / 90.4</td></tr>
              <tr><td>2024</td><td>Premier League</td><td>Weekly night</td><td>Littler</td><td>6–3</td><td>93.2 / 91.8</td></tr>
              <tr><td>2024</td><td>Premier League</td><td>Weekly night</td><td>Littler</td><td>6–3</td><td>99.0 / 94.6</td></tr>
              <tr><td>2024</td><td>Premier League</td><td>Weekly night</td><td>Littler</td><td>6–2</td><td>114.0 / 110.9</td></tr>
              <tr><td>2024</td><td>Premier League</td><td>Weekly night</td><td>van Gerwen</td><td>5–6</td><td>94.2 / 96.3</td></tr>
              <tr><td>2024</td><td>Premier League</td><td>Weekly night</td><td>van Gerwen</td><td>5–6</td><td>100.3 / 101.1</td></tr>
              <tr><td>26 Jan 2024</td><td>Dutch Masters</td><td>Final</td><td>van Gerwen</td><td>6–8</td><td>—</td></tr>
              <tr><td>19 Jan 2024</td><td>Bahrain Masters</td><td>Final</td><td>Littler</td><td>8–5</td><td>—</td></tr>
            </tbody>
          </table>
        </div>
        <p class="table-note">Rounds for most 2024 and 2025 weekly Premier League meetings are not stated in the sources consulted, so they are listed as weekly-night meetings. The round of the 2024 World Series Finals 11–4 win is unverified. Averages are not verified for the Bahrain and Dutch Masters 2024 finals. Saudi Arabia Masters averages are per mastercaller; Sportradar lists van Gerwen at 101.79.</p>
      </section>

      <!-- Major Finals -->
      <section class="content-card table-section">
        <h2>Major Finals Contested</h2>
        <p>Littler and van Gerwen have met in 5 finals — Littler has won 3, van Gerwen 2. Scores below are shown winner first.</p>
        <div class="table-responsive">
          <table class="data-table">
            <thead>
              <tr>
                <th>Final</th>
                <th>Winner</th>
                <th>Score</th>
              </tr>
            </thead>
            <tbody>
              <tr><td>Bahrain Masters 2024 (19 Jan 2024)</td><td>Littler</td><td>8–5</td></tr>
              <tr><td>Dutch Masters 2024 (26 Jan 2024)</td><td>van Gerwen</td><td>8–6</td></tr>
              <tr><td>World Championship 2025 (3 Jan 2025)</td><td>Littler</td><td>7–3 (sets)</td></tr>
              <tr><td>World Series Finals 2025</td><td>van Gerwen</td><td>11–7</td></tr>
              <tr><td>Saudi Arabia Masters 2026 (20 Jan 2026)</td><td>Littler</td><td>8–5</td></tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- Last 5 Meetings -->
      <section class="content-card table-section">
        <h2>Last 5 Meetings</h2>
        <p>Most recent first. Scores are shown winner first; averages are Littler / van Gerwen.</p>
        <div class="table-responsive">
          <table class="data-table">
            <thead>
              <tr>
                <th>Date</th>
                <th>Event</th>
                <th>Round</th>
                <th>Result</th>
                <th>Averages</th>
              </tr>
            </thead>
            <tbody>
              <tr><td>6 Sep 2026</td><td>Czech Open</td><td>Semi-final</td><td>Littler 7–3</td><td>106.64 / 83.53</td></tr>
              <tr><td>7 May 2026</td><td>Premier League Night 14</td><td>Quarter-final</td><td>Littler 6–5</td><td>100.28 / 101.15</td></tr>
              <tr><td>23 Apr 2026</td><td>Premier League Night 12</td><td>Semi-final</td><td>Littler 6–5</td><td>102.06 / 107.54</td></tr>
              <tr><td>26 Mar 2026</td><td>Premier League Night 8</td><td>Night final</td><td>Littler 6–4</td><td>106.36 / 103.87</td></tr>
              <tr><td>19 Mar 2026</td><td>Premier League Night 7</td><td>Semi-final</td><td>Littler 6–5</td><td>102.45 / 98.90</td></tr>
            </tbody>
          </table>
        </div>
        <p class="table-note">No meeting at the 2026 Grand Slam (Littler out in the Last 16; van Gerwen lost the semi-final to van Veen), World Series Finals 2026, World Matchplay, World Grand Prix or European Championship 2026.</p>
      </section>

      <!-- Rivalry Narrative -->
      <section class="content-card">
        <h2>The Rivalry</h2>
        <p>
          They first met in the Bahrain Masters final on 19 January 2024, when 16-year-old Littler won 8–5 for his first senior PDC title — having hit a nine-darter against Nathan Aspinall in the quarter-final the same day. Van Gerwen took immediate revenge a week later, winning the Dutch Masters final 8–6 after Littler missed a 170 for the match.
        </p>
        <p>
          The rivalry’s biggest stage so far was the 2025 World Championship final on 3 January 2025: Littler won 7–3, racing into a 4–0 lead, to become the youngest world champion in history.
        </p>
        <p>
          The quality has been extraordinary throughout — on 14 March 2024 Littler won a Premier League meeting 6–2 averaging 114.0, still his highest televised average, while van Gerwen averaged 110.9 in defeat. Littler has won the last 6 played meetings (the Saudi Arabia Masters final, then 19 March, 26 March, 23 April, 7 May and the Czech Open semi-final).
        </p>
      </section>

      <!-- FAQ Section -->
      <section class="content-card faq-section">
        <h2>Littler vs van Gerwen FAQ</h2>
        <div class="faq-accordion">
          {faqItems.map((item) => (
            <details class="faq-item">
              <summary class="faq-question">{item.q}</summary>
              <div class="faq-answer">
                <p>{item.a}</p>
              </div>
            </details>
          ))}
        </div>
      </section>

      <p class="last-updated">Last updated: 26 November 2026. Head-to-head record as of 26 November 2026. <a href="/players/player-comparisons/">← Back to Head-to-Head Comparisons</a></p>
    </main>

    <!-- Sidebar -->
    <aside class="sidebar-column">
      <div class="sidebar-card">
        <h3>Player Authority Hubs</h3>
        <ul class="sidebar-links">
          <li><a href="/players/">← Back to All Players</a></li>
          <li><a href="/players/stats/">📈 Performance Statistics</a></li>
          <li><a href="/players/rankings/">📊 Official Order of Merit</a></li>
          <li><a href="/players/earnings/">💰 Player Career Earnings</a></li>
          <li><a href="/players/darts-equipment-specs/">🎯 Darts Equipment Specs</a></li>
          <li><a href="/players/walk-on-songs/">🎵 Walk-On Songs &amp; Anthems</a></li>
          <li><a href="/players/records/">🏆 All-Time Records</a></li>
          <li><a href="/players/world-championship-records/">🏛️ World Championship Records</a></li>
          <li><a href="/players/9-darters/">🎯 Televised Nine-Darters</a></li>
          <li><a href="/players/180-records/">⚡ 180 Maximum Records</a></li>
        </ul>
      </div>

      <div class="sidebar-card highlight-sidebar">
        <h3>Tournament Key Pages</h3>
        <ul class="sidebar-links">
          <li><a href="/draw/">Tournament Draw &amp; Bracket</a></li>
          <li><a href="/schedule/">Full Schedule of Play</a></li>
          <li><a href="/results/">Live Match Results</a></li>
          <li><a href="/tournament/prize-money/">£5,000,000 Prize Fund</a></li>
        </ul>
      </div>
    </aside>
  </div>
</BaseLayout>

<style>
  .page-header {
    background: linear-gradient(135deg, #111827 0%, #1f2937 100%);
    border-bottom: 1px solid #374151;
    padding: 3rem 0 2rem;
    margin-bottom: 2rem;
  }
  .page-header h1 {
    color: #ffffff;
    font-size: 2.3rem;
    font-weight: 800;
    line-height: 1.2;
    margin: 0 0 1rem;
  }
  .badge-row {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }
  .lead-text {
    font-size: 1.125rem;
    color: #9ca3af;
    max-width: 800px;
    line-height: 1.6;
    margin-top: 0.75rem;
  }
  .content-layout {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 2rem;
    margin-bottom: 3rem;
  }
  @media (max-width: 900px) {
    .content-layout {
      grid-template-columns: 1fr;
    }
  }
  .content-card {
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 2rem;
    margin-bottom: 2rem;
  }
  .content-card h2 {
    color: #f8fafc;
    margin-top: 0;
  }
  .h2h-score-banner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    background: #0f172a;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 1.25rem;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  @media (max-width: 640px) {
    .h2h-score-banner {
      grid-template-columns: 1fr;
      text-align: center;
    }
  }
  .h2h-player {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .player-one {
    text-align: left;
  }
  .player-two {
    text-align: right;
  }
  @media (max-width: 640px) {
    .player-one, .player-two {
      text-align: center;
    }
  }
  .p-name a {
    font-size: 1.25rem;
    font-weight: 800;
    color: #38bdf8;
    text-decoration: none;
  }
  .p-name a:hover {
    text-decoration: underline;
  }
  .p-nick {
    font-size: 0.85rem;
    color: #94a3b8;
  }
  .p-titles {
    font-size: 0.8rem;
    color: #f59e0b;
    font-weight: 600;
  }
  .h2h-vs-box {
    text-align: center;
    padding: 0 1rem;
  }
  .vs-label {
    font-size: 0.75rem;
    font-weight: 700;
    color: #94a3b8;
  }
  .vs-tally {
    font-size: 1.75rem;
    font-weight: 900;
    color: #10b981;
    line-height: 1.2;
  }
  .vs-total {
    font-size: 0.75rem;
    color: #64748b;
  }
  .vs-meta {
    font-size: 0.7rem;
    color: #f59e0b;
    margin-top: 0.15rem;
  }
  .scope-banner {
    background: #0f172a;
    border: 1px solid #334155;
    padding: 0.5rem 0.75rem;
    border-radius: 4px;
    font-size: 0.8rem;
    color: #94a3b8;
    margin-bottom: 1.25rem;
  }
  .ledger-note {
    font-size: 0.9rem;
    color: #94a3b8;
    line-height: 1.5;
    margin: 0;
  }
  .table-note {
    font-size: 0.85rem;
    color: #94a3b8;
    line-height: 1.5;
    margin-top: 1rem;
  }
  .last-updated {
    font-size: 0.85rem;
    color: #94a3b8;
  }
  .last-updated a {
    color: #38bdf8;
    text-decoration: none;
  }
  .faq-accordion details {
    background: #0f172a;
    border: 1px solid #334155;
    border-radius: 6px;
    margin-bottom: 0.75rem;
    padding: 0.75rem 1rem;
  }
  .faq-question {
    cursor: pointer;
    font-weight: 600;
    color: #f8fafc;
  }
  .faq-answer {
    margin-top: 0.75rem;
    color: #94a3b8;
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .sidebar-card {
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
  }
  .sidebar-card h3 {
    margin-top: 0;
    font-size: 1.1rem;
    color: #f8fafc;
    border-bottom: 1px solid #334155;
    padding-bottom: 0.5rem;
    margin-bottom: 1rem;
  }
  .sidebar-links {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .sidebar-links li {
    margin-bottom: 0.6rem;
  }
  .sidebar-links a {
    color: #94a3b8;
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.2s;
  }
  .sidebar-links a:hover {
    color: #38bdf8;
  }
  .highlight-sidebar {
    border-color: #f59e0b;
  }
</style>
