---
// src/pages/players/stats.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AdSlot from '../../components/AdSlot.astro';
import VerificationBadge from '../../components/VerificationBadge.astro';
import playersData from '../../data/players.json';
import recordsData from '../../data/player-records.json';

const pageTitle = "PDC Darts Player Stats & 3-Dart Averages (2026/27 Season)";
const pageDescription = "Comprehensive statistical analysis of top PDC darts players. Compare 3-dart scoring averages, checkout percentages, 180 rates, and tournament form.";
const siteUrl = "https://worlddartshub.com";

const breadcrumbItems = [
  { name: 'Players', url: '/players/' },
  { name: 'Player Stats & Analytics', url: '/players/stats/' }
];

const statsSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": pageTitle,
  "description": pageDescription,
  "url": `${siteUrl}/players/stats/`,
  "mainEntity": {
    "@type": "ItemList",
    "name": "PDC Darts Top Contender Statistical Profiles",
    "numberOfItems": playersData.length,
    "itemListElement": playersData.map((player, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "name": `${player.name}: Career Average ${player.career_average}, Ally Pally Record: ${player.world_championship_best}`
    }))
  }
};
---

<BaseLayout 
  title={pageTitle} 
  description={pageDescription}
  schema={statsSchema}
>
  <Breadcrumbs items={breadcrumbItems} />

  <header class="page-header">
    <div class="container">
      <div class="badge-row">
        <span class="badge badge-accent">PERFORMANCE METRICS</span>
        <span class="badge">OFFICIAL MATCH ANALYTICS</span>
      </div>
      <h1>PDC Darts Player Statistics & Match Analytics</h1>
      <p class="lead-text">
        In-depth statistical breakdown of the world's premier darts players: 3-dart scoring averages, checkout efficiencies, Ally Pally track records, and historical match play metrics.
      </p>
    </div>
  </header>

  <div class="container content-layout">
    <main class="main-column">
      <VerificationBadge verifiedDate="October 2026" topic="PDC Televised Match Averages & Scoring Records" />

      <!-- Analytics Primer -->
      <section class="content-card intro-summary">
        <h2>Deconstructing Professional Darts Analytics</h2>
        <p>
          In modern professional darts, elite performance is governed by three critical statistical pillars:
        </p>
        <div class="metrics-grid">
          <div class="metric-card">
            <span class="metric-tag">Scoring</span>
            <h4>3-Dart Average</h4>
            <p>The total points scored divided by the number of darts thrown, multiplied by three. An average above 100.00 is the benchmark for world-class match performance.</p>
          </div>
          <div class="metric-card">
            <span class="metric-tag">Finishing</span>
            <h4>Checkout Percentage</h4>
            <p>The ratio of successful finishing darts to total attempts at a double or bullseye. Elite tour pros typically operate between 40% and 48% under pressure.</p>
          </div>
          <div class="metric-card">
            <span class="metric-tag">Power</span>
            <h4>180 Frequency</h4>
            <p>Maximum scores (treble 20 x 3) per leg. Heavy scorers like Luke Littler and Michael Smith average over 0.35 maximums per leg in championship matchplay.</p>
          </div>
        </div>
      </section>

      <AdSlot id="stats-top-ad" label="Darts Analytics Software & Gear" />

      <!-- Master Player Stats Table -->
      <section class="content-card table-section">
        <h2>Top 13 Contenders: Core Performance Metrics</h2>
        <p class="table-note">
          Data compiled across PDC World Championship appearances, major televised tournaments, and verified tour records.
        </p>

        <div class="table-responsive">
          <table class="data-table">
            <thead>
              <tr>
                <th>Player</th>
                <th>Tour Rank</th>
                <th>Career Average</th>
                <th>Major PDC Titles</th>
                <th>World Championship Best</th>
                <th>Televised 9-Darters</th>
              </tr>
            </thead>
            <tbody>
              {playersData.map((player) => (
                <tr>
                  <td>
                    <strong>
                      <a href={`/players/${player.slug}/`} class="player-link">
                        {player.name}
                      </a>
                    </strong>
                    <span class="sub-nick">"{player.nickname}"</span>
                  </td>
                  <td><span class="rank-tag">{player.pdc_order_of_merit_rank}</span></td>
                  <td><strong class="avg-text">{player.career_average}</strong></td>
                  <td><span class="title-count">{player.major_titles_count}</span></td>
                  <td><span class="ally-best">{player.world_championship_best}</span></td>
                  <td>
                    <span class={`nine-tag ${player.televised_nine_darters > 0 ? 'has-nine' : ''}`}>
                      {player.televised_nine_darters}
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <!-- All-Time High Average Records -->
      <section class="content-card record-section">
        <h2>Highest Match Averages in World Championship History</h2>
        <p>
          The highest individual match averages ever recorded on the Alexandra Palace stage:
        </p>

        <div class="avg-rank-list">
          {recordsData.world_championship_records.highest_match_averages.map((rec) => (
            <div class="avg-rank-item">
              <span class="rank-num">#{rec.rank}</span>
              <div class="avg-details">
                <span class="player-headline">
                  <strong>{rec.player}</strong> — <span class="score-highlight">{rec.average}</span>
                </span>
                <span class="match-context">{rec.year} {rec.round} vs. {rec.opponent}</span>
              </div>
            </div>
          ))}
        </div>
      </section>

      <AdSlot id="stats-mid-ad" label="Sports Technology & Training Systems" />

      <!-- FAQ Section -->
      <section class="content-card faq-section">
        <h2>Darts Statistics FAQ</h2>
        <div class="faq-accordion">
          <details class="faq-item">
            <summary class="faq-question">What is considered a good 3-dart average in darts?</summary>
            <div class="faq-answer">
              <p>In local league play, an average between 50 and 65 is standard. On the PDC ProTour, the median match average is approximately 92. At the World Championship, reaching the quarter-finals and beyond generally demands sustained averages of 98 to 105+.</p>
            </div>
          </details>

          <details class="faq-item">
            <summary class="faq-question">What is the highest match average in darts history?</summary>
            <div class="faq-answer">
              <p>The highest televised match average in history is <strong>123.40</strong>, recorded by Michael van Gerwen against Michael Smith during the 2016 Premier League in Aberdeen. At the World Darts Championship, van Gerwen also holds the record with <strong>114.05</strong> against Raymond van Barneveld in the 2017 semi-final.</p>
            </div>
          </details>

          <details class="faq-item">
            <summary class="faq-question">Why does a player with a lower average sometimes win the match?</summary>
            <div class="faq-answer">
              <p>Darts is won on legs and sets, not cumulative points. A player can score heavily but miss multiple double attempts, artificially inflating their opponent's opportunity. Clinical finishing at key moments (e.g. breaking throw with an 80+ checkout) routinely overcomes a scoring deficit.</p>
            </div>
          </details>
        </div>
      </section>
    </main>

    <!-- Sidebar -->
    <aside class="sidebar-column">
      <div class="sidebar-card">
        <h3>Player Authority Hubs</h3>
        <ul class="sidebar-links">
          <li><a href="/players/">← Back to All Players</a></li>
          <li><a href="/players/records/">🏆 All-Time Records</a></li>
          <li><a href="/players/world-championship-records/">🏛️ World Championship Records</a></li>
          <li><a href="/players/9-darters/">🎯 Televised Nine-Darters</a></li>
          <li><a href="/players/180-records/">⚡ 180 Maximum Records</a></li>
          <li><a href="/players/rankings/">📊 Official Order of Merit</a></li>
          <li><a href="/players/darts-equipment-specs/">🎯 Darts Equipment Specs</a></li>
          <li><a href="/players/walk-on-songs/">🎵 Walk-On Songs & Anthems</a></li>
          <li><a href="/players/player-comparisons/">⚔️ Head-to-Head Rivalries</a></li>
        </ul>
      </div>

      <div class="sidebar-card highlight-sidebar">
        <h3>Live Tournament Coverage</h3>
        <ul class="sidebar-links">
          <li><a href="/results/">Live Results & Set Scores</a></li>
          <li><a href="/schedule/">Daily Schedule of Play</a></li>
          <li><a href="/tournament/prize-money/">Prize Money Distribution</a></li>
        </ul>
      </div>

      <AdSlot id="stats-sidebar-ad" label="Professional Darts Scoring Apps" />
    </aside>
  </div>
</BaseLayout>

<style>
  .page-header {
    background: linear-gradient(135deg, #111827 0%, #1f2937 100%);
    border-bottom: 1px solid #374151;
    padding: 3rem 0 2rem;
    margin-bottom: 2rem;
  }
  .badge-row {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }
  .lead-text {
    font-size: 1.125rem;
    color: #9ca3af;
    max-width: 800px;
    line-height: 1.6;
    margin-top: 0.75rem;
  }
  .content-layout {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 2rem;
    margin-bottom: 3rem;
  }
  @media (max-width: 900px) {
    .content-layout {
      grid-template-columns: 1fr;
    }
  }
  .content-card {
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 2rem;
    margin-bottom: 2rem;
  }
  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.25rem;
    margin-top: 1.5rem;
  }
  .metric-card {
    background: #0f172a;
    border: 1px solid #334155;
    padding: 1.25rem;
    border-radius: 6px;
  }
  .metric-tag {
    font-size: 0.75rem;
    text-transform: uppercase;
    font-weight: 700;
    color: #f59e0b;
    display: block;
    margin-bottom: 0.25rem;
  }
  .metric-card h4 {
    margin: 0 0 0.5rem;
    color: #f8fafc;
    font-size: 1.1rem;
  }
  .metric-card p {
    margin: 0;
    font-size: 0.85rem;
    color: #94a3b8;
    line-height: 1.4;
  }
  .table-responsive {
    overflow-x: auto;
    margin-top: 1rem;
  }
  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
    text-align: left;
  }
  .data-table th {
    background: #0f172a;
    color: #e2e8f0;
    padding: 0.75rem 1rem;
    border-bottom: 2px solid #475569;
    white-space: nowrap;
  }
  .data-table td {
    padding: 0.85rem 1rem;
    border-bottom: 1px solid #334155;
    vertical-align: middle;
  }
  .player-link {
    color: #38bdf8;
    text-decoration: none;
    font-size: 1rem;
  }
  .player-link:hover {
    text-decoration: underline;
  }
  .sub-nick {
    display: block;
    font-size: 0.75rem;
    color: #94a3b8;
  }
  .rank-tag {
    font-size: 0.8rem;
    background: #0f172a;
    border: 1px solid #475569;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    color: #cbd5e1;
    white-space: nowrap;
  }
  .avg-text {
    color: #f59e0b;
    font-size: 1.05rem;
  }
  .title-count {
    color: #10b981;
    font-weight: 700;
  }
  .ally-best {
    font-size: 0.85rem;
    color: #cbd5e1;
  }
  .nine-tag {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    background: #0f172a;
    color: #64748b;
    font-size: 0.85rem;
  }
  .nine-tag.has-nine {
    background: rgba(16, 185, 129, 0.2);
    color: #10b981;
    font-weight: 700;
    border: 1px solid #10b981;
  }
  .avg-rank-list {
    margin-top: 1rem;
  }
  .avg-rank-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    background: #0f172a;
    border: 1px solid #334155;
    padding: 1rem;
    border-radius: 6px;
    margin-bottom: 0.75rem;
  }
  .rank-num {
    font-size: 1.25rem;
    font-weight: 800;
    color: #38bdf8;
    min-width: 40px;
  }
  .avg-details {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .player-headline {
    font-size: 1rem;
    color: #f8fafc;
  }
  .score-highlight {
    color: #f59e0b;
    font-weight: 800;
  }
  .match-context {
    font-size: 0.8rem;
    color: #94a3b8;
  }
  .faq-accordion details {
    background: #0f172a;
    border: 1px solid #334155;
    border-radius: 6px;
    margin-bottom: 0.75rem;
    padding: 0.75rem 1rem;
  }
  .faq-question {
    cursor: pointer;
    font-weight: 600;
    color: #f8fafc;
  }
  .faq-answer {
    margin-top: 0.75rem;
    color: #94a3b8;
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .sidebar-card {
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
  }
  .sidebar-card h3 {
    margin-top: 0;
    font-size: 1.1rem;
    color: #f8fafc;
    border-bottom: 1px solid #334155;
    padding-bottom: 0.5rem;
    margin-bottom: 1rem;
  }
  .sidebar-links {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .sidebar-links li {
    margin-bottom: 0.6rem;
  }
  .sidebar-links a {
    color: #94a3b8;
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.2s;
  }
  .sidebar-links a:hover {
    color: #38bdf8;
  }
  .highlight-sidebar {
    border-color: #f59e0b;
  }
</style>
