---
// src/pages/players/smith-vs-van-gerwen.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import VerificationBadge from '../../components/VerificationBadge.astro';

const pageTitle = "Michael Smith vs Michael van Gerwen Head to Head: Record, Meetings & Rivalry";
const pageDescription = "No verified current all-meetings total for Michael Smith vs Michael van Gerwen — Jan 2023 snapshot: van Gerwen 37–12. Televised meetings table, 4 major finals, last 5 meetings and the rivalry story.";
const siteUrl = "https://worlddartshub.com";
const canonicalUrl = `${siteUrl}/players/smith-vs-van-gerwen/`;

const breadcrumbItems = [
  { name: 'Home', url: '/' },
  { name: 'Players', url: '/players/' },
  { name: 'Head-to-Head Comparisons', url: '/players/player-comparisons/' },
  { name: 'Smith vs van Gerwen' }
];

const faqItems = [
  {
    q: "Who leads the head-to-head between Michael Smith and Michael van Gerwen?",
    a: "There is no verified current all-meetings total. The last verified overall count is a January 2023 snapshot: van Gerwen 37–12 from 49 meetings. In televised majors, van Gerwen leads 15–7 from 22 meetings."
  },
    {
    q: "When did Smith and van Gerwen last play each other?",
    a: "10 February 2026, Players Championship 2 in Hildesheim, which van Gerwen won 6–3. They did not meet in 2025, and their last televised meeting was the 2024 World Matchplay semi-final."
  },
    {
    q: "How many major finals have Smith and van Gerwen contested?",
    a: "Four major finals, 2–2: van Gerwen won the 2019 World Championship (7–3) and the 2018 Premier League (11–4); Smith won the 2022 US Darts Masters (8–4) and the 2023 World Championship (7–4)."
  }
];

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${canonicalUrl}#webpage`,
      "name": pageTitle,
      "description": pageDescription,
      "url": canonicalUrl,
      "inLanguage": "en-GB"
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonicalUrl}#breadcrumb`,
      "itemListElement": breadcrumbItems.map((item, index) => ({
        "@type": "ListItem",
        "position": index + 1,
        "name": item.name,
        "item": item.url ? `${siteUrl}${item.url}` : canonicalUrl
      }))
    },
    {
      "@type": "FAQPage",
      "@id": `${canonicalUrl}#faq`,
      "mainEntity": faqItems.map(item => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.a
        }
      }))
    }
  ]
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  schema={pageSchema}
  canonicalUrl={canonicalUrl}
>
  <Breadcrumbs items={breadcrumbItems} />

  <header class="page-header">
    <div class="container">
      <div class="badge-row">
        <span class="badge badge-accent">HEAD-TO-HEAD</span>
        <span class="badge">JAN 2023 SNAPSHOT</span>
      </div>
      <h1>Michael Smith vs Michael van Gerwen Head to Head</h1>
      <p class="lead-text">
        No verified current total, but one of the most famous finals ever: the January 2023 snapshot had van Gerwen 37–12, and the pair share the 2023 World Championship final — the nine-darter leg.
      </p>
    </div>
  </header>

  <div class="container content-layout">
    <main class="main-column">
      <VerificationBadge verifiedDate="26 November 2026" topic="PDC Head-to-Head Records & Stage Finals" />

      <!-- Head to Head Ledger -->
      <section class="content-card">
        <h2>Head-to-Head Record</h2>
        <div class="h2h-score-banner">
          <div class="h2h-player player-one">
            <span class="p-name">
              <a href="/players/michael-smith/">Michael Smith</a>
            </span>
            <span class="p-nick">"Bully Boy"</span>
            <span class="p-titles">1 World Title</span>
          </div>

          <div class="h2h-vs-box">
            <div class="vs-label">HEAD-TO-HEAD</div>
            <div class="vs-tally">12 - 37</div>
            <div class="vs-total">49 Meetings (Jan 2023 snapshot)</div>
            <div class="vs-meta">Snapshot: 3 January 2023</div>
          </div>

          <div class="h2h-player player-two">
            <span class="p-name">
              <a href="/players/michael-van-gerwen/">Michael van Gerwen</a>
            </span>
            <span class="p-nick">"Mighty Mike"</span>
            <span class="p-titles">3 World Titles</span>
          </div>
        </div>

        <div class="scope-banner">
          <strong>Scope:</strong> Televised majors — CSWStats televised-majors records, cross-checked against DartsRec match lists, mastercaller.com tournament results and PDC archives. <strong>Source:</strong> CSWStats televised-majors records, DartsRec match lists, mastercaller.com tournament results and PDC archives.
        </div>

        <p class="ledger-note">
          There is NO verified current all-meetings total for this pair. The last verified overall count is a dated snapshot from Sporting Life, 3 January 2023 (before the 2023 World Championship final): van Gerwen 37, Smith 12 from 49 meetings, televised 17–7. DartsRec (38–14 in 52 games) and DartStreams (45–16 in 61 matches) conflict with that snapshot and with each other, so no current total is published. Televised majors: 22 meetings, van Gerwen 15–7 — though even this count is incomplete, as CSW omits the 2019 and 2020 Premier League meetings listed below. World Championship head-to-head: 1–1. All “Smith” figures on this page are Michael Smith (Bully Boy) only — never Ross Smith.
        </p>
      </section>

      <!-- TV Meetings Table -->
      <section class="content-card table-section">
        <h2>Televised Meetings</h2>
        <p>
          Every televised-major meeting between Smith and van Gerwen, most recent first — 22 meetings in total. Scores and averages are shown Smith first.
        </p>
        <div class="table-responsive">
          <table class="data-table">
            <thead>
              <tr>
                <th>Date</th>
                <th>Event</th>
                <th>Round</th>
                <th>Winner</th>
                <th>Score</th>
                <th>Averages</th>
              </tr>
            </thead>
            <tbody>
              <tr><td>2024</td><td>World Matchplay</td><td>Semi-final</td><td>van Gerwen</td><td>13–17</td><td>96.9 / 98.4</td></tr>
              <tr><td>2024</td><td>Premier League</td><td>Night 11, semi-final</td><td>van Gerwen</td><td>4–6</td><td>89.4 / 93.3</td></tr>
              <tr><td>2024</td><td>Premier League</td><td>Night 9, quarter-final</td><td>van Gerwen</td><td>4–6</td><td>101.3 / 105.8</td></tr>
              <tr><td>2024</td><td>Premier League</td><td>Weekly night</td><td>van Gerwen</td><td>5–6</td><td>98.2 / 107.1</td></tr>
              <tr><td>2024</td><td>Premier League</td><td>Weekly night</td><td>Smith</td><td>6–5</td><td>94.1 / 97.1</td></tr>
              <tr><td>2023</td><td>Premier League</td><td>Weekly night</td><td>Smith</td><td>6–4</td><td>94.1 / 95.8</td></tr>
              <tr><td>2023</td><td>Premier League</td><td>Weekly night</td><td>Smith</td><td>6–4</td><td>91.6 / 99.4</td></tr>
              <tr><td>2023</td><td>Premier League</td><td>Weekly night</td><td>van Gerwen</td><td>4–6</td><td>99.1 / 100.2</td></tr>
              <tr><td>2023</td><td>Premier League</td><td>Weekly night</td><td>van Gerwen</td><td>3–6</td><td>100.8 / 102.4</td></tr>
              <tr><td>2023</td><td>World Championship</td><td>Final</td><td>Smith</td><td>7–4</td><td>100.9 / 99.6</td></tr>
              <tr><td>2022</td><td>Premier League</td><td>Weekly night</td><td>Smith</td><td>6–4</td><td>96.5 / 95.3</td></tr>
              <tr><td>2022</td><td>Premier League</td><td>Weekly night</td><td>Smith</td><td>6–5</td><td>88.6 / 93.2</td></tr>
              <tr><td>2022</td><td>Premier League</td><td>Weekly night</td><td>van Gerwen</td><td>5–6</td><td>94.6 / 95.2</td></tr>
              <tr><td>2022</td><td>Premier League</td><td>Weekly night</td><td>van Gerwen</td><td>5–6</td><td>100.0 / 99.0</td></tr>
              <tr><td>2022</td><td>Premier League</td><td>Weekly night</td><td>van Gerwen</td><td>5–6</td><td>96.8 / 89.5</td></tr>
              <tr><td>2022</td><td>Premier League</td><td>Weekly night</td><td>van Gerwen</td><td>4–6</td><td>100.6 / 103.9</td></tr>
              <tr><td>2022</td><td>Premier League</td><td>Weekly night</td><td>van Gerwen</td><td>2–6</td><td>97.1 / 104.4</td></tr>
              <tr><td>2021</td><td>Grand Slam</td><td>—</td><td>Smith</td><td>16–13</td><td>98.7 / 97.4</td></tr>
              <tr><td>2019</td><td>World Championship</td><td>Final</td><td>van Gerwen</td><td>3–7</td><td>95.3 / 102.2</td></tr>
              <tr><td>2018</td><td>Grand Slam</td><td>—</td><td>van Gerwen</td><td>8–10</td><td>100.7 / 108.3</td></tr>
              <tr><td>2016</td><td>Masters</td><td>—</td><td>van Gerwen</td><td>3–10</td><td>92.3 / 105.9</td></tr>
              <tr><td>2015</td><td>Grand Slam</td><td>—</td><td>van Gerwen</td><td>6–16</td><td>93.1 / 102.2</td></tr>
            </tbody>
          </table>
        </div>
        <p class="table-note">Rounds for most rows are not stated in the sources consulted, so they are shown as “—” where unverified. The 2024 World Matchplay meeting was the semi-final; the 2023 Premier League Smith wins were league-night meetings, and the 2023 play-off semi-final (van Gerwen 10–8 Smith, 25 May 2023) is NOT in the CSWStats table. Additional televised meetings not in the CSWStats table: 2019 Premier League (van Gerwen 8–3, 7–5, 7–3); 2020 Premier League (Smith 7–4, van Gerwen 8–5); 2019 Champions League (van Gerwen 10–6); 2019 European Darts Matchplay (van Gerwen 6–2); 2019 US Masters (Smith 8–6); 2020 Belgian Darts Championship (Smith 6–5); 2022 US Darts Masters final (Smith 8–4); 2023 Poland Masters (van Gerwen 7–3); 2024 Bahrain Masters (van Gerwen 7–6); 2023 Premier League play-off semi-final, 25 May 2023 (van Gerwen 10–8).</p>
      </section>

      <!-- Major Finals -->
      <section class="content-card table-section">
        <h2>Major Finals Contested</h2>
        <p>Smith and van Gerwen have met in 4 major finals — 2 wins each. Scores below are shown winner first.</p>
        <div class="table-responsive">
          <table class="data-table">
            <thead>
              <tr>
                <th>Final</th>
                <th>Winner</th>
                <th>Score</th>
              </tr>
            </thead>
            <tbody>
              <tr><td>Premier League 2018</td><td>van Gerwen</td><td>11–4</td></tr>
              <tr><td>World Championship 2019</td><td>van Gerwen</td><td>7–3</td></tr>
              <tr><td>US Darts Masters 2022</td><td>Smith</td><td>8–4</td></tr>
              <tr><td>World Championship 2023</td><td>Smith</td><td>7–4</td></tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- Last 5 Meetings -->
      <section class="content-card table-section">
        <h2>Last 5 Meetings</h2>
        <p>Most recent first. Scores are shown winner first; averages are Smith / van Gerwen.</p>
        <div class="table-responsive">
          <table class="data-table">
            <thead>
              <tr>
                <th>Date</th>
                <th>Event</th>
                <th>Round</th>
                <th>Result</th>
                <th>Averages</th>
              </tr>
            </thead>
            <tbody>
              <tr><td>10 Feb 2026</td><td>Players Championship 2 (floor, Hildesheim)</td><td>—</td><td>van Gerwen 6–3</td><td>—</td></tr>
              <tr><td>20 Jul 2024</td><td>World Matchplay</td><td>Semi-final</td><td>van Gerwen 17–13</td><td>96.9 / 98.4</td></tr>
              <tr><td>11 Apr 2024</td><td>Premier League Night 11</td><td>Semi-final</td><td>van Gerwen 6–4</td><td>89.4 / 93.3</td></tr>
              <tr><td>28 Mar 2024</td><td>Premier League Night 9</td><td>Quarter-final</td><td>van Gerwen 6–4</td><td>101.3 / 105.8</td></tr>
              <tr><td>19 Feb 2024</td><td>Players Championship 3 (floor, Leicester)</td><td>—</td><td>van Gerwen 6–4</td><td>—</td></tr>
            </tbody>
          </table>
        </div>
        <p class="table-note">No meeting in 2025 was found in the sources consulted (Smith was not in the 2025 Premier League). Van Gerwen has won the last 5 meetings in a row — the last Smith win was the 11 May 2023 Premier League quarter-final, Smith 6–4.</p>
      </section>

      <!-- Rivalry Narrative -->
      <section class="content-card">
        <h2>The Rivalry</h2>
        <p>
          The 2023 World Championship final (3 January 2023) is the rivalry’s signature match and one of the most famous legs ever played: van Gerwen missed double 12 for a nine-darter, and Smith immediately hit a nine-darter in the same leg. Smith won 7–4 (100.87 vs 99.58), his first world title, becoming world No. 1 — and making the World Championship finals between them 1–1.
        </p>
        <p>
          Van Gerwen dominated early: he led 25–6 overall by early 2019 and won the 2018 Premier League final 11–4 averaging 112.37 — at one point threatening his own televised record average of 123.40, set against Smith in the 2016 Premier League.
        </p>
        <p>
          The rivalry tightened sharply after 2020: since 2020 van Gerwen led only 7–6, and Smith actually won more legs in that run (80–79). Smith’s first televised win over van Gerwen in a major final came at the 2022 US Darts Masters, 8–4 at Madison Square Garden.
        </p>
      </section>

      <!-- FAQ Section -->
      <section class="content-card faq-section">
        <h2>Smith vs van Gerwen FAQ</h2>
        <div class="faq-accordion">
          {faqItems.map((item) => (
            <details class="faq-item">
              <summary class="faq-question">{item.q}</summary>
              <div class="faq-answer">
                <p>{item.a}</p>
              </div>
            </details>
          ))}
        </div>
      </section>

      <p class="last-updated">Last updated: 26 November 2026. Head-to-head snapshot as of 3 January 2023. <a href="/players/player-comparisons/">← Back to Head-to-Head Comparisons</a></p>
    </main>

    <!-- Sidebar -->
    <aside class="sidebar-column">
      <div class="sidebar-card">
        <h3>Player Authority Hubs</h3>
        <ul class="sidebar-links">
          <li><a href="/players/">← Back to All Players</a></li>
          <li><a href="/players/stats/">📈 Performance Statistics</a></li>
          <li><a href="/players/rankings/">📊 Official Order of Merit</a></li>
          <li><a href="/players/earnings/">💰 Player Career Earnings</a></li>
          <li><a href="/players/darts-equipment-specs/">🎯 Darts Equipment Specs</a></li>
          <li><a href="/players/walk-on-songs/">🎵 Walk-On Songs &amp; Anthems</a></li>
          <li><a href="/players/records/">🏆 All-Time Records</a></li>
          <li><a href="/players/world-championship-records/">🏛️ World Championship Records</a></li>
          <li><a href="/players/9-darters/">🎯 Televised Nine-Darters</a></li>
          <li><a href="/players/180-records/">⚡ 180 Maximum Records</a></li>
        </ul>
      </div>

      <div class="sidebar-card highlight-sidebar">
        <h3>Tournament Key Pages</h3>
        <ul class="sidebar-links">
          <li><a href="/draw/">Tournament Draw &amp; Bracket</a></li>
          <li><a href="/schedule/">Full Schedule of Play</a></li>
          <li><a href="/results/">Live Match Results</a></li>
          <li><a href="/tournament/prize-money/">£5,000,000 Prize Fund</a></li>
        </ul>
      </div>
    </aside>
  </div>
</BaseLayout>

<style>
  .page-header {
    background: linear-gradient(135deg, #111827 0%, #1f2937 100%);
    border-bottom: 1px solid #374151;
    padding: 3rem 0 2rem;
    margin-bottom: 2rem;
  }
  .page-header h1 {
    color: #ffffff;
    font-size: 2.3rem;
    font-weight: 800;
    line-height: 1.2;
    margin: 0 0 1rem;
  }
  .badge-row {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }
  .lead-text {
    font-size: 1.125rem;
    color: #9ca3af;
    max-width: 800px;
    line-height: 1.6;
    margin-top: 0.75rem;
  }
  .content-layout {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 2rem;
    margin-bottom: 3rem;
  }
  @media (max-width: 900px) {
    .content-layout {
      grid-template-columns: 1fr;
    }
  }
  .content-card {
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 2rem;
    margin-bottom: 2rem;
  }
  .content-card h2 {
    color: #f8fafc;
    margin-top: 0;
  }
  .h2h-score-banner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    background: #0f172a;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 1.25rem;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  @media (max-width: 640px) {
    .h2h-score-banner {
      grid-template-columns: 1fr;
      text-align: center;
    }
  }
  .h2h-player {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .player-one {
    text-align: left;
  }
  .player-two {
    text-align: right;
  }
  @media (max-width: 640px) {
    .player-one, .player-two {
      text-align: center;
    }
  }
  .p-name a {
    font-size: 1.25rem;
    font-weight: 800;
    color: #38bdf8;
    text-decoration: none;
  }
  .p-name a:hover {
    text-decoration: underline;
  }
  .p-nick {
    font-size: 0.85rem;
    color: #94a3b8;
  }
  .p-titles {
    font-size: 0.8rem;
    color: #f59e0b;
    font-weight: 600;
  }
  .h2h-vs-box {
    text-align: center;
    padding: 0 1rem;
  }
  .vs-label {
    font-size: 0.75rem;
    font-weight: 700;
    color: #94a3b8;
  }
  .vs-tally {
    font-size: 1.75rem;
    font-weight: 900;
    color: #10b981;
    line-height: 1.2;
  }
  .vs-total {
    font-size: 0.75rem;
    color: #64748b;
  }
  .vs-meta {
    font-size: 0.7rem;
    color: #f59e0b;
    margin-top: 0.15rem;
  }
  .scope-banner {
    background: #0f172a;
    border: 1px solid #334155;
    padding: 0.5rem 0.75rem;
    border-radius: 4px;
    font-size: 0.8rem;
    color: #94a3b8;
    margin-bottom: 1.25rem;
  }
  .ledger-note {
    font-size: 0.9rem;
    color: #94a3b8;
    line-height: 1.5;
    margin: 0;
  }
  .table-note {
    font-size: 0.85rem;
    color: #94a3b8;
    line-height: 1.5;
    margin-top: 1rem;
  }
  .last-updated {
    font-size: 0.85rem;
    color: #94a3b8;
  }
  .last-updated a {
    color: #38bdf8;
    text-decoration: none;
  }
  .faq-accordion details {
    background: #0f172a;
    border: 1px solid #334155;
    border-radius: 6px;
    margin-bottom: 0.75rem;
    padding: 0.75rem 1rem;
  }
  .faq-question {
    cursor: pointer;
    font-weight: 600;
    color: #f8fafc;
  }
  .faq-answer {
    margin-top: 0.75rem;
    color: #94a3b8;
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .sidebar-card {
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
  }
  .sidebar-card h3 {
    margin-top: 0;
    font-size: 1.1rem;
    color: #f8fafc;
    border-bottom: 1px solid #334155;
    padding-bottom: 0.5rem;
    margin-bottom: 1rem;
  }
  .sidebar-links {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .sidebar-links li {
    margin-bottom: 0.6rem;
  }
  .sidebar-links a {
    color: #94a3b8;
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.2s;
  }
  .sidebar-links a:hover {
    color: #38bdf8;
  }
  .highlight-sidebar {
    border-color: #f59e0b;
  }
</style>
