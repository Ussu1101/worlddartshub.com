---
// src/pages/players/records.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AdSlot from '../../components/AdSlot.astro';
import VerificationBadge from '../../components/VerificationBadge.astro';
import recordsData from '../../data/player-records.json';

const pageTitle = "All-Time Darts Records — PDC Titles, High Averages & Milestones";
const pageDescription = "Official all-time professional darts records. Explore most PDC major titles, highest televised match averages, youngest champions, and nine-darter milestones.";
const siteUrl = "https://worlddartsguide.com";

const breadcrumbItems = [
  { name: 'Players', url: '/players/' },
  { name: 'All-Time Records', url: '/players/records/' }
];

const recordsSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": pageTitle,
  "description": pageDescription,
  "url": `${siteUrl}/players/records/`,
  "mainEntity": {
    "@type": "ItemList",
    "name": "All-Time Professional Darts World Records",
    "numberOfItems": 6,
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Most World Titles: Phil Taylor (14 PDC / 16 total)" },
      { "@type": "ListItem", "position": 2, "name": "Highest Televised Average: Michael van Gerwen (123.40)" },
      { "@type": "ListItem", "position": 3, "name": "Highest World Championship Average: Michael van Gerwen (114.05)" },
      { "@type": "ListItem", "position": 4, "name": "Most 180s in Single Match: Peter Wright (24 maximums)" },
      { "@type": "ListItem", "position": 5, "name": "Youngest World Finalist: Luke Littler (16 years, 347 days)" },
      { "@type": "ListItem", "position": 6, "name": "First Alexandra Palace 9-Darter: Raymond van Barneveld (2009)" }
    ]
  }
};
---

<BaseLayout 
  title={pageTitle} 
  description={pageDescription}
  schema={recordsSchema}
>
  <Breadcrumbs items={breadcrumbItems} />

  <header class="page-header">
    <div class="container">
      <div class="badge-row">
        <span class="badge badge-accent">HISTORICAL ARCHIVES</span>
        <span class="badge">OFFICIAL PDC WORLD RECORDS</span>
      </div>
      <h1>PDC All-Time Darts World Records</h1>
      <p class="lead-text">
        The definitive record book of professional darts: unmatched world title tallies, record-shattering scoring averages, longevity feats, and the milestone achievements that define the sport's history.
      </p>
    </div>
  </header>

  <div class="container content-layout">
    <main class="main-column">
      <VerificationBadge verifiedDate={recordsData.last_verified} topic="PDC Historical Archives & Certified Match Records" />

      <!-- High Level Highlights Grid -->
      <section class="content-card intro-summary">
        <h2>Pinnacle Achievements in Darts History</h2>
        <div class="records-summary-grid">
          <div class="rec-highlight-card">
            <span class="rec-badge">WORLD TITLES</span>
            <h3>14 PDC Titles</h3>
            <p><strong>Phil Taylor</strong> (16 overall including BDO). The benchmark of sporting supremacy.</p>
          </div>
          <div class="rec-highlight-card">
            <span class="rec-badge">HIGHEST AVERAGE</span>
            <h3>123.40 Average</h3>
            <p><strong>Michael van Gerwen</strong> vs. Michael Smith (2016 Premier League, Aberdeen).</p>
          </div>
          <div class="rec-highlight-card">
            <span class="rec-badge">ALLY PALLY AVERAGE</span>
            <h3>114.05 Average</h3>
            <p><strong>Michael van Gerwen</strong> vs. Raymond van Barneveld (2017 World Semi-Final).</p>
          </div>
          <div class="rec-highlight-card">
            <span class="rec-badge">YOUNGEST FINALIST</span>
            <h3>16 Years, 347 Days</h3>
            <p><strong>Luke Littler</strong> at the 2024 World Darts Championship.</p>
          </div>
        </div>
      </section>

      <!-- Specialized Records Navigation Cards -->
      <section class="content-card specialized-hubs">
        <h2>Explore Detailed Record Archives</h2>
        <p>
          Dive deeper into specialized statistical record categories:
        </p>
        <div class="hubs-grid">
          <a href="/players/world-championship-records/" class="hub-link-card">
            <span class="hub-icon">🏛️</span>
            <h4>World Championship Records</h4>
            <p>Ally Pally match averages, most sets won, and tournament records.</p>
          </a>
          <a href="/players/9-darters/" class="hub-link-card">
            <span class="hub-icon">🎯</span>
            <h4>Televised Nine-Darters</h4>
            <p>Complete archive of all 16 Ally Pally perfect legs and checkout routes.</p>
          </a>
          <a href="/players/180-records/" class="hub-link-card">
            <span class="hub-icon">⚡</span>
            <h4>180 Maximum Records</h4>
            <p>Most 180s in a match, tournament totals, and the 901 milestone.</p>
          </a>
        </div>
      </section>

      <AdSlot id="records-top-ad" label="Sports Memorabilia & Framing" />

      <!-- Most PDC World Titles Table -->
      <section class="content-card table-section">
        <h2>Most PDC World Championship Titles (1994–Present)</h2>
        <p class="table-note">
          Reflects victories at the official PDC World Darts Championship (Circus Tavern 1994–2007; Alexandra Palace 2008–present).
        </p>

        <div class="table-responsive">
          <table class="data-table">
            <thead>
              <tr>
                <th>Player</th>
                <th>PDC Titles</th>
                <th>Championship Winning Years</th>
              </tr>
            </thead>
            <tbody>
              {recordsData.world_championship_records.most_titles_pdc.map((champ) => (
                <tr>
                  <td><strong>{champ.player}</strong></td>
                  <td><span class="title-badge">{champ.titles}</span></td>
                  <td><span class="years-text">{champ.years}</span></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <!-- Age & Longevity Milestones -->
      <section class="content-card longevity-section">
        <h2>Age & Longevity Milestones</h2>
        
        <div class="longevity-grid">
          <div class="long-card">
            <h4>Youngest World Champion</h4>
            <div class="long-player">Michael van Gerwen</div>
            <div class="long-meta">24 years, 252 days (2014)</div>
            <p>Defeated Peter Wright 7-4 in the final to become the youngest champion in PDC history.</p>
          </div>

          <div class="long-card">
            <h4>Oldest World Champion</h4>
            <div class="long-player">Phil Taylor</div>
            <div class="long-meta">52 years, 141 days (2013)</div>
            <p>Defeated Michael van Gerwen 7-4 to claim his 16th and final world title.</p>
          </div>

          <div class="long-card">
            <h4>Youngest Match Winner</h4>
            <div class="long-player">Luke Littler</div>
            <div class="long-meta">16 years, 331 days (2024)</div>
            <p>Averaged 106.12 to sweep Christian Kist in Round One on his historic debut.</p>
          </div>
        </div>
      </section>

      <AdSlot id="records-mid-ad" label="Darts Equipment & Flights" />

      <!-- FAQ Section -->
      <section class="content-card faq-section">
        <h2>All-Time Records FAQ</h2>
        <div class="faq-accordion">
          <details class="faq-item">
            <summary class="faq-question">How many World Championships did Phil Taylor win in total?</summary>
            <div class="faq-answer">
              <p>Phil Taylor won a record <strong>16 World Championship titles</strong>: 2 with the BDO (1990, 1992) and 14 with the PDC (1995, 1996, 1997, 1998, 1999, 2000, 2001, 2002, 2004, 2005, 2006, 2009, 2010, 2013).</p>
            </div>
          </details>

          <details class="faq-item">
            <summary class="faq-question">Who hit the first televised nine-darter in history?</summary>
            <div class="faq-answer">
              <p>John Lowe hit the world's first televised nine-dart finish on 13 October 1984 against Keith Deller at the World Matchplay in Slough, earning a £102,000 bonus prize.</p>
            </div>
          </details>

          <details class="faq-item">
            <summary class="faq-question">Has anyone ever hit two nine-darters in a single televised match?</summary>
            <div class="faq-answer">
              <p>Yes. Phil Taylor achieved this twice: first in the 2010 Premier League Final against James Wade, and Michael van Gerwen also hit two nine-darters in a single match on the European Tour in 2019.</p>
            </div>
          </details>
        </div>
      </section>
    </main>

    <!-- Sidebar -->
    <aside class="sidebar-column">
      <div class="sidebar-card">
        <h3>Record Sub-Directories</h3>
        <ul class="sidebar-links">
          <li><a href="/players/world-championship-records/">🏛️ World Championship Records</a></li>
          <li><a href="/players/9-darters/">🎯 16 Ally Pally Nine-Darters</a></li>
          <li><a href="/players/180-records/">⚡ 180 Maximum Records</a></li>
          <li><a href="/players/stats/">📈 Performance Statistics</a></li>
          <li><a href="/players/earnings/">💰 All-Time Earnings</a></li>
          <li><a href="/players/rankings/">📊 Official Order of Merit</a></li>
          <li><a href="/players/player-comparisons/">⚔️ Head-to-Head Rivalries</a></li>
        </ul>
      </div>

      <div class="sidebar-card highlight-sidebar">
        <h3>Tournament Quick Links</h3>
        <ul class="sidebar-links">
          <li><a href="/tournament/prize-money/">Prize Money Breakdown</a></li>
          <li><a href="/draw/">Tournament Bracket</a></li>
          <li><a href="/schedule/">Full Schedule of Play</a></li>
        </ul>
      </div>

      <AdSlot id="records-sidebar-ad" label="Sports Heritage & Trophies" />
    </aside>
  </div>
</BaseLayout>

<style>
  .page-header {
    background: linear-gradient(135deg, #111827 0%, #1f2937 100%);
    border-bottom: 1px solid #374151;
    padding: 3rem 0 2rem;
    margin-bottom: 2rem;
  }
  .badge-row {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }
  .lead-text {
    font-size: 1.125rem;
    color: #9ca3af;
    max-width: 800px;
    line-height: 1.6;
    margin-top: 0.75rem;
  }
  .content-layout {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 2rem;
    margin-bottom: 3rem;
  }
  @media (max-width: 900px) {
    .content-layout {
      grid-template-columns: 1fr;
    }
  }
  .content-card {
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 2rem;
    margin-bottom: 2rem;
  }
  .records-summary-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.25rem;
    margin-top: 1.5rem;
  }
  .rec-highlight-card {
    background: #0f172a;
    border: 1px solid #334155;
    padding: 1.25rem;
    border-radius: 6px;
  }
  .rec-badge {
    font-size: 0.75rem;
    font-weight: 700;
    color: #f59e0b;
    display: block;
    margin-bottom: 0.5rem;
  }
  .rec-highlight-card h3 {
    margin: 0 0 0.5rem;
    color: #f8fafc;
    font-size: 1.25rem;
  }
  .rec-highlight-card p {
    margin: 0;
    font-size: 0.85rem;
    color: #94a3b8;
    line-height: 1.4;
  }
  .hubs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
    margin-top: 1rem;
  }
  .hub-link-card {
    background: #0f172a;
    border: 1px solid #475569;
    padding: 1.25rem;
    border-radius: 6px;
    text-decoration: none;
    transition: transform 0.2s, border-color 0.2s;
  }
  .hub-link-card:hover {
    transform: translateY(-2px);
    border-color: #38bdf8;
  }
  .hub-icon {
    font-size: 1.5rem;
    display: block;
    margin-bottom: 0.5rem;
  }
  .hub-link-card h4 {
    margin: 0 0 0.4rem;
    color: #38bdf8;
    font-size: 1rem;
  }
  .hub-link-card p {
    margin: 0;
    font-size: 0.8rem;
    color: #94a3b8;
    line-height: 1.35;
  }
  .table-responsive {
    overflow-x: auto;
    margin-top: 1rem;
  }
  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
    text-align: left;
  }
  .data-table th {
    background: #0f172a;
    color: #e2e8f0;
    padding: 0.75rem 1rem;
    border-bottom: 2px solid #475569;
    white-space: nowrap;
  }
  .data-table td {
    padding: 0.85rem 1rem;
    border-bottom: 1px solid #334155;
    vertical-align: middle;
  }
  .title-badge {
    background: #f59e0b;
    color: #0f172a;
    font-weight: 800;
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    font-size: 0.9rem;
  }
  .years-text {
    color: #94a3b8;
    font-size: 0.85rem;
  }
  .longevity-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.25rem;
    margin-top: 1rem;
  }
  .long-card {
    background: #0f172a;
    border: 1px solid #334155;
    padding: 1.25rem;
    border-radius: 6px;
  }
  .long-card h4 {
    margin: 0 0 0.5rem;
    color: #38bdf8;
    font-size: 0.95rem;
  }
  .long-player {
    font-size: 1.1rem;
    font-weight: 700;
    color: #f8fafc;
  }
  .long-meta {
    font-size: 0.8rem;
    color: #f59e0b;
    margin-bottom: 0.5rem;
  }
  .long-card p {
    margin: 0;
    font-size: 0.85rem;
    color: #94a3b8;
    line-height: 1.4;
  }
  .faq-accordion details {
    background: #0f172a;
    border: 1px solid #334155;
    border-radius: 6px;
    margin-bottom: 0.75rem;
    padding: 0.75rem 1rem;
  }
  .faq-question {
    cursor: pointer;
    font-weight: 600;
    color: #f8fafc;
  }
  .faq-answer {
    margin-top: 0.75rem;
    color: #94a3b8;
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .sidebar-card {
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
  }
  .sidebar-card h3 {
    margin-top: 0;
    font-size: 1.1rem;
    color: #f8fafc;
    border-bottom: 1px solid #334155;
    padding-bottom: 0.5rem;
    margin-bottom: 1rem;
  }
  .sidebar-links {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .sidebar-links li {
    margin-bottom: 0.6rem;
  }
  .sidebar-links a {
    color: #94a3b8;
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.2s;
  }
  .sidebar-links a:hover {
    color: #38bdf8;
  }
  .highlight-sidebar {
    border-color: #f59e0b;
  }
</style>
