---
// src/pages/players/taylor-vs-van-barneveld.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import VerificationBadge from '../../components/VerificationBadge.astro';

const pageTitle = "Phil Taylor vs Raymond van Barneveld Head to Head: Record, Meetings & Rivalry";
const pageDescription = "Phil Taylor leads Raymond van Barneveld 61–18 (4 draws) in 83 meetings as of 26 November 2026. Full televised meetings table, 7 major finals, last 5 meetings and the rivalry story.";
const siteUrl = "https://worlddartshub.com";
const canonicalUrl = `${siteUrl}/players/taylor-vs-van-barneveld/`;

const breadcrumbItems = [
  { name: 'Home', url: '/' },
  { name: 'Players', url: '/players/' },
  { name: 'Head-to-Head Comparisons', url: '/players/player-comparisons/' },
  { name: 'Taylor vs van Barneveld' }
];

const faqItems = [
  {
    q: "Who leads the head-to-head between Phil Taylor and Raymond van Barneveld?",
    a: "Phil Taylor leads 61–18, with 4 draws, across 83 meetings. In televised meetings since Barneveld joined the PDC in 2006, Taylor leads 39–14 with 4 draws."
  },
    {
    q: "When did Taylor and van Barneveld last play each other?",
    a: "September 2017, the Champions League group stage, which Taylor won 10–6. The April and June 2020 online exhibition matches were not competitive meetings and are excluded."
  },
    {
    q: "How many major finals did Taylor and van Barneveld contest?",
    a: "Seven major finals. Taylor won six and Barneveld one — Barneveld’s win was the 2007 World Championship final (7–6 in a sudden-death leg); Taylor’s reply in the 2009 final was 7–1."
  }
];

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${canonicalUrl}#webpage`,
      "name": pageTitle,
      "description": pageDescription,
      "url": canonicalUrl,
      "inLanguage": "en-GB"
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonicalUrl}#breadcrumb`,
      "itemListElement": breadcrumbItems.map((item, index) => ({
        "@type": "ListItem",
        "position": index + 1,
        "name": item.name,
        "item": item.url ? `${siteUrl}${item.url}` : canonicalUrl
      }))
    },
    {
      "@type": "FAQPage",
      "@id": `${canonicalUrl}#faq`,
      "mainEntity": faqItems.map(item => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.a
        }
      }))
    }
  ]
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  schema={pageSchema}
  canonicalUrl={canonicalUrl}
>
  <Breadcrumbs items={breadcrumbItems} />

  <header class="page-header">
    <div class="container">
      <div class="badge-row">
        <span class="badge badge-accent">HEAD-TO-HEAD</span>
        <span class="badge">83 MEETINGS</span>
      </div>
      <h1>Phil Taylor vs Raymond van Barneveld Head to Head</h1>
      <p class="lead-text">
        Eighty-three meetings, the greatest rivalry in darts history: Taylor leads van Barneveld 61–18 (4 draws), with 7 major finals between them — including the 2007 and 2009 World Championship finals.
      </p>
    </div>
  </header>

  <div class="container content-layout">
    <main class="main-column">
      <VerificationBadge verifiedDate="26 November 2026" topic="PDC Head-to-Head Records & Stage Finals" />

      <!-- Head to Head Ledger -->
      <section class="content-card">
        <h2>Head-to-Head Record</h2>
        <div class="h2h-score-banner">
          <div class="h2h-player player-one">
            <span class="p-name">
              <a href="/players/player-comparisons/">Phil Taylor</a>
            </span>
            <span class="p-nick">"The Power"</span>
            <span class="p-titles">16 World Titles</span>
          </div>

          <div class="h2h-vs-box">
            <div class="vs-label">HEAD-TO-HEAD</div>
            <div class="vs-tally">61 - 18</div>
            <div class="vs-total">83 Meetings</div>
            <div class="vs-meta">As of 26 November 2026 · 4 draws · Rivalry closed</div>
          </div>

          <div class="h2h-player player-two">
            <span class="p-name">
              <a href="/players/raymond-van-barneveld/">Raymond van Barneveld</a>
            </span>
            <span class="p-nick">"Barney"</span>
            <span class="p-titles">5 World Titles</span>
          </div>
        </div>

        <div class="scope-banner">
          <strong>Scope:</strong> All meetings — televised and floor events across both players’ careers. <strong>Source:</strong> Sporting Life (April 2020), DartsRec match lists and PDC archives.
        </div>

        <p class="ledger-note">
          83 meetings: Taylor 61, Barneveld 18, 4 draws (Sporting Life, April 2020 — the rivalry is closed). Televised meetings since Barneveld joined the PDC in 2006: 57, Taylor 39–14, 4 draws. The table below lists 57 verified televised meetings; the arithmetic against Sporting Life’s 57 does not reconcile exactly (±1–3 depending on classification — the 2013 Players Championship quarter-final was a floor event televised on PDC TV). Averages were not available for most of these meetings and are not shown. The April and June 2020 online “Darts From Home” matches were charity exhibitions, not competitive meetings, and are excluded. World Championship head-to-head: Taylor 3, Barneveld 2.
        </p>
      </section>

      <!-- TV Meetings Table -->
      <section class="content-card table-section">
        <h2>Televised Meetings</h2>
        <p>
          Every verified televised meeting between Taylor and van Barneveld, most recent first — 57 meetings listed. Scores are shown Taylor first; averages were not available for most meetings and are not shown.
        </p>
        <div class="table-responsive">
          <table class="data-table">
            <thead>
              <tr>
                <th>Date</th>
                <th>Event</th>
                <th>Round</th>
                <th>Winner</th>
                <th>Score</th>
              </tr>
            </thead>
            <tbody>
              <tr><td>Sep 2017</td><td>Champions League</td><td>Group stage</td><td>Taylor</td><td>10–6</td></tr>
              <tr><td>Aug 2017</td><td>Perth Darts Masters</td><td>—</td><td>Barneveld</td><td>10–9</td></tr>
              <tr><td>Aug 2017</td><td>Auckland Darts Masters</td><td>—</td><td>Taylor</td><td>10–9</td></tr>
              <tr><td>26 Jul 2017</td><td>World Matchplay</td><td>Last 16</td><td>Taylor</td><td>11–3</td></tr>
              <tr><td>2017</td><td>Premier League</td><td>Round-robin</td><td>Taylor</td><td>7–3</td></tr>
              <tr><td>2017</td><td>Premier League</td><td>Round-robin</td><td>Taylor</td><td>7–4</td></tr>
              <tr><td>2017</td><td>World Championship</td><td>Quarter-final</td><td>Barneveld</td><td>5–3</td></tr>
              <tr><td>2016</td><td>Premier League</td><td>Round-robin</td><td>Barneveld</td><td>7–2</td></tr>
              <tr><td>2016</td><td>Premier League</td><td>Round-robin</td><td>Taylor</td><td>7–5</td></tr>
              <tr><td>2016</td><td>UK Open</td><td>—</td><td>Taylor</td><td>9–3</td></tr>
              <tr><td>2015</td><td>Grand Slam of Darts</td><td>Semi-final</td><td>Taylor</td><td>16–12</td></tr>
              <tr><td>2015</td><td>Japan Masters</td><td>—</td><td>Taylor</td><td>8–3</td></tr>
              <tr><td>2015</td><td>Premier League</td><td>Round-robin</td><td>Barneveld</td><td>7–2</td></tr>
              <tr><td>2015</td><td>Premier League</td><td>Round-robin</td><td>Barneveld</td><td>7–4</td></tr>
              <tr><td>2015</td><td>World Championship</td><td>Semi-final</td><td>Taylor</td><td>6–2</td></tr>
              <tr><td>2014</td><td>Premier League</td><td>Semi-final</td><td>Barneveld</td><td>8–5</td></tr>
              <tr><td>2014</td><td>Premier League</td><td>Round-robin</td><td>Draw</td><td>6–6</td></tr>
              <tr><td>2014</td><td>Premier League</td><td>Round-robin</td><td>Draw</td><td>6–6</td></tr>
              <tr><td>2013</td><td>Players Championship</td><td>Quarter-final</td><td>Taylor</td><td>9–2</td></tr>
              <tr><td>2013</td><td>Premier League</td><td>Semi-final</td><td>Taylor</td><td>8–4</td></tr>
              <tr><td>2013</td><td>Premier League</td><td>Round-robin</td><td>Draw</td><td>6–6</td></tr>
              <tr><td>2013</td><td>Premier League</td><td>Round-robin</td><td>Taylor</td><td>7–3</td></tr>
              <tr><td>2013</td><td>World Championship</td><td>Semi-final</td><td>Taylor</td><td>6–4</td></tr>
              <tr><td>2012</td><td>Premier League</td><td>Round-robin</td><td>Taylor</td><td>8–3</td></tr>
              <tr><td>2012</td><td>Premier League</td><td>Round-robin</td><td>Taylor</td><td>8–4</td></tr>
              <tr><td>2011</td><td>Premier League</td><td>3rd-place play-off</td><td>Taylor</td><td>8–6</td></tr>
              <tr><td>2011</td><td>Premier League</td><td>Round-robin</td><td>Taylor</td><td>8–3</td></tr>
              <tr><td>2011</td><td>Premier League</td><td>Round-robin</td><td>Taylor</td><td>8–3</td></tr>
              <tr><td>2010</td><td>World Matchplay</td><td>Final</td><td>Taylor</td><td>18–12</td></tr>
              <tr><td>2010</td><td>Premier League</td><td>Round-robin</td><td>Taylor</td><td>8–2</td></tr>
              <tr><td>2010</td><td>Premier League</td><td>Round-robin</td><td>Taylor</td><td>8–2</td></tr>
              <tr><td>2009</td><td>Grand Slam of Darts</td><td>Semi-final</td><td>Taylor</td><td>16–6</td></tr>
              <tr><td>2009</td><td>World Grand Prix</td><td>Final</td><td>Taylor</td><td>6–3</td></tr>
              <tr><td>2009</td><td>Las Vegas Desert Classic</td><td>Final</td><td>Taylor</td><td>13–11</td></tr>
              <tr><td>2009</td><td>Premier League</td><td>Round-robin</td><td>Taylor</td><td>8–2</td></tr>
              <tr><td>2009</td><td>Premier League</td><td>Round-robin</td><td>Taylor</td><td>8–4</td></tr>
              <tr><td>2009</td><td>World Championship</td><td>Final</td><td>Taylor</td><td>7–1</td></tr>
              <tr><td>2008</td><td>World Grand Prix</td><td>Final</td><td>Taylor</td><td>6–2</td></tr>
              <tr><td>2008</td><td>UK Open</td><td>Quarter-final</td><td>Barneveld</td><td>10–9</td></tr>
              <tr><td>2008</td><td>Premier League</td><td>Round-robin</td><td>Taylor</td><td>8–2</td></tr>
              <tr><td>2008</td><td>Premier League</td><td>Round-robin</td><td>Taylor</td><td>8–3</td></tr>
              <tr><td>2007</td><td>UK Open</td><td>Quarter-final</td><td>Barneveld</td><td>11–4</td></tr>
              <tr><td>2007</td><td>US Open</td><td>Final</td><td>Taylor</td><td>4–1</td></tr>
              <tr><td>2007</td><td>World Darts Challenge</td><td>Round-robin</td><td>Barneveld</td><td>4–1</td></tr>
              <tr><td>2007</td><td>International Darts League</td><td>Round of 16 (group)</td><td>Taylor</td><td>7–4</td></tr>
              <tr><td>2007</td><td>Premier League</td><td>Round-robin</td><td>Taylor</td><td>8–5</td></tr>
              <tr><td>2007</td><td>Premier League</td><td>Round-robin</td><td>Taylor</td><td>8–6</td></tr>
              <tr><td>2007</td><td>Masters of Darts</td><td>Round-robin</td><td>Barneveld</td><td>3–0</td></tr>
              <tr><td>2007</td><td>World Championship</td><td>Final</td><td>Barneveld</td><td>7–6</td></tr>
              <tr><td>2006</td><td>World Grand Prix</td><td>Round of 16</td><td>Taylor</td><td>3–1</td></tr>
              <tr><td>2006</td><td>Las Vegas Desert Classic</td><td>Semi-final</td><td>Barneveld</td><td>4–3</td></tr>
              <tr><td>2006</td><td>UK Open</td><td>Quarter-final</td><td>Barneveld</td><td>11–10</td></tr>
              <tr><td>2006</td><td>Premier League</td><td>Round-robin</td><td>Taylor</td><td>8–6</td></tr>
              <tr><td>2006</td><td>Premier League</td><td>Round-robin</td><td>Draw</td><td>7–7</td></tr>
              <tr><td>2005</td><td>Masters of Darts</td><td>Semi-final</td><td>Taylor</td><td>5–2</td></tr>
              <tr><td>2005</td><td>Masters of Darts</td><td>Round-robin</td><td>Taylor</td><td>4–0</td></tr>
              <tr><td>1999</td><td>Champion vs Champion</td><td>—</td><td>Taylor</td><td>21–10</td></tr>
            </tbody>
          </table>
        </div>
        <p class="table-note">57 verified meetings are listed; Sporting Life gives 57 TV meetings since 2006, but the arithmetic does not reconcile exactly (±1–3 depending on classification). The 2013 Players Championship quarter-final was a floor event televised on PDC TV and is included in this list. Averages were not available for most meetings and are not shown.</p>
      </section>

      <!-- Major Finals -->
      <section class="content-card table-section">
        <h2>Major Finals Contested</h2>
        <p>Taylor and van Barneveld met in 7 major finals — Taylor won 6, Barneveld 1. Scores below are shown winner first.</p>
        <div class="table-responsive">
          <table class="data-table">
            <thead>
              <tr>
                <th>Final</th>
                <th>Winner</th>
                <th>Score</th>
              </tr>
            </thead>
            <tbody>
              <tr><td>World Championship 2007</td><td>Barneveld</td><td>7–6</td></tr>
              <tr><td>US Open 2007</td><td>Taylor</td><td>4–1</td></tr>
              <tr><td>World Grand Prix 2008</td><td>Taylor</td><td>6–2</td></tr>
              <tr><td>World Championship 2009</td><td>Taylor</td><td>7–1</td></tr>
              <tr><td>Las Vegas Desert Classic 2009</td><td>Taylor</td><td>13–11</td></tr>
              <tr><td>World Grand Prix 2009</td><td>Taylor</td><td>6–3</td></tr>
              <tr><td>World Matchplay 2010</td><td>Taylor</td><td>18–12</td></tr>
            </tbody>
          </table>
        </div>
        <p class="table-note">Sporting Life also gives “All PDC Finals 11–2” and “Televised Finals 9–2” in Taylor’s favour — the additional finals (floor Players Championship finals and others) were not individually verified and are not listed here.</p>
      </section>

      <!-- Last 5 Meetings -->
      <section class="content-card table-section">
        <h2>Last 5 Meetings</h2>
        <p>Most recent first. Scores are shown winner first; averages were not available for most meetings and are not shown.</p>
        <div class="table-responsive">
          <table class="data-table">
            <thead>
              <tr>
                <th>Date</th>
                <th>Event</th>
                <th>Round</th>
                <th>Result</th>
                <th>Averages</th>
              </tr>
            </thead>
            <tbody>
              <tr><td>Sep 2017</td><td>Champions League</td><td>Group stage</td><td>Taylor 10–6</td><td>—</td></tr>
              <tr><td>Aug 2017</td><td>Perth Darts Masters</td><td>—</td><td>Barneveld 10–9</td><td>—</td></tr>
              <tr><td>Aug 2017</td><td>Auckland Darts Masters</td><td>—</td><td>Taylor 10–9</td><td>—</td></tr>
              <tr><td>26 Jul 2017</td><td>World Matchplay</td><td>Last 16</td><td>Taylor 11–3</td><td>102.27 (Taylor)</td></tr>
              <tr><td>2017</td><td>Premier League</td><td>Round-robin</td><td>Taylor 7–3</td><td>—</td></tr>
            </tbody>
          </table>
        </div>
        <p class="table-note">Exact days for the August and September 2017 World Series and Champions League meetings are not verified — they are shown as month and year only. No competitive meeting after September 2017. The April and June 2020 online “Darts From Home” matches (Barneveld 7–6 and 11–8) were charity exhibitions, not competitive meetings, and are excluded.</p>
      </section>

      <!-- Rivalry Narrative -->
      <section class="content-card">
        <h2>The Rivalry</h2>
        <p>
          The 2007 World Championship final is the rivalry’s defining match: Barneveld, in his first PDC season, came from 3–0 down in sets to beat Taylor 7–6 in a sudden-death leg at the Circus Tavern — his fifth world title, ending Taylor’s three-year reign.
        </p>
        <p>
          Taylor’s reply in the 2009 final was brutal: 7–1, averaging 110.94 — still listed as the highest average in a PDC World Championship final. Barneveld had the last word at the World Championship, though: 5–3 in the 2017 quarter-final on 30 December 2016, described by the PDC as their final meeting on the Ally Pally stage.
        </p>
        <p>
          Despite the one-sided ledger, Barneveld had more wins against Taylor than any other player — 10 televised wins by April 2015 — which is why the rivalry is still talked about as the greatest in darts history even at 61–18.
        </p>
      </section>

      <!-- FAQ Section -->
      <section class="content-card faq-section">
        <h2>Taylor vs van Barneveld FAQ</h2>
        <div class="faq-accordion">
          {faqItems.map((item) => (
            <details class="faq-item">
              <summary class="faq-question">{item.q}</summary>
              <div class="faq-answer">
                <p>{item.a}</p>
              </div>
            </details>
          ))}
        </div>
      </section>

      <p class="last-updated">Last updated: 26 November 2026. Head-to-head record as of 26 November 2026. <a href="/players/player-comparisons/">← Back to Head-to-Head Comparisons</a></p>
    </main>

    <!-- Sidebar -->
    <aside class="sidebar-column">
      <div class="sidebar-card">
        <h3>Player Authority Hubs</h3>
        <ul class="sidebar-links">
          <li><a href="/players/">← Back to All Players</a></li>
          <li><a href="/players/stats/">📈 Performance Statistics</a></li>
          <li><a href="/players/rankings/">📊 Official Order of Merit</a></li>
          <li><a href="/players/earnings/">💰 Player Career Earnings</a></li>
          <li><a href="/players/darts-equipment-specs/">🎯 Darts Equipment Specs</a></li>
          <li><a href="/players/walk-on-songs/">🎵 Walk-On Songs &amp; Anthems</a></li>
          <li><a href="/players/records/">🏆 All-Time Records</a></li>
          <li><a href="/players/world-championship-records/">🏛️ World Championship Records</a></li>
          <li><a href="/players/9-darters/">🎯 Televised Nine-Darters</a></li>
          <li><a href="/players/180-records/">⚡ 180 Maximum Records</a></li>
        </ul>
      </div>

      <div class="sidebar-card highlight-sidebar">
        <h3>Tournament Key Pages</h3>
        <ul class="sidebar-links">
          <li><a href="/draw/">Tournament Draw &amp; Bracket</a></li>
          <li><a href="/schedule/">Full Schedule of Play</a></li>
          <li><a href="/results/">Live Match Results</a></li>
          <li><a href="/tournament/prize-money/">£5,000,000 Prize Fund</a></li>
        </ul>
      </div>
    </aside>
  </div>
</BaseLayout>

<style>
  .page-header {
    background: linear-gradient(135deg, #111827 0%, #1f2937 100%);
    border-bottom: 1px solid #374151;
    padding: 3rem 0 2rem;
    margin-bottom: 2rem;
  }
  .page-header h1 {
    color: #ffffff;
    font-size: 2.3rem;
    font-weight: 800;
    line-height: 1.2;
    margin: 0 0 1rem;
  }
  .badge-row {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }
  .lead-text {
    font-size: 1.125rem;
    color: #9ca3af;
    max-width: 800px;
    line-height: 1.6;
    margin-top: 0.75rem;
  }
  .content-layout {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 2rem;
    margin-bottom: 3rem;
  }
  @media (max-width: 900px) {
    .content-layout {
      grid-template-columns: 1fr;
    }
  }
  .content-card {
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 2rem;
    margin-bottom: 2rem;
  }
  .content-card h2 {
    color: #f8fafc;
    margin-top: 0;
  }
  .h2h-score-banner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    background: #0f172a;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 1.25rem;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  @media (max-width: 640px) {
    .h2h-score-banner {
      grid-template-columns: 1fr;
      text-align: center;
    }
  }
  .h2h-player {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .player-one {
    text-align: left;
  }
  .player-two {
    text-align: right;
  }
  @media (max-width: 640px) {
    .player-one, .player-two {
      text-align: center;
    }
  }
  .p-name a {
    font-size: 1.25rem;
    font-weight: 800;
    color: #38bdf8;
    text-decoration: none;
  }
  .p-name a:hover {
    text-decoration: underline;
  }
  .p-nick {
    font-size: 0.85rem;
    color: #94a3b8;
  }
  .p-titles {
    font-size: 0.8rem;
    color: #f59e0b;
    font-weight: 600;
  }
  .h2h-vs-box {
    text-align: center;
    padding: 0 1rem;
  }
  .vs-label {
    font-size: 0.75rem;
    font-weight: 700;
    color: #94a3b8;
  }
  .vs-tally {
    font-size: 1.75rem;
    font-weight: 900;
    color: #10b981;
    line-height: 1.2;
  }
  .vs-total {
    font-size: 0.75rem;
    color: #64748b;
  }
  .vs-meta {
    font-size: 0.7rem;
    color: #f59e0b;
    margin-top: 0.15rem;
  }
  .scope-banner {
    background: #0f172a;
    border: 1px solid #334155;
    padding: 0.5rem 0.75rem;
    border-radius: 4px;
    font-size: 0.8rem;
    color: #94a3b8;
    margin-bottom: 1.25rem;
  }
  .ledger-note {
    font-size: 0.9rem;
    color: #94a3b8;
    line-height: 1.5;
    margin: 0;
  }
  .table-note {
    font-size: 0.85rem;
    color: #94a3b8;
    line-height: 1.5;
    margin-top: 1rem;
  }
  .last-updated {
    font-size: 0.85rem;
    color: #94a3b8;
  }
  .last-updated a {
    color: #38bdf8;
    text-decoration: none;
  }
  .faq-accordion details {
    background: #0f172a;
    border: 1px solid #334155;
    border-radius: 6px;
    margin-bottom: 0.75rem;
    padding: 0.75rem 1rem;
  }
  .faq-question {
    cursor: pointer;
    font-weight: 600;
    color: #f8fafc;
