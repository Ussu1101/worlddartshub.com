---
// src/pages/players/van-gerwen-vs-anderson.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import VerificationBadge from '../../components/VerificationBadge.astro';

const pageTitle = "Michael van Gerwen vs Gary Anderson Head to Head: Record, Meetings & Rivalry";
const pageDescription = "Michael van Gerwen leads Gary Anderson 50–22 (3 draws) in 75 official PDC meetings as of 26 November 2026. Full televised meetings table, 9 major finals, last 5 meetings and the rivalry story.";
const siteUrl = "https://worlddartshub.com";
const canonicalUrl = `${siteUrl}/players/van-gerwen-vs-anderson/`;

const breadcrumbItems = [
  { name: 'Home', url: '/' },
  { name: 'Players', url: '/players/' },
  { name: 'Head-to-Head Comparisons', url: '/players/player-comparisons/' },
  { name: 'van Gerwen vs Anderson' }
];

const faqItems = [
  {
    q: "Who leads the head-to-head between Michael van Gerwen and Gary Anderson?",
    a: "Michael van Gerwen leads 50–22, with 3 draws, across 75 official PDC meetings as of 30 December 2025. In televised majors the lead is 13–6 from 19 meetings."
  },
    {
    q: "When did van Gerwen and Anderson last play each other?",
    a: "30 December 2025, the World Championship last 16, which Anderson won 4–1 (averages 99.10 for Anderson and 99.81 for van Gerwen)."
  },
    {
    q: "How many major finals have van Gerwen and Anderson contested?",
    a: "Nine finals. Van Gerwen has won five and Anderson four, including the 2017 World Championship final (van Gerwen 7–3) and the 2015 Premier League final (Anderson 11–7)."
  }
];

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${canonicalUrl}#webpage`,
      "name": pageTitle,
      "description": pageDescription,
      "url": canonicalUrl,
      "inLanguage": "en-GB"
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonicalUrl}#breadcrumb`,
      "itemListElement": breadcrumbItems.map((item, index) => ({
        "@type": "ListItem",
        "position": index + 1,
        "name": item.name,
        "item": item.url ? `${siteUrl}${item.url}` : canonicalUrl
      }))
    },
    {
      "@type": "FAQPage",
      "@id": `${canonicalUrl}#faq`,
      "mainEntity": faqItems.map(item => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.a
        }
      }))
    }
  ]
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  schema={pageSchema}
  canonicalUrl={canonicalUrl}
>
  <Breadcrumbs items={breadcrumbItems} />

  <header class="page-header">
    <div class="container">
      <div class="badge-row">
        <span class="badge badge-accent">HEAD-TO-HEAD</span>
        <span class="badge">75 OFFICIAL PDC MEETINGS</span>
      </div>
      <h1>Michael van Gerwen vs Gary Anderson Head to Head</h1>
      <p class="lead-text">
        Seventy-five official meetings and nine finals: van Gerwen leads Anderson 50–22 (3 draws), with the rivalry’s peak the 2017 World Championship final.
      </p>
    </div>
  </header>

  <div class="container content-layout">
    <main class="main-column">
      <VerificationBadge verifiedDate="26 November 2026" topic="PDC Head-to-Head Records & Stage Finals" />

      <!-- Head to Head Ledger -->
      <section class="content-card">
        <h2>Head-to-Head Record</h2>
        <div class="h2h-score-banner">
          <div class="h2h-player player-one">
            <span class="p-name">
              <a href="/players/michael-van-gerwen/">Michael van Gerwen</a>
            </span>
            <span class="p-nick">"Mighty Mike"</span>
            <span class="p-titles">3 World Titles</span>
          </div>

          <div class="h2h-vs-box">
            <div class="vs-label">HEAD-TO-HEAD</div>
            <div class="vs-tally">50 - 22</div>
            <div class="vs-total">75 Official PDC Meetings</div>
            <div class="vs-meta">As of 30 December 2025 · 3 draws</div>
          </div>

          <div class="h2h-player player-two">
            <span class="p-name">
              <a href="/players/gary-anderson/">Gary Anderson</a>
            </span>
            <span class="p-nick">"The Flying Scotsman"</span>
            <span class="p-titles">2 World Titles</span>
          </div>
        </div>

        <div class="scope-banner">
          <strong>Scope:</strong> All official PDC meetings — televised majors, World Series, European Tour and Players Championship floor events, including Premier League draws. <strong>Source:</strong> Dartsnews and Live-Darts previews, CSWStats televised-majors records, mastercaller.com tournament results and PDC archives.
        </div>

        <p class="ledger-note">
          75 official meetings as of 30 December 2025: van Gerwen 50, Anderson 22, 3 draws. Before that World Championship last-16 match, both Dartsnews and Live-Darts reported 74 meetings (50–21, 3 draws); Anderson’s 4–1 win made it 50–22–3. Televised majors: CSW’s headline of 21 meetings (Anderson 7, van Gerwen 14) is WRONG as published — it double-counts the 2017 World Championship final and the 2015 World Championship semi-final, and one 2022 Premier League row carries a corrupted “1960-6” score. The corrected televised-majors count is 19 meetings, van Gerwen 13–6.
        </p>
      </section>

      <!-- TV Meetings Table -->
      <section class="content-card table-section">
        <h2>Televised Meetings</h2>
        <p>
          Every televised-major meeting between van Gerwen and Anderson, most recent first — 19 unique meetings in total (CSW’s headline 21 corrected). Scores and averages are shown Anderson first.
        </p>
        <div class="table-responsive">
          <table class="data-table">
            <thead>
              <tr>
                <th>Date</th>
                <th>Event</th>
                <th>Round</th>
                <th>Winner</th>
                <th>Score</th>
                <th>Averages</th>
              </tr>
            </thead>
            <tbody>
              <tr><td>30 Dec 2025</td><td>PDC World Championship</td><td>Last 16 (Round 4)</td><td>Anderson</td><td>4–1</td><td>99.1 / 99.8</td></tr>
              <tr><td>26 Oct 2024</td><td>European Championship</td><td>Last 16</td><td>Anderson</td><td>10–4</td><td>96.9 / 93.0</td></tr>
              <tr><td>2022</td><td>World Grand Prix</td><td>—</td><td>van Gerwen</td><td>0–2 (sets)</td><td>83.6 / 89.4</td></tr>
              <tr><td>2022</td><td>Premier League</td><td>—</td><td>Anderson</td><td>Not verified</td><td>—</td></tr>
              <tr><td>2022</td><td>Premier League</td><td>Weekly night</td><td>Anderson</td><td>6–4</td><td>91.4 / 96.1</td></tr>
              <tr><td>2021</td><td>Players Championship Finals</td><td>—</td><td>van Gerwen</td><td>6–10</td><td>91.1 / 95.1</td></tr>
              <tr><td>2021</td><td>Grand Slam of Darts</td><td>Group stage</td><td>van Gerwen</td><td>8–10</td><td>100.7 / 100.4</td></tr>
              <tr><td>2020</td><td>Grand Slam of Darts</td><td>Group stage</td><td>van Gerwen</td><td>2–10</td><td>97.0 / 101.8</td></tr>
              <tr><td>2019</td><td>PDC World Championship</td><td>Semi-final</td><td>van Gerwen</td><td>1–6</td><td>98.0 / 104.8</td></tr>
              <tr><td>2018</td><td>Grand Slam of Darts</td><td>—</td><td>Anderson</td><td>16–12</td><td>103.0 / 99.0</td></tr>
              <tr><td>2018</td><td>Players Championship Finals</td><td>—</td><td>van Gerwen</td><td>9–11</td><td>103.0 / 102.6</td></tr>
              <tr><td>2018</td><td>Masters</td><td>—</td><td>van Gerwen</td><td>5–11</td><td>95.4 / 102.0</td></tr>
              <tr><td>2017</td><td>World Series of Darts Finals</td><td>Final</td><td>van Gerwen</td><td>6–11</td><td>100.7 / 103.3</td></tr>
              <tr><td>2017</td><td>Masters</td><td>Final</td><td>van Gerwen</td><td>7–11</td><td>103.6 / 109.4</td></tr>
              <tr><td>1 Jan 2017</td><td>PDC World Championship</td><td>Final</td><td>van Gerwen</td><td>3–7</td><td>104.9 / 108.1</td></tr>
              <tr><td>2016</td><td>World Grand Prix</td><td>Final</td><td>van Gerwen</td><td>2–5 (sets)</td><td>92.7 / 100.3</td></tr>
              <tr><td>2015</td><td>European Championship</td><td>Final</td><td>van Gerwen</td><td>10–11</td><td>102.4 / 107.3</td></tr>
              <tr><td>2015</td><td>PDC World Championship</td><td>Semi-final</td><td>Anderson</td><td>6–3</td><td>102.2 / 101.3</td></tr>
              <tr><td>2014</td><td>PDC World Championship</td><td>—</td><td>van Gerwen</td><td>3–4</td><td>98.2 / 100.2</td></tr>
            </tbody>
          </table>
        </div>
        <p class="table-note">CSW’s headline of 21 televised-major meetings is wrong as published: the 2017 World Championship final and the 2015 World Championship semi-final are each listed twice, and one 2022 Premier League row carries a corrupted “1960-6” score — its score is shown as “Not verified”. The exact date of the 2022 World Grand Prix meeting is not verified. Additional verified televised meetings not in CSW’s table: Grand Slam group stage, 11 November 2025 (van Gerwen 5–2, averages van Gerwen 108.45 / Anderson 99.39); Grand Slam group stage, 10 November 2024 (Anderson 5–4, averages not verified); Champions League group stage, 2018 (Anderson 10–9); Belgian Darts Open quarter-final, 7 May 2023 (van Gerwen 6–1, averages not verified).</p>
      </section>

      <!-- Major Finals -->
      <section class="content-card table-section">
        <h2>Major Finals Contested</h2>
        <p>Van Gerwen and Anderson have met in 9 finals — van Gerwen has won 5, Anderson 4. Scores below are shown winner first.</p>
        <div class="table-responsive">
          <table class="data-table">
            <thead>
              <tr>
                <th>Final</th>
                <th>Winner</th>
                <th>Score</th>
              </tr>
            </thead>
            <tbody>
              <tr><td>Premier League 2015</td><td>Anderson</td><td>11–7</td></tr>
              <tr><td>European Championship 2015</td><td>van Gerwen</td><td>11–10</td></tr>
              <tr><td>World Grand Prix 2016</td><td>van Gerwen</td><td>5–2 (sets)</td></tr>
              <tr><td>Dubai Darts Masters 2016</td><td>Anderson</td><td>11–9</td></tr>
              <tr><td>Tokyo Darts Masters 2016</td><td>Anderson</td><td>8–6</td></tr>
              <tr><td>PDC World Championship 2017 (1 Jan 2017)</td><td>van Gerwen</td><td>7–3</td></tr>
              <tr><td>Masters 2017</td><td>van Gerwen</td><td>11–7</td></tr>
              <tr><td>World Series of Darts Finals 2017</td><td>van Gerwen</td><td>11–6</td></tr>
              <tr><td>Dubai Darts Masters 2017</td><td>Anderson</td><td>11–7</td></tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- Last 5 Meetings -->
      <section class="content-card table-section">
        <h2>Last 5 Meetings</h2>
        <p>Most recent first. Scores are shown winner first; averages are Anderson / van Gerwen.</p>
        <div class="table-responsive">
          <table class="data-table">
            <thead>
              <tr>
                <th>Date</th>
                <th>Event</th>
                <th>Round</th>
                <th>Result</th>
                <th>Averages</th>
              </tr>
            </thead>
            <tbody>
              <tr><td>30 Dec 2025</td><td>World Championship</td><td>Last 16</td><td>Anderson 4–1</td><td>99.10 / 99.81</td></tr>
              <tr><td>11 Nov 2025</td><td>Grand Slam of Darts</td><td>Group G</td><td>van Gerwen 5–2</td><td>99.39 / 108.45</td></tr>
              <tr><td>10 Nov 2024</td><td>Grand Slam of Darts</td><td>Group stage</td><td>Anderson 5–4</td><td>—</td></tr>
              <tr><td>26 Oct 2024</td><td>European Championship</td><td>Last 16</td><td>Anderson 10–4</td><td>96.9 / 93.0</td></tr>
              <tr><td>7 May 2023</td><td>Belgian Darts Open</td><td>Quarter-final</td><td>van Gerwen 6–1</td><td>—</td></tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- Rivalry Narrative -->
      <section class="content-card">
        <h2>The Rivalry</h2>
        <p>
          The rivalry’s peak was the 2017 World Championship final — 7–3 to van Gerwen, both men averaging over 104, with a then-record 42 maximums in the match. Anderson had won the two previous World titles (2015 and 2016), and his only World Championship win over van Gerwen before December 2025 was the 2015 semi-final (6–3), on his way to his first world title; van Gerwen had beaten him at the Worlds in 2014 (4–3), 2017 (final) and 2019 (semi-final, 6–1).
        </p>
        <p>
          They contested nine finals against each other — Anderson won 4, van Gerwen 5 — including three finals in 2017 alone (the World Championship, the Masters and the World Series Finals, all won by van Gerwen) and two Dubai finals won by Anderson.
        </p>
        <p>
          The 2025 Grand Slam group match ended Anderson’s 17-year run of always reaching the Grand Slam knockouts (18 appearances), and the 2025 World Championship meeting was their first World Championship meeting since 2019 — won 4–1 by Anderson, his first World Championship win over van Gerwen in a decade.
        </p>
      </section>

      <!-- FAQ Section -->
      <section class="content-card faq-section">
        <h2>van Gerwen vs Anderson FAQ</h2>
        <div class="faq-accordion">
          {faqItems.map((item) => (
            <details class="faq-item">
              <summary class="faq-question">{item.q}</summary>
              <div class="faq-answer">
                <p>{item.a}</p>
              </div>
            </details>
          ))}
        </div>
      </section>

      <p class="last-updated">Last updated: 26 November 2026. Head-to-head record as of 30 December 2025. <a href="/players/player-comparisons/">← Back to Head-to-Head Comparisons</a></p>
    </main>

    <!-- Sidebar -->
    <aside class="sidebar-column">
      <div class="sidebar-card">
        <h3>Player Authority Hubs</h3>
        <ul class="sidebar-links">
          <li><a href="/players/">← Back to All Players</a></li>
          <li><a href="/players/stats/">📈 Performance Statistics</a></li>
          <li><a href="/players/rankings/">📊 Official Order of Merit</a></li>
          <li><a href="/players/earnings/">💰 Player Career Earnings</a></li>
          <li><a href="/players/darts-equipment-specs/">🎯 Darts Equipment Specs</a></li>
          <li><a href="/players/walk-on-songs/">🎵 Walk-On Songs &amp; Anthems</a></li>
          <li><a href="/players/records/">🏆 All-Time Records</a></li>
          <li><a href="/players/world-championship-records/">🏛️ World Championship Records</a></li>
          <li><a href="/players/9-darters/">🎯 Televised Nine-Darters</a></li>
          <li><a href="/players/180-records/">⚡ 180 Maximum Records</a></li>
        </ul>
      </div>

      <div class="sidebar-card highlight-sidebar">
        <h3>Tournament Key Pages</h3>
        <ul class="sidebar-links">
          <li><a href="/draw/">Tournament Draw &amp; Bracket</a></li>
          <li><a href="/schedule/">Full Schedule of Play</a></li>
          <li><a href="/results/">Live Match Results</a></li>
          <li><a href="/tournament/prize-money/">£5,000,000 Prize Fund</a></li>
        </ul>
      </div>
    </aside>
  </div>
</BaseLayout>

<style>
  .page-header {
    background: linear-gradient(135deg, #111827 0%, #1f2937 100%);
    border-bottom: 1px solid #374151;
    padding: 3rem 0 2rem;
    margin-bottom: 2rem;
  }
  .page-header h1 {
    color: #ffffff;
    font-size: 2.3rem;
    font-weight: 800;
    line-height: 1.2;
    margin: 0 0 1rem;
  }
  .badge-row {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }
  .lead-text {
    font-size: 1.125rem;
    color: #9ca3af;
    max-width: 800px;
    line-height: 1.6;
    margin-top: 0.75rem;
  }
  .content-layout {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 2rem;
    margin-bottom: 3rem;
  }
  @media (max-width: 900px) {
    .content-layout {
      grid-template-columns: 1fr;
    }
  }
  .content-card {
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 2rem;
    margin-bottom: 2rem;
  }
  .content-card h2 {
    color: #f8fafc;
    margin-top: 0;
  }
  .h2h-score-banner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    background: #0f172a;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 1.25rem;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  @media (max-width: 640px) {
    .h2h-score-banner {
      grid-template-columns: 1fr;
      text-align: center;
    }
  }
  .h2h-player {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .player-one {
    text-align: left;
  }
  .player-two {
    text-align: right;
  }
  @media (max-width: 640px) {
    .player-one, .player-two {
      text-align: center;
    }
  }
  .p-name a {
    font-size: 1.25rem;
    font-weight: 800;
    color: #38bdf8;
    text-decoration: none;
  }
  .p-name a:hover {
    text-decoration: underline;
  }
  .p-nick {
    font-size: 0.85rem;
    color: #94a3b8;
  }
  .p-titles {
    font-size: 0.8rem;
    color: #f59e0b;
    font-weight: 600;
  }
  .h2h-vs-box {
    text-align: center;
    padding: 0 1rem;
  }
  .vs-label {
    font-size: 0.75rem;
    font-weight: 700;
    color: #94a3b8;
  }
  .vs-tally {
    font-size: 1.75rem;
    font-weight: 900;
    color: #10b981;
    line-height: 1.2;
  }
  .vs-total {
    font-size: 0.75rem;
    color: #64748b;
  }
  .vs-meta {
    font-size: 0.7rem;
    color: #f59e0b;
    margin-top: 0.15rem;
  }
  .scope-banner {
    background: #0f172a;
    border: 1px solid #334155;
    padding: 0.5rem 0.75rem;
    border-radius: 4px;
    font-size: 0.8rem;
    color: #94a3b8;
    margin-bottom: 1.25rem;
  }
  .ledger-note {
    font-size: 0.9rem;
    color: #94a3b8;
    line-height: 1.5;
    margin: 0;
  }
  .table-note {
    font-size: 0.85rem;
    color: #94a3b8;
    line-height: 1.5;
    margin-top: 1rem;
  }
  .last-updated {
    font-size: 0.85rem;
    color: #94a3b8;
  }
  .last-updated a {
    color: #38bdf8;
    text-decoration: none;
  }
  .faq-accordion details {
    background: #0f172a;
    border: 1px solid #334155;
    border-radius: 6px;
    margin-bottom: 0.75rem;
    padding: 0.75rem 1rem;
  }
  .faq-question {
    cursor: pointer;
    font-weight: 600;
    color: #f8fafc;
  }
  .faq-answer {
    margin-top: 0.75rem;
    color: #94a3b8;
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .sidebar-card {
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
  }
  .sidebar-card h3 {
    margin-top: 0;
    font-size: 1.1rem;
    color: #f8fafc;
    border-bottom: 1px solid #334155;
    padding-bottom: 0.5rem;
    margin-bottom: 1rem;
  }
  .sidebar-links {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .sidebar-links li {
    margin-bottom: 0.6rem;
  }
  .sidebar-links a {
    color: #94a3b8;
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.2s;
  }
  .sidebar-links a:hover {
    color: #38bdf8;
  }
  .highlight-sidebar {
    border-color: #f59e0b;
  }
</style>
