---
// src/pages/cookie-policy.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const pageTitle = "Cookie Policy — World Darts Hub";
const pageDescription = "Cookie Policy for World Darts Hub. What cookies we use — including Google Analytics and advertising cookies — and how to manage your preferences.";

const breadcrumbItems = [
  { name: 'Cookie Policy' }
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <Breadcrumbs items={breadcrumbItems} />

  <div class="container container-narrow page-content">
    <h1>Cookie Policy</h1>
    <p class="lead">Last updated: October 2026</p>

    <p>
      World Darts Hub ("we", "us", "our") uses cookies and similar technologies to keep the site working,
      understand how visitors use it, and support advertising. This policy explains what cookies we use,
      why we use them, and how you can control them.
    </p>

    <h2>1. What Are Cookies?</h2>
    <p>
      Cookies are small text files stored on your device when you visit a website. They help the site
      remember your preferences, measure traffic, and — where advertising is shown — serve relevant ads.
      Cookies can be "first-party" (set by worlddartshub.com) or "third-party" (set by services we use,
      such as Google).
    </p>

    <h2>2. Cookies We Use</h2>

    <h3>Strictly Necessary Cookies</h3>
    <p>
      These are required for the site to function and cannot be switched off. Our hosting provider
      (Netlify) may set cookies for security, load balancing, and network management. No consent
      is required for these under UK GDPR / PECR because the site would not work without them.
    </p>

    <h3>Analytics Cookies</h3>
    <p>
      We use Google Analytics 4 to understand how visitors use the site in aggregate — for example,
      which pages are popular and how visitors arrive. Google Analytics sets cookies such as
      <code>_ga</code> and <code>_ga_&lt;measurement-id&gt;</code>. The data collected is aggregated
      and does not identify you personally.
    </p>
    <ul>
      <li>Provider: Google LLC</li>
      <li>Opt out: <a href="https://tools.google.com/dlpage/gaoptout" target="_blank" rel="noopener noreferrer nofollow">Google Analytics Opt-out Browser Add-on</a></li>
    </ul>

    <h3>Advertising Cookies</h3>
    <p>
      We use Google AdSense to support the site through advertising. Google and its partners use
      cookies to serve ads based on your prior visits to our website and other sites on the internet,
      including for ad personalisation and measurement. Google's use of advertising cookies enables
      it and its partners to serve ads based on your visit to our site and/or other sites.
    </p>
    <ul>
      <li>Provider: Google LLC</li>
      <li>Opt out of personalised advertising: <a href="https://www.google.com/settings/ads" target="_blank" rel="noopener noreferrer nofollow">Google Ads Settings</a></li>
      <li>Learn more: <a href="https://policies.google.com/technologies/cookies" target="_blank" rel="noopener noreferrer nofollow">How Google uses cookies</a></li>
    </ul>

    <h2>3. Managing Your Cookie Preferences</h2>
    <p>
      You can control cookies through your browser settings at any time:
    </p>
    <ul>
      <li>Block all or specific cookies via your browser's privacy settings.</li>
      <li>Delete cookies already stored on your device.</li>
      <li>Use your browser's "Do Not Track" signal where supported.</li>
    </ul>
    <p>
      Please note that blocking strictly necessary cookies may affect how the site functions.
      Guidance for common browsers:
    </p>
    <ul>
      <li><a href="https://support.google.com/chrome/answer/95647" target="_blank" rel="noopener noreferrer nofollow">Google Chrome</a></li>
      <li><a href="https://support.mozilla.org/en-US/kb/cookies-information-websites-store-on-your-computer" target="_blank" rel="noopener noreferrer nofollow">Mozilla Firefox</a></li>
      <li><a href="https://support.apple.com/en-gb/guide/safari/sfri11471/mac" target="_blank" rel="noopener noreferrer nofollow">Apple Safari</a></li>
      <li><a href="https://support.microsoft.com/en-us/microsoft-edge/delete-cookies-in-microsoft-edge-63947406-40ac-c3b8-57b9-2a946a2c3bab" target="_blank" rel="noopener noreferrer nofollow">Microsoft Edge</a></li>
    </ul>

    <h2>4. Changes to This Policy</h2>
    <p>
      We may update this Cookie Policy from time to time to reflect changes in the cookies we use
      or for legal and regulatory reasons. The "Last updated" date at the top of this page shows
      when it was most recently revised.
    </p>

    <h2>5. Contact</h2>
    <p>
      For questions about our use of cookies, please contact <a href="mailto:privacy@worlddartshub.com">privacy@worlddartshub.com</a>.
      You can also read our <a href="/privacy-policy/">Privacy Policy</a> for broader information
      on how we handle data.
    </p>
  </div>
</BaseLayout>

<style>
  .page-content {
    margin-top: 2.5rem;
    margin-bottom: 4rem;
  }
  .page-content h3 {
    margin-top: 1.75rem;
  }
  .page-content code {
    background: #f1f5f9;
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    font-size: 0.9em;
  }
</style>
