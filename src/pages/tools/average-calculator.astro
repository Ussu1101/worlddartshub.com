---
// src/pages/tools/average-calculator.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AdSlot from '../../components/AdSlot.astro';

const pageTitle = "Darts Average Calculator: 3-Dart Average & Match Average";
const pageDescription = "Calculate your darts three-dart average from points and darts, work out 501 leg averages, and combine multiple legs into an accurate match average.";
const siteUrl = "https://worlddartshub.com";

const breadcrumbItems = [
  { name: 'Darts Knowledge', url: '/darts/average-explained/' },
  { name: 'Average Calculator' }
];

const calculatorSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Darts Average Calculator",
  "url": `${siteUrl}/tools/average-calculator/`,
  "applicationCategory": "SportsApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript",
  "description": pageDescription,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "GBP"
  },
  "publisher": {
    "@type": "Organization",
    "name": "World Darts Hub",
    "url": siteUrl
  }
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  schema={calculatorSchema}
>
  <Breadcrumbs items={breadcrumbItems} />

  <!-- Hero Header -->
  <header class="calculator-hero">
    <div class="container">
      <div class="badge-group">
        <span class="badge badge-accent">INTERACTIVE TOOL</span>
        <span class="badge">3-DART BENCHMARK</span>
      </div>
      <h1>Darts Average Calculator</h1>
      <p class="hero-lead">
        Calculate your exact three-dart average from points scored and darts thrown, analyze individual X01 legs, and correctly combine multiple legs into a true weighted match average without mathematical skew.
      </p>
    </div>
  </header>

  <div class="container content-layout">
    <main class="main-column" id="main-content">
      
      <!-- Interactive Calculator Card -->
      <section class="calculator-card" aria-label="Darts Average Calculator Tool">
        
        <!-- Mode Switcher Tabs -->
        <div class="tab-nav" role="tablist" aria-label="Calculator Modes">
          <button
            type="button"
            class="tab-btn active"
            role="tab"
            aria-selected="true"
            aria-controls="pane-quick"
            id="tab-quick"
            data-mode="quick"
          >
            ⚡ Quick Calc
          </button>
          <button
            type="button"
            class="tab-btn"
            role="tab"
            aria-selected="false"
            aria-controls="pane-leg"
            id="tab-leg"
            data-mode="leg"
          >
            🎯 Single Leg (X01)
          </button>
          <button
            type="button"
            class="tab-btn"
            role="tab"
            aria-selected="false"
            aria-controls="pane-match"
            id="tab-match"
            data-mode="match"
          >
            🏆 Multi-Leg Match
          </button>
          <button
            type="button"
            class="tab-btn"
            role="tab"
            aria-selected="false"
            aria-controls="pane-target"
            id="tab-target"
            data-mode="target"
          >
            ⏱️ Target Pace
          </button>
        </div>

        <div class="calculator-body">
          
          <!-- Primary Results Banner (Universal) -->
          <div class="results-display" id="primary-results-card" aria-live="polite">
            <div class="results-header">
              <span class="result-badge" id="results-mode-label">QUICK CALCULATION RESULT</span>
              <span class="live-indicator">● LIVE CALCULATION</span>
            </div>
            
            <div class="results-main">
              <div class="result-primary-number">
                <span class="avg-label">Three-Dart Average</span>
                <span class="avg-value" id="res-3dart-avg">83.50</span>
              </div>
              
              <div class="results-grid">
                <div class="result-stat-box">
                  <span class="stat-label">Points Per Dart (PPD)</span>
                  <span class="stat-value" id="res-ppd">27.83</span>
                </div>
                <div class="result-stat-box">
                  <span class="stat-label">Points Scored</span>
                  <span class="stat-value" id="res-points">501</span>
                </div>
                <div class="result-stat-box">
                  <span class="stat-label">Darts Thrown</span>
                  <span class="stat-value" id="res-darts">18</span>
                </div>
                <div class="result-stat-box">
                  <span class="stat-label">Visits (3 Darts)</span>
                  <span class="stat-value" id="res-visits">6.0</span>
                </div>
              </div>
            </div>

            <div class="formula-readout" id="formula-readout-box">
              <span class="formula-icon">📐</span>
              <span class="formula-text" id="res-formula-text">Formula: (501 ÷ 18) × 3 = 83.50</span>
            </div>
          </div>

          <!-- PANE A: QUICK CALCULATOR -->
          <div class="mode-pane active" id="pane-quick" role="tabpanel" aria-labelledby="tab-quick">
            <h2 class="pane-title">Quick Points &amp; Darts Calculator</h2>
            <p class="pane-description">
              Enter your total points scored and total darts thrown to work out your overall 3-dart average instantly.
            </p>

            <form class="calc-form" id="form-quick" onsubmit="event.preventDefault();">
              <div class="form-grid">
                <div class="form-group">
                  <label for="quick-points">Total Points Scored</label>
                  <input
                    type="number"
                    id="quick-points"
                    name="quick-points"
                    class="form-input"
                    value="501"
                    min="0"
                    max="100000"
                    step="1"
                    placeholder="e.g. 501"
                    required
                  />
                  <span class="input-hint">Sum of all scores recorded across your throw</span>
                </div>

                <div class="form-group">
                  <label for="quick-darts">Total Darts Thrown</label>
                  <input
                    type="number"
                    id="quick-darts"
                    name="quick-darts"
                    class="form-input"
                    value="18"
                    min="1"
                    max="10000"
                    step="1"
                    placeholder="e.g. 18"
                    required
                  />
                  <span class="input-hint">Every dart thrown at the board (including misses)</span>
                </div>
              </div>

              <!-- Presets -->
              <div class="presets-row">
                <span class="presets-label">Quick 501 Presets:</span>
                <div class="preset-buttons">
                  <button type="button" class="preset-btn" data-points="501" data-darts="12">12 Darts (125.25)</button>
                  <button type="button" class="preset-btn" data-points="501" data-darts="15">15 Darts (100.20)</button>
                  <button type="button" class="preset-btn" data-points="501" data-darts="18">18 Darts (83.50)</button>
                  <button type="button" class="preset-btn" data-points="501" data-darts="21">21 Darts (71.57)</button>
                  <button type="button" class="preset-btn" data-points="501" data-darts="24">24 Darts (62.63)</button>
                </div>
              </div>

              <div class="form-actions">
                <button type="button" class="btn btn-secondary" id="btn-reset-quick">Reset Quick Calculator</button>
              </div>
            </form>
          </div>

          <!-- PANE B: SINGLE X01 LEG -->
          <div class="mode-pane" id="pane-leg" role="tabpanel" aria-labelledby="tab-leg" hidden>
            <h2 class="pane-title">Single X01 Leg Average Calculator</h2>
            <p class="pane-description">
              Select your game format, specify any remaining points (if unfinished), and calculate your exact leg average.
            </p>

            <form class="calc-form" id="form-leg" onsubmit="event.preventDefault();">
              
              <!-- Starting Score Selector -->
              <div class="form-group">
                <label>Starting Leg Format</label>
                <div class="pill-selector" role="radiogroup" aria-label="Starting Score">
                  <button type="button" class="pill-btn" data-start="301">301</button>
                  <button type="button" class="pill-btn active" data-start="501">501</button>
                  <button type="button" class="pill-btn" data-start="701">701</button>
                  <button type="button" class="pill-btn" data-start="custom">Custom</button>
                </div>
              </div>

              <div class="form-grid">
                <div class="form-group" id="group-custom-start" style="display: none;">
                  <label for="leg-custom-start">Custom Starting Score</label>
                  <input
                    type="number"
                    id="leg-custom-start"
                    class="form-input"
                    value="501"
                    min="1"
                    max="10001"
                    step="1"
                  />
                  <span class="input-hint">Enter custom X01 starting target</span>
                </div>

                <div class="form-group">
                  <label for="leg-remaining">Remaining Score</label>
                  <input
                    type="number"
                    id="leg-remaining"
                    class="form-input"
                    value="0"
                    min="0"
                    max="10000"
                    step="1"
                    placeholder="0 if completed"
                  />
                  <span class="input-hint">Enter 0 if the leg was won/checked out</span>
                </div>

                <div class="form-group">
                  <label for="leg-darts">Darts Thrown</label>
                  <input
                    type="number"
                    id="leg-darts"
                    class="form-input"
                    value="15"
                    min="1"
                    max="500"
                    step="1"
                    placeholder="e.g. 15"
                    required
                  />
                  <span class="input-hint">Total darts thrown in this leg</span>
                </div>
              </div>

              <div id="leg-warning" class="input-alert" style="display: none;" role="alert">
                Remaining score cannot exceed starting score.
              </div>

              <div class="form-actions">
                <button type="button" class="btn btn-secondary" id="btn-reset-leg">Reset Leg Calculator</button>
              </div>
            </form>
          </div>

          <!-- PANE C: MULTI-LEG MATCH -->
          <div class="mode-pane" id="pane-match" role="tabpanel" aria-labelledby="tab-match" hidden>
            <h2 class="pane-title">Multi-Leg Match Aggregator</h2>
            <p class="pane-description">
              Combine multiple legs into a mathematically correct weighted match average. <strong>Leg averages are never simply averaged together</strong>; all points and darts are aggregated across the entire match.
            </p>

            <div class="match-notice">
              <span class="notice-icon">💡</span>
              <span class="notice-text">
                <strong>Why weighted aggregation matters:</strong> Averaging leg averages introduces mathematical skew because legs with more darts have greater statistical weight. This tool computes true match averages identically to official PDC tournament scoring systems.
              </span>
            </div>

            <!-- Dynamic Legs Table -->
            <div class="match-legs-wrapper">
              <div class="table-responsive">
                <table class="match-table" id="match-legs-table">
                  <thead>
                    <tr>
                      <th>Leg #</th>
                      <th>Game</th>
                      <th>Remaining</th>
                      <th>Darts Thrown</th>
                      <th>Points Scored</th>
                      <th>Leg Average</th>
                      <th>Action</th>
                    </tr>
                  </thead>
                  <tbody id="match-legs-tbody">
                    <!-- Dynamic Leg Rows Inserted Here via JS -->
                  </tbody>
                </table>
              </div>
            </div>

            <div class="match-controls">
              <button type="button" class="btn btn-primary" id="btn-add-leg">+ Add Leg</button>
              <button type="button" class="btn btn-secondary" id="btn-reset-match">Reset Match</button>
            </div>

            <!-- Multi-leg Match Summary Strip -->
            <div class="match-summary-card">
              <h3>Match Aggregation Summary</h3>
              <div class="match-summary-grid">
                <div class="summary-metric">
                  <span class="summary-label">Legs Counted</span>
                  <span class="summary-val" id="match-summary-legs">2</span>
                </div>
                <div class="summary-metric">
                  <span class="summary-label">Total Match Points</span>
                  <span class="summary-val" id="match-summary-points">1,002</span>
                </div>
                <div class="summary-metric">
                  <span class="summary-label">Total Match Darts</span>
                  <span class="summary-val" id="match-summary-darts">39</span>
                </div>
                <div class="summary-metric summary-highlight">
                  <span class="summary-label">True Weighted Match Avg</span>
                  <span class="summary-val" id="match-summary-avg">77.08</span>
                </div>
              </div>
              <p class="summary-subtext" id="match-summary-comparison">
                Comparison: True weighted average is <strong>77.08</strong> (vs an incorrect unweighted average of <strong>81.42</strong>).
              </p>
            </div>
          </div>

          <!-- PANE D: TARGET PACE ESTIMATOR -->
          <div class="mode-pane" id="pane-target" role="tabpanel" aria-labelledby="tab-target" hidden>
            <h2 class="pane-title">Target Average 501 Leg Estimator</h2>
            <p class="pane-description">
              Set a target 3-dart average to estimate how many darts and visits are theoretically required to complete a 501 leg at that scoring pace.
            </p>

            <form class="calc-form" id="form-target" onsubmit="event.preventDefault();">
              <div class="form-group">
                <label for="target-avg-input">Target Three-Dart Average</label>
                <input
                  type="number"
                  id="target-avg-input"
                  class="form-input"
                  value="85.00"
                  min="10"
                  max="167"
                  step="0.5"
                  placeholder="e.g. 85.00"
                  required
                />
                <span class="input-hint">Enter your target scoring benchmark (e.g., 60, 75, 90, 100)</span>
              </div>

              <!-- Target Benchmark Presets -->
              <div class="presets-row">
                <span class="presets-label">Benchmark Targets:</span>
                <div class="preset-buttons">
                  <button type="button" class="target-preset-btn" data-target="60">60.00 (Pub / Social)</button>
                  <button type="button" class="target-preset-btn" data-target="75">75.00 (Superleague / Club)</button>
                  <button type="button" class="target-preset-btn" data-target="85">85.00 (County Standard)</button>
                  <button type="button" class="target-preset-btn" data-target="100">100.00 (Elite PDC Pro)</button>
                </div>
              </div>

              <!-- Target Output Box -->
              <div class="target-output-card">
                <div class="target-output-grid">
                  <div class="target-output-item">
                    <span class="target-label">Estimated Darts for 501</span>
                    <span class="target-val" id="target-res-darts">17.7</span>
                  </div>
                  <div class="target-output-item">
                    <span class="target-label">Estimated Visits Required</span>
                    <span class="target-val" id="target-res-visits">~6 visits (18 darts)</span>
                  </div>
                  <div class="target-output-item">
                    <span class="target-label">Required Points Per Dart</span>
                    <span class="target-val" id="target-res-ppd">28.33 PPD</span>
                  </div>
                </div>
                <p class="target-disclaimer">
                  ⚠️ <em>Note: This is a theoretical mathematical estimate based on consistent scoring pace (501 × 3 ÷ target average). Real-world 501 legs require finishing on a double, which typically lowers the final leg average if multiple double attempts are needed.</em>
                </p>
              </div>

              <div class="form-actions">
                <button type="button" class="btn btn-secondary" id="btn-reset-target">Reset Estimator</button>
              </div>
            </form>
          </div>

        </div>
      </section>

      <AdSlot position="in-article" />

      <!-- Section: How to Calculate a Darts Average -->
      <section class="content-card">
        <h2>How to Calculate a Darts Average</h2>
        <p>
          In professional darts, player performance is benchmarked by the <strong>three-dart average</strong>. Because a standard turn (visit) at the board consists of exactly three darts, the three-dart average represents the expected number of points a player scores every time they step up to the oche.
        </p>

        <div class="formula-box">
          <div class="formula-math">
            <span class="formula-label">Three-Dart Average</span> = 
            <span class="fraction">
              <span class="numerator">Total Points Scored</span>
              <span class="denominator">Total Darts Thrown</span>
            </span>
            &times; 3
          </div>
        </div>

        <h3>Step-by-Step Calculation Example</h3>
        <ol class="step-list">
          <li>
            <strong>Determine total points scored:</strong> In a completed 501 leg, you scored exactly 501 points. If the leg was unfinished, subtract your remaining score from the starting score.
          </li>
          <li>
            <strong>Count every dart thrown:</strong> Count all darts thrown at the board, including misses and darts aimed at doubles. For example, suppose you won the leg in <strong>18 darts</strong>.
          </li>
          <li>
            <strong>Divide points by darts:</strong> Calculate your single-dart average (Points Per Dart, or PPD):<br />
            <code>501 &divide; 18 = 27.833 points per dart</code>.
          </li>
          <li>
            <strong>Multiply by 3:</strong> Multiply the single-dart figure by 3 to reach your standard visit benchmark:<br />
            <code>27.833 &times; 3 = 83.50 three-dart average</code>.
          </li>
        </ol>
      </section>

      <!-- Section: Three-Dart Average vs Points Per Dart -->
      <section class="content-card">
        <h2>Three-Dart Average vs Points Per Dart (PPD)</h2>
        <p>
          Depending on whether you play steel-tip or soft-tip darts, or which mobile scoring app you use, you may encounter both <strong>Three-Dart Average</strong> and <strong>Points Per Dart (PPD)</strong>:
        </p>

        <div class="comparison-grid">
          <div class="comparison-box">
            <h4>Three-Dart Average (PDC / Steel-Tip Standard)</h4>
            <p>
              Standardized across all PDC television events (such as the <a href="/tournament/world-darts-championship/">World Darts Championship</a>), the BDO/WDF, and traditional pub leagues. It reflects the points scored per full three-dart visit.
            </p>
            <div class="conversion-pill">Formula: PPD &times; 3</div>
          </div>

          <div class="comparison-box">
            <h4>Points Per Dart (PPD / Soft-Tip Standard)</h4>
            <p>
              Commonly used in electronic soft-tip darts leagues, North American tournaments, and certain scoring apps. It represents the average value of each individual arrow thrown at the board.
            </p>
            <div class="conversion-pill">Formula: 3-Dart Average &divide; 3</div>
          </div>
        </div>

        <p class="conversion-summary">
          To convert from PPD to 3-Dart Average, simply <strong>multiply by 3</strong>. To convert from 3-Dart Average to PPD, <strong>divide by 3</strong>. For example, a 90.00 three-dart average equals exactly 30.00 PPD.
        </p>
      </section>

      <!-- Section: How to Calculate a 501 Average -->
      <section class="content-card">
        <h2>How to Calculate a 501 Average</h2>
        <p>
          The 501 leg is the universal competition format in professional darts. Calculating your average across a single 501 leg differs slightly depending on whether the leg was won or left unfinished:
        </p>

        <h3>1. Completed 501 Leg (Leg Won)</h3>
        <p>
          When you check out and win a 501 leg, you scored all 501 points. Divide 501 by the number of darts thrown to finish, then multiply by 3:
        </p>
        <div class="table-responsive">
          <table class="data-table">
            <thead>
              <tr>
                <th>Darts to Finish</th>
                <th>Visits Taken</th>
                <th>Points Per Dart (PPD)</th>
                <th>Three-Dart Average</th>
                <th>PDC Rating Context</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>9 Darts</strong></td>
                <td>3 Visits</td>
                <td>55.67 PPD</td>
                <td><strong class="text-accent">167.00</strong></td>
                <td>Perfect 9-Dart Leg (Maximum possible average)</td>
              </tr>
              <tr>
                <td><strong>12 Darts</strong></td>
                <td>4 Visits</td>
                <td>41.75 PPD</td>
                <td><strong class="text-accent">125.25</strong></td>
                <td>World-Class Broadcast TV standard</td>
              </tr>
              <tr>
                <td><strong>15 Darts</strong></td>
                <td>5 Visits</td>
                <td>33.40 PPD</td>
                <td><strong>100.20</strong></td>
                <td>Elite Premier League / Major standard</td>
              </tr>
              <tr>
                <td><strong>18 Darts</strong></td>
                <td>6 Visits</td>
                <td>27.83 PPD</td>
                <td><strong>83.50</strong></td>
                <td>Strong County / Superleague standard</td>
              </tr>
              <tr>
                <td><strong>21 Darts</strong></td>
                <td>7 Visits</td>
                <td>23.86 PPD</td>
                <td><strong>71.57</strong></td>
                <td>Solid Pub / Competitive League standard</td>
              </tr>
              <tr>
                <td><strong>24 Darts</strong></td>
                <td>8 Visits</td>
                <td>20.88 PPD</td>
                <td><strong>62.63</strong></td>
                <td>Intermediate Club standard</td>
              </tr>
            </tbody>
          </table>
        </div>

        <h3>2. Unfinished Leg (Opponent Checked Out First)</h3>
        <p>
          If your opponent checks out while you still have points left, calculate only the points you actually scored:
        </p>
        <p class="formula-inline">
          <code>Points Scored = 501 &minus; Remaining Score</code><br />
          <code>Unfinished Average = (Points Scored &divide; Darts Thrown) &times; 3</code>
        </p>
        <p>
          <strong>Example:</strong> You had 40 points left after throwing 15 darts when your opponent took out the leg. You scored <code>501 - 40 = 461 points</code>. Your average for that leg is <code>(461 &divide; 15) &times; 3 = 92.20</code>.
        </p>
      </section>

      <!-- Section: How to Calculate a Match Average -->
      <section class="content-card">
        <h2>How to Calculate a Match Average</h2>
        <p>
          A darts match consists of multiple legs (e.g. best of 9 legs, best of 11 legs, or sets play). To calculate your overall match average, track your cumulative statistics across the entire contest:
        </p>
        
        <div class="callout callout-info">
          <h4>Match Average Formula</h4>
          <p>
            <code>Match Three-Dart Average = (Total Match Points Scored &divide; Total Match Darts Thrown) &times; 3</code>
          </p>
        </div>

        <p>
          You must record two running totals throughout the match:
        </p>
        <ul>
          <li><strong>Total Points:</strong> Add together every point scored across all legs (both legs won and legs lost).</li>
          <li><strong>Total Darts:</strong> Add together every dart thrown across all legs.</li>
        </ul>
      </section>

      <!-- Section: The Aggregation Trap -->
      <section class="content-card">
        <h2>The Aggregation Trap: Why You Cannot Average Separate Leg Averages</h2>
        <p>
          The most widespread mathematical mistake made by amateur dart players and scorekeepers is <strong>taking the simple average of individual leg averages</strong>. Doing so produces a statistically incorrect result known as an unweighted average skew.
        </p>

        <div class="trap-comparison">
          <div class="trap-box trap-wrong">
            <h4>❌ The Wrong Method (Unweighted Arithmetic Mean)</h4>
            <p>Suppose you play a short 2-leg practice match:</p>
            <ul>
              <li><strong>Leg 1:</strong> 501 points in <strong>15 darts</strong> = 100.20 Average</li>
              <li><strong>Leg 2:</strong> 501 points in <strong>24 darts</strong> = 62.63 Average</li>
            </ul>
            <p>Incorrectly averaging the two leg numbers together:</p>
            <p class="trap-calc"><code>(100.20 + 62.63) &divide; 2 = 81.42 Average</code></p>
            <p class="trap-flaw">
              <strong>Why it's wrong:</strong> This gives equal weight to both legs, ignoring the fact that Leg 2 took 24 darts (61.5% of your throws) while Leg 1 only took 15 darts (38.5% of your throws).
            </p>
          </div>

          <div class="trap-box trap-correct">
            <h4>✅ The Correct Method (True Weighted Aggregate)</h4>
            <p>Summing total points and total darts thrown across the entire match:</p>
            <ul>
              <li><strong>Total Points:</strong> 501 + 501 = 1,002 points</li>
              <li><strong>Total Darts:</strong> 15 + 24 = 39 darts</li>
            </ul>
            <p>Applying the true match formula:</p>
            <p class="trap-calc"><code>(1,002 &divide; 39) &times; 3 = 77.08 Average</code></p>
            <p class="trap-flaw">
              <strong>The reality:</strong> Your actual match average is <strong>77.08</strong>, more than <strong>4.3 points lower</strong> than the flawed 81.42 estimate. Longer legs have a proportionally greater impact on your true scoring rate.
            </p>
          </div>
        </div>

        <p>
          Our <a href="#main-content">Multi-Leg Match Calculator</a> automatically applies this correct weighted formula, ensuring your calculated averages match official PDC statistical records exactly.
        </p>
      </section>

      <!-- Section: First-Nine Average -->
      <section class="content-card">
        <h2>First-Nine Average (Scoring Power vs Finishing Pressure)</h2>
        <p>
          On professional television broadcasts, commentators and statisticians frequently display a player's <strong>First-Nine Average</strong> alongside their overall 3-dart average.
        </p>

        <div class="grid-2">
          <div class="card">
            <h4>What Is the First-Nine Average?</h4>
            <p>
              The First-Nine average measures the points scored during the first 9 darts (the first 3 visits) of every 501 leg. Because a leg cannot be won in fewer than 9 darts, these first visits are virtually always thrown at the treble 20 without any double-finishing attempts.
            </p>
          </div>

          <div class="card">
            <h4>Why Does PDC Track It Separately?</h4>
            <p>
              The First-Nine isolates pure scoring power from double conversion. When a player struggles on their finishing doubles (throwing multiple darts scoring 0 points), their overall average drops sharply while their First-Nine average accurately reveals how heavily they were scoring in the opening visits.
            </p>
          </div>
        </div>

        <p class="guide-note">
          For a comprehensive analysis of how First-Nine averages interact with match strategy and why a player with a higher average can still lose, read our in-depth guide on <a href="/darts/average-explained/">How 3-Dart Averages Work in Professional Darts</a>.
        </p>
      </section>

      <!-- Section: Benchmark Darts Averages -->
      <section class="content-card">
        <h2>Benchmark Darts Averages: Where Do You Stand?</h2>
        <p>
          While official darts governing bodies do not enforce statutory rating divisions, three-dart averages serve as a universally recognized barometer of competitive skill. The following editorial benchmark ranges illustrate typical performance standards observed across grass-roots leagues, county circuits, and professional tours:
        </p>

        <div class="table-responsive">
          <table class="data-table">
            <thead>
              <tr>
                <th>Average Range</th>
                <th>Standard Category</th>
                <th>Typical Leg Length</th>
                <th>Competitive Context</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>35.00 – 48.00</strong></td>
                <td>Beginner / Social</td>
                <td>31 – 43 darts</td>
                <td>Casual home play, learning board arithmetic and setup shots</td>
              </tr>
              <tr>
                <td><strong>50.00 – 62.00</strong></td>
                <td>Pub League / Club</td>
                <td>24 – 30 darts</td>
                <td>Regular pub league player with consistent treble 20 visits</td>
              </tr>
              <tr>
                <td><strong>65.00 – 78.00</strong></td>
                <td>Superleague / Advanced Club</td>
                <td>19 – 23 darts</td>
                <td>Competitive league standout; clinical finishes on favorite doubles</td>
              </tr>
              <tr>
                <td><strong>80.00 – 90.00</strong></td>
                <td>County / Challenge Tour</td>
                <td>17 – 19 darts</td>
                <td>PDC Q-School aspirant, Challenge Tour contender, top county representative</td>
              </tr>
              <tr>
                <td><strong>92.00 – 102.00</strong></td>
                <td>PDC Tour Card Professional</td>
                <td>14 – 16 darts</td>
                <td>PDC ProTour regular, qualifying for European Tour and major stages</td>
              </tr>
              <tr>
                <td><strong>105.00+</strong></td>
                <td>World Championship Elite</td>
                <td>12 – 14 darts</td>
                <td>World-title winning form displayed by Luke Littler, Luke Humphries, and Michael van Gerwen</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class="table-footnote">
          *Note: Benchmark ranges represent typical sustained single-match scoring averages. In shorter legs or best-of-5 formats, statistical variance is significantly higher because a single missed dart at double has a heavier mathematical impact.
        </p>
      </section>

      <!-- Section: Frequently Asked Questions -->
      <section class="content-card">
        <h2>Frequently Asked Questions</h2>
        
        <div class="faq-list">
          <div class="faq-item">
            <h4>How do you calculate a darts average?</h4>
            <p>
              To calculate a three-dart average, divide the total points you scored by the total number of darts you threw, then multiply the result by 3: <code>(Points &divide; Darts) &times; 3</code>. For example, 501 points scored in 18 darts equals <code>(501 &divide; 18) &times; 3 = 83.50</code>.
            </p>
          </div>

          <div class="faq-item">
            <h4>What is a three-dart average?</h4>
            <p>
              A three-dart average is the standard statistical metric used in professional darts. Because each turn at the board consists of throwing three darts, the three-dart average represents the expected scoring value of one complete visit to the oche.
            </p>
          </div>

          <div class="faq-item">
            <h4>How do you calculate a 501 average?</h4>
            <p>
              For a completed 501 leg that you won, divide 501 by the number of darts thrown and multiply by 3. If the leg was unfinished when your opponent won, subtract your remaining score from 501 to find your points scored, divide by your darts thrown, and multiply by 3.
            </p>
          </div>

          <div class="faq-item">
            <h4>Does this calculator work for 301, 701, and custom formats?</h4>
            <p>
              Yes. In our Single Leg (X01) mode, you can select 301, 501, 701, or any custom starting score. The calculator determines your net points scored (Starting Score minus Remaining Score) and computes your exact three-dart average.
            </p>
          </div>

          <div class="faq-item">
            <h4>Can I calculate a match average across multiple legs?</h4>
            <p>
              Yes. Use our Multi-Leg Match mode. You should never average individual leg averages together because legs with more darts thrown carry more statistical weight. The calculator combines all points scored across all legs and divides by the combined darts thrown before multiplying by 3.
            </p>
          </div>

          <div class="faq-item">
            <h4>Why might my average differ slightly from a scoring app?</h4>
            <p>
              Differences typically arise from how scoring apps handle edge cases. For instance, in a "bust" scenario, some platforms record all 3 darts for the visit while others only count the darts thrown before the bust occurred. Additionally, some apps truncate decimals rather than rounding them. Our calculator adheres strictly to standard PDC weighted arithmetic.
            </p>
          </div>
        </div>
      </section>

