    </main>
  </div>

  <script>
    // Client-side Interactive Darts Average Calculator
    document.addEventListener('DOMContentLoaded', () => {
      
      // Elements: Tabs
      const tabButtons = document.querySelectorAll('.tab-btn');
      const modePanes = document.querySelectorAll('.mode-pane');
      const resultsModeLabel = document.getElementById('results-mode-label');
      
      // Elements: Universal Result Display
      const res3DartAvg = document.getElementById('res-3dart-avg');
      const resPpd = document.getElementById('res-ppd');
      const resPoints = document.getElementById('res-points');
      const resDarts = document.getElementById('res-darts');
      const resVisits = document.getElementById('res-visits');
      const resFormulaText = document.getElementById('res-formula-text');

      // Elements: Quick Calc
      const quickPointsInput = document.getElementById('quick-points') as HTMLInputElement | null;
      const quickDartsInput = document.getElementById('quick-darts') as HTMLInputElement | null;
      const btnResetQuick = document.getElementById('btn-reset-quick');
      const quickPresetBtns = document.querySelectorAll('.preset-btn');

      // Elements: Single Leg (X01)
      const legPillBtns = document.querySelectorAll('.pill-btn');
      const groupCustomStart = document.getElementById('group-custom-start');
      const legCustomStartInput = document.getElementById('leg-custom-start') as HTMLInputElement | null;
      const legRemainingInput = document.getElementById('leg-remaining') as HTMLInputElement | null;
      const legDartsInput = document.getElementById('leg-darts') as HTMLInputElement | null;
      const legWarning = document.getElementById('leg-warning');
      const btnResetLeg = document.getElementById('btn-reset-leg');
      let legStartScore = 501;

      // Elements: Multi-Leg Match
      const matchLegsTbody = document.getElementById('match-legs-tbody');
      const btnAddLeg = document.getElementById('btn-add-leg');
      const btnResetMatch = document.getElementById('btn-reset-match');
      const matchSummaryLegs = document.getElementById('match-summary-legs');
      const matchSummaryPoints = document.getElementById('match-summary-points');
      const matchSummaryDarts = document.getElementById('match-summary-darts');
      const matchSummaryAvg = document.getElementById('match-summary-avg');
      const matchSummaryComparison = document.getElementById('match-summary-comparison');

      // Elements: Target Estimator
      const targetAvgInput = document.getElementById('target-avg-input') as HTMLInputElement | null;
      const targetPresetBtns = document.querySelectorAll('.target-preset-btn');
      const targetResDarts = document.getElementById('target-res-darts');
      const targetResVisits = document.getElementById('target-res-visits');
      const targetResPpd = document.getElementById('target-res-ppd');
      const btnResetTarget = document.getElementById('btn-reset-target');

      // State: Multi-Leg Match
      interface MatchLeg {
        id: number;
        start: number;
        remaining: number;
        darts: number;
      }
      
      let matchLegs: MatchLeg[] = [
        { id: 1, start: 501, remaining: 0, darts: 15 },
        { id: 2, start: 501, remaining: 0, darts: 24 }
      ];
      let nextLegId = 3;

      // Active Mode Tracker
      let activeMode = 'quick';

      // Update Universal Primary Results Box
      function updateUniversalResults(avg: number, ppd: number, points: number, darts: number, customFormula?: string) {
        if (!res3DartAvg || !resPpd || !resPoints || !resDarts || !resVisits || !resFormulaText) return;
        
        if (darts <= 0 || isNaN(avg) || !isFinite(avg)) {
          res3DartAvg.textContent = '0.00';
          resPpd.textContent = '0.00';
          resPoints.textContent = points > 0 ? points.toLocaleString() : '0';
          resDarts.textContent = '0';
          resVisits.textContent = '0.0';
          resFormulaText.textContent = 'Enter darts thrown (at least 1) to calculate average';
          return;
        }

        res3DartAvg.textContent = avg.toFixed(2);
        resPpd.textContent = ppd.toFixed(2);
        resPoints.textContent = points.toLocaleString();
        resDarts.textContent = darts.toString();
        resVisits.textContent = (darts / 3).toFixed(1);

        if (customFormula) {
          resFormulaText.textContent = customFormula;
        } else {
          resFormulaText.textContent = `Formula: (${points.toLocaleString()} ÷ ${darts}) × 3 = ${avg.toFixed(2)}`;
        }
      }

      // --- 1. QUICK CALCULATOR LOGIC ---
      function calculateQuick() {
        if (!quickPointsInput || !quickDartsInput) return;
        const points = Math.max(0, parseInt(quickPointsInput.value, 10) || 0);
        const darts = Math.max(0, parseInt(quickDartsInput.value, 10) || 0);

        if (darts <= 0) {
          updateUniversalResults(0, 0, points, 0);
          return;
        }

        const ppd = points / darts;
        const avg = ppd * 3;
        updateUniversalResults(avg, ppd, points, darts);
      }

      quickPointsInput?.addEventListener('input', calculateQuick);
      quickDartsInput?.addEventListener('input', calculateQuick);

      quickPresetBtns.forEach(btn => {
        btn.addEventListener('click', (e) => {
          const target = e.currentTarget as HTMLElement;
          const p = target.getAttribute('data-points');
          const d = target.getAttribute('data-darts');
          if (p && d && quickPointsInput && quickDartsInput) {
            quickPointsInput.value = p;
            quickDartsInput.value = d;
            calculateQuick();
          }
        });
      });

      btnResetQuick?.addEventListener('click', () => {
        if (quickPointsInput && quickDartsInput) {
          quickPointsInput.value = '501';
          quickDartsInput.value = '18';
          calculateQuick();
        }
      });

      // --- 2. SINGLE LEG (X01) LOGIC ---
      function calculateLeg() {
        if (!legRemainingInput || !legDartsInput) return;

        let start = legStartScore;
        if (legStartScore === -1 && legCustomStartInput) {
          start = Math.max(1, parseInt(legCustomStartInput.value, 10) || 501);
        }

        const remaining = Math.max(0, parseInt(legRemainingInput.value, 10) || 0);
        const darts = Math.max(0, parseInt(legDartsInput.value, 10) || 0);

        if (remaining > start) {
          if (legWarning) legWarning.style.display = 'block';
          updateUniversalResults(0, 0, 0, darts, 'Error: Remaining score exceeds starting score');
          return;
        } else {
          if (legWarning) legWarning.style.display = 'none';
        }

        const pointsScored = start - remaining;
        if (darts <= 0) {
          updateUniversalResults(0, 0, pointsScored, 0);
          return;
        }

        const ppd = pointsScored / darts;
        const avg = ppd * 3;
        const formula = `Formula: (${start} - ${remaining} = ${pointsScored} pts) ÷ ${darts} × 3 = ${avg.toFixed(2)}`;
        updateUniversalResults(avg, ppd, pointsScored, darts, formula);
      }

      legPillBtns.forEach(btn => {
        btn.addEventListener('click', (e) => {
          legPillBtns.forEach(b => b.classList.remove('active'));
          const target = e.currentTarget as HTMLElement;
          target.classList.add('active');
          const val = target.getAttribute('data-start');
          if (val === 'custom') {
            legStartScore = -1;
            if (groupCustomStart) groupCustomStart.style.display = 'block';
          } else {
            legStartScore = parseInt(val || '501', 10);
            if (groupCustomStart) groupCustomStart.style.display = 'none';
          }
          calculateLeg();
        });
      });

      legCustomStartInput?.addEventListener('input', calculateLeg);
      legRemainingInput?.addEventListener('input', calculateLeg);
      legDartsInput?.addEventListener('input', calculateLeg);

      btnResetLeg?.addEventListener('click', () => {
        legStartScore = 501;
        legPillBtns.forEach(b => {
          b.classList.toggle('active', b.getAttribute('data-start') === '501');
        });
        if (groupCustomStart) groupCustomStart.style.display = 'none';
        if (legRemainingInput) legRemainingInput.value = '0';
        if (legDartsInput) legDartsInput.value = '15';
        if (legWarning) legWarning.style.display = 'none';
        calculateLeg();
      });

      // --- 3. MULTI-LEG MATCH LOGIC ---
      function renderMatchTable() {
        if (!matchLegsTbody) return;
        matchLegsTbody.innerHTML = '';

        matchLegs.forEach((leg, index) => {
          const row = document.createElement('tr');
          const ptsScored = Math.max(0, leg.start - leg.remaining);
          const legAvg = leg.darts > 0 ? ((ptsScored / leg.darts) * 3).toFixed(2) : '0.00';

          row.innerHTML = `
            <td><strong>Leg ${index + 1}</strong></td>
            <td>
              <select class="table-select leg-start-select" data-id="${leg.id}">
                <option value="501" ${leg.start === 501 ? 'selected' : ''}>501</option>
                <option value="301" ${leg.start === 301 ? 'selected' : ''}>301</option>
                <option value="701" ${leg.start === 701 ? 'selected' : ''}>701</option>
              </select>
            </td>
            <td>
              <input type="number" class="table-input leg-remaining-input" data-id="${leg.id}" value="${leg.remaining}" min="0" max="${leg.start}" style="width: 70px;" />
            </td>
            <td>
              <input type="number" class="table-input leg-darts-input" data-id="${leg.id}" value="${leg.darts}" min="1" max="300" style="width: 70px;" />
            </td>
            <td><span class="pts-cell">${ptsScored}</span></td>
            <td><strong class="avg-cell text-accent">${legAvg}</strong></td>
            <td>
              <button type="button" class="btn-delete-leg" data-id="${leg.id}" aria-label="Delete Leg ${index + 1}" ${matchLegs.length <= 1 ? 'disabled style="opacity: 0.4;"' : ''}>✕</button>
            </td>
          `;

          matchLegsTbody.appendChild(row);
        });

        // Add event listeners to table inputs
        const startSelects = matchLegsTbody.querySelectorAll('.leg-start-select');
        startSelects.forEach(el => {
          el.addEventListener('change', (e) => {
            const target = e.target as HTMLSelectElement;
            const id = parseInt(target.getAttribute('data-id') || '0', 10);
            const leg = matchLegs.find(l => l.id === id);
            if (leg) {
              leg.start = parseInt(target.value, 10);
              renderMatchTable();
              calculateMatch();
            }
          });
        });

        const remInputs = matchLegsTbody.querySelectorAll('.leg-remaining-input');
        remInputs.forEach(el => {
          el.addEventListener('input', (e) => {
            const target = e.target as HTMLInputElement;
            const id = parseInt(target.getAttribute('data-id') || '0', 10);
            const leg = matchLegs.find(l => l.id === id);
            if (leg) {
              leg.remaining = Math.max(0, parseInt(target.value, 10) || 0);
              updateRowCalculations(target.closest('tr'), leg);
              calculateMatch();
            }
          });
        });

        const dartsInputs = matchLegsTbody.querySelectorAll('.leg-darts-input');
        dartsInputs.forEach(el => {
          el.addEventListener('input', (e) => {
            const target = e.target as HTMLInputElement;
            const id = parseInt(target.getAttribute('data-id') || '0', 10);
            const leg = matchLegs.find(l => l.id === id);
            if (leg) {
              leg.darts = Math.max(1, parseInt(target.value, 10) || 1);
              updateRowCalculations(target.closest('tr'), leg);
              calculateMatch();
            }
          });
        });

        const deleteButtons = matchLegsTbody.querySelectorAll('.btn-delete-leg');
        deleteButtons.forEach(el => {
          el.addEventListener('click', (e) => {
            if (matchLegs.length <= 1) return;
            const target = e.target as HTMLElement;
            const id = parseInt(target.getAttribute('data-id') || '0', 10);
            matchLegs = matchLegs.filter(l => l.id !== id);
            renderMatchTable();
            calculateMatch();
          });
        });
      }

      function updateRowCalculations(row: HTMLTableRowElement | null, leg: MatchLeg) {
        if (!row) return;
        const ptsScored = Math.max(0, leg.start - leg.remaining);
        const legAvg = leg.darts > 0 ? ((ptsScored / leg.darts) * 3).toFixed(2) : '0.00';
        const ptsCell = row.querySelector('.pts-cell');
        const avgCell = row.querySelector('.avg-cell');
        if (ptsCell) ptsCell.textContent = ptsScored.toString();
        if (avgCell) avgCell.textContent = legAvg;
      }

      function calculateMatch() {
        let totalPoints = 0;
        let totalDarts = 0;
        let legAveragesSum = 0;
        let validLegsCount = 0;

        matchLegs.forEach(leg => {
          const pts = Math.max(0, leg.start - leg.remaining);
          totalPoints += pts;
          totalDarts += leg.darts;
          if (leg.darts > 0) {
            legAveragesSum += (pts / leg.darts) * 3;
            validLegsCount++;
          }
        });

        const matchAvg = totalDarts > 0 ? (totalPoints / totalDarts) * 3 : 0;
        const matchPpd = totalDarts > 0 ? totalPoints / totalDarts : 0;
        const unweightedMean = validLegsCount > 0 ? legAveragesSum / validLegsCount : 0;

        if (matchSummaryLegs) matchSummaryLegs.textContent = matchLegs.length.toString();
        if (matchSummaryPoints) matchSummaryPoints.textContent = totalPoints.toLocaleString();
        if (matchSummaryDarts) matchSummaryDarts.textContent = totalDarts.toString();
        if (matchSummaryAvg) matchSummaryAvg.textContent = matchAvg.toFixed(2);

        if (matchSummaryComparison) {
          matchSummaryComparison.innerHTML = `Comparison: True weighted average is <strong>${matchAvg.toFixed(2)}</strong> (vs an incorrect unweighted leg average of <strong>${unweightedMean.toFixed(2)}</strong>).`;
        }

        if (activeMode === 'match') {
          const formula = `Weighted Match: (${totalPoints.toLocaleString()} pts ÷ ${totalDarts} darts) × 3 = ${matchAvg.toFixed(2)}`;
          updateUniversalResults(matchAvg, matchPpd, totalPoints, totalDarts, formula);
        }
      }

      btnAddLeg?.addEventListener('click', () => {
        matchLegs.push({
          id: nextLegId++,
          start: 501,
          remaining: 0,
          darts: 18
        });
        renderMatchTable();
        calculateMatch();
      });

      btnResetMatch?.addEventListener('click', () => {
        matchLegs = [
          { id: 1, start: 501, remaining: 0, darts: 15 },
          { id: 2, start: 501, remaining: 0, darts: 24 }
        ];
        nextLegId = 3;
        renderMatchTable();
        calculateMatch();
      });

      // --- 4. TARGET PACE ESTIMATOR LOGIC ---
      function calculateTarget() {
        if (!targetAvgInput || !targetResDarts || !targetResVisits || !targetResPpd) return;
        const target = Math.max(1, parseFloat(targetAvgInput.value) || 0);

        if (target <= 0) {
          targetResDarts.textContent = '--';
          targetResVisits.textContent = '--';
          targetResPpd.textContent = '--';
          return;
        }

        // Formula: 501 * 3 / target
        const estDarts = (501 * 3) / target;
        const estVisits = Math.ceil(estDarts / 3);
        const ppd = target / 3;

        targetResDarts.textContent = estDarts.toFixed(1) + ' darts';
        targetResVisits.textContent = `~${(estDarts / 3).toFixed(1)} visits (approx ${Math.round(estDarts)} darts)`;
        targetResPpd.textContent = ppd.toFixed(2) + ' PPD';

        if (activeMode === 'target') {
          const formula = `Pace Estimate: 501 pts × 3 ÷ ${target.toFixed(2)} target avg = ${estDarts.toFixed(1)} darts`;
          updateUniversalResults(target, ppd, 501, Math.round(estDarts), formula);
        }
      }

      targetAvgInput?.addEventListener('input', calculateTarget);

      targetPresetBtns.forEach(btn => {
        btn.addEventListener('click', (e) => {
          const target = e.currentTarget as HTMLElement;
          const val = target.getAttribute('data-target');
          if (val && targetAvgInput) {
            targetAvgInput.value = val;
            calculateTarget();
          }
        });
      });

      btnResetTarget?.addEventListener('click', () => {
        if (targetAvgInput) {
          targetAvgInput.value = '85.00';
          calculateTarget();
        }
      });

      // --- TAB SWITCHER LOGIC ---
      tabButtons.forEach(btn => {
        btn.addEventListener('click', (e) => {
          const clickedBtn = e.currentTarget as HTMLButtonElement;
          const mode = clickedBtn.getAttribute('data-mode') || 'quick';
          activeMode = mode;

          // Update tabs
          tabButtons.forEach(b => {
            b.classList.remove('active');
            b.setAttribute('aria-selected', 'false');
          });
          clickedBtn.classList.add('active');
          clickedBtn.setAttribute('aria-selected', 'true');

          // Switch panes
          modePanes.forEach(pane => {
            pane.classList.remove('active');
            pane.setAttribute('hidden', '');
          });

          const activePane = document.getElementById(`pane-${mode}`);
          if (activePane) {
            activePane.classList.add('active');
            activePane.removeAttribute('hidden');
          }

          // Update label on primary banner
          if (resultsModeLabel) {
            if (mode === 'quick') resultsModeLabel.textContent = 'QUICK CALCULATION RESULT';
            else if (mode === 'leg') resultsModeLabel.textContent = 'SINGLE X01 LEG RESULT';
            else if (mode === 'match') resultsModeLabel.textContent = 'MULTI-LEG MATCH RESULT';
            else if (mode === 'target') resultsModeLabel.textContent = 'TARGET PACE RESULT';
          }

          // Trigger active mode calculation for universal display
          if (mode === 'quick') calculateQuick();
          else if (mode === 'leg') calculateLeg();
          else if (mode === 'match') calculateMatch();
          else if (mode === 'target') calculateTarget();
        });
      });

      // Initial execution
      renderMatchTable();
      calculateQuick();
    });
  </script>

  <style>
    /* Calculator Page Specific Styling */
    .calculator-hero {
      background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
      color: #ffffff;
      padding: 2.75rem 0 3.25rem;
      border-bottom: 1px solid #334155;
    }
    .badge-group {
      display: flex;
      gap: 0.5rem;
      margin-bottom: 0.85rem;
    }
    .calculator-hero h1 {
      color: #ffffff;
      font-size: 2.5rem;
      margin-bottom: 0.75rem;
      letter-spacing: -0.02em;
    }
    .hero-lead {
      color: #cbd5e1;
      font-size: 1.15rem;
      max-width: 800px;
      line-height: 1.6;
      margin-bottom: 0;
    }

    .content-layout {
      margin-top: 2rem;
      margin-bottom: 4rem;
    }
    .main-column {
      max-width: 900px;
      margin: 0 auto;
    }

    /* Calculator Main Card */
    .calculator-card {
      background: #ffffff;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-md);
      overflow: hidden;
      margin-bottom: 2.5rem;
    }

    /* Tab Switcher */
    .tab-nav {
      display: flex;
      background: #f1f5f9;
      border-bottom: 1px solid var(--color-border);
      overflow-x: auto;
      scrollbar-width: thin;
    }
    .tab-btn {
      flex: 1;
      min-width: 140px;
      padding: 1rem 0.75rem;
      font-size: 0.95rem;
      font-weight: 700;
      color: var(--color-text-muted);
      background: transparent;
      border: none;
      border-bottom: 3px solid transparent;
      cursor: pointer;
      transition: all 0.15s ease;
      white-space: nowrap;
      text-align: center;
    }
    .tab-btn:hover {
      color: var(--color-primary);
      background: rgba(255, 255, 255, 0.6);
    }
    .tab-btn.active {
      color: var(--color-primary);
      background: #ffffff;
      border-bottom-color: var(--color-accent);
    }

    .calculator-body {
      padding: 1.75rem;
    }

    /* Primary Results Banner */
    .results-display {
      background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
      border-radius: var(--radius-md);
      padding: 1.75rem;
      color: #ffffff;
      margin-bottom: 2rem;
      box-shadow: 0 4px 12px rgba(15, 23, 42, 0.15);
    }
    .results-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.25rem;
      border-bottom: 1px solid #334155;
      padding-bottom: 0.75rem;
    }
    .result-badge {
      font-size: 0.75rem;
      font-weight: 800;
      letter-spacing: 0.08em;
      color: var(--color-accent);
      text-transform: uppercase;
    }
    .live-indicator {
      font-size: 0.75rem;
      color: #34d399;
      font-weight: 600;
      letter-spacing: 0.05em;
    }

    .results-main {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1.5rem;
      align-items: center;
    }
    @media (min-width: 640px) {
      .results-main {
        grid-template-columns: 220px 1fr;
      }
    }

    .result-primary-number {
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: var(--radius-sm);
      padding: 1.25rem;
      text-align: center;
    }
    .avg-label {
      display: block;
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: #94a3b8;
      font-weight: 700;
      margin-bottom: 0.35rem;
    }
    .avg-value {
      display: block;
      font-size: 3rem;
      font-weight: 900;
      line-height: 1;
      color: var(--color-accent);
      font-family: var(--font-mono);
      letter-spacing: -0.03em;
    }

    .results-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 0.85rem;
    }
    .result-stat-box {
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: var(--radius-sm);
      padding: 0.75rem 1rem;
    }
    .stat-label {
      display: block;
      font-size: 0.75rem;
      color: #94a3b8;
      margin-bottom: 0.25rem;
    }
    .stat-value {
      display: block;
      font-size: 1.25rem;
      font-weight: 700;
      color: #f8fafc;
      font-family: var(--font-mono);
    }

    .formula-readout {
      margin-top: 1.25rem;
      padding-top: 0.85rem;
      border-top: 1px solid #334155;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.85rem;
      color: #cbd5e1;
      font-family: var(--font-mono);
    }
    .formula-icon {
      font-size: 1rem;
    }

    /* Mode Panes */
    .mode-pane {
      display: none;
    }
    .mode-pane.active {
      display: block;
    }
    .pane-title {
      font-size: 1.4rem;
      color: var(--color-primary);
      margin-bottom: 0.5rem;
      margin-top: 0;
    }
    .pane-description {
      color: var(--color-text-muted);
      font-size: 0.95rem;
      margin-bottom: 1.5rem;
    }

    /* Form Layouts */
    .calc-form {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }
    .form-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
    @media (min-width: 640px) {
      .form-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
    }
    .form-group label {
      font-size: 0.9rem;
      font-weight: 700;
      color: var(--color-primary);
    }
    .form-input {
      width: 100%;
      padding: 0.75rem 1rem;
      font-size: 1.05rem;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-sm);
      background-color: #f8fafc;
      color: var(--color-primary);
      font-family: var(--font-mono);
      transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }
    .form-input:focus {
      outline: none;
      border-color: var(--color-accent);
      background-color: #ffffff;
      box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.15);
    }
    .input-hint {
      font-size: 0.8rem;
      color: var(--color-text-light);
    }
    .input-alert {
      background-color: #fee2e2;
      border-left: 4px solid var(--color-dart-red);
      color: #991b1b;
      padding: 0.75rem 1rem;
      border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
      font-size: 0.9rem;
      font-weight: 600;
    }

    /* Pill Selector for 301, 501, 701 */
    .pill-selector {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-top: 0.25rem;
    }
    .pill-btn {
      padding: 0.5rem 1.25rem;
      font-size: 0.9rem;
      font-weight: 700;
      border: 1px solid var(--color-border);
      border-radius: 9999px;
      background: #f8fafc;
      color: var(--color-primary);
      cursor: pointer;
      transition: all 0.15s ease;
    }
    .pill-btn:hover {
      background: #e2e8f0;
    }
    .pill-btn.active {
      background: var(--color-primary);
      color: #ffffff;
      border-color: var(--color-primary);
    }

    /* Presets Strip */
    .presets-row {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      padding: 1rem;
      background: #f8fafc;
      border-radius: var(--radius-sm);
      border: 1px solid var(--color-border);
    }
    @media (min-width: 640px) {
      .presets-row {
        flex-direction: row;
        align-items: center;
      }
    }
    .presets-label {
      font-size: 0.85rem;
      font-weight: 700;
      color: var(--color-text-muted);
      white-space: nowrap;
    }
    .preset-buttons {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }
    .preset-btn, .target-preset-btn {
      background: #ffffff;
      border: 1px solid #cbd5e1;
      padding: 0.35rem 0.75rem;
      font-size: 0.8rem;
      font-weight: 600;
      border-radius: var(--radius-sm);
      color: var(--color-primary);
      cursor: pointer;
      transition: all 0.15s ease;
    }
    .preset-btn:hover, .target-preset-btn:hover {
      background: #f1f5f9;
      border-color: var(--color-accent);
      color: #92400e;
    }

    .form-actions {
      display: flex;
      justify-content: flex-end;
      margin-top: 0.5rem;
    }

    /* Multi-Leg Match Specifics */
    .match-notice {
      display: flex;
      gap: 0.75rem;
      align-items: flex-start;
      background: #eff6ff;
      border-left: 4px solid #3b82f6;
      padding: 0.9rem 1.1rem;
      border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
      margin-bottom: 1.5rem;
      font-size: 0.9rem;
      color: #1e40af;
      line-height: 1.5;
    }
    .notice-icon {
      font-size: 1.1rem;
    }
    .match-table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
      font-size: 0.9rem;
    }
    .match-table th {
      background: #f8fafc;
      padding: 0.75rem 0.85rem;
      border-bottom: 1px solid var(--color-border);
      font-weight: 700;
      color: var(--color-primary);
      font-size: 0.8rem;
      text-transform: uppercase;
    }
    .match-table td {
      padding: 0.75rem 0.85rem;
      border-bottom: 1px solid var(--color-border);
      vertical-align: middle;
    }
    .table-select, .table-input {
      padding: 0.4rem 0.6rem;
      font-size: 0.9rem;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-sm);
      background: #ffffff;
      font-family: var(--font-mono);
    }
    .btn-delete-leg {
      background: #fee2e2;
      color: #dc2626;
      border: 1px solid #fca5a5;
      border-radius: 4px;
      width: 28px;
      height: 28px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      font-weight: 700;
      transition: background-color 0.15s ease;
    }
    .btn-delete-leg:hover:not(:disabled) {
      background: #fecaca;
    }
    .match-controls {
      display: flex;
      gap: 0.75rem;
      margin: 1rem 0 1.5rem;
    }

    .match-summary-card {
      background: #f8fafc;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-sm);
      padding: 1.25rem;
    }
    .match-summary-card h3 {
      font-size: 1.1rem;
      margin-top: 0;
      margin-bottom: 1rem;
      color: var(--color-primary);
    }
    .match-summary-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }
    @media (min-width: 640px) {
      .match-summary-grid {
        grid-template-columns: repeat(4, 1fr);
      }
    }
    .summary-metric {
      background: #ffffff;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-sm);
      padding: 0.75rem 1rem;
    }
    .summary-highlight {
      background: #fffbeb;
      border-color: #fde68a;
    }
    .summary-label {
      display: block;
      font-size: 0.75rem;
      color: var(--color-text-muted);
      margin-bottom: 0.25rem;
    }
    .summary-val {
      display: block;
      font-size: 1.35rem;
      font-weight: 800;
      color: var(--color-primary);
      font-family: var(--font-mono);
    }
    .summary-highlight .summary-val {
      color: #b45309;
    }
    .summary-subtext {
      margin-top: 1rem;
      margin-bottom: 0;
      font-size: 0.85rem;
      color: #64748b;
    }

    /* Target Estimator Card */
    .target-output-card {
      background: #f8fafc;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-sm);
      padding: 1.5rem;
      margin-top: 0.5rem;
    }
    .target-output-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    @media (min-width: 640px) {
      .target-output-grid {
        grid-template-columns: repeat(3, 1fr);
      }
    }
    .target-output-item {
      background: #ffffff;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-sm);
      padding: 1rem;
      text-align: center;
    }
    .target-label {
      display: block;
      font-size: 0.75rem;
      color: var(--color-text-muted);
      margin-bottom: 0.35rem;
      text-transform: uppercase;
      font-weight: 700;
    }
    .target-val {
      display: block;
      font-size: 1.4rem;
      font-weight: 800;
      color: var(--color-primary);
      font-family: var(--font-mono);
    }
    .target-disclaimer {
      margin-top: 1.25rem;
      margin-bottom: 0;
      font-size: 0.85rem;
      color: #64748b;
      line-height: 1.5;
    }

    /* Content Cards (Articles / Explanations) */
    .content-card {
      background: #ffffff;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      padding: 2rem;
      margin-bottom: 2rem;
      box-shadow: var(--shadow-sm);
    }
    .content-card h2 {
      margin-top: 0;
      font-size: 1.6rem;
      color: var(--color-primary);
      border-bottom: 2px solid #f1f5f9;
      padding-bottom: 0.75rem;
      margin-bottom: 1.25rem;
    }
    .content-card h3 {
      font-size: 1.2rem;
      color: var(--color-primary);
      margin-top: 1.5rem;
      margin-bottom: 0.75rem;
    }

    /* Math Formula Display */
    .formula-box {
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: var(--radius-sm);
      padding: 1.5rem;
      margin: 1.5rem 0;
      text-align: center;
    }
    .formula-math {
      font-size: 1.3rem;
      font-weight: 700;
      display: inline-flex;
      align-items: center;
      gap: 0.75rem;
      color: var(--color-primary);
    }
    .formula-label {
      color: #b45309;
    }
    .fraction {
      display: inline-flex;
      flex-direction: column;
      vertical-align: middle;
      text-align: center;
      padding: 0 0.5rem;
    }
    .numerator {
      border-bottom: 2px solid var(--color-primary);
      padding-bottom: 0.25rem;
      font-size: 1.05rem;
    }
    .denominator {
      padding-top: 0.25rem;
      font-size: 1.05rem;
    }
    .formula-inline {
      background: #f1f5f9;
      padding: 0.85rem 1.25rem;
      border-radius: var(--radius-sm);
      margin: 1rem 0;
      font-family: var(--font-mono);
      font-size: 0.95rem;
    }

    .step-list {
      margin: 1.25rem 0;
      padding-left: 1.5rem;
    }
    .step-list li {
      margin-bottom: 1rem;
      line-height: 1.6;
    }

    /* Comparison Grids */
    .comparison-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1.25rem;
      margin: 1.5rem 0;
    }
    @media (min-width: 640px) {
      .comparison-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }
    .comparison-box {
      background: #f8fafc;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-sm);
      padding: 1.25rem;
    }
    .comparison-box h4 {
      margin-top: 0;
      margin-bottom: 0.5rem;
      font-size: 1.05rem;
      color: var(--color-primary);
    }
    .conversion-pill {
      display: inline-block;
      margin-top: 0.75rem;
      background: #e2e8f0;
      padding: 0.35rem 0.75rem;
      border-radius: 9999px;
      font-size: 0.8rem;
      font-weight: 700;
      font-family: var(--font-mono);
      color: var(--color-primary);
    }
    .conversion-summary {
      font-size: 0.95rem;
      color: var(--color-text-muted);
      margin-top: 0.5rem;
    }

    /* The Aggregation Trap */
    .trap-comparison {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1.5rem;
      margin: 1.5rem 0;
    }
    @media (min-width: 768px) {
      .trap-comparison {
        grid-template-columns: repeat(2, 1fr);
      }
    }
    .trap-box {
      border-radius: var(--radius-sm);
      padding: 1.5rem;
    }
    .trap-wrong {
      background: #fef2f2;
      border: 1px solid #fecaca;
    }
    .trap-wrong h4 {
      color: #991b1b;
      margin-top: 0;
    }
    .trap-correct {
      background: #f0fdf4;
      border: 1px solid #bbf7d0;
    }
    .trap-correct h4 {
      color: #166534;
      margin-top: 0;
    }
    .trap-calc {
      background: #ffffff;
      padding: 0.75rem;
      border-radius: var(--radius-sm);
      font-family: var(--font-mono);
      font-weight: 700;
      margin: 1rem 0;
    }
    .trap-flaw {
      font-size: 0.9rem;
      line-height: 1.5;
      margin-bottom: 0;
    }

    .guide-note {
      background: #f8fafc;
      border-left: 4px solid var(--color-accent);
      padding: 1rem 1.25rem;
      border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
      margin-top: 1.5rem;
      font-size: 0.95rem;
    }

    /* FAQ List */
    .faq-list {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
      margin-top: 1rem;
    }
    .faq-item {
      background: #f8fafc;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-sm);
      padding: 1.25rem;
    }
    .faq-item h4 {
      margin-top: 0;
      margin-bottom: 0.5rem;
      font-size: 1.05rem;
      color: var(--color-primary);
    }
    .faq-item p:last-child {
      margin-bottom: 0;
      color: #475569;
      font-size: 0.95rem;
      line-height: 1.6;
    }

    /* Related Links Grid */
    .related-links-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1rem;
      margin-top: 1.25rem;
    }
    @media (min-width: 640px) {
      .related-links-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }
    .link-card {
      background: #f8fafc;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-sm);
      padding: 1.25rem;
      text-decoration: none;
      transition: all 0.15s ease;
      display: flex;
      flex-direction: column;
    }
    .link-card:hover {
      border-color: var(--color-accent);
      box-shadow: var(--shadow-sm);
      transform: translateY(-2px);
      text-decoration: none;
    }
    .link-card h4 {
      margin-top: 0;
      margin-bottom: 0.35rem;
      font-size: 1rem;
      color: var(--color-primary);
    }
    .link-card p {
      margin: 0;
      font-size: 0.85rem;
      color: #64748b;
      line-height: 1.5;
    }

    .text-accent {
      color: #b45309;
    }
    .table-footnote {
      font-size: 0.85rem;
      color: #64748b;
      margin-top: 0.75rem;
      margin-bottom: 0;
    }
