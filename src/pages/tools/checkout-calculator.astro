---
// src/pages/tools/checkout-calculator.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AdSlot from '../../components/AdSlot.astro';
import VerificationBadge from '../../components/VerificationBadge.astro';

const pageTitle = "501 Darts Checkout Calculator: Find Optimal Out Combinations";
const pageDescription = "Interactive 501 darts checkout calculator. Enter any score from 2 to 170 to find recommended 1-dart, 2-dart, and 3-dart finishes, bogey numbers, and alternative out routes.";
const siteUrl = "https://worlddartshub.com";
const canonicalUrl = `${siteUrl}/tools/checkout-calculator/`;

const breadcrumbItems = [
  { name: 'Darts Knowledge', url: '/darts/rules/' },
  { name: 'Checkout Calculator' }
];

const calculatorSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "501 Darts Checkout Calculator",
  "url": canonicalUrl,
  "applicationCategory": "SportsApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript",
  "description": pageDescription,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "GBP"
  },
  "publisher": {
    "@type": "Organization",
    "name": "World Darts Hub",
    "url": siteUrl
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the highest possible checkout in 501 darts?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The highest possible 3-dart checkout is 170, famously known as 'The Big Fish'. It is achieved by throwing Treble 20 (60), Treble 20 (60), and finishing on the 50-point red inner Bullseye."
      }
    },
    {
      "@type": "Question",
      "name": "What are the seven bogey numbers in darts?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Bogey numbers are scores between 159 and 169 that cannot be checked out in three darts under any legal combination. The seven bogey numbers are 159, 162, 163, 165, 166, 168, and 169."
      }
    },
    {
      "@type": "Question",
      "name": "What is the highest two-dart finish in darts?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The highest two-dart checkout is 110, achieved with Treble 20 (60 points) followed by the inner Bullseye (50 points)."
      }
    },
    {
      "@type": "Question",
      "name": "Why can you not checkout a score of 1 in darts?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Under official double-out rules, you must finish on an outer double (minimum 2 points for Double 1) or the inner bullseye (50 points). Leaving a remaining score of 1 requires a 0.5 segment, which does not exist, triggering an automatic bust."
      }
    },
    {
      "@type": "Question",
      "name": "Does the calculator prioritize pro checkout preferences?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. The calculator prioritizes favorite professional routes that leave favorable doubles (such as Double 20, Double 16, and Double 8) and provides common alternative routes where multiple accepted paths exist."
      }
    }
  ]
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
>
  <script type="application/ld+json" set:html={JSON.stringify(calculatorSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <header class="calculator-hero">
    <div class="container">
      <Breadcrumbs items={breadcrumbItems} />
      <div class="badge-group">
        <span class="badge badge-accent">INTERACTIVE TOOL</span>
        <span class="badge">501 FINISHING MATRIX</span>
      </div>
      <h1>501 Darts Checkout Calculator</h1>
      <p class="hero-lead">
        Enter your remaining score (2 to 170) to instantly calculate recommended 1-dart, 2-dart, or 3-dart checkout routes. Discover conventional alternative paths, verify double-out legality, and identify bogey numbers.
      </p>
      <div class="meta-row">
        <VerificationBadge />
        <span class="meta-item">Official DRA Double-Out Rules Compliant</span>
        <span class="meta-item">Instant Client-Side Calculation</span>
      </div>
    </div>
  </header>

  <div class="container content-layout">
    <main class="main-column" id="main-content">
      <!-- Interactive Calculator Card -->
      <section class="calculator-card" aria-label="501 Checkout Calculator">
        <div class="calc-header">
          <h2>Enter Remaining Score</h2>
          <span class="calc-hint">Valid 3-dart out-shots: 2 to 170</span>
        </div>

        <form class="calc-form" id="checkout-form" onsubmit="event.preventDefault();">
          <div class="input-row">
            <div class="input-wrapper">
              <label for="score-input" class="input-label">Remaining Target (Points)</label>
              <div class="input-group">
                <span class="input-prefix">🎯</span>
                <input
                  type="number"
                  id="score-input"
                  name="score"
                  class="score-input"
                  min="1"
                  max="501"
                  step="1"
                  value="170"
                  placeholder="e.g. 170"
                  required
                />
              </div>
            </div>
            <div class="action-buttons">
              <button type="submit" id="calc-btn" class="btn btn-primary">
                Calculate Checkout &rarr;
              </button>
              <button type="button" id="reset-btn" class="btn btn-secondary">
                Reset
              </button>
            </div>
          </div>

          <!-- Quick Presets -->
          <div class="presets-section">
            <span class="presets-title">Popular Target Presets:</span>
            <div class="presets-grid">
              <button type="button" class="preset-pill" data-score="170">170 (Big Fish)</button>
              <button type="button" class="preset-pill" data-score="167">167 (Bull)</button>
              <button type="button" class="preset-pill" data-score="164">164 (Bull)</button>
              <button type="button" class="preset-pill" data-score="161">161 (Bull)</button>
              <button type="button" class="preset-pill" data-score="121">121</button>
              <button type="button" class="preset-pill" data-score="120">120 (Shanghai)</button>
              <button type="button" class="preset-pill" data-score="100">100 (Ton Out)</button>
              <button type="button" class="preset-pill" data-score="80">80</button>
              <button type="button" class="preset-pill" data-score="60">60</button>
              <button type="button" class="preset-pill" data-score="50">50 (Bull)</button>
              <button type="button" class="preset-pill" data-score="40">40 (Tops)</button>
              <button type="button" class="preset-pill" data-score="32">32 (D16)</button>
              <button type="button" class="preset-pill alert-pill" data-score="169">169 (Bogey)</button>
              <button type="button" class="preset-pill alert-pill" data-score="1">1 (Bust)</button>
            </div>
          </div>
        </form>

        <!-- Results Display Panel -->
        <div class="result-panel" id="result-panel" aria-live="polite">
          <div class="result-header">
            <div class="status-indicator">
              <span class="badge" id="res-badge">VALID 3-DART CHECKOUT</span>
              <span class="score-display">Score: <strong id="res-target-number">170</strong></span>
            </div>
            <span class="darts-needed-tag" id="res-darts-needed">3 Darts Required</span>
          </div>

          <!-- Primary Route Sequence -->
          <div class="route-display" id="res-route-container">
            <span class="route-label">Recommended Route:</span>
            <div class="darts-sequence" id="res-darts-sequence">
              <!-- Rendered via JavaScript -->
            </div>
          </div>

          <!-- Arithmetic Breakdown -->
          <div class="arithmetic-card" id="res-arithmetic-card">
            <span class="arithmetic-icon">📐</span>
            <span class="arithmetic-text" id="res-arithmetic-text">
              60 (T20) + 60 (T20) + 50 (Bullseye) = 170 Total Points
            </span>
          </div>

          <!-- Alternative Route Box -->
          <div class="alternative-box" id="res-alt-box" style="display: none;">
            <span class="alt-title">Alternative Pro Route:</span>
            <span class="alt-sequence" id="res-alt-sequence"></span>
          </div>

          <!-- Tactical Note Box -->
          <div class="tactical-note-box" id="res-note-box">
            <span class="note-icon">💡</span>
            <span class="note-text" id="res-note-text">
              The Big Fish — Maximum possible checkout in professional darts.
            </span>
          </div>
        </div>
      </section>

      <AdSlot slotType="in-feed" id="checkout-calc-infeed" />

      <!-- Educational Section: How It Works -->
      <section class="content-card">
        <h2>How 501 Darts Checkouts Work</h2>
        <p>
          In professional 501 darts under <a href="/darts/rules/">DRA tournament rules</a>, a leg concludes only when a player reduces their score to exactly zero, with the decisive final dart landing in an outer double or the 50-point red inner bullseye.
        </p>
        <p>
          Finishing involves strict mathematical parameters:
        </p>
        <ul>
          <li><strong>Maximum 3-Dart Finish (170):</strong> Treble 20 (60) + Treble 20 (60) + Bullseye (50) = 170. Check out <a href="/darts/why-is-170-the-highest-checkout/">why 170 is the highest checkout</a> for full historical analysis.</li>
          <li><strong>Maximum 2-Dart Finish (110):</strong> Treble 20 (60) + Bullseye (50) = 110.</li>
          <li><strong>Maximum 1-Dart Finish (50):</strong> The red inner bullseye (50 points). Outer doubles range from D1 (2 points) up to D20 (40 points).</li>
        </ul>
      </section>

      <!-- Educational Section: Bogey Numbers -->
      <section class="content-card">
        <h2>The Seven Bogey Numbers (159 to 169)</h2>
        <p>
          Between 159 and 169, there are exactly seven scores that <strong>cannot be checked out in three darts</strong> under any legal mathematical combination. These are known as <a href="/darts/bogey-numbers-in-darts/">bogey numbers in darts</a>:
        </p>

        <div class="bogey-display-grid">
          <div class="bogey-card"><strong>159</strong><span>Max 2 trebles (120) leaves 39 (No double)</span></div>
          <div class="bogey-card"><strong>162</strong><span>162 &minus; 120 = 42 (Requires 2 darts)</span></div>
          <div class="bogey-card"><strong>163</strong><span>163 &minus; 120 = 43 (Requires 2 darts)</span></div>
          <div class="bogey-card"><strong>165</strong><span>165 &minus; 120 = 45 (Requires 2 darts)</span></div>
          <div class="bogey-card"><strong>166</strong><span>166 &minus; 120 = 46 (Requires 2 darts)</span></div>
          <div class="bogey-card"><strong>168</strong><span>168 &minus; 120 = 48 (Requires 2 darts)</span></div>
          <div class="bogey-card"><strong>169</strong><span>169 &minus; 120 = 49 (Requires 2 darts)</span></div>
        </div>

        <p style="margin-top: 1rem;">
          If your score sits on a bogey number, our calculator will instantly notify you and recommend throwing a scoring visit (targeting Treble 20) to leave an active double next turn.
        </p>
      </section>

      <!-- Educational Section: The Bust Rule -->
      <section class="content-card">
        <h2>Why You Cannot Check Out 1 Point (The Bust Rule)</h2>
        <p>
          New players often ask why a score of 1 cannot be checked out. Because the lowest double on a dartboard is Double 1 (worth 2 points), reaching zero from 1 would require hitting a "0.5 point" segment.
        </p>
        <p>
          Because there is no half-point segment on a board, leaving a remaining score of 1 triggers an automatic bust under DRA Rule 5.4. Your visit ends immediately and your score resets to what it was at the beginning of that turn. Read our comprehensive guide on <a href="/darts/bust-rule-in-darts/">what is a bust in darts</a> for complete penalty rules.
        </p>
      </section>

      <!-- Section: FAQ -->
      <section class="content-card">
        <h2>Frequently Asked Questions About Darts Checkouts</h2>
        <div class="faq-list">
          <div class="faq-item">
            <h3>What is the highest possible checkout in 501 darts?</h3>
            <p>
              The highest possible 3-dart checkout is 170, famously known as 'The Big Fish'. It is achieved by throwing Treble 20 (60), Treble 20 (60), and finishing on the 50-point red inner Bullseye.
            </p>
          </div>

          <div class="faq-item">
            <h3>What are the seven bogey numbers in darts?</h3>
            <p>
              Bogey numbers are scores between 159 and 169 that cannot be checked out in three darts under any legal combination. The seven bogey numbers are 159, 162, 163, 165, 166, 168, and 169.
            </p>
          </div>

          <div class="faq-item">
            <h3>What is the highest two-dart finish in darts?</h3>
            <p>
              The highest two-dart checkout is 110, achieved with Treble 20 (60 points) followed by the inner Bullseye (50 points).
            </p>
          </div>

          <div class="faq-item">
            <h3>Why can you not checkout a score of 1 in darts?</h3>
            <p>
              Under official double-out rules, you must finish on an outer double (minimum 2 points for Double 1) or the inner bullseye (50 points). Leaving a remaining score of 1 requires a 0.5 segment, which does not exist, triggering an automatic bust.
            </p>
          </div>

          <div class="faq-item">
            <h3>Does the calculator prioritize pro checkout preferences?</h3>
            <p>
              Yes. The calculator prioritizes favorite professional routes that leave favorable doubles (such as Double 20, Double 16, and Double 8) and provides common alternative routes where multiple accepted paths exist.
            </p>
          </div>
        </div>
      </section>

      <!-- Section: Related Links -->
      <section class="content-card">
        <h2>Related Tools & Finishing Guides</h2>
        <div class="links-grid">
          <a href="/darts/checkout-chart/" class="link-card">
            <strong>Static 501 Checkout Chart</strong>
            <span>Complete printed reference guide from 170 down to 41.</span>
          </a>
          <a href="/tools/average-calculator/" class="link-card">
            <strong>Darts Average Calculator</strong>
            <span>Calculate 3-dart averages, points per dart, and match stats.</span>
          </a>
          <a href="/darts/bogey-numbers-in-darts/" class="link-card">
            <strong>Bogey Numbers in Darts</strong>
            <span>Explore all 7 mathematically impossible checkouts under 170.</span>
          </a>
          <a href="/darts/rules/" class="link-card">
            <strong>Official 501 Darts Rules</strong>
            <span>DRA tournament regulations, board dimensions, and scoring.</span>
          </a>
          <a href="/darts/bust-rule-in-darts/" class="link-card">
            <strong>What Is a Bust in Darts?</strong>
            <span>Score reset penalties, leaving 1, and tactical bust mechanics.</span>
          </a>
          <a href="/darts/double-in-double-out/" class="link-card">
            <strong>Double-In Double-Out Rules</strong>
            <span>World Grand Prix double-start format and tactical strategies.</span>
          </a>
        </div>
      </section>
    </main>

    <!-- Sidebar -->
    <aside class="sidebar">
      <div class="sidebar-card">
        <h3>Finishing Rules Quick Reference</h3>
        <ul class="fact-list">
          <li><strong>Max 3-Dart Out:</strong> 170 (T20, T20, Bull)</li>
          <li><strong>Max 2-Dart Out:</strong> 110 (T20, Bull)</li>
          <li><strong>Max 1-Dart Out:</strong> 50 (Bullseye)</li>
          <li><strong>Lowest Double Out:</strong> 2 (Double 1)</li>
          <li><strong>Finishing Rule:</strong> Outer Double or Bull</li>
          <li><strong>Total Bogey Numbers:</strong> Exactly 7</li>
          <li><strong>1 Point Remaining:</strong> Automatic Bust</li>
        </ul>
      </div>

      <AdSlot slotType="rectangle" id="checkout-calc-sidebar" />

      <div class="sidebar-card">
        <h3>Pro Finishing Strategy</h3>
        <p style="font-size: 0.88rem; color: #475569; line-height: 1.5; margin-bottom: 0.5rem;">
          Elite players always aim to leave even double combinations—primarily <strong>Double 16</strong> or <strong>Double 20 (Tops)</strong>. If a dart misses inside Double 16, it leaves Single 16 and a clean attempt at Double 8 without losing a visit!
        </p>
      </div>
    </aside>
  </div>
</BaseLayout>

<script>
  // Complete deterministic 501 checkout engine
  const BOGEYS = [159, 162, 163, 165, 166, 168, 169];

  const CHECKOUTS: Record<number, { primary: string[]; alt: string[] | null; note: string }> = {
