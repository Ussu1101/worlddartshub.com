  function getDartScore(dart: string): number {
    if (dart === 'Bull' || dart === 'Bullseye') return 50;
    if (dart === '25' || dart === 'Outer Bull') return 25;
    const match = dart.match(/^([STD])(\d+)$/);
    if (!match) return 0;
    const multiplier = match[1] === 'S' ? 1 : match[1] === 'D' ? 2 : 3;
    return multiplier * parseInt(match[2], 10);
  }

  function getDartDescription(dart: string): string {
    if (dart === 'Bull' || dart === 'Bullseye') return 'Bullseye (50)';
    if (dart === '25') return 'Outer Bull (25)';
    const match = dart.match(/^([STD])(\d+)$/);
    if (!match) return dart;
    const type = match[1] === 'S' ? 'Single' : match[1] === 'D' ? 'Double' : 'Treble';
    return `${type} ${match[2]}`;
  }

  function updateCalculator(score: number) {
    const resBadge = document.getElementById('res-badge') as HTMLElement;
    const resTargetNumber = document.getElementById('res-target-number') as HTMLElement;
    const resDartsNeeded = document.getElementById('res-darts-needed') as HTMLElement;
    const resDartsSequence = document.getElementById('res-darts-sequence') as HTMLElement;
    const resArithmeticText = document.getElementById('res-arithmetic-text') as HTMLElement;
    const resArithmeticCard = document.getElementById('res-arithmetic-card') as HTMLElement;
    const resAltBox = document.getElementById('res-alt-box') as HTMLElement;
    const resAltSequence = document.getElementById('res-alt-sequence') as HTMLElement;
    const resNoteText = document.getElementById('res-note-text') as HTMLElement;

    if (!resBadge || !resTargetNumber) return;

    resTargetNumber.textContent = isNaN(score) ? '?' : score.toString();

    // 1. Boundary & validation checks
    if (isNaN(score) || score <= 0) {
      resBadge.textContent = 'INVALID INPUT';
      resBadge.className = 'badge badge-error';
      resDartsNeeded.textContent = 'Error';
      resDartsSequence.innerHTML = '<span class="status-error-text">Please enter a valid positive number between 2 and 170.</span>';
      resArithmeticCard.style.display = 'none';
      resAltBox.style.display = 'none';
      resNoteText.textContent = 'Darts target scores must be positive integers.';
      return;
    }

    // 2. Score = 1 (Automatic Bust)
    if (score === 1) {
      resBadge.textContent = 'AUTOMATIC BUST (1 REMAINING)';
      resBadge.className = 'badge badge-error';
      resDartsNeeded.textContent = 'Bust (0 Darts Possible)';
      resDartsSequence.innerHTML = `
        <div class="bust-notice">
          <span class="bust-title">⚠️ Score of 1 Cannot Be Checked Out</span>
          <p>Under official DRA double-out rules, you must finish on an outer double (minimum 2 points for D1) or inner bull (50 points). There is no 0.5 segment on a dartboard. Reducing your score to 1 is an instant bust!</p>
        </div>
      `;
      resArithmeticCard.style.display = 'none';
      resAltBox.style.display = 'none';
      resNoteText.textContent = 'DRA Rule 5.4: If a player leaves 1 point remaining, their visit terminates and their score resets to their starting total.';
      return;
    }

    // 3. Score > 170 (Setup required)
    if (score > 170) {
      resBadge.textContent = 'SETUP VISIT REQUIRED';
      resBadge.className = 'badge badge-warning';
      resDartsNeeded.textContent = '4+ Darts Required';
      resDartsSequence.innerHTML = `
        <div class="setup-notice">
          <span class="setup-title">🎯 Score Exceeds 3-Dart Maximum</span>
          <p>The highest possible 3-dart checkout is 170 (T20, T20, Bull). Any score of ${score} requires at least one setup visit to reach a finishable out-shot.</p>
        </div>
      `;
      resArithmeticCard.style.display = 'block';
      const pointsTo170 = score - 170;
      resArithmeticText.textContent = `Score is ${pointsTo170} points above the 170 maximum out-shot threshold. Aim for maximum scoring (T20 bed).`;
      resAltBox.style.display = 'none';
      resNoteText.textContent = `A standard 180 visit reduces ${score} to ${score - 180 <= 0 ? 0 : score - 180}.`;
      return;
    }

    // 4. Bogey Number Check (159, 162, 163, 165, 166, 168, 169)
    if (BOGEYS.includes(score)) {
      resBadge.textContent = 'BOGEY NUMBER (NO 3-DART OUT)';
      resBadge.className = 'badge badge-bogey';
      resDartsNeeded.textContent = 'Impossible in 3 Darts';
      resDartsSequence.innerHTML = `
        <div class="bogey-notice">
          <span class="bogey-title">🚫 Bogey Number: Mathematical Dead-End</span>
          <p>Score ${score} is one of the seven recognized bogey numbers. Two trebles leave a remaining total that cannot be completed on a legal double with the third dart.</p>
        </div>
      `;
      resArithmeticCard.style.display = 'block';
      resArithmeticText.textContent = `Mathematical Proof: Even hitting T20 + T20 (120) leaves ${score - 120}, which cannot be finished on a single dart.`;
      resAltBox.style.display = 'none';
      resNoteText.textContent = `Tactical Recommendation: Throw your first dart at Treble 20 to set up a finish next visit. If you hit Single 20, re-adjust!`;
      return;
    }

    // 5. Valid Checkout (2 to 170)
    const data = CHECKOUTS[score];
    if (data) {
      resBadge.textContent = 'VALID DOUBLE-OUT FINISH';
      resBadge.className = 'badge badge-success';

      const dartsCount = data.primary.length;
      resDartsNeeded.textContent = `${dartsCount} Dart${dartsCount > 1 ? 's' : ''} Required`;

      // Render primary darts badges
      resDartsSequence.innerHTML = data.primary.map((dart, index) => {
        let badgeClass = 'dart-badge';
        if (dart.startsWith('T')) badgeClass += ' dart-treble';
        else if (dart.startsWith('D') || dart === 'Bull') badgeClass += ' dart-double';
        else badgeClass += ' dart-single';

        const isLast = index === dartsCount - 1;
        return `
          <div class="dart-step">
            <span class="dart-step-num">Dart ${index + 1}</span>
            <div class="${badgeClass}">${dart}</div>
            <span class="dart-desc">${getDartDescription(dart)}</span>
          </div>
          ${!isLast ? '<span class="dart-arrow">&rarr;</span>' : ''}
        `;
      }).join('');

      // Arithmetic text
      resArithmeticCard.style.display = 'block';
      const breakdown = data.primary.map(d => `${getDartScore(d)} (${d})`).join(' + ');
      resArithmeticText.textContent = `${breakdown} = ${score} Points (Clean Finish)`;

      // Alternative route
      if (data.alt && data.alt.length > 0) {
        resAltBox.style.display = 'block';
        resAltSequence.innerHTML = data.alt.map(d => `<span class="alt-pill">${d}</span>`).join(' &rarr; ');
      } else {
        resAltBox.style.display = 'none';
      }

      // Tactical note
      resNoteText.textContent = data.note || 'Standard professional finishing route.';
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('checkout-form');
    const input = document.getElementById('score-input') as HTMLInputElement;
    const resetBtn = document.getElementById('reset-btn');
    const presetPills = document.querySelectorAll('.preset-pill');

    if (form && input) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const score = parseInt(input.value.trim(), 10);
        updateCalculator(score);
      });

      input.addEventListener('input', () => {
        const val = input.value.trim();
        if (val === '') return;
        const score = parseInt(val, 10);
        updateCalculator(score);
      });
    }

    if (resetBtn && input) {
      resetBtn.addEventListener('click', () => {
        input.value = '170';
        updateCalculator(170);
        input.focus();
      });
    }

    presetPills.forEach((pill) => {
      pill.addEventListener('click', () => {
        const scoreVal = pill.getAttribute('data-score');
        if (scoreVal && input) {
          input.value = scoreVal;
          updateCalculator(parseInt(scoreVal, 10));
        }
      });
    });

    // Run initial calculation on page load (170)
    updateCalculator(170);
  });
</script>

