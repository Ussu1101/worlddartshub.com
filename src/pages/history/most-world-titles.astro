---
// src/pages/history/most-world-titles.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import VerificationBadge from '../../components/VerificationBadge.astro';

const pageTitle = "Most World Darts Championship Titles";
const pageDescription = "Who has won the most World Darts Championship titles? From Phil Taylor's 16 crowns to Michael van Gerwen, Eric Bristow, and Raymond van Barneveld.";
const siteUrl = "https://worlddartshub.com";
const canonicalUrl = `${siteUrl}/history/most-world-titles/`;

const breadcrumbItems = [
  { name: 'Home', url: '/' },
  { name: 'History', url: '/history/' },
  { name: 'Most World Titles', url: '/history/most-world-titles/' }
];

const articleSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "@id": `${canonicalUrl}#article`,
      "isPartOf": {
        "@type": "WebSite",
        "@id": `${siteUrl}/#website`,
        "name": "World Darts Hub",
        "url": siteUrl
      },
      "headline": pageTitle,
      "description": pageDescription,
      "url": canonicalUrl,
      "inLanguage": "en-GB",
      "datePublished": "2026-10-19T00:00:00+00:00",
      "dateModified": "2026-10-19T00:00:00+00:00",
      "mainEntityOfPage": canonicalUrl,
      "publisher": {
        "@type": "Organization",
        "name": "World Darts Hub",
        "url": siteUrl
      }
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonicalUrl}#breadcrumb`,
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": `${siteUrl}/`
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "History",
          "item": `${siteUrl}/history/`
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Most World Titles",
          "item": canonicalUrl
        }
      ]
    },
    {
      "@type": "FAQPage",
      "@id": `${canonicalUrl}#faq`,
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Who has won the most World Darts Championship titles in history?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Phil Taylor holds the all-time record with 16 World Championships. He won 2 BDO world titles (1990, 1992) and 14 PDC World Championships between 1995 and 2013."
          }
        },
        {
          "@type": "Question",
          "name": "How many players have won multiple PDC World Championships?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Seven players have won multiple PDC World Championships: Phil Taylor (14), Michael van Gerwen (3), Gary Anderson (2), Adrian Lewis (2), Peter Wright (2), John Part (2), and Luke Littler (2)."
          }
        },
        {
          "@type": "Question",
          "name": "Which players have won world titles in both the BDO and PDC?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Three players have captured world titles in both organisations: Phil Taylor (2 BDO, 14 PDC), Raymond van Barneveld (4 BDO, 1 PDC), and John Part (1 BDO, 2 PDC)."
          }
        },
        {
          "@type": "Question",
          "name": "Did Eric Bristow ever win a PDC World Championship?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No, all five of Eric Bristow's world championship victories came in the BDO (1980, 1981, 1984, 1985, 1986). While Bristow was a founding player of the WDC/PDC, his best PDC World Championship result was reaching the semi-finals in 1997."
          }
        }
      ]
    }
  ]
};
---

<BaseLayout 
  title={pageTitle} 
  description={pageDescription}
  schema={articleSchema}
  canonicalUrl={canonicalUrl}
>
  <Breadcrumbs items={breadcrumbItems} />

  <header class="page-header">
    <div class="container">
      <div class="badge-row">
        <span class="badge badge-accent">HISTORICAL RECORDS</span>
        <span class="badge">CHAMPIONS LEADERBOARD</span>
      </div>
      <h1>Most World Darts Championship Titles</h1>
      <p class="lead-text">
        Since the inaugural world championship in 1978, only an elite fraternity of players have captured multiple world titles. From Phil Taylor's unmatched 16 crowns to the multi-title dynasties of Eric Bristow, Raymond van Barneveld, and Michael van Gerwen, here is the complete historical leaderboard.
      </p>
    </div>
  </header>

  <div class="container content-layout">
    <main class="main-column">
      <VerificationBadge verifiedDate="October 2026" topic="PDC & BDO World Championship Records & Title Counts" />

      <!-- Overview Section -->
      <section class="content-card">
        <h2>The Pantheon of Multiple World Champions</h2>
        <p>
          Lifting a world championship trophy once represents the pinnacle of a professional dart player's career. Repeating that feat requires sustained technical brilliance, mental resilience, and the capacity to adapt across evolving generations of challengers.
        </p>
        <p>
          World championship darts comprises two distinct lineages: the original BDO World Championship (inaugurated in 1978 at the Heart of the Midlands Club) and the PDC World Championship (formed following the 1993 split). To inspect year-by-year tournament records, consult our comprehensive <a href="/history/roll-of-honour/">World Darts Championship Roll of Honour</a> and our complete guide to <a href="/history/world-championship-finals/">World Championship Finals and Final Scores</a>.
        </p>
      </section>

      <!-- All-Time Leaderboard Table -->
      <section class="content-card">
        <h2>All-Time Leaderboard: Multiple World Championship Winners</h2>
        <p>
          The table below tracks every player who has claimed two or more world titles across the PDC and BDO/WDF codes:
        </p>

        <div class="table-responsive">
          <table class="data-table">
            <thead>
              <tr>
                <th>Player</th>
                <th>Total Titles</th>
                <th>PDC Titles</th>
                <th>BDO Titles</th>
                <th>Years Won</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>Phil Taylor</strong></td>
                <td><strong>16</strong></td>
                <td>14</td>
                <td>2</td>
                <td>1990, 1992 (BDO); 1995–2002, 2004–2006, 2009, 2010, 2013 (PDC)</td>
              </tr>
              <tr>
                <td><strong>Eric Bristow</strong></td>
                <td><strong>5</strong></td>
                <td>0</td>
                <td>5</td>
                <td>1980, 1981, 1984, 1985, 1986 (BDO)</td>
              </tr>
              <tr>
                <td><strong>Raymond van Barneveld</strong></td>
                <td><strong>5</strong></td>
                <td>1</td>
                <td>4</td>
                <td>1998, 1999, 2003, 2005 (BDO); 2007 (PDC)</td>
              </tr>
              <tr>
                <td><strong>Michael van Gerwen</strong></td>
                <td><strong>3</strong></td>
                <td>3</td>
                <td>0</td>
                <td>2014, 2017, 2019 (PDC)</td>
              </tr>
              <tr>
                <td><strong>John Lowe</strong></td>
                <td><strong>3</strong></td>
                <td>0</td>
                <td>3</td>
                <td>1979, 1987, 1993 (BDO)</td>
              </tr>
              <tr>
                <td><strong>Martin Adams</strong></td>
                <td><strong>3</strong></td>
                <td>0</td>
                <td>3</td>
                <td>2007, 2010, 2011 (BDO)</td>
              </tr>
              <tr>
                <td><strong>Glen Durrant</strong></td>
                <td><strong>3</strong></td>
                <td>0</td>
                <td>3</td>
                <td>2017, 2018, 2019 (BDO)</td>
              </tr>
              <tr>
                <td><strong>John Part</strong></td>
                <td><strong>3</strong></td>
                <td>2</td>
                <td>1</td>
                <td>1994 (BDO); 2003, 2008 (PDC)</td>
              </tr>
              <tr>
                <td><strong>Gary Anderson</strong></td>
                <td><strong>2</strong></td>
                <td>2</td>
                <td>0</td>
                <td>2015, 2016 (PDC)</td>
              </tr>
              <tr>
                <td><strong>Adrian Lewis</strong></td>
                <td><strong>2</strong></td>
                <td>2</td>
                <td>0</td>
                <td>2011, 2012 (PDC)</td>
              </tr>
              <tr>
                <td><strong>Peter Wright</strong></td>
                <td><strong>2</strong></td>
                <td>2</td>
                <td>0</td>
                <td>2020, 2022 (PDC)</td>
              </tr>
              <tr>
                <td><strong>Luke Littler</strong></td>
                <td><strong>2</strong></td>
                <td>2</td>
                <td>0</td>
                <td>2025, 2026 (PDC)</td>
              </tr>
              <tr>
                <td><strong>Jocky Wilson</strong></td>
                <td><strong>2</strong></td>
                <td>0</td>
                <td>2</td>
                <td>1982, 1989 (BDO)</td>
              </tr>
              <tr>
                <td><strong>Ted Hankey</strong></td>
                <td><strong>2</strong></td>
                <td>0</td>
                <td>2</td>
                <td>2000, 2009 (BDO)</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- The Phil Taylor Dominance -->
      <section class="content-card">
        <h2>Phil Taylor: The Undisputed 16-Time Champion</h2>
        <p>
          Phil "The Power" Taylor's haul of 16 world titles stands as one of the most unbreakable records in global sport. Having learned the game in Stoke-on-Trent under the mentorship of Eric Bristow, Taylor captured his first world title at the 1990 BDO World Championship, thrashing Bristow 6–1 in the final.
        </p>
        <p>
          Following the establishment of the World Darts Council (later the PDC), Taylor embarked on an extraordinary sequence of dominance at the Circus Tavern in Purfleet. Between 1995 and 2002, Taylor won eight consecutive world titles. He reached 14 consecutive PDC finals from 1994 to 2007, and claimed his fourteenth PDC crown in 2013 at Alexandra Palace, defeating Michael van Gerwen 7–4. Across his 29 career world championship appearances, Taylor compiled a 110–13 match record.
        </p>
      </section>

      <!-- The Five-Time Legends -->
      <section class="content-card">
        <h2>Five-Time Titans: Eric Bristow &amp; Raymond van Barneveld</h2>
        <p>
          Sharing second place on the all-time list with five titles apiece are two defining icons from different eras:
        </p>
        <div class="feature-box">
          <h3>Eric Bristow (5 Titles: 1980, 1981, 1984, 1985, 1986)</h3>
          <p>
            Bristow was the catalyst for the televised darts revolution. Combining swaggering stage charisma with lethal finishing, Bristow contested ten BDO finals, winning five. His consistency was unmatched in the 1980s, establishing darts as primetime television entertainment. Read more in our history of <a href="/history/bdo-world-champions/">BDO world champions</a>.
          </p>
        </div>
        <div class="feature-box">
          <h3>Raymond van Barneveld (5 Titles: 1998, 1999, 2003, 2005 BDO; 2007 PDC)</h3>
          <p>
            The Dutch pioneer broke the British monopoly on world darts by winning four Lakeside crowns before making a high-profile switch to the PDC in 2006. In January 2007, "Barney" faced Phil Taylor at the Circus Tavern in what is universally acclaimed as the greatest final in darts history, triumphing 7–6 in a sudden-death leg to capture his fifth world championship.
          </p>
        </div>
      </section>

      <!-- The Three-Title Tier -->
      <section class="content-card">
        <h2>The Three-Title Club: Van Gerwen, Lowe, Adams, Durrant &amp; Part</h2>
        <p>
          Five players hold three world titles, each achieving the feat through distinct historical narratives:
        </p>
        <ul>
          <li><strong>Michael van Gerwen (3 PDC):</strong> The defining force of the modern era, Van Gerwen won at Alexandra Palace in 2014, 2017, and 2019, posting the highest winning tournament average in history (106.96 in 2017).</li>
          <li><strong>John Lowe (3 BDO):</strong> "Old Stoneface" achieved the unique distinction of winning world titles across three separate decades (1979, 1987, 1993), demonstrating unprecedented longevity.</li>
          <li><strong>Martin Adams (3 BDO):</strong> "Wolfie" captured Lakeside titles in 2007, 2010, and 2011, serving as the figurehead of the BDO circuit for more than two decades.</li>
          <li><strong>Glen Durrant (3 BDO):</strong> "Duzza" completed an historic Lakeside three-peat between 2017 and 2019 before transitioning to the PDC and winning the Premier League in 2020.</li>
          <li><strong>John Part (1 BDO, 2 PDC):</strong> Canada's "Darth Maple" broke new ground as the first non-European world champion (1994 BDO), later winning PDC titles at both the Circus Tavern (2003) and Alexandra Palace (2008).</li>
        </ul>
        <p>
          For a full year-by-year breakdown of all champions, runner-ups, and tournament statistics, visit our official <a href="/history/roll-of-honour/">World Darts Championship Roll of Honour</a>.
        </p>
      </section>

      <!-- FAQ Section -->
      <section class="content-card faq-section">
        <h2>Frequently Asked Questions: Most World Titles</h2>

        <div class="faq-item">
          <h3>Who has won the most World Darts Championship titles in history?</h3>
          <p>
            Phil Taylor holds the all-time record with 16 World Championships. He won 2 BDO world titles (1990, 1992) and 14 PDC World Championships between 1995 and 2013.
          </p>
        </div>

        <div class="faq-item">
          <h3>How many players have won multiple PDC World Championships?</h3>
          <p>
            Seven players have won multiple PDC World Championships: Phil Taylor (14), Michael van Gerwen (3), Gary Anderson (2), Adrian Lewis (2), Peter Wright (2), John Part (2), and Luke Littler (2).
          </p>
        </div>

        <div class="faq-item">
          <h3>Which players have won world titles in both the BDO and PDC?</h3>
          <p>
            Three players have captured world titles in both organisations: Phil Taylor (2 BDO, 14 PDC), Raymond van Barneveld (4 BDO, 1 PDC), and John Part (1 BDO, 2 PDC).
          </p>
        </div>

        <div class="faq-item">
          <h3>Did Eric Bristow ever win a PDC World Championship?</h3>
          <p>
            No, all five of Eric Bristow's world championship victories came in the BDO (1980, 1981, 1984, 1985, 1986). While Bristow was a founding player of the WDC/PDC, his best PDC World Championship result was reaching the semi-finals in 1997.
          </p>
        </div>
      </section>
    </main>
  </div>
</BaseLayout>

<style>
  .page-header {
    background: linear-gradient(135deg, #0f172a, #1e293b);
    color: #fff;
    padding: 3rem 0;
    margin-bottom: 2rem;
  }
  .badge-row {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }
  .badge {
    background: rgba(255, 255, 255, 0.15);
    padding: 0.25rem 0.75rem;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .badge-accent {
    background: var(--color-brand-accent, #c99700);
    color: #000;
  }
  .page-header h1 {
    color: #ffffff !important;
    font-size: 2.2rem;
    font-weight: 800;
    margin: 0 0 1rem 0;
    line-height: 1.2;
  }
  .lead-text {
    font-size: 1.15rem;
    line-height: 1.6;
    color: #cbd5e1;
    max-width: 850px;
    margin: 0;
  }
  .content-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    padding-bottom: 4rem;
  }
  .content-card {
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 2rem;
    margin-bottom: 2rem;
  }
  .content-card h2 {
    font-size: 1.5rem;
    font-weight: 700;
    margin-top: 0;
    margin-bottom: 1rem;
    color: #0f172a;
    border-bottom: 2px solid #f1f5f9;
    padding-bottom: 0.5rem;
  }
  .content-card h3 {
    font-size: 1.2rem;
    font-weight: 600;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
    color: #1e293b;
  }
  .content-card p, .content-card li {
    color: #334155;
    line-height: 1.7;
    font-size: 1rem;
  }
  .content-card a {
    color: #0284c7;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .content-card a:hover {
    color: #0369a1;
  }
  .feature-box {
    background: #f8fafc;
    border-left: 4px solid var(--color-brand-accent, #c99700);
    padding: 1.25rem 1.5rem;
    border-radius: 0 8px 8px 0;
    margin: 1.5rem 0;
  }
  .feature-box h3 {
    margin-top: 0;
  }
  .table-responsive {
    overflow-x: auto;
    margin: 1.5rem 0;
  }
  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
    text-align: left;
  }
  .data-table th, .data-table td {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid #e2e8f0;
  }
  .data-table th {
    background: #f8fafc;
    color: #0f172a;
    font-weight: 700;
  }
  .faq-section .faq-item {
    border-bottom: 1px solid #e2e8f0;
    padding: 1.25rem 0;
  }
  .faq-section .faq-item:last-child {
    border-bottom: none;
  }
  .faq-section h3 {
    margin: 0 0 0.5rem 0;
    font-size: 1.15rem;
    color: #0f172a;
  }
  .faq-section p {
    margin: 0;
    color: #475569;
  }
</style>
