---
// src/pages/history/roll-of-honour.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AdSlot from '../../components/AdSlot.astro';
import VerificationBadge from '../../components/VerificationBadge.astro';
import finalsData from '../../data/world-championship-finals.json';

const pageTitle = "World Darts Championship Roll of Honour: Winners List";
const pageDescription = "Complete Roll of Honour for the World Darts Championship. Verified list of all PDC champions (1994–2026), runner-ups, final scores, and venues.";
const siteUrl = "https://worlddartshub.com";

const breadcrumbItems = [
  { name: 'History', url: '/history/' },
  { name: 'Roll of Honour', url: '/history/roll-of-honour/' }
];

const rollOfHonourSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "name": pageTitle,
      "description": pageDescription,
      "url": `${siteUrl}/history/roll-of-honour/`,
      "mainEntity": {
        "@type": "ItemList",
        "name": "PDC World Darts Championship Winners",
        "numberOfItems": finalsData.pdc_finals.length,
        "itemListElement": finalsData.pdc_finals.map((item, index) => ({
          "@type": "ListItem",
          "position": index + 1,
          "name": `${item.year} World Champion: ${item.winner} (Runner-up: ${item.runner_up}, Score: ${item.score})`
        }))
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How many World Championships did Phil Taylor win in his career?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Phil Taylor won a record 16 World Championships across his career: 2 with the BDO (1990, 1992) and 14 with the PDC (1995, 1996, 1997, 1998, 1999, 2000, 2001, 2002, 2004, 2005, 2006, 2009, 2010, 2013)."
          }
        },
        {
          "@type": "Question",
          "name": "Who was the first non-UK winner of the PDC World Darts Championship?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Canada's John Part was the first non-UK player to win the PDC World Championship, triumphing 7–6 over Phil Taylor at the Circus Tavern in 2003, before winning again at Alexandra Palace in 2008."
          }
        },
        {
          "@type": "Question",
          "name": "Has anyone ever won the World Championship on their tournament debut?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Dennis Priestley won the inaugural 1994 event on debut, Christian Kist won the 2012 BDO event on debut, and Rob Cross famously won the 2018 PDC World Championship on his debut, defeating Phil Taylor 7–2 in the final."
          }
        }
      ]
    }
  ]
};
---

<BaseLayout 
  title={pageTitle} 
  description={pageDescription}
  schema={rollOfHonourSchema}
>
  <Breadcrumbs items={breadcrumbItems} />

  <header class="page-header">
    <div class="container">
      <div class="badge-row">
        <span class="badge badge-accent">ROLL OF HONOUR</span>
        <span class="badge">OFFICIAL WORLD CHAMPIONS</span>
      </div>
      <h1>World Darts Championship Roll of Honour</h1>
      <p class="lead-text">
        The definitive record of every darts world champion in history. This archive clearly differentiates the premier <strong>PDC World Darts Championship (1994–present)</strong> from the historical <strong>BDO World Championship (1978–2020)</strong>.
      </p>
    </div>
  </header>

  <div class="container content-layout">
    <main class="main-column">
      <VerificationBadge verifiedDate={finalsData.last_verified} topic="PDC & BDO Official World Championship Records" />

      <!-- Introductory Clarification Box -->
      <section class="content-card clarification-box">
        <p class="clarification-title">Important Historical Distinction: PDC vs. BDO World Titles</p>
        <p>
          In January 1993, the world's leading 16 darts professionals separated from the British Darts Organisation (BDO) to form the World Darts Council (later renamed the <strong>Professional Darts Corporation, or PDC</strong>). Between 1994 and 2020, two distinct World Championships ran concurrently. Today, the PDC World Darts Championship staged at Alexandra Palace represents the undisputed pinnacle of the global sport.
        </p>
      </section>

      <!-- Roll of Honour vs Finals Archive distinction -->
      <div class="diff-box">
        <p><strong>Roll of Honour vs Finals Archive:</strong> this page is the definitive winners' list — every world champion, every year, across the PDC and BDO eras. For full final scores, winning averages, venue history and the stories behind the most iconic finals, see our <a href="/history/world-championship-finals/">World Championship Finals Archive</a>.</p>
      </div>

      <AdSlot id="roll-top-ad" label="Championship Heritage & Books" />

      <!-- Championship Eras -->
      <section class="content-card era-section">
        <h2>Eras of the World Championship</h2>
        <p>
          <strong>The Taylor Era (1995–2013).</strong> No roll of honour discussion starts anywhere but Phil Taylor. After losing the inaugural 1994 final to Dennis Priestley, Taylor captured 14 PDC world titles — including eight in succession from 1995 to 2002, a run of dominance no other world championship in any sport has matched. His 2003 final defeat to John Part, 7–6 in a sudden-death leg at the Circus Tavern, remains the most famous upset in darts history. Taylor's final title in 2013, aged 52, made him the oldest PDC world champion ever.
        </p>
        <p>
          <strong>The Transition (2014–2019).</strong> As Taylor faded, Michael van Gerwen claimed three titles (2014, 2017, 2019) and Gary Anderson went back-to-back (2015, 2016), while Adrian Lewis had already defended his crown in 2011–2012. The era closed symbolically in 2018: Rob Cross, on his tournament debut, defeated Taylor 7–2 in the great man's farewell final.
        </p>
        <p>
          <strong>The New Generation (2020–present).</strong> Five different champions across six editions — Peter Wright (2020, 2022), Gerwyn Price (2021), Michael Smith (2023) and Luke Humphries (2024) — before Luke Littler's 2025 triumph at just 17 years old made him the youngest world champion in darts history and signalled a full generational shift at the top of the sport.
        </p>
      </section>

      <!-- PDC Roll of Honour Table -->
      <section class="content-card table-section">
        <h2>PDC World Darts Championship Winners (1994–Present)</h2>
        <p class="table-note">
          Official championship finals contested under set-play rules at the Circus Tavern (1994–2007) and Alexandra Palace (2008–present).
        </p>

        <div class="table-responsive">
          <table class="data-table">
            <thead>
              <tr>
                <th>Season (Final)</th>
                <th>Champion</th>
                <th>Runner-Up</th>
                <th>Final Score</th>
                <th>Venue</th>
                <th>Historical Context</th>
              </tr>
            </thead>
            <tbody>
              {finalsData.pdc_finals.map((final) => (
                <tr class={final.season === "2026/27" ? "upcoming-row" : ""}>
                  <td>
                    <strong class="year-highlight">{final.season}</strong>
                    <span class="sub-final-year">({final.final_year} Final)</span>
                  </td>
                  <td>
                    {final.year === "2026/27" ? (
                      <span class="tbd-tag">{final.winner}</span>
                    ) : (
                      <strong class="winner-name">{final.winner}</strong>
                    )}
                  </td>
                  <td><span class="runner-name">{final.runner_up}</span></td>
                  <td><span class="score-tag">{final.score}</span></td>
                  <td><span class="venue-cell">{final.venue}</span></td>
                  <td><span class="notes-cell">{final.notes}</span></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <!-- Multiple PDC Champions Summary -->
      <section class="content-card multiple-champs-section">
        <h2>Multiple PDC World Champions Leaderboard</h2>
        <div class="champs-grid">
          {finalsData.multiple_champions_pdc.map((champ) => (
            <div class="champ-card">
              <span class="titles-badge">{champ.titles} {champ.titles === 1 ? 'TITLE' : 'TITLES'}</span>
              <h3>{champ.player}</h3>
              <p class="years-text">{champ.years}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- Back-to-Back Champions -->
      <section class="content-card back-to-back-section">
        <h2>Back-to-Back Champions: Consecutive World Titles</h2>
        <p>
          Retaining the World Darts Championship is universally regarded as the ultimate test in professional darts. The gruelling multi-week knockout schedule, relentless media spotlight, and the unique psychological burden of defending ranking prize money make consecutive titles exceptionally rare. In the history of the PDC World Championship, only three men have ever achieved this pinnacle:
        </p>
        <ul>
          <li>
            <strong>Phil Taylor (1995–2002):</strong> The benchmark of darts dominance. After finishing runner-up in 1994, Taylor captured an unprecedented eight consecutive PDC world crowns across an eight-year dynasty at the Circus Tavern. During this streak, Taylor defeated Rod Harrington (6–2 in 1995), Dennis Priestley four times (7–6 in 1996, 6–3 in 1997, 6–0 in 1998, 7–3 in 2000), Peter Manley twice (6–2 in 1999, 7–0 in 2002), and John Part (7–0 in 2001). Taylor also registered back-to-back title runs in 2004–2006 (defeating Kevin Painter, Mark Dudbridge, and Peter Manley) and 2009–2010 (defeating Raymond van Barneveld and Simon Whitlock).
          </li>
          <li>
            <strong>Adrian Lewis (2011–2012):</strong> "Jackpot" made history at Alexandra Palace by becoming the first player in PDC history to successfully defend their maiden world championship crown. Lewis lifted the Sid Waddell Trophy for the first time in 2011 with a 7–5 victory over Gary Anderson—punctuated by an iconic nine-dart finish in the final—and returned twelve months later in 2012 to defeat Andy Hamilton 7–3 in the title decider.
          </li>
          <li>
            <strong><a href="/players/gary-anderson/">Gary Anderson</a> (2015–2016):</strong> "The Flying Scotsman" cemented his status among the sport's all-time greats with back-to-back triumphs at Alexandra Palace. Anderson edged Phil Taylor in an epic 7–6 deciding-set thriller in 2015, and defended his world title in 2016 by overcoming Adrian Lewis 7–5 in a blistering final featuring 34 maximum 180s.
          </li>
        </ul>
        <p>
          Winning consecutive world titles requires maintaining peak scoring consistency and clinical doubling across 14 consecutive high-pressure set-play matches spanning two winters—a monumental feat that separates legendary champions from one-time titleholders.
        </p>
      </section>

      <AdSlot id="roll-mid-ad" label="Custom Dartboards & Frames" />

      <!-- BDO Historical Roll of Honour -->
      <section class="content-card bdo-section">
        <h2>Historical BDO World Championship Winners (1978–2020)</h2>
        <p class="table-note">
          Staged at the Heart of the Midlands Club (1978), Jollees Club (1979–1985), Lakeside Country Club (1986–2019), and Indigo at The O2 (2020). The BDO ceased operations in late 2020.
        </p>

        <div class="table-responsive">
          <table class="data-table">
            <thead>
              <tr>
                <th>Player</th>
                <th>BDO World Titles</th>
                <th>Championship Years</th>
              </tr>
            </thead>
            <tbody>
              {finalsData.bdo_historical_winners.map((bdo) => (
                <tr>
                  <td><strong>{bdo.player}</strong></td>
                  <td><span class="bdo-pill">{bdo.titles}</span></td>
                  <td><span class="years-cell">{bdo.years}</span></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <!-- FAQ Section -->
      <section class="content-card records-section">
        <h2>Roll of Honour Records &amp; Milestones</h2>
        <ul class="records-list">
          <li><strong>Most world titles (all organisations):</strong> Phil Taylor — 16 (2 BDO, 14 PDC).</li>
          <li><strong>Most consecutive PDC titles:</strong> Phil Taylor — 8 in a row, 1995–2002.</li>
          <li><strong>Youngest world champion:</strong> Luke Littler — 17 years old (2025).</li>
          <li><strong>Oldest PDC world champion:</strong> Phil Taylor — 52 years old (2013).</li>
          <li><strong>Back-to-back PDC champions:</strong> Phil Taylor (1995–2002 run, 2004–2006, 2008–2010), Adrian Lewis (2011–2012), Gary Anderson (2015–2016).</li>
          <li><strong>The five-time champions club:</strong> Phil Taylor (16), Eric Bristow (5 BDO), Raymond van Barneveld (5 — 4 BDO, 1 PDC).</li>
          <li><strong>First non-UK PDC champion:</strong> John Part of Canada (2003).</li>
          <li><strong>Debut winners:</strong> Dennis Priestley (1994), Christian Kist (BDO 2012), Rob Cross (2018).</li>
        </ul>
      </section>

      <section class="content-card faq-section">
        <h2>Roll of Honour FAQ</h2>
        <div class="faq-accordion">
          <details class="faq-item">
            <summary class="faq-question">How many World Championships did Phil Taylor win in his career?</summary>
            <div class="faq-answer">
              <p>Phil Taylor won a record <strong>16 World Championships</strong> across his career: 2 with the BDO (1990, 1992) and 14 with the PDC (1995, 1996, 1997, 1998, 1999, 2000, 2001, 2002, 2004, 2005, 2006, 2009, 2010, 2013).</p>
            </div>
          </details>

          <details class="faq-item">
            <summary class="faq-question">Who was the first non-UK winner of the PDC World Darts Championship?</summary>
            <div class="faq-answer">
              <p>Canada's <strong>John Part</strong> was the first non-UK player to win the PDC World Championship, triumphing 7–6 over Phil Taylor at the Circus Tavern in 2003, before winning again at Alexandra Palace in 2008.</p>
            </div>
          </details>

          <details class="faq-item">
            <summary class="faq-question">Has anyone ever won the World Championship on their tournament debut?</summary>
            <div class="faq-answer">
              <p>Yes. Dennis Priestley won the inaugural 1994 event on debut, Christian Kist won the 2012 BDO event on debut, and <strong>Rob Cross</strong> famously won the 2018 PDC World Championship on his debut, defeating Phil Taylor 7–2 in the final.</p>
            </div>
          </details>
        </div>
      </section>
    </main>

    <!-- Sidebar -->
    <aside class="sidebar-column">
      <div class="sidebar-card">
        <h3>History Navigation</h3>
        <ul class="sidebar-links">
          <li><a href="/history/">← History Hub</a></li>
          <li><a href="/history/world-championship-finals/">⚔️ All-Time Finals Index</a></li>
          <li><a href="/history/alexandra-palace-world-championship/">🏛️ Alexandra Palace History</a></li>
          <li><a href="/history/nine-darters/">⚡ Nine-Darter History</a></li>
          <li><a href="/players/world-championship-records/">📊 Tournament Records</a></li>
          <li><a href="/players/records/">🏆 All-Time Records Directory</a></li>
        </ul>
      </div>

      <div class="sidebar-card highlight-sidebar">
        <h3>Current Tournament</h3>
        <ul class="sidebar-links">
          <li><a href="/tournament/prize-money/">£5,000,000 Prize Fund Breakdown</a></li>
          <li><a href="/tournament/pdc-majors-explained/">PDC Major Tournaments Guide</a></li>
          <li><a href="/draw/">2026/27 Bracket &amp; Draw</a></li>
          <li><a href="/schedule/">Full Schedule of Play</a></li>
          <li><a href="/players/">Player Profiles Directory</a></li>
        </ul>
      </div>

      <AdSlot id="roll-sidebar-ad" label="Darts Historic Framing & Programs" />
    </aside>
  </div>
</BaseLayout>

<style>
  .page-header {
    background: linear-gradient(135deg, #111827 0%, #1f2937 100%);
    border-bottom: 1px solid #374151;
    padding: 3rem 0 2rem;
    margin-bottom: 2rem;
  }
  .page-header h1 {
    color: #ffffff;
    font-size: 2.3rem;
    font-weight: 800;
    line-height: 1.2;
    margin: 0 0 1rem;
  }
  .badge-row {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }
  .lead-text {
    font-size: 1.125rem;
    color: #9ca3af;
    max-width: 800px;
    line-height: 1.6;
    margin-top: 0.75rem;
  }
  .content-layout {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 2rem;
    margin-bottom: 3rem;
  }
  @media (max-width: 900px) {
    .content-layout {
      grid-template-columns: 1fr;
    }
  }
  .content-card {
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 2rem;
    margin-bottom: 2rem;
  }
  .clarification-box {
    background: #0f172a;
    border-left: 4px solid #38bdf8;
  }
  .clarification-box .clarification-title {
    margin: 0 0 0.5rem;
    color: #38bdf8;
    font-size: 1.1rem;
  }
  .clarification-box p {
    margin: 0;
    color: #cbd5e1;
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .table-responsive {
    overflow-x: auto;
    margin-top: 1rem;
  }
  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
    text-align: left;
  }
  .data-table th {
    background: #0f172a;
    color: #e2e8f0;
    padding: 0.75rem 1rem;
    border-bottom: 2px solid #475569;
    white-space: nowrap;
  }
  .data-table td {
    padding: 0.85rem 1rem;
    border-bottom: 1px solid #334155;
    vertical-align: middle;
  }
  .upcoming-row {
    background: rgba(245, 158, 11, 0.08);
  }
  .tbd-tag {
    color: #f59e0b;
    font-style: italic;
    font-weight: 600;
  }
  .year-highlight {
    color: #38bdf8;
    font-size: 0.95rem;
  }
  .winner-name {
    color: #f8fafc;
  }
  .runner-name {
    color: #cbd5e1;
  }
  .score-tag {
    background: #0f172a;
    border: 1px solid #475569;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    font-weight: 700;
    color: #10b981;
    white-space: nowrap;
  }
  .venue-cell {
    font-size: 0.8rem;
    color: #94a3b8;
    white-space: nowrap;
  }
  .sub-final-year {
    display: block;
    font-size: 0.75rem;
    color: #94a3b8;
    font-weight: 500;
  }
  .notes-cell {
    font-size: 0.8rem;
    color: #cbd5e1;
    line-height: 1.35;
  }
  .champs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
    margin-top: 1.25rem;
  }
  .champ-card {
    background: #0f172a;
    border: 1px solid #334155;
    padding: 1.25rem;
    border-radius: 6px;
  }
  .titles-badge {
    font-size: 0.75rem;
    font-weight: 800;
    color: #f59e0b;
    display: block;
    margin-bottom: 0.25rem;
  }
  .champ-card h3 {
    margin: 0 0 0.5rem;
    color: #f8fafc;
    font-size: 1.15rem;
  }
  .years-text {
    margin: 0;
    font-size: 0.8rem;
    color: #94a3b8;
    line-height: 1.4;
  }
  .bdo-pill {
    background: #334155;
    color: #f8fafc;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    font-weight: 700;
    font-size: 0.85rem;
  }
  .years-cell {
    font-size: 0.85rem;
    color: #cbd5e1;
  }
  .faq-accordion details {
    background: #0f172a;
    border: 1px solid #334155;
    border-radius: 6px;
    margin-bottom: 0.75rem;
    padding: 0.75rem 1rem;
  }
  .faq-question {
    cursor: pointer;
    font-weight: 600;
    color: #f8fafc;
  }
  .faq-answer {
    margin-top: 0.75rem;
    color: #94a3b8;
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .sidebar-card {
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
  }
  .sidebar-card h3 {
    margin-top: 0;
    font-size: 1.1rem;
    color: #f8fafc;
    border-bottom: 1px solid #334155;
    padding-bottom: 0.5rem;
    margin-bottom: 1rem;
  }
  .sidebar-links {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .sidebar-links li {
    margin-bottom: 0.6rem;
  }
  .sidebar-links a {
    color: #94a3b8;
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.2s;
  }
  .sidebar-links a:hover {
    color: #38bdf8;
  }
  .highlight-sidebar {
    border-color: #f59e0b;
  }
  .diff-box {
    background: #0f172a;
    border-left: 4px solid #f59e0b;
    border-radius: 6px;
    padding: 1rem 1.25rem;
    margin-bottom: 2rem;
  }
  .diff-box p {
    margin: 0;
    color: #cbd5e1;
    font-size: 0.95rem;
    line-height: 1.6;
  }
  .diff-box strong {
    color: #f8fafc;
  }
  .diff-box a {
    color: #38bdf8;
  }
  .era-section h2,
  .records-section h2 {
    color: #f8fafc;
    margin-top: 0;
    margin-bottom: 1rem;
    font-size: 1.4rem;
  }
  .era-section p {
    color: #cbd5e1;
    line-height: 1.7;
    margin-bottom: 1rem;
  }
  .era-section p:last-child {
    margin-bottom: 0;
  }
  .era-section p strong {
    color: #f8fafc;
  }
  .records-list {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
  }
  .records-list li {
    color: #cbd5e1;
    padding: 0.6rem 0;
    border-bottom: 1px solid #334155;
    line-height: 1.6;
    font-size: 0.95rem;
  }
  .records-list li:last-child {
    border-bottom: none;
  }
  .records-list li strong {
    color: #f8fafc;
  }
</style>
