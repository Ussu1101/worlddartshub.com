---
// src/pages/travel/tube-train-routes.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AdSlot from '../../components/AdSlot.astro';
import VerificationBadge from '../../components/VerificationBadge.astro';
import travelData from '../../data/travel.json';

const pageTitle = "How to Get to Alexandra Palace Darts — Tube, Train & Bus Routes (2026/27)";
const pageDescription = "Comprehensive travel guide to Alexandra Palace for the PDC World Darts Championship. Wood Green Piccadilly Line, Alexandra Palace Rail, W3 bus, Night Tube, and egress tips.";

const breadcrumbItems = [
  { name: 'Travel Guide', url: '/travel/' },
  { name: 'Tube, Train & Bus Routes' }
];

const travelFaqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "name": "Alexandra Palace PDC World Darts Travel FAQ",
  "description": pageDescription,
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the best tube station for Alexandra Palace?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Wood Green Underground Station on the Piccadilly Line (London Fare Zone 3) is the primary tube station. From Wood Green, you can take the direct TfL W3 bus up the hill to Palm Court (8–10 minutes) or walk approximately 20–25 minutes uphill through Station Road and the park."
      }
    },
    {
      "@type": "Question",
      "name": "What is the closest National Rail station to Ally Pally?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Alexandra Palace Rail Station (operated by Great Northern) is the closest station, located just 0.6 miles from the Great Hall (approx. 10–15 minutes walk uphill). Direct trains run regularly from Moorgate, Old Street, Highbury & Islington, and Finsbury Park."
      }
    },
    {
      "@type": "Question",
      "name": "Which bus goes directly to the Alexandra Palace entrance?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The TfL W3 bus is the definitive spectator route. It connects Finsbury Park Station and Wood Green Station directly to the Alexandra Palace Palm Court entrance at the crest of the hill, completely avoiding the steep park walk."
      }
    },
    {
      "@type": "Question",
      "name": "Does the Night Tube run after evening darts sessions?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Night Tube operates 24 hours on Friday and Saturday nights only on the Piccadilly Line from Wood Green. On Sunday through Thursday nights, the last southbound Piccadilly Line trains depart Wood Green between approximately 00:15 and 00:30."
      }
    },
    {
      "@type": "Question",
      "name": "Can you get an Uber or taxi from Alexandra Palace after the evening session?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "While rideshare apps operate in London, road congestion and severe surge pricing occur along Alexandra Palace Way when 5,000 spectators exit at 23:00. Walking down the hill to Wood Green High Road or Muswell Hill before requesting an Uber or Bolt is strongly recommended to save significant time and money."
      }
    }
  ]
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  schema={travelFaqSchema}
>
  <Breadcrumbs items={breadcrumbItems} />

  <header class="travel-hero">
    <div class="container">
      <div class="badge-group">
        <span class="badge badge-accent">LONDON SPECTATOR NAVIGATION</span>
        <span class="badge">FARE ZONE 3</span>
      </div>
      <h1 class="travel-title">How to Get to Alexandra Palace Darts: Tube, Train & Bus Guide</h1>
      <p class="travel-subtitle">
        Everything you need to navigate to Ally Pally for the PDC World Darts Championship 2026/27. Fast routes via Wood Green, Great Northern trains, W3 buses, and late-night egress tips.
      </p>
      <div class="hero-meta">
        <span class="meta-item">🚇 Tube: Wood Green (Piccadilly Line)</span>
        <span class="meta-item">🚆 Train: Alexandra Palace Rail (Great Northern)</span>
        <span class="meta-item">🚌 Bus: W3 Direct to Palm Court</span>
        <span class="meta-item">📅 Verified: October 2026</span>
      </div>
    </div>
  </header>

  <main class="container content-container">
    <div class="travel-layout">
      <!-- Main Content -->
      <article class="travel-main">

        <!-- DYNAMIC TFL STATUS ADVISORY -->
        <section class="tfl-advisory-banner">
          <div class="advisory-badge">
            <span class="badge-icon">ℹ️</span>
            <span>OFFICIAL TRANSPORT ADVISORY</span>
          </div>
          <h2>Check TfL Service Status Before Traveling</h2>
          <p class="advisory-quote">
            "{travelData.tfl_status_advisory}"
          </p>
          <div class="advisory-actions">
            <a href="https://tfl.gov.uk" target="_blank" rel="noopener noreferrer" class="advisory-btn">
              Live TfL Underground Status ↗
            </a>
            <a href="https://www.nationalrail.co.uk" target="_blank" rel="noopener noreferrer" class="advisory-btn secondary">
              National Rail Enquiries ↗
            </a>
          </div>
        </section>

        <AdSlot position="top" client="ca-pub-placeholder" slotId="travel-top-slot" />

        <!-- CORE ARRIVAL OPTIONS -->
        <section class="travel-section">
          <h2>The Primary Arrival Stations</h2>
          <p>
            Alexandra Palace is perched on a prominent hill in North London (Fare Zone 3). Depending on where you stay or travel from, two main stations serve the venue:
          </p>

          <div class="stations-stack">
            {travelData.primary_stations.map(st => (
              <div class="station-card">
                <div class="station-card-top">
                  <div class="st-header-info">
                    <span class="mode-badge">{st.mode}</span>
                    <h3>{st.name}</h3>
                    <span class="zone-pill">{st.zone}</span>
                  </div>
                  <div class="distance-badge">
                    <span class="dist-val">{st.distance_miles} miles</span>
                    <span class="dist-label">to Great Hall</span>
                  </div>
                </div>

                <div class="station-card-details">
                  {st.line && <p><strong>Line:</strong> {st.line}</p>}
                  {st.lines && <p><strong>Lines:</strong> {st.lines.join(', ')}</p>}
                  {st.operator && <p><strong>Operator:</strong> {st.operator}</p>}
                  {st.walking_time && <p><strong>Walking Time:</strong> {st.walking_time}</p>}
                  {st.bus_connection && <p><strong>Bus Link:</strong> {st.bus_connection}</p>}
                  {st.direct_connections && <p><strong>Direct Trains:</strong> {st.direct_connections}</p>}
                  {st.night_service && <p class="night-note"><strong>Late-Night Return:</strong> {st.night_service}</p>}
                </div>
              </div>
            ))}
          </div>
        </section>

        <!-- THE CRITICAL W3 BUS EXPLAINED -->
        <section class="travel-section w3-highlight-box">
          <div class="w3-badge">🚌 THE SECRET TO AVOIDING THE HILL</div>
          <h2>Why the TfL W3 Bus is the Spectator Favorite</h2>
          <p>
            The hill up through Alexandra Park has an average gradient of over 8% and can take 20 to 25 minutes of brisk uphill walking on cold December afternoons. For fans in fancy dress, carrying coats, or wanting to arrive warm and relaxed, the <strong>W3 Bus</strong> is essential.
          </p>

          <div class="bus-feature-grid">
            <div class="bus-feature">
              <h4>Direct Palm Court Drop-off</h4>
              <p>The W3 bus stops directly outside the Palm Court main venue entrance at the crest of the hill. No park stairs, no steep pathways.</p>
            </div>
            <div class="bus-feature">
              <h4>Frequency</h4>
              <p>Runs every 6 to 10 minutes throughout the afternoon, evening, and egress periods across all event days.</p>
            </div>
            <div class="bus-feature">
              <h4>Boarding Points</h4>
              <p>Board directly opposite Wood Green Tube Station (Station Road) or at Finsbury Park Bus Station (Stop G).</p>
            </div>
            <div class="bus-feature">
              <h4>Cost & Payment</h4>
              <p>Standard flat TfL bus fare (£1.75). Contactless card, mobile payment, or Oyster card accepted. Cash is not accepted.</p>
            </div>
          </div>
        </section>

        <!-- ROUTE GUIDES FROM KEY HUBS -->
        <section class="travel-section">
          <h2>Route Guides from Major London Origins</h2>
          <p>
            Direct journey estimates and recommended transit options from London's most common transport interchanges:
          </p>

          <div class="route-table-wrapper">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Origin Hub</th>
                  <th>Recommended Transit Route</th>
                  <th>Est. Travel Time</th>
                </tr>
              </thead>
              <tbody>
                {travelData.route_guides.map((route, idx) => (
                  <tr class={idx % 2 === 0 ? "even" : "odd"}>
                    <td class="origin-cell"><strong>{route.origin}</strong></td>
                    <td class="route-cell">{route.recommended_route}</td>
                    <td class="time-cell">{route.estimated_travel_time}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="disclaimer-text" style="font-size: 0.82rem; color: #64748b; margin-top: 0.75rem;">
            <em>Route Duration & Distance Advisory: All walking distances (approx. 1.2 miles from Wood Green; approx. 0.6 miles from Alexandra Palace Station) and transit durations (such as approx. 14 minutes scheduled train travel from King's Cross) are approximate estimates derived from standard TfL and National Rail timetables under normal operating conditions. Actual travel times vary based on station crowd control, interchange transfers, and walking pace. Spectators should build in ample buffer time when travelling to sessions.</em>
          </p>
        </section>

        <!-- NIGHT EGRESS & LEAVING ALLY PALLY -->
        <section class="travel-section egress-section">
          <h2>Late-Night Egress: Leaving Alexandra Palace at 23:00</h2>
          <p>
            When an evening session concludes around 23:00 GMT, approximately 5,000 spectators exit the Great Hall into the chilly winter air simultaneously. Understanding egress realities saves you 45+ minutes of unnecessary freezing:
          </p>

          <div class="egress-grid">
            <div class="egress-card bus-warning">
              <h3>⚠️ The W3 Bus Queue Bottleneck</h3>
              <p>
                The bus stops directly outside Palm Court experience huge queues immediately following session end. While TfL deploys extra buses, you may wait 30–45 minutes in line just to board.
              </p>
              <p class="pro-tip">
                <strong>Pro-Tip:</strong> Walk downhill through the illuminated park path to Wood Green station. The walk is all downhill, takes only 15 minutes, and gets you onto a southbound train well before bus queuers reach the station.
              </p>
            </div>

            <div class="egress-card night-tube">
              <h3>🚇 Night Tube on Friday & Saturday</h3>
              <p>
                The Piccadilly Line operates <strong>24-hour Night Tube</strong> on Friday nights and Saturday nights. Trains run continuously every 10 minutes between Wood Green and Central London / Heathrow all night long.
              </p>
              <p class="weekday-note">
                <strong>Sunday to Thursday:</strong> The last southbound Piccadilly Line trains depart Wood Green around <strong>00:15–00:30</strong>. Always monitor the time if matches extend into overtime tie-breaks.
              </p>
            </div>

            <div class="egress-card taxi-surge">
              <h3>🚕 Taxis & Rideshare (Uber / Bolt)</h3>
              <p>
                Vehicular access to Alexandra Palace Way is heavily restricted during egress. Rideshare drivers struggle to reach the pick-up area, resulting in 40+ minute waits and severe 2x–3x surge pricing.
              </p>
              <p class="pro-tip">
                <strong>Pro-Tip:</strong> If you must order a car, walk 10–15 minutes down the hill into Muswell Hill Broadway or Wood Green High Road before requesting your vehicle.
              </p>
            </div>
          </div>
        </section>

        <AdSlot position="middle" client="ca-pub-placeholder" slotId="travel-mid-slot" />

        <!-- ACCESSIBILITY TRANSPORT -->
        <section class="travel-section">
          <h2>Step-Free Travel & Accessibility</h2>
          <div class="accessibility-card">
            <h3>Wheelchair & Mobility Access</h3>
            <p>
              Neither Wood Green Tube Station nor Alexandra Palace Rail Station are currently fully step-free from street to platform without stairs. For wheelchair users and spectators with limited mobility:
            </p>
            <ul>
              <li><strong>Finsbury Park Station:</strong> Offers step-free access between street and platforms for both the Piccadilly/Victoria Lines and National Rail. From Finsbury Park, low-floor accessible W3 buses run straight to Palm Court.</li>
              <li><strong>Dedicated Blue Badge Parking:</strong> Alexandra Palace provides dedicated accessible parking bays in the East Car Park directly adjacent to the Palm Court entrance. Blue badge parking is free but requires advance booking via the venue website.</li>
            </ul>
          </div>
        </section>

        <!-- FAQ SECTION -->
        <section class="travel-section">
          <h2>Frequently Asked Questions: Getting to Ally Pally</h2>
          <div class="faq-list">
            {travelFaqSchema.mainEntity.map(faq => (
              <div class="faq-item">
                <h3>{faq.name}</h3>
                <p>{faq.acceptedAnswer.text}</p>
              </div>
            ))}
          </div>
        </section>

        <!-- VERIFICATION COMPONENT -->
        <VerificationBadge
          source={travelData.source}
          verifiedDate={travelData.last_verified}
          status="CONFIRMED TRANSIT ROUTES / ESTIMATED TIMINGS"
        />

      </article>

      <!-- Sidebar -->
      <aside class="travel-sidebar">
        <div class="sidebar-widget">
          <h3 class="widget-title">Travel Quick Facts</h3>
          <ul class="glance-list">
            <li><strong>Zone:</strong> London Fare Zone 3</li>
            <li><strong>Nearest Tube:</strong> Wood Green (Piccadilly)</li>
            <li><strong>Nearest Rail:</strong> Alexandra Palace (Gt Northern)</li>
            <li><strong>Top Bus:</strong> TfL W3 Direct to Entrance</li>
            <li><strong>Night Tube:</strong> Fri & Sat Nights (Piccadilly)</li>
            <li><strong>Fare:</strong> Oyster, Contactless, Travelcard</li>
          </ul>
        </div>

        <div class="sidebar-widget">
          <h3 class="widget-title">Session Egress Schedule</h3>
          <div class="session-times-box">
            <div class="session-time-item">
              <span class="sess-label">Afternoon Session Ends:</span>
              <span class="sess-val">Approx. 16:30 GMT</span>
              <span class="sess-sub">Daylight egress, normal transit intervals</span>
            </div>
            <div class="session-time-item">
              <span class="sess-label">Evening Session Ends:</span>
              <span class="sess-val">Approx. 23:00 GMT</span>
              <span class="sess-sub">Peak crowding, last trains 00:15–00:30 (Sun-Thu)</span>
            </div>
          </div>
        </div>

        <div class="sidebar-widget">
          <h3 class="widget-title">Related Spectator Guides</h3>
          <ul class="widget-links">
            <li><a href="/hotels/budget-options/">Budget Hotels Near Ally Pally</a></li>
            <li><a href="/venue/security-bag-policy/">Bag Size Limits & Security Checks</a></li>
            <li><a href="/venue/food-drink-bars/">On-site Bars & Nearby Pubs</a></li>
            <li><a href="/venue/great-hall-seating-plan/">Great Hall Seating Views</a></li>
            <li><a href="/tickets/resale-returns/">Official Ticket Resale Guide</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </main>
</BaseLayout>

<style>
  .travel-hero {
    background: linear-gradient(135deg, #064e3b 0%, #065f46 100%);
    color: #ffffff;
    padding: 3rem 0;
    border-bottom: 1px solid #047857;
  }

  .badge-group {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }

  .badge {
    background: #047857;
    color: #a7f3d0;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.65rem;
    border-radius: 4px;
    letter-spacing: 0.05em;
  }

  .badge-accent {
    background: #10b981;
    color: #064e3b;
  }

  .travel-title {
    font-size: 2.25rem;
    font-weight: 800;
    margin: 0 0 1rem;
    line-height: 1.2;
  }

  .travel-subtitle {
    font-size: 1.15rem;
    color: #d1fae5;
    max-width: 820px;
    margin: 0 0 1.5rem;
    line-height: 1.5;
  }

  .hero-meta {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    font-size: 0.85rem;
    color: #a7f3d0;
  }

  .content-container {
    padding-top: 2rem;
    padding-bottom: 4rem;
  }

  .travel-layout {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 2.5rem;
  }

  /* TfL Advisory Banner */
  .tfl-advisory-banner {
    background: #eff6ff;
    border: 2px solid #3b82f6;
    border-radius: 12px;
    padding: 1.75rem;
    margin-bottom: 2rem;
  }

  .advisory-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #1d4ed8;
    color: #ffffff;
    font-weight: 800;
    font-size: 0.78rem;
    padding: 0.25rem 0.65rem;
    border-radius: 9999px;
    margin-bottom: 0.75rem;
  }

  .tfl-advisory-banner h2 {
    color: #1e3a8a;
    margin-top: 0;
    margin-bottom: 0.5rem;
    font-size: 1.35rem;
  }

  .advisory-quote {
    color: #1e40af;
    font-size: 1rem;
    line-height: 1.5;
    margin: 0 0 1.25rem;
    font-weight: 500;
  }

  .advisory-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .advisory-btn {
    background: #1d4ed8;
    color: #ffffff;
    padding: 0.55rem 1rem;
    border-radius: 6px;
    font-weight: 700;
    font-size: 0.88rem;
    text-decoration: none;
  }

  .advisory-btn:hover {
    background: #1e40af;
  }

  .advisory-btn.secondary {
    background: #ffffff;
    color: #1d4ed8;
    border: 1px solid #bfdbfe;
  }

  /* Stations Stack */
  .stations-stack {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin: 1.5rem 0;
  }

  .station-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 1.5rem;
  }

  .station-card-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1rem;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .st-header-info {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .mode-badge {
    background: #0f172a;
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 800;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
  }

  .st-header-info h3 {
    margin: 0;
    font-size: 1.2rem;
    color: #0f172a;
  }

  .zone-pill {
    background: #f1f5f9;
    color: #475569;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    border: 1px solid #cbd5e1;
  }

  .distance-badge {
    text-align: right;
  }

  .dist-val {
    display: block;
    font-size: 1.15rem;
    font-weight: 800;
    color: #059669;
  }

  .dist-label {
    font-size: 0.75rem;
    color: #64748b;
  }

  .station-card-details p {
    margin: 0 0 0.4rem;
    font-size: 0.9rem;
    color: #334155;
  }

  .night-note {
    color: #b45309 !important;
    background: #fffbeb;
    padding: 0.5rem 0.75rem;
    border-radius: 4px;
    margin-top: 0.5rem !important;
  }

  /* W3 Highlight Box */
  .w3-highlight-box {
    background: #f0fdf4;
    border: 2px solid #86efac;
    border-radius: 12px;
    padding: 1.75rem;
    margin: 2rem 0;
  }

  .w3-badge {
    display: inline-block;
    background: #16a34a;
    color: #ffffff;
    font-size: 0.78rem;
    font-weight: 800;
    padding: 0.25rem 0.65rem;
    border-radius: 9999px;
    margin-bottom: 0.75rem;
  }

  .w3-highlight-box h2 {
    color: #166534;
    margin-top: 0;
    margin-bottom: 0.5rem;
  }

  .bus-feature-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 1.25rem;
  }

  .bus-feature {
    background: #ffffff;
    border: 1px solid #bbf7d0;
    border-radius: 8px;
    padding: 1.15rem;
  }

  .bus-feature h4 {
    margin: 0 0 0.35rem;
    color: #14532d;
    font-size: 0.98rem;
  }

  .bus-feature p {
    margin: 0;
    font-size: 0.85rem;
    color: #334155;
    line-height: 1.45;
  }

  /* Route Table */
  .route-table-wrapper {
    overflow-x: auto;
    margin: 1.5rem 0;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
  }

  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.88rem;
    text-align: left;
  }

  .data-table th {
    background: #f8fafc;
    padding: 0.85rem 1rem;
    font-weight: 700;
    color: #334155;
    border-bottom: 2px solid #e2e8f0;
  }

  .data-table td {
    padding: 0.85rem 1rem;
    border-bottom: 1px solid #e2e8f0;
    vertical-align: top;
  }

  .data-table tr.even {
    background: #ffffff;
  }

  .data-table tr.odd {
    background: #fdfdfd;
  }

  .origin-cell {
    color: #0f172a;
    width: 25%;
  }

  .route-cell {
    color: #334155;
    width: 55%;
  }

  .time-cell {
    color: #059669;
    font-weight: 700;
    width: 20%;
  }

  /* Egress Section */
  .egress-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    margin: 1.5rem 0;
  }

  .egress-card {
    border-radius: 8px;
    padding: 1.25rem;
    border: 1px solid #e2e8f0;
    background: #ffffff;
  }

  .bus-warning {
    border-left: 4px solid #f59e0b;
  }

  .night-tube {
    border-left: 4px solid #0284c7;
  }

  .taxi-surge {
    border-left: 4px solid #ef4444;
  }

  .egress-card h3 {
    margin: 0 0 0.5rem;
    font-size: 1.1rem;
    color: #0f172a;
  }

  .egress-card p {
    margin: 0 0 0.5rem;
    font-size: 0.88rem;
    color: #475569;
    line-height: 1.5;
  }

  .pro-tip {
    background: #f8fafc;
    border-radius: 4px;
    padding: 0.6rem 0.85rem;
    font-size: 0.85rem !important;
    color: #1e293b !important;
    margin-bottom: 0 !important;
  }

  .weekday-note {
    background: #f0f9ff;
    padding: 0.6rem 0.85rem;
    border-radius: 4px;
    font-size: 0.85rem !important;
    color: #0369a1 !important;
    margin-bottom: 0 !important;
  }

  /* Accessibility Card */
  .accessibility-card {
    background: #f8fafc;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    padding: 1.25rem;
    margin: 1.5rem 0;
  }

  .accessibility-card h3 {
    margin-top: 0;
    color: #0f172a;
    font-size: 1.1rem;
  }

  .accessibility-card ul {
    margin: 0;
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.88rem;
    color: #334155;
  }

  /* FAQs */
  .faq-list {
