---
// src/pages/privacy-policy.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const pageTitle = "Privacy Policy — World Darts Guide";
const pageDescription = "Privacy Policy for World Darts Guide. Details on data handling, cookies, analytics, and advertising under UK GDPR regulations.";

const breadcrumbItems = [
  { name: 'Privacy Policy' }
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <Breadcrumbs items={breadcrumbItems} />

  <div class="container container-narrow page-content">
    <h1>Privacy Policy</h1>
    <p class="lead">Last updated: October 2026</p>

    <p>
      World Darts Guide ("we", "us", "our") respects your privacy and is committed to protecting your personal data in accordance with the UK General Data Protection Regulation (UK GDPR) and Data Protection Act 2018.
    </p>

    <h2>1. Information We Collect</h2>
    <p>
      We collect standard web traffic logs and anonymous usage analytics when you browse our site, including your browser type, device operating system, pages visited, and referring URLs. We do not require account registration or store sensitive personal identifiers.
    </p>

    <h2>2. Cookies & Advertising</h2>
    <p>
      We use cookies and similar technologies to enhance site performance and serve relevant advertisements. Third-party vendors, including Google, use cookies to serve ads based on prior visits to our website and other sites across the internet:
    </p>
    <ul>
      <li>Users may opt out of personalized advertising by visiting <a href="https://www.google.com/settings/ads" target="_blank" rel="noopener noreferrer nofollow">Google Ads Settings</a>.</li>
      <li>You can configure your browser to reject all or certain cookies.</li>
    </ul>

    <h2>3. Third-Party Links</h2>
    <p>
      Our website contains links to third-party services (such as official broadcasters, SeeTickets, and public transit providers). We do not control and are not responsible for the privacy practices of external websites.
    </p>

    <h2>4. Contact</h2>
    <p>
      For privacy-related inquiries, please contact <a href="mailto:privacy@worlddartsguide.com">privacy@worlddartsguide.com</a>.
    </p>
  </div>
</BaseLayout>

<style>
  .page-content {
    margin-top: 2.5rem;
    margin-bottom: 4rem;
  }
</style>
