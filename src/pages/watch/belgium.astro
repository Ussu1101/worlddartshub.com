---
// src/pages/watch/belgium.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AdSlot from '../../components/AdSlot.astro';
import VerificationBadge from '../../components/VerificationBadge.astro';

const pageTitle = "How to Watch PDC World Darts Championship Live in Belgium — VTM 2 & VTM GO Guide";
const pageDescription = "Official free-to-air TV channels, VTM GO live streaming setup, Belgian session times (CET), and commentary details for the 2026/27 World Darts Championship in Belgium.";

const breadcrumbItems = [
  { name: 'Watch & Stream', url: '/watch/' },
  { name: 'Belgium' }
];

const belgiumFaqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "name": "PDC World Darts Championship Belgium Broadcast Guide",
  "description": pageDescription,
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Which TV channel broadcasts the PDC World Darts Championship in Belgium?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "In Belgium, the PDC World Darts Championship is broadcast live and free-to-air on VTM 2, owned by commercial broadcaster DPG Media under a multi-year rights agreement renewed in 2026 covering premier PDC tournaments for the coming years."
      }
    },
    {
      "@type": "Question",
      "name": "Is VTM 2 free to watch in Belgium?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. VTM 2 is an unencrypted commercial free-to-air television channel included in the basic channel lineup of all Belgian digital television providers, including Telenet, Proximus Pickx, Orange TV, and TV Vlaanderen."
      }
    },
    {
      "@type": "Question",
      "name": "How can I stream World Darts matches online in Belgium?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Belgian viewers can stream live sessions for free via the VTM GO application (available for iOS, Android, and Smart TVs) or on the web at vtm.be/vtmgo. You only need to create a free personal account using an email address and Belgian postal code."
      }
    },
    {
      "@type": "Question",
      "name": "What language is the commentary on VTM 2?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "VTM 2 and VTM GO provide live commentary in Dutch/Flemish, hosted by veteran Belgian sports journalists and darts analysts. Viewers seeking English stage commentary can subscribe to the PDC's direct-to-consumer streaming service, PDCTV."
      }
    },
    {
      "@type": "Question",
      "name": "What time do sessions start in Belgium?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Belgium is in the Central European Time (CET) zone, which is exactly one hour ahead of London time (GMT). Afternoon sessions typically begin at 13:30 CET (12:30 London), and evening sessions begin at 20:00 CET (19:00 London)."
      }
    }
  ]
};
---

<BaseLayout 
  title={pageTitle} 
  description={pageDescription}
  schema={belgiumFaqSchema}
>
  <Breadcrumbs items={breadcrumbItems} />

  <header class="page-hero">
    <div class="container">
      <div class="badge-group">
        <span class="badge badge-accent">BELGIUM BROADCAST GUIDE</span>
        <span class="badge">100% FREE-TO-AIR</span>
      </div>
      <h1>How to Watch the PDC World Darts Championship 2026/27 Live in Belgium</h1>
      <p class="hero-lead">
        Comprehensive guide to watching Dimitri Van den Bergh, Mike De Decker, and the world's best darts players live on VTM 2 and VTM GO across Belgium without subscription fees.
      </p>
    </div>
  </header>

  <div class="container main-layout">
    <article class="content-body">
      <VerificationBadge verifiedDate="October 2026" topic="DPG Media (VTM) Broadcast Agreement & Platform Setup" />

      <!-- Quick Summary Card -->
      <section class="summary-box">
        <div class="summary-grid">
          <div class="summary-item">
            <span class="summary-label">Primary Broadcaster</span>
            <span class="summary-val">VTM 2 (DPG Media)</span>
          </div>
          <div class="summary-item">
            <span class="summary-label">Digital Streaming</span>
            <span class="summary-val">VTM GO (App & Browser)</span>
          </div>
          <div class="summary-item">
            <span class="summary-label">Cost / Access</span>
            <span class="summary-val status-free">100% Free-to-Air</span>
          </div>
          <div class="summary-item">
            <span class="summary-label">Commentary Language</span>
            <span class="summary-val">Flemish / Dutch (PDCTV for English)</span>
          </div>
          <div class="summary-item">
            <span class="summary-label">Belgian Time Zone</span>
            <span class="summary-val">CET (UTC+1, London +1 hour)</span>
          </div>
          <div class="summary-item">
            <span class="summary-label">Rights Validity</span>
            <span class="summary-val">Multi-Year Deal (for the coming years)</span>
          </div>
        </div>
      </section>

      <!-- Source Attribution & Rights Scope Breakdown -->
      <section class="content-section">
        <h2>Official Rights Framework & Primary Source Attribution</h2>
        <p>
          Broadcast rights for professional darts in Belgium are governed by the landmark agreement between the <strong>Professional Darts Corporation (PDC)</strong> and commercial media leader <strong>DPG Media</strong>, officially renewed in <strong>2026</strong>.
        </p>
        <p>
          According to the authoritative 2026 rights announcement, the scope of coverage is structured as follows:
        </p>
        <ul>
          <li><strong>2026/27 World Darts Championship:</strong> Complete live coverage of every session from Alexandra Palace (11 December 2026 – 3 January 2027) broadcast free-to-air on linear television via <strong>VTM 2</strong> and streamed free via <strong>VTM GO</strong>.</li>
          <li><strong>Broader Premier PDC Tournaments:</strong> The multi-year renewal grants DPG Media exclusive Flemish free-to-air coverage for the PDC's premier televised majors—including the World Matchplay, World Grand Prix, Grand Slam of Darts, and the Premier League—for the <em>coming years</em>.</li>
          <li><strong>European Tour Coverage Distinction:</strong> Coverage of European Tour stages (including the Flanders Darts Trophy and Belgian Darts Open) operates under distinct scheduling frameworks, with selected live broadcasts and highlights scheduled across VTM GO and linear windows.</li>
        </ul>
        <p>
          <em>Primary Source Citation: PDC & DPG Media (VTM) Official Broadcast Partnership Announcement (2026). Last verified: October 2026.</em>
        </p>
      </section>

      <!-- TV Broadcaster Overview -->
      <section class="content-section">
        <h2>Live Television Coverage on VTM 2</h2>
        <p>
          Belgian darts coverage has experienced an extraordinary boom, driven by historic major titles for Belgian players on the PDC ProTour and European Tour. In Belgium, darts is established as a major mainstream television sport, with <strong>VTM 2</strong> serving as the official home of the PDC World Darts Championship.
        </p>
        <p>
          Unlike in neighboring territories such as the United Kingdom or the Netherlands—where championship darts is locked behind premium pay-TV subscriptions—Belgian fans enjoy <strong>unrestricted, free-to-air linear television access</strong> throughout the entire tournament from Alexandra Palace (11 December 2026 – 3 January 2027).
        </p>

        <h3>Where to Find VTM 2 on Belgian TV Packages</h3>
        <p>
          VTM 2 is included in the base package of all major telecommunications and cable providers in Belgium. You do not need to order a separate sports tier (such as Play Sports or Pickx Sports):
        </p>

        <div class="table-responsive">
          <table class="data-table">
            <thead>
              <tr>
                <th>TV Provider</th>
                <th>Standard Channel Position</th>
                <th>Coverage Region</th>
                <th>Access Tier</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>Telenet</strong></td>
                <td>Channel 7 (Flanders) / Channel 8 (Brussels)</td>
                <td>Flanders & Brussels</td>
                <td>Basic TV (Included)</td>
              </tr>
              <tr>
                <td><strong>Proximus Pickx</strong></td>
                <td>Channel 6 (Dutch list) / Channel 11</td>
                <td>National (All regions)</td>
                <td>Basic TV (Included)</td>
              </tr>
              <tr>
                <td><strong>Orange TV</strong></td>
                <td>Channel 7</td>
                <td>National (All regions)</td>
                <td>Basic TV (Included)</td>
              </tr>
              <tr>
                <td><strong>TV Vlaanderen</strong></td>
                <td>Channel 7 (Satellite Astra 19.2°E / 23.5°E)</td>
                <td>National & Satellite subscribers</td>
                <td>Basic Pack (Included)</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <AdSlot position="mid-content" format="in-article" />

      <!-- Streaming on VTM GO -->
      <section class="content-section">
        <h2>How to Stream Online Free on VTM GO</h2>
        <p>
          If you do not have a traditional television set or prefer watching on a mobile phone, tablet, computer, or casting to your smart TV, DPG Media provides live online streaming via its dedicated OTT platform, <strong>VTM GO</strong>.
        </p>

        <div class="steps-container">
          <div class="step-card">
            <span class="step-number">1</span>
            <div class="step-body">
              <h4>Download the App or Open the Web Portal</h4>
              <p>
                Visit <a href="https://vtm.be/vtmgo" target="_blank" rel="noopener noreferrer">vtm.be/vtmgo</a> in any modern browser, or download the free <strong>VTM GO</strong> application from the Apple App Store, Google Play Store, or your Smart TV app marketplace (Samsung Tizen, LG webOS, Android TV, Apple TV).
              </p>
            </div>
          </div>

          <div class="step-card">
            <span class="step-number">2</span>
            <div class="step-body">
              <h4>Create a Free DPG Media Account</h4>
              <p>
                Registration is completely free of charge. You will be prompted to provide an email address, create a password, and indicate your Belgian residence. <strong>No credit card or banking details are ever requested</strong> for standard free VTM GO viewing.
              </p>
            </div>
          </div>

          <div class="step-card">
            <span class="step-number">3</span>
            <div class="step-body">
              <h4>Select the Live Stream or On-Demand Replay</h4>
              <p>
                Navigate to the <em>Live TV</em> section and select <strong>VTM 2</strong> during active session windows. Full match sessions and highlight packages are also archived in the sports catalog for convenient on-demand catch-up viewing.
              </p>
            </div>
          </div>
        </div>

        <div class="callout tip-callout">
          <strong>💡 EU Roaming / Travel Note:</strong> If you are a Belgian resident traveling within the European Union during the festive holidays (such as visiting France, Germany, or Spain), EU cross-border digital portability regulations permit you to access your Belgian VTM GO account while abroad, provided your Belgian profile verification is completed prior to departure.
        </div>
      </section>

      <!-- Belgian Session Times -->
      <section class="content-section">
        <h2>Belgian Session Times (Central European Time / CET)</h2>
        <p>
          London operates on Greenwich Mean Time (GMT / UTC+0), whereas Brussels and all of Belgium operate on <strong>Central European Time (CET / UTC+1)</strong>. Belgian viewers must tune in <strong>one hour ahead</strong> of London schedule listings:
        </p>

        <div class="session-schedule-grid">
          <div class="session-card">
            <div class="session-badge">AFTERNOON SESSIONS</div>
            <div class="session-time">13:30 CET</div>
            <p class="session-sub">12:30 London GMT • 4 Matches per session</p>
            <p class="session-desc">
              Rounds 1–3 and Quarter-Finals stage daytime matches. VTM 2 broadcast coverage typically opens 15 minutes before the first walk-on.
            </p>
          </div>

          <div class="session-card">
            <div class="session-badge">EVENING SESSIONS</div>
            <div class="session-time">20:00 CET</div>
            <p class="session-sub">19:00 London GMT • 4 Matches (Semi-Finals/Final: 1-2 matches)</p>
            <p class="session-desc">
              Prime-time evening sessions, including the Semi-Finals (2 January 2027) and the Grand Final (3 January 2027 at 21:00 CET).
            </p>
          </div>
        </div>
      </section>

      <!-- Belgian Stars & Local Interest -->
      <section class="content-section">
        <h2>The Belgian Darts Golden Era at Alexandra Palace</h2>
        <p>
          Belgium has emerged as one of the most formidable nations on the PDC global circuit. Belgian television broadcasts draw massive viewing figures when domestic stars step onto the Alexandra Palace stage:
        </p>

        <div class="player-highlight-grid">
          <div class="player-card">
            <h4>Dimitri Van den Bergh ("The DreamMaker")</h4>
            <p>
              Former World Matchplay Champion, UK Open Champion, and two-time World Youth Champion. Dimitri has reached the World Championship semi-finals and remains Belgium's premier international darts icon.
            </p>
          </div>

          <div class="player-card">
            <h4>Mike De Decker ("The Real Deal")</h4>
            <p>
              The 2024 World Grand Prix champion whose breakthrough double-in, double-out triumph solidified Belgium's status as a top-tier darts superpower, sparking even greater television demand across Flanders.
            </p>
          </div>

          <div class="player-card">
            <h4>Kim Huybrechts ("The Hurricane")</h4>
            <p>
              A veteran pioneer of Belgian professional darts with over a decade of elite PDC experience, multiple ProTour titles, and historic World Cup of Darts final appearances alongside his compatriot teammates.
            </p>
          </div>
        </div>
      </section>

      <!-- English Commentary Alternative -->
      <section class="content-section">
        <h2>English Commentary Alternative: PDCTV in Belgium</h2>
        <p>
          While VTM 2 provides high-caliber Flemish commentary, some international residents and purists residing in Belgium prefer the original British stage commentary from Sky Sports broadcasters (Wayne Mardle, John Part, Mark Webster, Stuart Pyke).
        </p>
        <p>
          Belgian residents can purchase a direct subscription to <strong>PDCTV</strong> (<a href="https://video.pdc.tv" target="_blank" rel="noopener noreferrer">video.pdc.tv</a>), the PDC's official international streaming portal. PDCTV offers:
        </p>
        <ul>
          <li>Official English live commentary direct from Alexandra Palace.</li>
          <li>High-definition multi-device web and mobile app feeds.</li>
          <li>Access to tournament press conferences, player interviews, and archive footage.</li>
        </ul>
        <p>
          <em>Note: Because VTM 2 holds non-exclusive or terrestrial rights in Belgium, PDCTV is generally available for purchase without territorial blackout restrictions. Check official PDCTV availability at tournament commencement.</em>
        </p>
      </section>

      <!-- Frequently Asked Questions -->
      <section class="content-section faq-section">
        <h2>Frequently Asked Questions: Watching in Belgium</h2>

        <div class="faq-accordion">
          <details class="faq-item" open>
            <summary>Do I need to pay anything to watch VTM 2 in Belgium?</summary>
            <div class="faq-content">
              <p>
                No. VTM 2 is an open commercial channel included as standard in every Belgian cable, fiber, and satellite subscription. There is no paywall or additional monthly charge.
              </p>
            </div>
          </details>

          <details class="faq-item">
            <summary>Can I cast VTM GO to my TV using Chromecast or AirPlay?</summary>
            <div class="faq-content">
              <p>
                Yes. The VTM GO app for iOS and Android fully supports Google Cast (Chromecast) and Apple AirPlay, allowing you to beam live matches directly from your phone to any television screen in HD.
              </p>
            </div>
          </details>

          <details class="faq-item">
            <summary>Does RTBF broadcast darts in Wallonia (French-speaking Belgium)?</summary>
            <div class="faq-content">
              <p>
                RTBF (the French-language public broadcaster) does not currently hold live broadcast rights for the PDC World Darts Championship. However, VTM 2 is distributed nationwide on cable networks (including Proximus and Orange) throughout Wallonia and Brussels, meaning French-speaking fans can still watch the live pictures on VTM 2 or via VTM GO.
              </p>
            </div>
          </details>
        </div>
      </section>
    </article>

    <aside class="sidebar">
      <div class="widget card">
        <h3 class="widget-title">Broadcasting Directory</h3>
        <p class="sidebar-micro">Explore viewing guides across other countries:</p>
        <ul class="widget-list">
          <li><a href="/watch/free-streams/">🆓 Legal Free Streams Guide</a></li>
          <li><a href="/watch/germany/">🇩🇪 Germany (Sport1 & DAZN)</a></li>
          <li><a href="/watch/austria-switzerland/">🇦🇹/🇨🇭 Austria & Switzerland</a></li>
          <li><a href="/watch/netherlands/">🇳🇱 Netherlands (Viaplay)</a></li>
          <li><a href="/watch/uk/">🇬🇧 United Kingdom (Sky Sports)</a></li>
          <li><a href="/watch/usa/">🇺🇸 United States (ESPN & Peacock)</a></li>
          <li><a href="/watch/broadcaster-history/">📜 Broadcaster Rights History</a></li>
        </ul>
      </div>

      <div class="widget card">
        <h3 class="widget-title">Tournament Resources</h3>
        <ul class="widget-list">
          <li><a href="/schedule/">Full 2026/27 Schedule (CET)</a></li>
          <li><a href="/schedule/finals-weekend/">Finals Weekend Times</a></li>
          <li><a href="/tournament/prize-money/">£5M Prize Fund Breakdown</a></li>
          <li><a href="/tournament/order-of-merit/">PDC Order of Merit Rankings</a></li>
          <li><a href="/draw/">Tournament Bracket & Draw</a></li>
        </ul>
      </div>

      <AdSlot position="sidebar" format="box" />
    </aside>
  </div>
</BaseLayout>

<style>
  .page-hero {
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
    color: #ffffff;
    padding: 3rem 0 2.5rem;
    border-bottom: 1px solid #334155;
  }

  .badge-group {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }

  .badge {
    display: inline-block;
    padding: 0.25rem 0.65rem;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-radius: 4px;
    background-color: #334155;
    color: #f8fafc;
  }

  .badge-accent {
    background-color: #f59e0b;
    color: #0f172a;
  }

  .page-hero h1 {
    font-size: 2.2rem;
    font-weight: 900;
    line-height: 1.2;
    margin-bottom: 1rem;
    color: #ffffff;
    letter-spacing: -0.02em;
  }

  .hero-lead {
    font-size: 1.1rem;
    line-height: 1.6;
    color: #cbd5e1;
    max-width: 820px;
    margin-bottom: 0;
  }

  .main-layout {
    display: grid;
    grid-template-columns: 2.6fr 1fr;
    gap: 2.5rem;
    padding-top: 2rem;
    padding-bottom: 4rem;
  }

  .summary-box {
    background-color: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .summary-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .summary-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .summary-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: #64748b;
  }

  .summary-val {
    font-size: 0.95rem;
    font-weight: 700;
    color: #0f172a;
  }

  .status-free {
    color: #16a34a;
  }

  .content-section {
    margin-bottom: 2.75rem;
  }

  .content-section h2 {
    font-size: 1.5rem;
    color: #0f172a;
    font-weight: 800;
    border-bottom: 2px solid #e2e8f0;
    padding-bottom: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .content-section h3 {
    font-size: 1.2rem;
    color: #1e293b;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
  }

  .content-section p {
    font-size: 0.96rem;
    line-height: 1.7;
    color: #334155;
    margin-bottom: 1rem;
  }

  .table-responsive {
    overflow-x: auto;
    margin: 1.25rem 0;
  }

  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.88rem;
    text-align: left;
  }

  .data-table th {
    background-color: #0f172a;
    color: #ffffff;
    padding: 0.75rem 0.85rem;
    font-weight: 700;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .data-table td {
    padding: 0.75rem 0.85rem;
    border-bottom: 1px solid #e2e8f0;
    vertical-align: middle;
  }

  .data-table tr:hover {
    background-color: #f1f5f9;
  }

  .steps-container {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin: 1.5rem 0;
  }

  .step-card {
    display: flex;
    gap: 1.25rem;
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 1.25rem;
    align-items: flex-start;
  }

  .step-number {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    background-color: #0f172a;
    color: #ffffff;
    font-weight: 800;
    border-radius: 50%;
    flex-shrink: 0;
    font-size: 1rem;
  }

  .step-body h4 {
    margin: 0 0 0.35rem;
    font-size: 1.05rem;
    color: #0f172a;
  }

  .step-body p {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.6;
    color: #475569;
  }

  .tip-callout {
    background-color: #eff6ff;
    border-left: 4px solid #3b82f6;
    padding: 1rem 1.25rem;
    border-radius: 4px;
    margin: 1.5rem 0;
    font-size: 0.92rem;
    line-height: 1.6;
    color: #1e3a8a;
  }

  .session-schedule-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
    margin-top: 1.25rem;
  }

  .session-card {
    background: #f8fafc;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    padding: 1.25rem;
  }

  .session-badge {
    font-size: 0.75rem;
    font-weight: 800;
    color: #0284c7;
    letter-spacing: 0.05em;
    margin-bottom: 0.35rem;
  }

  .session-time {
    font-size: 1.6rem;
    font-weight: 900;
    color: #0f172a;
    line-height: 1.2;
    margin-bottom: 0.25rem;
  }

  .session-sub {
    font-size: 0.82rem;
    color: #64748b;
    margin-bottom: 0.65rem;
    font-weight: 600;
  }

  .session-desc {
    font-size: 0.88rem;
    line-height: 1.55;
    color: #475569;
    margin: 0;
  }

  .player-highlight-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-top: 1.25rem;
  }

  .player-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 1.25rem;
  }

  .player-card h4 {
    margin: 0 0 0.35rem;
    color: #0f172a;
    font-size: 1.05rem;
  }

  .player-card p {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.6;
    color: #475569;
  }

  .faq-accordion {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin-top: 1.25rem;
  }

  .faq-item {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 1rem 1.25rem;
  }

  .faq-item summary {
    font-weight: 700;
    color: #0f172a;
    cursor: pointer;
    font-size: 1rem;
    line-height: 1.4;
  }

  .faq-content {
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid #f1f5f9;
  }

  .faq-content p {
    font-size: 0.92rem;
    line-height: 1.6;
    color: #475569;
    margin: 0;
  }

  .sidebar {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .widget {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
