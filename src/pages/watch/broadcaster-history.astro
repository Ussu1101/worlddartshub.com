    color: #ffffff;
    padding: 3rem 0 2.5rem;
    border-bottom: 1px solid #334155;
  }

  .badge-group {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }

  .badge {
    display: inline-block;
    padding: 0.25rem 0.65rem;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-radius: 4px;
    background-color: #334155;
    color: #f8fafc;
  }

  .badge-accent {
    background-color: #d97706;
    color: #ffffff;
  }

  .page-hero h1 {
    font-size: 2.2rem;
    font-weight: 900;
    line-height: 1.2;
    margin-bottom: 1rem;
    color: #ffffff;
    letter-spacing: -0.02em;
  }

