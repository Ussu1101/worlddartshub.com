    color: #0f172a;
    font-weight: 800;
    border-bottom: 2px solid #e2e8f0;
    padding-bottom: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .content-section p {
    font-size: 0.96rem;
    line-height: 1.7;
    color: #334155;
    margin-bottom: 1rem;
  }

  .timeline-container {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
