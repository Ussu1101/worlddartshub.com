    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid #f1f5f9;
  }

  .faq-content p {
    font-size: 0.92rem;
    line-height: 1.6;
    color: #475569;
    margin: 0;
  }

  .sidebar {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .widget {
    background: #ffffff;
    border: 1px solid #e2e8f0;
