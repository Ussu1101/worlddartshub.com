    border-radius: 4px;
    white-space: nowrap;
  }

  .timeline-content {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 1.25rem;
    margin-left: 0.5rem;
  }

  .timeline-content h3 {
    font-size: 1.15rem;
    color: #0f172a;
    margin: 0 0 0.5rem;
  }

  .timeline-content p {
    font-size: 0.92rem;
    line-height: 1.6;
    color: #475569;
    margin-bottom: 0.75rem;
  }

  .timeline-content p:last-child {
    margin-bottom: 0;
  }

  .timeline-content ul {
    padding-left: 1.25rem;
    margin-bottom: 0.5rem;
  }

  .timeline-content li {
    font-size: 0.9rem;
    line-height: 1.55;
