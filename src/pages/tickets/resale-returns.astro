---
// src/pages/tickets/resale-returns.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AdSlot from '../../components/AdSlot.astro';
import VerificationBadge from '../../components/VerificationBadge.astro';
import ticketingData from '../../data/ticketing.json';

const pageTitle = "PDC World Darts Ticket Resale & Returns Guide 2026/27 — Official Fan-to-Fan Rules";
const pageDescription = "Authoritative guide to official See Tickets Fan-to-Fan resale, barcode security, face-value rules, production returns, and avoiding secondary ticket tout scams for Alexandra Palace.";

const breadcrumbItems = [
  { name: 'Tickets', url: '/tickets/' },
  { name: 'Official Resale & Returns' }
];

const ticketingFaqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "name": "PDC World Darts Championship Ticket Resale & Returns FAQ",
  "description": pageDescription,
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the only official ticket resale platform for the PDC World Darts Championship?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The See Tickets Fan-to-Fan Resale Marketplace is the only authorized, PDC-sanctioned resale platform. Any other marketplace is unauthorized and puts purchasers at risk of ticket cancellation."
      }
    },
    {
      "@type": "Question",
      "name": "How does See Tickets Fan-to-Fan protect buyers against counterfeit tickets?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "When a ticket is resold on See Tickets Fan-to-Fan, the original seller's digital barcode is immediately canceled and invalidated. A brand-new, unique encrypted barcode is automatically generated directly into the buyer's official See Tickets account, ensuring guaranteed legitimate admission."
      }
    },
    {
      "@type": "Question",
      "name": "Can sellers charge higher prices on the official resale platform?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. The See Tickets Fan-to-Fan platform strictly caps resale prices at original face value plus standard nominal booking fees. Profiteering or price gouging is prohibited by PDC regulations."
      }
    },
    {
      "@type": "Question",
      "name": "Are tickets bought on Viagogo or StubHub valid for entry at Alexandra Palace?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Under PDC Official Ticketing Terms & Conditions, tickets purchased or resold via unauthorized secondary platforms (such as Viagogo, StubHub, Gigsberg, or social media touts) breach conditions of sale and are liable to cancellation without refund. Event security reserves the right to refuse admission to anyone holding unauthorized resale tickets."
      }
    },
    {
      "@type": "Question",
      "name": "Can I get a refund if I can no longer attend a session?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Primary ticket purchases are strictly non-refundable through See Tickets unless a session is canceled by the PDC. If you cannot attend, your only authorized option is to list your tickets for resale at face value via the official See Tickets Fan-to-Fan platform."
      }
    }
  ]
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  schema={ticketingFaqSchema}
>
  <Breadcrumbs items={breadcrumbItems} />

  <header class="ticket-hero">
    <div class="container">
      <div class="badge-group">
        <span class="badge badge-accent">OFFICIAL TICKETING UTILITY</span>
        <span class="badge">SEE TICKETS AUTHORIZED PLATFORM</span>
      </div>
      <h1 class="ticket-title">PDC World Darts Ticket Resale & Returns Guide 2026/27</h1>
      <p class="ticket-subtitle">
        How to legally buy and sell spare World Darts Championship tickets at face value, understand digital barcode re-issuance, and protect yourself against unauthorized secondary ticket scams.
      </p>
      <div class="hero-meta">
        <span class="meta-item">🎟️ Primary Partner: See Tickets</span>
        <span class="meta-item">🛡️ Authorized Resale: Fan-to-Fan Only</span>
        <span class="meta-item">📅 Policy Verified: October 2026</span>
      </div>
    </div>
  </header>

  <main class="container content-container">
    <div class="ticket-layout">
      <!-- Main Content -->
      <article class="ticket-main">

        <!-- QUICK ALERT BOX -->
        <section class="alert-box-warning">
          <div class="alert-icon">⚠️</div>
          <div class="alert-content">
            <h2>Authorized Resale Notice: PDC Ticketing Conditions</h2>
            <p>
              Under official PDC Ticketing Terms and Conditions, tickets resold through unauthorized secondary ticketing platforms are <strong>liable to cancellation without refund</strong>, and holders may be refused admission at Alexandra Palace.
            </p>
            <p>
              The <strong>sole authorized platform</strong> recognized by the PDC to buy or sell spare tickets is the official <strong>See Tickets Fan-to-Fan Resale Marketplace</strong>, where tickets are capped at face value and issued with verified barcodes.
            </p>
          </div>
        </section>

        <AdSlot position="top" client="ca-pub-placeholder" slotId="tickets-top-slot" />

        <!-- HOW SEE TICKETS FAN-TO-FAN WORKS -->
        <section class="ticket-section">
          <h2>How See Tickets Fan-to-Fan Resale Operates</h2>
          <p>
            With all 28 sessions of the World Darts Championship traditionally selling out within hours of general release, the See Tickets Fan-to-Fan platform provides the only secure mechanism for genuine darts fans to trade spare tickets legitimately.
          </p>

          <div class="mechanism-steps-grid">
            <div class="mech-step">
              <div class="step-badge">1</div>
              <h3>Seller Lists at Face Value</h3>
              <p>
                A verified original purchaser unable to attend logs into their See Tickets account and selects their seats. By regulation, the resale price is locked at original face value (no markups or surge pricing permitted).
              </p>
            </div>

            <div class="mech-step">
              <div class="step-badge">2</div>
              <h3>Buyer Completes Purchase</h3>
              <p>
                Another fan browses available sessions on the See Tickets Fan-to-Fan portal and buys the tickets, paying face value plus standard booking and processing fees.
              </p>
            </div>

            <div class="mech-step">
              <div class="step-badge">3</div>
              <h3>Automatic Barcode Invalidation</h3>
              <p>
                The instant payment confirms, See Tickets cancels the seller's original digital barcode. The seller's PDF or in-app ticket is permanently deactivated.
              </p>
            </div>

            <div class="mech-step">
              <div class="step-badge">4</div>
              <h3>Brand-New Barcode Issued</h3>
              <p>
                A completely new, encrypted dynamic barcode is deposited directly into the buyer's official See Tickets account, ensuring 100% guaranteed admission at Palm Court scanners.
              </p>
            </div>
          </div>
        </section>

        <!-- PRIORITY SALES TIMELINE -->
        <section class="ticket-section">
          <h2>PDC World Championship Ticketing Phases</h2>
          <p>
            Securing primary or resale tickets requires understanding the three official release stages implemented by the PDC each season:
          </p>

          <div class="timeline-stack">
            {ticketingData.priority_windows.map((window, idx) => (
              <div class="timeline-card">
                <div class="timeline-header">
                  <span class="timeline-pill">STAGE {idx + 1}</span>
                  <h3>{window.phase}</h3>
                  <span class="timeline-date">{window.timing_typical}</span>
                </div>
                <div class="timeline-body">
                  <p><strong>Eligibility:</strong> {window.eligibility}</p>
                  <p class="timeline-notes"><strong>How it works:</strong> {window.notes}</p>
                </div>
              </div>
            ))}
          </div>
        </section>

        <!-- FACE VALUE BENCHMARK -->
        <section class="ticket-section">
          <h2>Official Face-Value Pricing Benchmarks</h2>
          <p>
            Always know the genuine face-value rate before buying. The PDC structures pricing into tiered seating categories across early rounds and finals weekend:
          </p>

          <div class="pricing-grid">
            {ticketingData.face_value_tiers.map(tier => (
              <div class="pricing-card">
                <div class="pricing-tier-header">
                  <h3>{tier.tier}</h3>
                  <span class="price-figure">{tier.price_range}</span>
                </div>
                <p class="pricing-desc">{tier.description}</p>
                <div class="pricing-meta">
                  <span class="fee-note">ℹ️ {tier.booking_fee}</span>
                </div>
              </div>
            ))}
          </div>
          <p class="disclaimer-text">
            <em>Note: Hospitality and VIP packages (offering pre-match fine dining, complimentary bar, and priority player access) are sold separately via official PDC hospitality partners starting at £250–£450+ per guest.</em>
          </p>
        </section>

        <!-- UNAUTHORIZED RESALE SCAMS -->
        <section class="ticket-section scam-warning-section">
          <h2>Unauthorized Secondary Marketplaces & Ticket Risks</h2>
          <p>
            Commercial secondary ticketing websites frequently list Alexandra Palace tickets at inflated prices. However, under official PDC Ticketing Terms and Conditions, tickets offered or purchased through unauthorized platforms are strictly invalid and liable to cancellation.
          </p>

          <div class="banned-platforms-card">
            <h3>Unauthorized Secondary Portals</h3>
            <div class="tags-cloud">
              {ticketingData.rules_and_restrictions.unauthorized_resale_risk.platforms_unauthorized.map(platform => (
                <span class="platform-tag">⚠️ {platform}</span>
              ))}
            </div>
            <div class="consequence-box">
              <h4>PDC Ticketing Terms & Enforcement:</h4>
              <p>{ticketingData.rules_and_restrictions.unauthorized_resale_risk.consequence}</p>
            </div>
            <div class="fraud-callout">
              <h4>🚨 Social Media & Private Sale Risks</h4>
              <p>{ticketingData.rules_and_restrictions.unauthorized_resale_risk.scam_alert}</p>
            </div>
          </div>
        </section>

        <!-- HOW TO SNIPE RESALE TICKETS -->
        <section class="ticket-section">
          <h2>How to Successfully Secure Fan-to-Fan Resale Tickets</h2>
          <p>
            Because demand for December sessions is immense, tickets listed on See Tickets Fan-to-Fan are snapped up quickly. Follow these proven recommendations to improve your chances:
          </p>

          <div class="tips-grid">
            <div class="tip-card">
              <h4>1. Set Up Your See Tickets Account Early</h4>
              <p>Create and verify your See Tickets account with stored payment details and mobile number well in advance so you can checkout in under 30 seconds when seats appear.</p>
            </div>
            <div class="tip-card">
              <h4>2. Check Frequently in Mid-November & December</h4>
              <p>Resale volume peaks 2 to 3 weeks before the tournament begins as fans finalize their holiday travel plans and work schedules.</p>
            </div>
            <div class="tip-card">
              <h4>3. Look for Production Hold Releases</h4>
              <p>In early December, once television camera positions, commentary rigs, and lighting gantries are constructed inside the Great Hall, the PDC routinely releases surplus production hold tickets directly onto See Tickets.</p>
            </div>
            <div class="tip-card">
              <h4>4. Afternoon Sessions Offer Higher Availability</h4>
              <p>Weekday afternoon sessions (12:30 starts) have significantly higher turnover and lower resale competition than Friday and Saturday evening sessions.</p>
            </div>
          </div>
        </section>

        <AdSlot position="middle" client="ca-pub-placeholder" slotId="tickets-mid-slot" />

        <!-- FAQ SECTION -->
        <section class="ticket-section">
          <h2>Frequently Asked Questions: Resale & Returns</h2>
          <div class="faq-list">
            {ticketingFaqSchema.mainEntity.map(faq => (
              <div class="faq-item">
                <h3>{faq.name}</h3>
                <p>{faq.acceptedAnswer.text}</p>
              </div>
            ))}
          </div>
        </section>

        <!-- VERIFICATION COMPONENT -->
        <VerificationBadge
          source={ticketingData.source}
          verifiedDate={ticketingData.last_verified}
          status="CONFIRMED PDC & SEE TICKETS TERMS"
        />

      </article>

      <!-- Sidebar -->
      <aside class="ticket-sidebar">
        <div class="sidebar-widget">
          <h3 class="widget-title">Resale Quick Reference</h3>
          <ul class="glance-list">
            <li><strong>Official Resale:</strong> See Tickets Fan-to-Fan</li>
            <li><strong>Price Cap:</strong> Face Value Only</li>
            <li><strong>Barcode Security:</strong> Digital re-issue on sale</li>
            <li><strong>Viagogo / StubHub:</strong> Unauthorized (liable to cancellation)</li>
            <li><strong>Primary Refunds:</strong> Non-refundable</li>
            <li><strong>Ticket Delivery:</strong> In-app digital tickets</li>
          </ul>
        </div>

        <div class="sidebar-widget">
          <h3 class="widget-title">Official Ticketing Links</h3>
          <div class="link-btn-group">
            <a href="https://www.pdc.tv/tickets" target="_blank" rel="noopener noreferrer" class="btn-primary">
              Official PDC Tickets Portal ↗
            </a>
            <a href="https://www.seetickets.com" target="_blank" rel="noopener noreferrer" class="btn-secondary">
              See Tickets Official Site ↗
            </a>
          </div>
        </div>

        <div class="sidebar-widget">
          <h3 class="widget-title">Spectator Planning</h3>
          <ul class="widget-links">
            <li><a href="/tickets/">Tickets Overview & Pricing</a></li>
            <li><a href="/venue/great-hall-seating-plan/">Seating Plan & Tables vs Bleachers</a></li>
            <li><a href="/venue/security-bag-policy/">Security & Bag Limit Rules</a></li>
            <li><a href="/travel/tube-train-routes/">London Travel & Tube Guide</a></li>
            <li><a href="/hotels/budget-options/">Budget Hotel Recommendations</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </main>
</BaseLayout>

<style>
  .ticket-hero {
    background: linear-gradient(135deg, #091e3a 0%, #172554 100%);
    color: #ffffff;
    padding: 3rem 0;
    border-bottom: 1px solid #1e3a8a;
  }

  .badge-group {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }

  .badge {
    background: #1e3a8a;
    color: #bfdbfe;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.65rem;
    border-radius: 4px;
    letter-spacing: 0.05em;
  }

  .badge-accent {
    background: #2563eb;
    color: #ffffff;
  }

  .ticket-title {
    font-size: 2.25rem;
    font-weight: 800;
    margin: 0 0 1rem;
    line-height: 1.2;
  }

  .ticket-subtitle {
    font-size: 1.15rem;
    color: #cbd5e1;
    max-width: 820px;
    margin: 0 0 1.5rem;
    line-height: 1.5;
  }

  .hero-meta {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    font-size: 0.85rem;
    color: #94a3b8;
  }

  .content-container {
    padding-top: 2rem;
    padding-bottom: 4rem;
  }

  .ticket-layout {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 2.5rem;
  }

  /* Alert Box */
  .alert-box-warning {
    display: flex;
    gap: 1.25rem;
    background: #fffbeb;
    border: 2px solid #f59e0b;
    border-radius: 12px;
    padding: 1.5rem;
    margin-bottom: 2rem;
  }

  .alert-icon {
    font-size: 2rem;
    line-height: 1;
  }

  .alert-content h2 {
    color: #92400e;
    margin-top: 0;
    margin-bottom: 0.5rem;
    font-size: 1.35rem;
  }

  .alert-content p {
    color: #78350f;
    margin: 0 0 0.5rem;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .alert-content p:last-child {
    margin-bottom: 0;
  }

  /* Mechanism Steps Grid */
  .mechanism-steps-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.25rem;
    margin: 1.5rem 0;
  }

  .mech-step {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 1.25rem;
    position: relative;
  }

  .step-badge {
    display: inline-block;
    width: 30px;
    height: 30px;
    line-height: 30px;
    text-align: center;
    background: #2563eb;
    color: #ffffff;
    font-weight: 800;
    border-radius: 50%;
    margin-bottom: 0.75rem;
    font-size: 0.9rem;
  }

  .mech-step h3 {
    margin: 0 0 0.5rem;
    font-size: 1.05rem;
    color: #0f172a;
  }

  .mech-step p {
    margin: 0;
    font-size: 0.88rem;
    color: #475569;
    line-height: 1.45;
  }

  /* Timeline */
  .timeline-stack {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin: 1.5rem 0;
  }

  .timeline-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 1.25rem;
  }

  .timeline-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
  }

  .timeline-pill {
    background: #0f172a;
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 800;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
  }

  .timeline-header h3 {
    margin: 0;
    font-size: 1.15rem;
    color: #1e293b;
    flex: 1;
  }

  .timeline-date {
    font-size: 0.85rem;
    font-weight: 700;
    color: #2563eb;
    background: #eff6ff;
    padding: 0.25rem 0.6rem;
    border-radius: 4px;
  }

  .timeline-body p {
    margin: 0 0 0.4rem;
    font-size: 0.9rem;
    color: #334155;
  }

  .timeline-notes {
    color: #64748b !important;
    font-size: 0.85rem !important;
  }

  /* Pricing Grid */
  .pricing-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
    margin: 1.5rem 0;
  }

  .pricing-card {
    background: #f8fafc;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    padding: 1.25rem;
  }

  .pricing-tier-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.5rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .pricing-tier-header h3 {
    margin: 0;
    font-size: 1.1rem;
    color: #0f172a;
  }

  .price-figure {
    font-size: 1.1rem;
    font-weight: 800;
    color: #047857;
  }

  .pricing-desc {
    font-size: 0.88rem;
    color: #475569;
    margin: 0 0 0.75rem;
    line-height: 1.4;
  }

  .fee-note {
    font-size: 0.78rem;
    color: #64748b;
  }

  /* Scam warning section */
  .scam-warning-section {
    background: #fef2f2;
    border: 1px solid #fee2e2;
    border-radius: 8px;
    padding: 1.5rem;
    margin: 2rem 0;
  }

  .scam-warning-section h2 {
    color: #991b1b;
    margin-top: 0;
  }

  .banned-platforms-card {
    background: #ffffff;
    border: 1px solid #fecaca;
    border-radius: 8px;
    padding: 1.25rem;
    margin-top: 1rem;
  }

  .banned-platforms-card h3 {
    margin-top: 0;
    color: #b91c1c;
    font-size: 1.05rem;
  }

  .tags-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .platform-tag {
    background: #fee2e2;
    color: #991b1b;
    font-size: 0.82rem;
    font-weight: 700;
    padding: 0.25rem 0.6rem;
    border-radius: 4px;
    border: 1px solid #fca5a5;
  }

  .consequence-box {
    background: #fff1f2;
    border-left: 4px solid #e11d48;
    padding: 0.75rem 1rem;
    margin-bottom: 1rem;
    border-radius: 4px;
  }

  .consequence-box h4 {
    margin: 0 0 0.25rem;
    color: #9f1239;
    font-size: 0.95rem;
  }

  .consequence-box p {
    margin: 0;
    font-size: 0.88rem;
    color: #881337;
    line-height: 1.45;
  }

  .fraud-callout {
    background: #fff7ed;
    border-left: 4px solid #f97316;
    padding: 0.75rem 1rem;
    border-radius: 4px;
  }

  .fraud-callout h4 {
    margin: 0 0 0.25rem;
    color: #9a3412;
    font-size: 0.95rem;
  }

  .fraud-callout p {
    margin: 0;
    font-size: 0.88rem;
    color: #7c2d12;
  }

  /* Tips Grid */
  .tips-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin: 1.5rem 0;
  }

  .tip-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 1.25rem;
  }

  .tip-card h4 {
    margin: 0 0 0.4rem;
    color: #0f172a;
    font-size: 0.98rem;
  }

  .tip-card p {
    margin: 0;
    font-size: 0.85rem;
    color: #475569;
    line-height: 1.45;
  }

  /* FAQs */
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-top: 1rem;
  }

  .faq-item {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 1.25rem;
  }

  .faq-item h3 {
    margin: 0 0 0.5rem;
    font-size: 1.05rem;
    color: #0f172a;
  }

  .faq-item p {
    margin: 0;
    font-size: 0.9rem;
    color: #475569;
    line-height: 1.5;
  }

  /* Sidebar */
  .ticket-sidebar {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .sidebar-widget {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 1.25rem;
  }

  .widget-title {
    font-size: 1rem;
    margin: 0 0 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid #f1f5f9;
    color: #0f172a;
  }

  .glance-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: #334155;
  }

  .link-btn-group {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .btn-primary {
    display: block;
    text-align: center;
    background: #2563eb;
    color: #ffffff;
    padding: 0.65rem 1rem;
    border-radius: 6px;
    font-weight: 700;
    font-size: 0.9rem;
    text-decoration: none;
  }

  .btn-primary:hover {
    background: #1d4ed8;
  }

  .btn-secondary {
    display: block;
    text-align: center;
    background: #f1f5f9;
    color: #1e293b;
    padding: 0.65rem 1rem;
    border-radius: 6px;
    font-weight: 600;
    font-size: 0.88rem;
    text-decoration: none;
    border: 1px solid #cbd5e1;
  }

  .btn-secondary:hover {
    background: #e2e8f0;
  }

  .widget-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .widget-links a {
    color: #2563eb;
    text-decoration: none;
    font-size: 0.88rem;
    font-weight: 500;
  }

  .widget-links a:hover {
