  "@type": "Article",
  "headline": pageTitle,
  "description": pageDescription,
  "url": canonicalUrl,
  "author": {
    "@type": "Organization",
    "name": "World Darts Hub Editorial Team"
  },
  "publisher": {
    "@type": "Organization",
    "name": "World Darts Hub",
    "url": siteUrl
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
