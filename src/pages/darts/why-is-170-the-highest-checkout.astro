    border-top: 3px solid var(--color-brand-accent, #c99700);
  }
  .strat-item h3 {
    margin-top: 0;
    font-size: 1.1rem;
  }
  .strat-item p {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.6;
  }
  .table-responsive {
    overflow-x: auto;
    margin: 1.5rem 0;
  }
  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
  }
  .data-table th, .data-table td {
    padding: 0.85rem 1rem;
    border: 1px solid #e2e8f0;
    text-align: left;
  }
  .data-table th {
    background: #0f172a;
    color: #fff;
    font-weight: 700;
  }
  .data-table tr:nth-child(even) {
    background: #f8fafc;
  }
  .faq-item {
    border-bottom: 1px solid #e2e8f0;
    padding: 1.25rem 0;
  }
  .faq-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }
  .faq-item h3 {
    margin: 0 0 0.5rem;
    font-size: 1.15rem;
  }
  .faq-item p {
    margin: 0;
    color: #475569;
  }
  .links-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-top: 1rem;
  }
