    margin-top: 0;
  }
  .proof-card code {
    display: inline-block;
    background: #e2e8f0;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    font-weight: 700;
    color: #0f172a;
    margin: 0.35rem 0;
  }
  .lore-box {
    background: #eff6ff;
    border-left: 4px solid #3b82f6;
    border-radius: 0 6px 6px 0;
    padding: 1.25rem;
    margin: 1.25rem 0;
  }
  .lore-box p {
    color: #1e3a8a;
    margin-bottom: 0.5rem;
  }
  .lore-box p:last-child {
    margin-bottom: 0;
  }
  .strategy-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    margin: 1.5rem 0;
  }
  @media (min-width: 768px) {
    .strategy-list {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .strat-item {
