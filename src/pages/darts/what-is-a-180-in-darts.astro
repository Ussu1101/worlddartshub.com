---
// src/pages/darts/what-is-a-180-in-darts.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AdSlot from '../../components/AdSlot.astro';
import VerificationBadge from '../../components/VerificationBadge.astro';

const pageTitle = "What Is a 180 in Darts? The Maximum Score & Math Explained";
const pageDescription = "What is a 180 in darts? Learn why three Treble 20s form the maximum score, how it beats the bullseye, iconic referee calls, and impact on 501 legs.";
const siteUrl = "https://worlddartshub.com";
const canonicalUrl = `${siteUrl}/darts/what-is-a-180-in-darts/`;

const breadcrumbItems = [
  { name: 'Darts Knowledge', url: '/darts/rules/' },
  { name: 'What Is a 180?' }
];

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": pageTitle,
  "description": pageDescription,
  "url": canonicalUrl,
  "author": {
    "@type": "Organization",
    "name": "World Darts Hub Editorial Team"
  },
  "publisher": {
    "@type": "Organization",
    "name": "World Darts Hub",
    "url": siteUrl
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is a 180 in darts?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A 180 is the highest possible score a player can achieve in a single three-dart visit, accomplished by landing all three darts into the Treble 20 bed (60 + 60 + 60 = 180)."
      }
    },
    {
      "@type": "Question",
      "name": "Why is 180 higher than three Bullseyes?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The inner Bullseye is worth 50 points, meaning three darts in the red bull yield 150 points. A Treble 20 is worth 60 points (20 × 3), so three Treble 20s yield 180 points—30 points higher than three bullseyes."
      }
    },
    {
      "@type": "Question",
      "name": "What is a 180 called in darts?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A 180 is universally called 'a maximum' or 'a ton-eighty'. At professional tournaments, referees famously shout 'One Hundred and Eighty!' to signal the score to the crowd."
      }
    },
    {
      "@type": "Question",
      "name": "Can you win a 501 leg with a 180?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Under standard 501 double-out rules, a leg must finish on an outer double ring or the 50-point inner bullseye. Because Treble 20 is a treble, a 180 can never be a checkout."
      }
    },
    {
      "@type": "Question",
      "name": "How does a 180 relate to a 9-dart finish?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A 180 is the scoring engine of a 9-dart finish. In the classic nine-dart route, a player opens with back-to-back 180s to reduce 501 down to 141, which is then checked out with their final three darts."
      }
    }
  ]
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  schema={[articleSchema, faqSchema]}
>
  <Breadcrumbs items={breadcrumbItems} />

  <header class="page-header">
    <div class="container">
      <div class="badge-row">
        <span class="badge badge-accent">SCORING ESSENTIALS</span>
        <span class="badge">THE MAXIMUM</span>
      </div>
      <h1>What Is a 180 in Darts? The Maximum Score Explained</h1>
      <p class="lead-text">
        Whether you are watching the PDC World Darts Championship at Alexandra Palace or playing in a local pub league, no score electrifies the room like a 180. Discover the mathematics, terminology, and tactical importance of the maximum.
      </p>
    </div>
  </header>

  <div class="container content-layout">
    <main class="main-column">
      <VerificationBadge verifiedDate="October 2026" topic="DRA Regulation Scoring & Tournament Rules" />

      <!-- Quick Answer Summary Box -->
      <section class="content-card summary-box">
        <h2>At A Glance: What Does a 180 Mean?</h2>
        <p>
          In steel-tip darts, a <strong>180</strong> is the highest single-turn score mathematically possible. It occurs when a player throws all three darts of their visit into the narrow red <strong>Treble 20</strong> bed:
        </p>
        <div class="score-formula">
          <code>Dart 1: Treble 20 (60) + Dart 2: Treble 20 (60) + Dart 3: Treble 20 (60) = 180 Points</code>
        </div>
        <p>
          Often referred to as <strong>"The Maximum"</strong> or a <strong>"Ton-Eighty,"</strong> hitting a 180 is the ultimate benchmark of scoring power in modern professional darts.
        </p>
      </section>

      <!-- Section: Why 180 Beats the Bullseye -->
      <section class="content-card">
        <h2>The Common Beginner Trap: Why Treble 20 Beats the Bullseye</h2>
        <p>
          Newcomers to darts often assume the red bullseye in the exact centre of the board is the highest-value target. In reality, the board's arithmetic rewards the upper treble segment:
        </p>

        <div class="comparison-grid">
          <div class="comp-card comp-treble">
            <span class="comp-badge">HIGHEST SCORING</span>
            <h3>Three Treble 20s</h3>
            <p class="comp-math">60 + 60 + 60 = <strong>180 Points</strong></p>
            <p class="comp-desc">The narrow inner treble ring triples the segment value (20 &times; 3 = 60). Three perfect darts produce 180 points.</p>
          </div>

          <div class="comp-card comp-bull">
            <span class="comp-badge">LOWER SCORING</span>
            <h3>Three Bullseyes</h3>
            <p class="comp-math">50 + 50 + 50 = <strong>150 Points</strong></p>
            <p class="comp-desc">The inner red Bullseye is worth 50 points (Double 25). Three darts squarely in the bull produce only 150 points—30 points fewer than a 180.</p>
          </div>
        </div>

        <p>
          This is why touring professionals spend virtually their entire scoring visits aimed at the top of the 20 segment rather than firing at the center of the board.
        </p>
      </section>

      <!-- Section: The Mathematics of 180 in a 501 Leg -->
      <section class="content-card">
        <h2>How a 180 Transforms a 501 Leg</h2>
        <p>
          Under official <a href="/darts/rules/">501 darts rules</a>, players start at 501 and count downwards to zero. A single 180 takes an enormous bite out of the required score:
        </p>

        <div class="leg-progression">
          <div class="prog-step">
            <span class="step-num">Start of Leg</span>
            <strong>501 Points Remaining</strong>
            <p>Both players toe the oche aiming to score heavily.</p>
          </div>
          <div class="prog-arrow">&darr;</div>
          <div class="prog-step prog-highlight">
            <span class="step-num">First Visit: 180 Thrown</span>
            <strong>321 Points Remaining</strong>
            <p>In just three darts, the required score drops by over 35%.</p>
          </div>
          <div class="prog-arrow">&darr;</div>
          <div class="prog-step prog-highlight">
            <span class="step-num">Second Visit: 180 Thrown</span>
            <strong>141 Points Remaining</strong>
            <p>The player enters checkout territory, setting up a potential <a href="/darts/what-is-a-9-dart-finish/">9-dart finish</a>.</p>
          </div>
        </div>

        <h3>Can a 180 Check Out a Leg?</h3>
        <p>
          <strong>No.</strong> Standard professional darts requires a <em>double-out</em> finish. Because Treble 20 is a treble and not a double, a player cannot win a leg with a 180. If a player requires 180 to win, they cannot finish in that turn because the highest checkout allowed under double-out rules is <a href="/darts/why-is-170-the-highest-checkout/">170 (The Big Fish)</a>.
        </p>
      </section>

      <AdSlot position="in-article" />

      <!-- Section: Terminology & Referee Calls -->
      <section class="content-card">
        <h2>Darts Terminology: Maximums, Ton-80s, and Callers</h2>
        <p>
          Over decades of British televised sport, rich terminology has emerged around the 180:
        </p>

        <div class="terms-list">
          <div class="term-item">
            <h3>"A Maximum"</h3>
            <p>The most common broadcast phrase, referring to the fact that 180 is the absolute mathematical limit achievable in a standard three-dart turn.</p>
          </div>

          <div class="term-item">
            <h3>"Ton-Eighty"</h3>
            <p>In traditional darts slang, a score of 100 is known as a "Ton." A score of 180 is therefore affectionately called a "Ton-Eighty."</p>
          </div>

          <div class="term-item">
            <h3>The Referee's Cry: "One Hundred and Eighty!"</h3>
            <p>When the third dart strikes Treble 20, the tournament caller bellows the iconic cry into the microphone. World-renowned callers like Russ Bray, George Noble, and Kirk Bevins developed signature vocal cadences that have become part of global darts culture.</p>
          </div>
        </div>
      </section>

      <!-- Section: 180 vs 9-Dart Finish -->
      <section class="content-card">
        <h2>180 vs 9-Dart Finish: What Is the Difference?</h2>
        <p>
          While casual spectators sometimes confuse these two terms, they represent completely different achievements:
        </p>

        <div class="table-responsive">
          <table class="data-table">
            <thead>
              <tr>
                <th>Feature</th>
                <th>180 Maximum</th>
                <th>9-Dart Finish</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>Darts Thrown</strong></td>
                <td>3 darts in a single visit</td>
                <td>9 darts across three visits</td>
              </tr>
              <tr>
                <td><strong>Objective</strong></td>
                <td>Pure scoring (60 + 60 + 60)</td>
                <td>Winning the entire 501 leg on a double</td>
              </tr>
              <tr>
                <td><strong>Winning Play?</strong></td>
                <td>No (cannot end a leg)</td>
                <td>Yes (immediate game shot)</td>
              </tr>
              <tr>
                <td><strong>Frequency</strong></td>
                <td>Dozens per televised tournament session</td>
                <td>Extremely rare (only 16 in Alexandra Palace history)</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- Section: When Pros Switch Away from T20 -->
      <section class="content-card">
        <h2>Why Do Players Sometimes Avoid Throwing for a 180?</h2>
        <p>
          Although Treble 20 is the default target, elite professionals frequently switch away from it for tactical reasons:
        </p>

        <div class="tactics-grid">
          <div class="tactic-box">
            <h3>1. Blocked Treble Bed</h3>
            <p>If the first two darts land with high barrel angles or bulky flights that obscure the small 8mm treble bed, throwing a third dart risks a deflection. Players switch down to <strong>Treble 19</strong> to bank a guaranteed 57 rather than risking a single 1 or 5.</p>
          </div>

          <div class="tactic-box">
            <h3>2. Avoiding a Bogey Number</h3>
            <p>Elite players calculate downstream. If throwing a 180 would leave an impossible finish like 169 or 168 (known as <a href="/darts/bogey-numbers-in-darts/">bogey numbers in darts</a>), a player will deliberately shape their visit to leave a clean checkout for their next turn.</p>
          </div>

          <div class="tactic-box">
            <h3>3. Setup Numbers</h3>
            <p>When approaching checkout territory, setting up a preferred double (like Double 16 or Double 20) is far more important than chasing another 180. Consult our <a href="/darts/checkout-chart/">501 Darts Checkout Chart</a> to explore standard professional setups.</p>
          </div>
        </div>

        <p class="records-note">
          Interested in all-time records? See our comprehensive statistical database of <a href="/players/180-records/">PDC World Championship 180 Records</a>, including match benchmarks by Peter Wright and Michael Smith.
        </p>
      </section>

      <!-- FAQ Section -->
      <section class="content-card faq-section">
        <h2>Frequently Asked Questions</h2>
        {faqSchema.mainEntity.map((item) => (
          <div class="faq-item">
            <h3>{item.name}</h3>
            <p>{item.acceptedAnswer.text}</p>
          </div>
        ))}
      </section>

      <!-- Related Navigation -->
      <section class="content-card">
        <h2>Related Darts Knowledge & Rules</h2>
        <div class="links-grid">
          <a href="/players/180-records/" class="link-card">
            <strong>180 Maximum Records</strong>
            <span>All-time PDC records, tournament totals, and most 180s in a match.</span>
          </a>
          <a href="/darts/what-is-a-9-dart-finish/" class="link-card">
            <strong>What Is a 9-Dart Finish?</strong>
            <span>The perfect leg explained: combinations, arithmetic, and TV history.</span>
          </a>
          <a href="/darts/average-explained/" class="link-card">
            <strong>Darts Averages Explained</strong>
            <span>How 3-dart averages and First-9 scoring are officially calculated.</span>
          </a>
          <a href="/darts/checkout-chart/" class="link-card">
            <strong>501 Darts Checkout Chart</strong>
            <span>Complete 2-dart and 3-dart out combinations from 170 down to 41.</span>
          </a>
          <a href="/darts/shanghai-finish-in-darts/" class="link-card">
            <strong>Shanghai Finish Explained</strong>
            <span>The classic 120 checkout, the 6N formula, and double-out rules.</span>
          </a>
          <a href="/darts/robin-hood-in-darts/" class="link-card">
            <strong>What Is a Robin Hood?</strong>
            <span>DRA rules, why it scores 0 points, and how flights prevent stem damage.</span>
          </a>
          <a href="/darts/board-height-and-distance/" class="link-card">
            <strong>Dartboard Height & Distance</strong>
            <span>Regulation setup dimensions, 9ft 7.5in diagonal check, and oche rules.</span>
          </a>
        </div>
      </section>
    </main>
  </div>
</BaseLayout>

<style>
  .page-header {
    background: linear-gradient(135deg, #0c1a2c 0%, #1e293b 100%);
    color: #fff;
    padding: 3rem 0;
    margin-bottom: 2rem;
    border-bottom: 3px solid var(--color-brand-accent, #c99700);
  }
  .badge-row {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }
