const canonicalUrl = `${siteUrl}/darts/how-to-throw-darts/`;

const breadcrumbItems = [
  { name: 'Darts Knowledge', url: '/darts/rules/' },
  { name: 'How to Throw Darts' }
];

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": pageTitle,
  "description": pageDescription,
  "url": canonicalUrl,
  "author": { "@type": "Organization", "name": "World Darts Hub Editorial Team" },
  "publisher": { "@type": "Organization", "name": "World Darts Hub", "url": siteUrl }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Which eye should you aim with when throwing darts?",
      "acceptedAnswer": { "@type": "Answer", "text": "Most players aim using their dominant eye. To test your dominant eye, form a small triangle with your thumbs and index fingers, hold your hands out at arm's length, and view the bullseye through the opening with both eyes open. Close your left eye: if the bullseye remains centred, you are right-eye dominant; if it moves out of view, you are left-eye dominant. Bringing the dart up in line with your dominant eye generally provides the most natural sighting line." }
    },
    {
      "@type": "Question",
      "name": "What is cross-eye dominance, and how does it affect darts?",
      "acceptedAnswer": { "@type": "Answer", "text": "Cross-eye dominance occurs when your dominant throwing hand does not match your dominant eye (for example, a right-handed thrower with a dominant left eye). If you are cross-dominant, avoid forcing your throw into an unnatural position. Instead, bring the dart back toward your dominant eye or slightly adjust your head angle so your dominant eye aligns comfortably over your throwing arm." }
    },
