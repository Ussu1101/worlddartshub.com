      }
    },
    {
      "@type": "Question",
      "name": "Can you throw remaining darts after busting?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Under official Darts Regulation Authority (DRA) Rule 5.4, the moment a bust occurs, the player's turn is officially over. Any darts remaining in the player's hand must be retained and cannot be thrown at the board."
      }
    },
