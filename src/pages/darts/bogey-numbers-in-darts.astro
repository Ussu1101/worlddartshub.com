    background: #f8fafc;
    border-left: 4px solid var(--color-brand-primary, #0c1a2c);
  }
  .math-rules-box {
    background: #f1f5f9;
    border-left: 4px solid #0284c7;
    padding: 1rem 1.25rem;
    border-radius: 0 6px 6px 0;
    margin: 1.25rem 0;
  }
  .math-rules-box ul {
    margin: 0 0 0 1.25rem;
    padding: 0;
    color: #1e293b;
    line-height: 1.7;
  }
  .math-rules-box code {
    background: #e2e8f0;
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    font-size: 0.9rem;
    color: #0f172a;
  }
  .table-responsive {
    overflow-x: auto;
    margin: 1.5rem 0;
  }
  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
  }
  .data-table th, .data-table td {
    padding: 0.85rem 1rem;
    border: 1px solid #e2e8f0;
    text-align: left;
  }
  .data-table th {
    background: #0f172a;
    color: #fff;
    font-weight: 700;
  }
  .data-table tr:nth-child(even) {
    background: #f8fafc;
  }
  .status-pass {
    display: inline-block;
    background: #dcfce7;
    color: #166534;
    font-weight: 700;
    font-size: 0.75rem;
    padding: 0.2rem 0.5rem;
