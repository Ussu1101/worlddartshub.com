    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-top: 1rem;
  }
  @media (min-width: 600px) {
    .links-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  .link-card {
    display: block;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    padding: 1rem;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .link-card:hover {
    border-color: var(--color-brand-primary, #0c1a2c);
    transform: translateY(-2px);
  }
  .link-card strong {
    display: block;
    color: #0f172a;
    font-size: 0.95rem;
    margin-bottom: 0.25rem;
  }
