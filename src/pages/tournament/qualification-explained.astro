---
// src/pages/tournament/qualification-explained.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AdSlot from '../../components/AdSlot.astro';
import VerificationBadge from '../../components/VerificationBadge.astro';

const pageTitle = "How 128 Players Qualify for the World Darts Championship";
const pageDescription = "All 128 seats explained: 40 from the main Order of Merit, 40 from the ProTour, 48 from international and secondary routes — see which route your favourite took.";
const siteUrl = "https://worlddartshub.com";
const canonicalUrl = `${siteUrl}/tournament/qualification-explained/`;

const breadcrumbItems = [
  { name: 'Tournament', url: '/tournament/world-darts-championship/' },
  { name: 'Qualification Explained' }
];

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": pageTitle,
  "description": pageDescription,
  "url": canonicalUrl,
  "author": { "@type": "Organization", "name": "World Darts Hub Editorial Team" },
  "publisher": { "@type": "Organization", "name": "World Darts Hub", "url": siteUrl }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Can an amateur or non-Tour Card holder qualify for Alexandra Palace?",
      "acceptedAnswer": { "@type": "Answer", "text": "Yes. Amateurs and non-Tour Card holders have numerous paths into the tournament: finishing in the top three of the Challenge Tour or Development Tour Order of Merit, finishing in qualifying positions on the Women's Series, winning the Women's World Matchplay, or winning an official regional international affiliate qualifier (such as CDC events, Asian Tour events, or ADG African qualifiers)." }
    },
    {
      "@type": "Question",
      "name": "What happens if the Women's World Matchplay winner has already qualified?",
      "acceptedAnswer": { "@type": "Answer", "text": "Under official PDPA rules, if the Women's World Matchplay winner has already qualified for the World Championship (or declines), the invitation does not roll down the Women's Series Order of Merit. Instead, the unused spot is transferred directly to the PDPA Tour Card Holder Qualifier." }
    },
    {
      "@type": "Question",
      "name": "What happens if the PDC World Youth Champion has already qualified?",
      "acceptedAnswer": { "@type": "Answer", "text": "If the reigning World Youth Champion qualifies through the senior PDC Order of Merit, ProTour rankings, or Development Tour Order of Merit, no replacement is selected from the youth standings. The vacant berth transfers to the PDPA Tour Card Holder Qualifier." }
    },
    {
      "@type": "Question",
      "name": "How do roll-downs operate on the Challenge and Development Tours?",
      "acceptedAnswer": { "@type": "Answer", "text": "On both the Winmau Challenge Tour and Winmau Development Tour, if an eligible player in the top three has already qualified via higher ranking lists, places roll down sequentially to the next eligible player on that tour's final Order of Merit until all three spots are filled." }
    },
    {
      "@type": "Question",
      "name": "How does Q-School differ from the Tour Card Holder Qualifier?",
      "acceptedAnswer": { "@type": "Answer", "text": "Q-School (Qualifying School) takes place every January in the UK and Europe. It is an open tournament where hundreds of players compete to win a professional two-year PDC Tour Card. The PDPA Tour Card Holder Qualifier takes place in late November. It is a closed, last-chance event open exclusively to current Tour Card holders who have not yet qualified for that season's World Championship." }
    }
  ]
};
