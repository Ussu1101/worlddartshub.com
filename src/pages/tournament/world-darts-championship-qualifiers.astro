---
// src/pages/tournament/world-darts-championship-qualifiers.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import VerificationBadge from '../../components/VerificationBadge.astro';
import AdSlot from '../../components/AdSlot.astro';

const pageTitle = "Who Qualified for the 2026/27 World Darts Championship?";
const pageDescription = "Complete list of confirmed qualifiers for the 2026/27 PDC World Darts Championship at Alexandra Palace: 48 international spots, confirmed players, and TBC routes.";
const siteUrl = "https://worlddartshub.com";
const canonicalUrl = `${siteUrl}/tournament/world-darts-championship-qualifiers/`;

const breadcrumbItems = [
  { name: 'Home', url: '/' },
  { name: 'Tournaments', url: '/tournament/pdc-majors-explained/' },
  { name: 'PDC World Darts Championship', url: '/tournament/world-darts-championship/' },
  { name: 'Qualifiers List' }
];

const faqItems = [
  {
    q: "How many players qualify for the 2026/27 World Darts Championship?",
    a: "A total of 128 players qualify for the tournament at Alexandra Palace: the top 40 from the two-year PDC Order of Merit, the top 40 non-qualified players from the one-year ProTour Order of Merit, and 48 international and secondary circuit qualifiers."
  },
  {
    q: "When is the final qualification cut-off for the World Darts Championship?",
    a: "The final ranking cut-off takes place at the conclusion of the Players Championship Finals in Minehead (27–29 November 2026). The final qualifying spots are settled on 30 November at the PDPA Tour Card Holder Qualifier in Leicester."
  },
  {
    q: "Which women have qualified for the 2026/27 World Darts Championship?",
    a: "Beau Greaves, Fallon Sherrock, Lisa Ashton, Gemma Hayter, and Vicky Pruim have secured qualification via the Betfred Women's World Matchplay and the PDC Women's Series Order of Merit."
  },
  {
    q: "How many African players qualify for Alexandra Palace in 2026/27?",
    a: "For the first time in tournament history, Africa receives two guaranteed spots at the World Darts Championship, organized by the African Darts Group (ADG): one for Northern/East Africa (won by Kenya's David Munyua) and one for Southern Africa."
  },
  {
    q: "When is the official World Darts Championship draw announced?",
    a: "The official first-round draw takes place in early December 2026, shortly after the PDPA Tour Card Holder Qualifier concludes in Leicester."
  }
];

const articleSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "@id": `${canonicalUrl}#article`,
      "isPartOf": {
        "@type": "WebSite",
        "@id": `${siteUrl}/#website`,
        "name": "World Darts Hub",
        "url": siteUrl
      },
      "headline": pageTitle,
      "description": pageDescription,
      "url": canonicalUrl,
      "inLanguage": "en-GB",
      "datePublished": "2026-10-27T00:00:00+00:00",
      "dateModified": "2026-10-27T00:00:00+00:00",
      "mainEntityOfPage": canonicalUrl,
      "publisher": {
        "@type": "Organization",
        "name": "World Darts Hub",
        "url": siteUrl
      }
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonicalUrl}#breadcrumb`,
      "itemListElement": breadcrumbItems.map((item, index) => ({
        "@type": "ListItem",
        "position": index + 1,
        "name": item.name,
        "item": item.url ? `${siteUrl}${item.url}` : canonicalUrl
      }))
    },
    {
      "@type": "FAQPage",
      "@id": `${canonicalUrl}#faq`,
      "mainEntity": faqItems.map(item => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.a
        }
      }))
    }
  ]
};
---

<BaseLayout 
  title={pageTitle} 
  description={pageDescription}
  schema={articleSchema}
  canonicalUrl={canonicalUrl}
>
  <Breadcrumbs items={breadcrumbItems} />

  <header class="page-header">
    <div class="container">
      <div class="badge-row">
        <span class="badge badge-accent">PDC WORLD CHAMPIONSHIP</span>
        <span class="badge">ALEXANDRA PALACE 2026/27</span>
        <span class="badge badge-outline">128-PLAYER FIELD</span>
