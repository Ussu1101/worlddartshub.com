            <thead>
              <tr>
                <th style="width: 80px;">Slot(s)</th>
                <th>Qualifying Pathway</th>
                <th>Region / Circuit</th>
                <th>Player</th>
                <th>Key Context &amp; Significance</th>
              </tr>
            </thead>
