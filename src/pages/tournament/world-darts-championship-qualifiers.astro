</BaseLayout>

<style>
  .page-header {
    background: linear-gradient(135deg, #0c1a2c 0%, #1e293b 100%);
    color: #fff;
    padding: 3rem 0;
    margin-bottom: 2rem;
    border-bottom: 3px solid var(--color-brand-accent, #c99700);
  }
  .badge-row {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }
  .badge {
    background: rgba(255, 255, 255, 0.15);
    color: #f8fafc;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.6rem;
    border-radius: 4px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
