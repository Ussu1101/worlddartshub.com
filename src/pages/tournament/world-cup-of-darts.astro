          "item": `${siteUrl}/`
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Tournament",
          "item": `${siteUrl}/tournament/world-darts-championship/`
        },
        {
          "@type": "ListItem",
          "position": 3,
