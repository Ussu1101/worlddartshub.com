      "description": pageDescription,
      "url": canonicalUrl,
      "inLanguage": "en-GB",
      "datePublished": "2026-10-18T00:00:00+00:00",
      "dateModified": "2026-10-18T00:00:00+00:00",
      "mainEntityOfPage": canonicalUrl,
      "publisher": {
        "@type": "Organization",
        "name": "World Darts Hub",
        "url": siteUrl
      }
    },
