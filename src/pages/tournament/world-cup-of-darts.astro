import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import VerificationBadge from '../../components/VerificationBadge.astro';

const pageTitle = "World Cup of Darts: Format, Prize Money & Past Winners";
const pageDescription = "Comprehensive guide to the PDC World Cup of Darts: 40-nation pairs format, £500,000 prize fund breakdown, Frankfurt venue details, and full winners archive.";
const siteUrl = "https://worlddartshub.com";
const canonicalUrl = `${siteUrl}/tournament/world-cup-of-darts/`;

const breadcrumbItems = [
  { name: 'Home', url: '/' },
  { name: 'Tournament', url: '/tournament/world-darts-championship/' },
  { name: 'World Cup of Darts', url: '/tournament/world-cup-of-darts/' }
];

const faqItems = [
  {
    q: "How does the World Cup of Darts work?",
    a: "The World Cup of Darts is a 40-nation pairs tournament where each country is represented by two players. The top four seeded nations receive a bye into the Last 16, while the remaining 36 teams compete across 12 round-robin groups of three. Group winners join the top four seeds in a straight knockout bracket, with all matches contested as doubles leg play."
  },
  {
    q: "How many teams play in the World Cup of Darts?",
    a: "Exactly 40 national teams compete in the modern PDC World Cup of Darts, featuring 80 players from across Europe, the Americas, Asia, Africa, and Oceania."
  },
  {
    q: "Who won the 2026 World Cup of Darts?",
    a: "England won the 2026 World Cup of Darts, represented by Luke Littler and Luke Humphries, defeating the Netherlands (Michael van Gerwen and Gian van Veen) 10–5 in the final on 14 June 2026."
  },
  {
    q: "Where is the World Cup of Darts held?",
    a: "The World Cup of Darts is staged at the Eissporthalle in Frankfurt, Germany, which has served as the tournament's permanent venue since 2022."
  },
  {
    q: "Does World Cup of Darts prize money count towards the Order of Merit?",
    a: "No. Because the World Cup of Darts is an invitational team event rather than an individual ranking major, prize money won does not count towards the two-year rolling PDC Order of Merit."
  },
  {
    q: "Which country has won the most World Cup of Darts titles?",
    a: "England holds the record for the most World Cup of Darts titles, having won the tournament six times (2012, 2013, 2015, 2016, 2024, and 2026)."
  }
];

const articleSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "@id": `${canonicalUrl}#article`,
      "isPartOf": {
        "@type": "WebSite",
        "@id": `${siteUrl}/#website`,
