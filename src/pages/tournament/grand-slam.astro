---
// src/pages/tournament/grand-slam.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import VerificationBadge from '../../components/VerificationBadge.astro';
import AdSlot from '../../components/AdSlot.astro';

const pageTitle = "Grand Slam of Darts 2026: Results, Schedule, Draw & How to Watch";
const pageDescription = "Grand Slam of Darts 2026, 14–22 Nov at WV Active Aldersley: latest results, full schedule, draw, 48-player format, 16 groups, prize money and how to watch.";
const siteUrl = "https://worlddartshub.com";
const canonicalUrl = `${siteUrl}/tournament/grand-slam/`;

const breadcrumbItems = [
  { name: 'Home', url: '/' },
  { name: 'Tournaments', url: '/tournament/pdc-majors-explained/' },
  { name: 'Grand Slam of Darts', url: '/tournament/grand-slam/' }
];

const faqItems = [
  {
    q: "When is the Grand Slam of Darts 2026?",
    a: "The 2026 Grand Slam of Darts takes place from Saturday 14 November to Sunday 22 November 2026 at WV Active Aldersley in Wolverhampton, England."
  },
  {
    q: "What is the new Grand Slam format for 2026?",
    a: "The 2026 tournament features an expanded 48-player field divided into 16 groups of three players. Matches in the group phase are best-of-9 legs, and only the group winner advances to the Last 16 knockout stage."
  },
  {
    q: "Who is the defending champion?",
    a: "Luke Littler is the two-time defending champion, having won consecutive Grand Slam of Darts titles in 2024 and 2025, defeating Luke Humphries 16–11 in the 2025 final."
  },
  {
    q: "How do players qualify for the Grand Slam?",
    a: "Players qualify through four main avenues: winning or reaching finals of televised PDC majors, European Tour and Players Championship winners, secondary tour exemptions, and the final eight spots decided at the Tour Card Holder Qualifier on 6 November 2026."
  },
  {
    q: "How much is the Grand Slam prize money?",
    a: "The total prize fund is £1,000,000, with the champion collecting £200,000 and every qualified player guaranteed a minimum payout of £5,000."
  },
  {
    q: "How can I watch the Grand Slam live?",
    a: "In the UK, live coverage is broadcast exclusively on Sky Sports and streamed via NOW. International viewers can watch via PDCTV, or through regional rightsholders including DAZN and Viaplay."
  }
];

const articleSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "@id": `${canonicalUrl}#article`,
      "isPartOf": {
        "@type": "WebSite",
        "@id": `${siteUrl}/#website`,
        "name": "World Darts Hub",
        "url": siteUrl
      },
      "headline": pageTitle,
      "description": pageDescription,
      "url": canonicalUrl,
      "inLanguage": "en-GB",
      "datePublished": "2026-10-24T00:00:00+00:00",
      "dateModified": "2026-11-22T00:00:00+00:00",
      "mainEntityOfPage": canonicalUrl,
      "publisher": {
        "@type": "Organization",
        "name": "World Darts Hub",
        "url": siteUrl
      }
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonicalUrl}#breadcrumb`,
      "itemListElement": breadcrumbItems.map((item, index) => ({
        "@type": "ListItem",
        "position": index + 1,
        "name": item.name,
        "item": item.url ? `${siteUrl}${item.url}` : canonicalUrl
      }))
    },
    {
      "@type": "FAQPage",
      "@id": `${canonicalUrl}#faq`,
      "mainEntity": faqItems.map(item => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.a
        }
      }))
    }
  ]
};
---

<BaseLayout 
  title={pageTitle} 
  description={pageDescription}
  schema={articleSchema}
  canonicalUrl={canonicalUrl}
>
  <Breadcrumbs items={breadcrumbItems} />

  <header class="page-header">
    <div class="container">
      <div class="badge-row">
        <span class="badge badge-accent">PDC RANKED MAJOR</span>
        <span class="badge">WOLVERHAMPTON 2026</span>
        <span class="badge badge-outline">NEW 48-PLAYER FORMAT</span>
      </div>
      <h1>Grand Slam of Darts 2026: Results, Schedule, Draw &amp; How to Watch</h1>
      <p class="lead-text">
        The 2026 Grand Slam of Darts returns to Wolverhampton's <a href="/venue/wv-active-aldersley/">WV Active Aldersley</a> from 14 to 22 November 2026, marking the 20th staging of the iconic cross-code major. Defending champion Luke Littler aims for a historic third consecutive crown amid the most radical format transformation in the tournament's history.
      </p>
    </div>
  </header>

  <div class="container content-layout">
    <main class="main-column">
      <VerificationBadge verifiedDate="17 November 2026" topic="PDC Grand Slam of Darts Tournament Specifications & Regulations" />

      <!-- Section 1: Intro -->
      <section class="content-card">
        <h2>Tournament Overview &amp; The 20th Anniversary</h2>
        <p>
          Staged from <strong>Saturday 14 November to Sunday 22 November 2026</strong> at the WV Active Aldersley venue in Wolverhampton, as documented on the <a href="https://www.pdc.tv/tournament/mr-vegas-grand-slam-darts" target="_blank" rel="noopener noreferrer">official PDC tournament hub</a>, the Grand Slam of Darts stands as one of the crown jewels of the autumn darts calendar. Since its inauguration in 2007, the tournament has captured the imagination of darting enthusiasts by pitting major winners and continental qualifiers together in a unique group-to-knockout structure.
        </p>
        <p>
          The 2026 edition introduces the biggest structural overhaul in the event's 20-year history. A significantly expanded field, higher stakes in every group fixture, and a record £1,000,000 prize purse ensure that Wolverhampton will serve as the pivotal battleground ahead of the World Darts Championship at Alexandra Palace.
        </p>
      </section>

      <!-- Section 2: The New 48-Player Format Explained -->
      <section class="content-card">
        <h2>The New 48-Player Format, Explained</h2>
        <p>
          For nineteen editions, the Grand Slam adhered to a 32-player format with eight groups of four, where the top two players from each pool advanced. In 2026, the PDC officially expanded the field to <strong>48 players</strong>, reorganised into <strong>16 groups of three</strong> (Groups A to P).
        </p>
        <p>
          Under the new regulations, group-stage matches remain the traditional <strong>best of 9 legs</strong> (first to 5). Crucially, <strong>only the group winner advances to the Last 16</strong>. The second-place safety net has been eliminated completely.
        </p>

        <div class="table-responsive">
          <table class="data-table">
            <thead>
              <tr>
                <th>Tournament Metric</th>
                <th>Traditional Format (2007–2025)</th>
                <th>New 2026 Format</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>Total Field Size</strong></td>
                <td>32 Players</td>
                <td><strong>48 Players</strong></td>
              </tr>
              <tr>
                <td><strong>Group Stage Pools</strong></td>
                <td>8 Groups of 4 Players</td>
                <td><strong>16 Groups of 3 Players</strong></td>
              </tr>
              <tr>
                <td><strong>Knockout Qualifiers</strong></td>
                <td>Top 2 from each group (16 players)</td>
                <td><strong>Group Winner Only (16 players)</strong></td>
              </tr>
              <tr>
                <td><strong>Matches Per Player in Groups</strong></td>
                <td>3 Round-Robin Matches</td>
                <td><strong>2 Round-Robin Matches</strong></td>
              </tr>
              <tr>
                <td><strong>Knockout Bracket Stage</strong></td>
                <td>Last 16 (Knockout)</td>
                <td><strong>Last 16 (Knockout)</strong></td>
              </tr>
            </tbody>
          </table>
        </div>

        <h3>Seeding &amp; Draw Mechanics</h3>
        <p>
          The top 16 players on the two-year rolling <a href="/tournament/order-of-merit/">PDC Order of Merit</a> are seeded into positions 1 through 16, with one seed heading each of the 16 groups (Group A through Group P). The remaining 32 competitors are drawn into groups from Pot 2 (ranked 17–32) and Pot 3 (ranked 33–48 and qualifiers).
        </p>
        <p>
          The tactical reality is unforgiving: with no runner-up qualification slot, a seeded heavyweight plays exactly two short best-of-9 matches. A single slow start or deciding-leg defeat can eliminate a title contender before the knockout phase even begins.
        </p>
      </section>

      <!-- Section 3: How Players Qualify -->
      <section class="content-card">
        <h2>How Players Qualify for the Grand Slam</h2>
        <p>
          Qualification for the 48-player field follows four clearly defined hierarchical criteria established in the PDC Rulebook:
        </p>
        <ol>
          <li>
            <strong>PDC Televised Major Winners &amp; Finalists:</strong> Champions and runners-up from the World Championship, World Matchplay, World Grand Prix, UK Open, European Championship, Premier League, Players Championship Finals, Masters, and World Cup of Darts champions.
          </li>
          <li>
            <strong>PDC European Tour &amp; ProTour Winners:</strong> Winners of 2026 European Tour events and Players Championship tournaments, ranked in Order of Merit priority to fill available automatic berths.
          </li>
          <li>
            <strong>Secondary Tour &amp; Invitational Exemptions:</strong> Order of Merit leaders from the Challenge Tour, Development Tour, PDC Women's Series, and the World Youth Championship finalists.
          </li>
          <li>
            <strong>Tour Card Holder Qualifier:</strong> The final eight places in the 48-man field are decided in a dedicated sudden-death qualifying tournament for all remaining Tour Card holders.
          </li>
        </ol>

        <div class="callout warning-box">
          <h3>⚠️ Qualification Status Notice</h3>
          <p>
            Entries for the 2026 Tour Card Holder Qualifier close on <strong>Friday 6 November 2026</strong>. The complete 48-player field will be finalized on the evening of 6 November, with the official group-stage draw scheduled immediately following the conclusion of the qualifier.
          </p>
        </div>
      </section>

      <!-- Section 4: Confirmed Field -->
      <section class="content-card">
        <h2>Confirmed — the full 48-player field is final</h2>
        <p>
          As of 9 November 2026, the complete 48-player lineup for Wolverhampton is final. Anton Östlund's Nordic &amp; Baltic Championship win (8–4 vs Darius Labanauskas, Odense, 8 November) took the last place. The following twenty competitors are officially confirmed:
        </p>
        <ul>
          <li><strong>Luke Littler</strong> — Two-time defending champion (2024 and 2025).</li>
          <li><strong>Ross Smith</strong> — 2026 European Championship winner (defeated Martin Schindler 11–8 in the Dortmund final; was already qualified prior to the event).</li>
          <li><strong>Martin Schindler</strong> — Qualified via his run to the 2026 European Championship final on 25 October.</li>
          <li><strong>Beau Greaves</strong> — Qualified via the women's and secondary tour qualification allocations.</li>
          <li><strong>Lisa Ashton</strong> — Secured qualification as the highest-placed eligible competitor from the PDC Women's Series Order of Merit.</li>
          <li><strong>Paolo Nebrida</strong> — 2026 PDC Asian Championship winner (defeating Kam Weng Cheng 3–0 in the final on 14 September in Hainan).</li>
          <li><strong>Charlie Manby</strong> — Qualified via his maiden ranking title at Players Championship 31 on 28 October 2026 (beat Kuivenhoven 8–2 in the Den Bosch final).</li>
          <li><strong>Raymond Smith (Australia)</strong> — 2026 ANZ Premier League winner (beat Tim Pusey 10–2 in the Brisbane final on 31 October 2026).</li>
          <li><strong>Tommy Morris</strong> — Qualified via his Players Championship 34 title on 5 November 2026 (beat Luke Humphries 8–5 in the Leicester final).</li>
          <li><strong>Stephen Bunting</strong> — Qualified via the Tour Card Holder Qualifier on 6 November 2026 (beat Jimmy van Schie 5–2 in the final round).</li>
          <li><strong>Maik Kuivenhoven</strong> — Qualified via the Tour Card Holder Qualifier on 6 November 2026 (beat Chris Landman 5–2 in the final round).</li>
          <li><strong>Tom Sykes</strong> — Qualified via the Tour Card Holder Qualifier on 6 November 2026 (beat Adam Leek 5–3 in the final round).</li>
          <li><strong>Rusty-Jake Rodriguez</strong> — Qualified via the Tour Card Holder Qualifier on 6 November 2026 (beat Tom Bissell 5–2 in the final round).</li>
          <li><strong>Niko Springer</strong> — Qualified via the Tour Card Holder Qualifier on 6 November 2026 (beat Stefaan Henderyck 5–1 in the final round).</li>
          <li><strong>Ricky Evans</strong> — Qualified via the Tour Card Holder Qualifier on 6 November 2026 (beat Cristo Reyes 5–3 in the final round).</li>
          <li><strong>Carl Sneyd</strong> — Qualified via the Tour Card Holder Qualifier on 6 November 2026 (beat Andy Boulton 5–2 in the final round).</li>
          <li><strong>Bradley Brooks</strong> — Qualified via the Tour Card Holder Qualifier on 6 November 2026 (beat Dave Chisnall 5–2 in the final round).</li>
          <li><strong>Joe Cullen</strong> — Qualified via the Tour Card Holder Qualifier on 6 November 2026 (beat Michael Smith 5–3 in the final round).</li>
          <li><strong>Alan Soutar</strong> — Qualified via the Tour Card Holder Qualifier on 6 November 2026 (beat Mike De Decker 5–3 in the final round).</li>
          <li><strong>Anton Östlund</strong> — Qualified via the PDC Nordic &amp; Baltic Championship on 8 November 2026 (beat Darius Labanauskas 8–4 in the Odense final); completes the 48-player field.</li>
        </ul>
        <p class="field-note">
          <strong>Field complete:</strong> All 48 places are now filled. The last place went to Anton Östlund, who won the Nordic &amp; Baltic Championship (6–8 November 2026) in Odense. The ten Tour Card Holder Qualifier places were decided on Friday 6 November 2026 in Leicester. The ANZ Premier League berth went to Raymond Smith, who beat Tim Pusey 10–2 in the Brisbane final on 31 October 2026. The official draw was made on Monday 9 November 2026 — see the full <a href="/tournament/grand-slam-draw/">Grand Slam draw, groups and schedule</a>.
        </p>
      </section>

      <!-- Section: Event-Week Daily Updates Protocol -->
      <section class="content-card">
        <h2>Event-Week Daily Coverage &amp; Results Protocol (14–22 November)</h2>
        <p>
          Throughout tournament week at WV Active Aldersley, World Darts Hub will publish daily round-by-round coverage directly on this hub:
        </p>
        <ul>
          <li><strong>Daily Order of Play:</strong> Official PDC-confirmed session fixtures and starting times, published prior to each session (no speculative pairings).</li>
          <li><strong>Same-Evening Results:</strong> Immediate post-session group match results, scores in legs, and updated group standings published every evening.</li>
          <li><strong>Next-Day Lineup:</strong> Clear next-session times and progression markers as group winners advance to the Last 16.</li>
          <li><strong>Post-Event Rankings:</strong> Following the final on Sunday 22 November, an immediate rankings refresh reflecting the £200,000 champion's prize will be published with an updated verification stamp.</li>
        </ul>
      </section>

      <!-- Section: Day 1 Results -->
      <section class="content-card">
        <h2>Day 1 Results — Saturday 14 November 2026</h2>
        <p>
          All 16 opening group matches are complete. Defending champion Luke Littler beat Beau Greaves 5–2 with a 109.97 average (Greaves averaged almost 104 in defeat), and Gian van Veen averaged 110.51 in a 5–2 win over Carl Sneyd. The day's shocks: debutant Tom Sykes beat 15th seed Luke Woodhouse 5–3, Tommy Morris beat Josh Rock 5–2, Anton Östlund beat Jonny Clayton 5–4, and Rusty-Jake Rodriguez beat Ross Smith 5–3. Each Day 1 winner takes 2 points; the beaten player sits on 0, with the third player in each group yet to play.
        </p>
        <p><strong>Afternoon session — Saturday 14 November:</strong></p>
        <ul>
          <li>Luke Woodhouse 3–5 Tom Sykes (J)</li>
          <li>Jermaine Wattimena 5–2 Lisa Ashton (B)</li>
          <li>Stephen Bunting 5–4 Raymond Smith (D)</li>
          <li>Ryan Searle 5–4 Charlie Manby (F)</li>
          <li>Josh Rock 2–5 Tommy Morris (C)</li>
          <li>Wessel Nijman 5–1 Adam Sevada (H)</li>
