---
// src/pages/contact.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const pageTitle = "Contact World Darts Hub — Editorial & Inquiries";
const pageDescription = "Contact the editorial team at World Darts Hub for factual corrections, spectator inquiries, or advertising partnerships.";

const breadcrumbItems = [
  { name: 'Contact' }
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <Breadcrumbs items={breadcrumbItems} />

  <div class="container container-narrow page-content">
    <h1>Contact Our Team</h1>
    <p class="lead">
      We welcome inquiries, feedback, and factual corrections from sports fans, visitors, and media partners.
    </p>

    <div class="grid-2 contact-options">
      <div class="card">
        <h3>Editorial & Corrections</h3>
        <p>Noticed an outdated schedule time or broadcast channel update? Let our editorial staff know directly.</p>
        <p><strong>Email:</strong> <a href="mailto:Usssamaa@gmail.com">Usssamaa@gmail.com</a></p>
      </div>

      <div class="card">
        <h3>Advertising & Partnerships</h3>
        <p>For display advertising opportunities, programmatic sponsorships, or media inquiries.</p>
        <p><strong>Email:</strong> <a href="mailto:Usssamaa@gmail.com">Usssamaa@gmail.com</a></p>
      </div>
    </div>

    <div class="callout">
      <h3>⚠️ Looking for Official PDC or Ally Pally Tickets?</h3>
      <p>
        Please note that World Darts Hub is an independent fan resource. We do <strong>not</strong> sell tickets, provide customer service for SeeTickets, or operate the Alexandra Palace box office. For official ticketing assistance, please contact the PDC directly or visit SeeTickets.
      </p>
    </div>
  </div>
</BaseLayout>

<style>
  .page-content {
    margin-top: 2.5rem;
    margin-bottom: 4rem;
  }
  .contact-options {
    margin: 2rem 0;
  }
</style>
