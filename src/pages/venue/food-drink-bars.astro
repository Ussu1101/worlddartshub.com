---
// src/pages/venue/food-drink-bars.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AdSlot from '../../components/AdSlot.astro';
import VerificationBadge from '../../components/VerificationBadge.astro';
import foodDrinkData from '../../data/food-drink.json';

const pageTitle = "Food, Drink & Bars at Alexandra Palace Darts (2026/27)";
const pageDescription = "Spectator guide to food, drinks, and bars at the PDC World Darts Championship. 4-pint pitchers, reusable cup deposits, cashless bars, and nearby pubs.";

const breadcrumbItems = [
  { name: 'Venue Guide', url: '/venue/' },
  { name: 'Food, Drink & Bars' }
];

const foodDrinkFaqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "name": "Food, Drink and Bars at Alexandra Palace Darts FAQ",
  "description": pageDescription,
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Can you pay with cash at Alexandra Palace bars during the darts?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Alexandra Palace operates a strictly 100% cashless payment system. All bars, street food stalls, and merchandise vendors accept contactless mobile payments and cards only (Apple Pay, Google Pay, Visa, Mastercard). Cash is not accepted anywhere inside the venue."
      }
    },
    {
      "@type": "Question",
      "name": "What are the 4-pint pitchers served at the darts?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Across recent World Championship tournaments, Great Hall bars have served large 4-pint draught beer pitchers designed for fast group service and reduced queuing between legs. Official 2026/27 tournament drinks pricing and menu options will be confirmed upon event commencement."
      }
    },
    {
      "@type": "Question",
      "name": "How does the reusable stack cup system work?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The tournament utilizes branded, reusable souvenir stack cups with interlocking handles. Under established event operations, spectators pay a nominal deposit or purchase fee on their initial drink, exchange cups for fresh ones at the bar, and can keep them as souvenirs or return them at designated points. Exact 2026/27 cup scheme terms will be published at tournament launch."
      }
    },
    {
      "@type": "Question",
      "name": "Can you bring your own food or alcohol into Alexandra Palace?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No outside alcohol, unsealed drinks, cans, glass bottles, or takeaway food are permitted through security checkpoints. You may bring an empty reusable plastic water bottle to refill at free water points in Palm Court, or a factory-sealed bottle of water up to 500ml."
      }
    },
    {
      "@type": "Question",
      "name": "Are there good pubs near Alexandra Palace before the darts starts?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Top verified nearby options include The Starting Gate (directly opposite Alexandra Palace Rail Station on Station Road), The Victoria Stakes (at the foot of Muswell Hill), and The Mossy Well (a spacious Wetherspoon pub on Muswell Hill Broadway)."
      }
    }
  ]
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  schema={foodDrinkFaqSchema}
>
  <Breadcrumbs items={breadcrumbItems} />

  <header class="food-hero">
    <div class="container">
      <div class="badge-group">
        <span class="badge badge-accent">FOOD & DRINK DIRECTORY</span>
        <span class="badge">100% CASHLESS VENUE</span>
      </div>
      <h1 class="food-title">Food, Drink & Bars at Alexandra Palace Darts</h1>
      <p class="food-subtitle">
        Everything you need to know about 4-pint beer pitchers, reusable souvenir stack cups, Palm Court street food, cashless bars, and top pre-match pubs for the 2026/27 championship.
      </p>
      <div class="hero-meta">
        <span class="meta-item">💳 Payment: Card & Contactless Only</span>
        <span class="meta-item">🍺 In-Arena: 4-Pint Draught Pitchers</span>
        <span class="meta-item">🍔 Concourse: Palm Court Street Food</span>
        <span class="meta-item">📅 Verified: October 2026</span>
      </div>
    </div>
  </header>

  <main class="container content-container">
    <div class="food-layout">
      <!-- Main Content -->
      <article class="food-main">

        <!-- CASHLESS NOTICE CALLOUT -->
        <section class="cashless-card">
          <div class="cashless-badge">
            <span class="cashless-icon">💳</span>
            <span>STRICT VENUE PAYMENT POLICY</span>
          </div>
          <h2>Alexandra Palace is 100% Cashless</h2>
          <p>
            {foodDrinkData.payment_policy.description}
          </p>
          <div class="accepted-cards-row">
            <span class="pay-chip">Apple Pay</span>
            <span class="pay-chip">Google Pay</span>
            <span class="pay-chip">Visa Debit / Credit</span>
            <span class="pay-chip">Mastercard</span>
            <span class="pay-chip">Contactless NFC</span>
            <span class="pay-chip no-cash">❌ No Cash / No Notes</span>
          </div>
        </section>

        <AdSlot position="top" client="ca-pub-placeholder" slotId="food-top-slot" />

        <!-- SECTION 1: PERMANENT ON-SITE FACILITY -->
        <section class="food-section">
          <h2>Permanent On-Site Venue Facilities</h2>
          <div class="venue-zone-card">
            <div class="zone-header">
              <span class="zone-tag">YEAR-ROUND FACILITY</span>
              <h3>{foodDrinkData.permanent_facilities.the_phoenix_bar_and_pizzeria.title}</h3>
            </div>
            <p>{foodDrinkData.permanent_facilities.the_phoenix_bar_and_pizzeria.description}</p>
            <p class="phoenix-rules"><strong>Access:</strong> {foodDrinkData.permanent_facilities.the_phoenix_bar_and_pizzeria.access_rules}</p>
            <p class="phoenix-vibe"><strong>Atmosphere:</strong> {foodDrinkData.permanent_facilities.the_phoenix_bar_and_pizzeria.atmosphere}</p>
          </div>
        </section>

        <!-- SECTION 2: TOURNAMENT EVENT CATERING -->
        <section class="food-section">
          <h2>World Championship Event Catering & Arena Bars</h2>
          <p>
            During the PDC World Darts Championship, Alexandra Palace operates specialized high-volume catering operations across the Great Hall and Palm Court concourse.
          </p>

          <!-- Great Hall Bars -->
          <div class="venue-zone-card">
            <div class="zone-header">
              <span class="zone-tag">ESTABLISHED TOURNAMENT OPERATION</span>
              <h3>{foodDrinkData.tournament_arena_catering.draught_and_pitchers.title}</h3>
            </div>
            <p>{foodDrinkData.tournament_arena_catering.draught_and_pitchers.description}</p>

            <div class="offerings-grid">
              <div class="offering-box highlight-pitcher">
                <div class="box-icon">🍺</div>
                <h4>4-Pint Draught Pitchers</h4>
                <p>
                  A staple of World Darts hospitality across recent tournaments. Served in sturdy, stackable plastic pitchers enabling table and bleacher groups to purchase 4 pints together, minimizing trips to the bar between legs.
                </p>
              </div>

              <div class="offering-box highlight-cup">
                <div class="box-icon">🥤</div>
                <h4>Reusable Souvenir Stack Cups</h4>
                <p>
                  To eliminate single-use plastic waste, the tournament uses branded rigid stack cups with interlocking handles. Spectators pay a nominal deposit/purchase fee on their initial round, swap cups at the bar, and can take them home as official souvenirs.
                </p>
              </div>
            </div>

            <div class="dietary-callout" style="background: #f8fafc; border-color: #94a3b8; color: #475569;">
              ℹ️ <strong>Status Advisory:</strong> {foodDrinkData.tournament_arena_catering.draught_and_pitchers.confirmation_note}
            </div>
          </div>

          <!-- Palm Court Street Food Village -->
          <div class="venue-zone-card">
            <div class="zone-header">
              <span class="zone-tag">TYPICAL / RECENT EVENT EXAMPLES</span>
              <h3>{foodDrinkData.tournament_arena_catering.fan_village_street_food.title}</h3>
            </div>
            <p>{foodDrinkData.tournament_arena_catering.fan_village_street_food.description}</p>

            <div class="food-traders-grid">
              {foodDrinkData.tournament_arena_catering.fan_village_street_food.example_traders_recent_editions.map(trader => (
                <div class="trader-pill">
                  <span class="trader-icon">🍴</span>
                  <span class="trader-name">{trader}</span>
                </div>
              ))}
            </div>

            <div class="dietary-callout">
              <strong>Dietary Provision:</strong> {foodDrinkData.tournament_arena_catering.fan_village_street_food.dietary_notes}
            </div>
            <p class="disclaimer-text" style="margin-top: 0.75rem;">
              <em>Note: {foodDrinkData.tournament_arena_catering.fan_village_street_food.confirmation_note}</em>
            </p>
          </div>
        </section>

        <!-- ALCOHOL REGULATIONS & LICENSING -->
        <section class="food-section licensing-panel">
          <h2>Alcohol Regulations & Licensing Rules</h2>
          <div class="licensing-grid">
            <div class="lic-card">
              <h4>🔞 Challenge 25 Mandatory</h4>
              <p>{foodDrinkData.venue_licensing_and_water.challenge_25.rule}</p>
            </div>
            <div class="lic-card">
              <h4>🚫 Intoxication & Ejection</h4>
              <p>{foodDrinkData.venue_licensing_and_water.intoxication_policy.rule}</p>
            </div>
            <div class="lic-card">
              <h4>🚰 Free Water & Outside Food</h4>
              <p>{foodDrinkData.venue_licensing_and_water.outside_alcohol.rule} {foodDrinkData.venue_licensing_and_water.free_water.rule}</p>
            </div>
          </div>
        </section>

        <!-- SECTION 2: NEARBY PUBS -->
        <section class="food-section">
          <h2>Top Verified Pubs Near Alexandra Palace</h2>
          <p>
            Many darts fans prefer meeting early for lunch or pre-session drinks before ascending the hill. These four verified public houses offer authentic atmosphere, great food, and convenient walking or bus links to the venue:
          </p>

          <div class="pubs-stack">
            {foodDrinkData.nearby_establishments.map(pub => (
              <div class="pub-card">
                <div class="pub-card-header">
                  <div>
                    <span class="pub-type-tag">{pub.type}</span>
                    <h3>{pub.name}</h3>
                    <span class="pub-loc">📍 {pub.location}</span>
                  </div>
                  <div class="pub-prox-box">
                    <span class="prox-val">{pub.proximity.split('(')[0]}</span>
                    <span class="prox-sub">{pub.proximity.includes('(') ? pub.proximity.split('(')[1].replace(')', '') : ''}</span>
                  </div>
                </div>

                <div class="pub-card-body">
                  <p class="pub-vibe"><strong>The Vibe:</strong> {pub.vibe}</p>
                  <p class="pub-fit"><strong>Session Timing:</strong> {pub.session_fit}</p>
                </div>
              </div>
            ))}
          </div>
        </section>

        <!-- SESSION TIMING ADVICE -->
        <section class="food-section timing-advice-card">
          <h2>Pre- & Post-Session Dining Strategy</h2>
          <div class="timing-grid">
            <div class="timing-item">
              <h3>Afternoon Sessions (12:30 Start / 16:30 Finish)</h3>
              <p>{foodDrinkData.session_timing_advisories.afternoon_session}</p>
            </div>
            <div class="timing-item">
              <h3>Evening Sessions (19:00 Start / 23:00 Finish)</h3>
              <p>{foodDrinkData.session_timing_advisories.evening_session}</p>
            </div>
          </div>
        </section>

        <AdSlot position="middle" client="ca-pub-placeholder" slotId="food-mid-slot" />

        <!-- FAQ SECTION -->
        <section class="food-section">
          <h2>Frequently Asked Questions: Food & Drink</h2>
          <div class="faq-list">
            {foodDrinkFaqSchema.mainEntity.map(faq => (
              <div class="faq-item">
                <h3>{faq.name}</h3>
                <p>{faq.acceptedAnswer.text}</p>
              </div>
            ))}
          </div>
        </section>

        <!-- VERIFICATION COMPONENT -->
        <VerificationBadge
          source={foodDrinkData.source}
          verifiedDate={foodDrinkData.last_verified}
          status="CONFIRMED VENUE POLICY / EVENT MENUS PENDING"
        />

      </article>

      <!-- Sidebar -->
      <aside class="food-sidebar">
        <div class="sidebar-widget">
          <h3 class="widget-title">Food & Drink Checklist</h3>
          <ul class="glance-list">
            <li><strong>Payment:</strong> 100% Cashless Only</li>
            <li><strong>Pitchers:</strong> 4-Pint Draught Beers</li>
            <li><strong>Cups:</strong> Reusable Souvenir Cups</li>
            <li><strong>ID Policy:</strong> Challenge 25 Active</li>
            <li><strong>Water:</strong> Free Palm Court Refills</li>
            <li><strong>Outside Alcohol:</strong> Strictly Prohibited</li>
          </ul>
        </div>

        <div class="sidebar-widget">
          <h3 class="widget-title">Top Pre-Match Pubs</h3>
          <ul class="glance-list">
            <li><strong>The Starting Gate:</strong> By Rail Station</li>
            <li><strong>The Victoria Stakes:</strong> Muswell Hill foot</li>
            <li><strong>The Mossy Well:</strong> Wetherspoon budget</li>
            <li><strong>The Phoenix:</strong> On-site terrace pub</li>
          </ul>
        </div>

        <div class="sidebar-widget">
          <h3 class="widget-title">Related Ally Pally Guides</h3>
          <ul class="widget-links">
            <li><a href="/venue/security-bag-policy/">Bag Size Limits & Prohibited Items</a></li>
            <li><a href="/venue/great-hall-seating-plan/">Great Hall Seating Views</a></li>
            <li><a href="/travel/tube-train-routes/">London Underground & Rail Routes</a></li>
            <li><a href="/hotels/budget-options/">Budget Hotels Near Ally Pally</a></li>
            <li><a href="/tickets/resale-returns/">Official Ticket Resale Guide</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </main>
</BaseLayout>

<style>
  .food-hero {
    background: linear-gradient(135deg, #7c2d12 0%, #9a3412 100%);
    color: #ffffff;
    padding: 3rem 0;
    border-bottom: 1px solid #c2410c;
  }

  .badge-group {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }

  .badge {
    background: #9a3412;
    color: #fed7aa;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.65rem;
    border-radius: 4px;
    letter-spacing: 0.05em;
  }

  .badge-accent {
    background: #f97316;
    color: #ffffff;
  }

  .food-title {
    font-size: 2.25rem;
    font-weight: 800;
    margin: 0 0 1rem;
    line-height: 1.2;
  }

  .food-subtitle {
    font-size: 1.15rem;
    color: #ffedd5;
    max-width: 820px;
    margin: 0 0 1.5rem;
    line-height: 1.5;
  }

  .hero-meta {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    font-size: 0.85rem;
    color: #fdba74;
  }

  .content-container {
    padding-top: 2rem;
    padding-bottom: 4rem;
  }

  .food-layout {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 2.5rem;
  }

  /* Cashless Card */
  .cashless-card {
    background: #eff6ff;
    border: 2px solid #3b82f6;
    border-radius: 12px;
    padding: 1.75rem;
    margin-bottom: 2rem;
  }

  .cashless-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #1d4ed8;
    color: #ffffff;
    font-weight: 800;
    font-size: 0.78rem;
    padding: 0.25rem 0.65rem;
    border-radius: 9999px;
    margin-bottom: 0.75rem;
  }

  .cashless-card h2 {
    color: #1e3a8a;
    margin-top: 0;
    margin-bottom: 0.5rem;
    font-size: 1.35rem;
  }

  .cashless-card p {
    color: #1e40af;
    font-size: 0.95rem;
    line-height: 1.5;
    margin: 0 0 1.25rem;
  }

  .accepted-cards-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .pay-chip {
    background: #ffffff;
    border: 1px solid #bfdbfe;
    color: #1e3a8a;
    font-size: 0.82rem;
    font-weight: 700;
    padding: 0.35rem 0.75rem;
    border-radius: 6px;
  }

  .pay-chip.no-cash {
    background: #fee2e2;
    border-color: #fca5a5;
    color: #991b1b;
  }

  /* Venue Zone Card */
  .venue-zone-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .zone-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
    flex-wrap: wrap;
  }

  .zone-tag {
    background: #0f172a;
    color: #ffffff;
    font-size: 0.72rem;
    font-weight: 800;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
  }

  .zone-header h3 {
    margin: 0;
    font-size: 1.25rem;
    color: #0f172a;
  }

  .offerings-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin: 1.25rem 0;
  }

  .offering-box {
    border-radius: 8px;
    padding: 1.25rem;
    border: 1px solid;
  }

  .highlight-pitcher {
    background: #fffbeb;
    border-color: #fde68a;
  }

  .highlight-pitcher h4 {
    color: #92400e;
    margin: 0 0 0.4rem;
  }

  .highlight-cup {
    background: #f0fdf4;
    border-color: #bbf7d0;
  }

  .highlight-cup h4 {
    color: #166534;
    margin: 0 0 0.4rem;
  }

  .box-icon {
    font-size: 1.5rem;
    margin-bottom: 0.4rem;
  }

  .offering-box p {
    font-size: 0.85rem;
    margin: 0;
    color: #475569;
    line-height: 1.45;
  }

  .beverage-types-list h4 {
    margin: 0 0 0.5rem;
    font-size: 0.95rem;
    color: #0f172a;
  }

  .beverage-types-list ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.88rem;
    color: #334155;
  }

  /* Palm Court Traders */
  .food-traders-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 0.75rem;
    margin: 1rem 0;
  }

  .trader-pill {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    padding: 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .trader-name {
    font-size: 0.85rem;
    color: #334155;
    font-weight: 500;
  }

  .dietary-callout {
    background: #f0fdf4;
    border-left: 4px solid #16a34a;
    padding: 0.65rem 0.85rem;
    font-size: 0.85rem;
    color: #166534;
    border-radius: 4px;
    margin-top: 1rem;
  }

  .phoenix-rules, .phoenix-vibe {
    font-size: 0.88rem;
    color: #475569;
    margin: 0.35rem 0 0;
  }

  /* Licensing Panel */
  .licensing-panel {
    background: #f8fafc;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    padding: 1.5rem;
    margin: 2rem 0;
  }

  .licensing-panel h2 {
    margin-top: 0;
    color: #0f172a;
  }

  .licensing-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
    margin-top: 1rem;
  }

  .lic-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    padding: 1rem;
  }

  .lic-card h4 {
    margin: 0 0 0.4rem;
    font-size: 0.95rem;
    color: #0f172a;
  }

  .lic-card p {
    margin: 0;
    font-size: 0.82rem;
    color: #475569;
    line-height: 1.45;
  }

  /* Pubs Stack */
  .pubs-stack {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin: 1.5rem 0;
  }

  .pub-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 1.5rem;
  }

  .pub-card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .pub-type-tag {
    background: #fef3c7;
    color: #92400e;
    font-size: 0.72rem;
    font-weight: 800;
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
    display: inline-block;
    margin-bottom: 0.25rem;
  }

  .pub-card-header h3 {
    margin: 0 0 0.2rem;
    font-size: 1.2rem;
    color: #0f172a;
  }

  .pub-loc {
    font-size: 0.82rem;
    color: #64748b;
  }

  .pub-prox-box {
    text-align: right;
  }

  .prox-val {
    display: block;
    font-size: 1.1rem;
    font-weight: 800;
    color: #c2410c;
  }

  .prox-sub {
    font-size: 0.75rem;
    color: #64748b;
  }

  .pub-card-body p {
    margin: 0 0 0.4rem;
    font-size: 0.88rem;
    color: #334155;
    line-height: 1.45;
  }

  /* Timing Advice */
  .timing-advice-card {
    background: #fff7ed;
    border: 1px solid #ffedd5;
    border-radius: 8px;
    padding: 1.5rem;
    margin: 2rem 0;
  }

  .timing-advice-card h2 {
    color: #9a3412;
    margin-top: 0;
  }

  .timing-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
    margin-top: 1rem;
  }

  .timing-item {
    background: #ffffff;
    border: 1px solid #fed7aa;
    border-radius: 6px;
    padding: 1.15rem;
  }

  .timing-item h3 {
    margin: 0 0 0.5rem;
    font-size: 1rem;
    color: #c2410c;
  }

  .timing-item p {
    margin: 0;
    font-size: 0.85rem;
    color: #475569;
    line-height: 1.45;
  }

  /* FAQs */
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-top: 1rem;
  }

  .faq-item {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 1.25rem;
  }

  .faq-item h3 {
    margin: 0 0 0.5rem;
    font-size: 1.05rem;
    color: #0f172a;
  }

  .faq-item p {
    margin: 0;
    font-size: 0.9rem;
    color: #475569;
    line-height: 1.5;
  }

